PLATFORM_API_BASE_URL=http://localhost:3000
# Optional external storefront scheme override. Behind a trusted proxy the dashboard
# uses X-Forwarded-Proto automatically; production otherwise defaults to HTTPS.
# STOREFRONT_PUBLIC_PROTOCOL=https
DASHBOARD_PUBLIC_BASE_URL=http://dashboard.lvh.me
DASHBOARD_AUTH_COOKIE_DOMAIN=.lvh.me
# Must match platform-api BETTER_AUTH_COOKIE_PREFIX (default ecs → ecs.session_token)
BETTER_AUTH_COOKIE_PREFIX=ecs
STOREFRONT_PUBLIC_BASE_DOMAIN=lvh.me
