---
import Icon from "./Icon.astro";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";
interface Props { data: unknown; themeTokens?: unknown; tenantName: string; deferCartCount?: boolean; }
const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const wishlistMessages = {
  emptyTitle: m.wishlist_empty_title({}, { locale }),
  emptyHelp: m.wishlist_empty_help({}, { locale }),
  browse: m.action_browse_products({}, { locale }),
  savedProduct: m.wishlist_saved_product({}, { locale }),
  productFallback: m.catalog_product_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
};
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title={m.wishlist_title({}, { locale })}>
  <main class="lv-wishlist" data-wishlist-page data-wishlist-messages={JSON.stringify(wishlistMessages)}><header><span><Icon name="wishlist" /></span><p>{m.wishlist_saved_items({}, { locale })}</p><h1>{m.wishlist_title({}, { locale })}</h1><small data-wishlist-account-copy>{m.wishlist_intro({}, { locale })}</small></header><section data-wishlist-content aria-live="polite" aria-busy="true"><div class="lv-wishlist__loading"><span aria-hidden="true"></span><strong>{m.wishlist_loading({}, { locale })}</strong></div></section></main>
</Layout>
<script>
  import { WISHLIST_REQUEST_EVENT, WISHLIST_UPDATED_EVENT, type WishlistEntry } from "../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../lib/browser/localized-path";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-wishlist-page]"); const content = root?.querySelector("[data-wishlist-content]"); if (!content) return;
    const messages = JSON.parse(root?.dataset.wishlistMessages || "{}") as Record<string, string>;
    let items: WishlistEntry[] = [];
    const money = (amount: number | null, currency: string | null) => { if (typeof amount !== "number") return ""; try { return new Intl.NumberFormat(document.documentElement.lang === "am" ? "am-ET" : "en-ET",{ style:"currency", currency:(currency || "ETB").toUpperCase() }).format(amount); } catch { return String(amount); } };
    const render = () => {
      content.replaceChildren();
      if (!items.length) { const empty = document.createElement("div"); empty.className = "lv-wishlist__empty"; const title = document.createElement("h2"); title.textContent = messages.emptyTitle || ""; const copy = document.createElement("p"); copy.textContent = messages.emptyHelp || ""; const link = document.createElement("a"); link.href = localizeBrowserPath("/products"); link.textContent = messages.browse || ""; empty.append(title, copy, link); content.append(empty); return; }
      const grid = document.createElement("div"); grid.className = "lv-wishlist__grid";
      for (const item of items) { const card = document.createElement("article"); const itemPath = localizeBrowserPath(item.path); if (item.thumbnail) { const media = document.createElement("a"); media.className = "lv-wishlist__media"; media.href = itemPath; const image = document.createElement("img"); image.src = item.thumbnail; image.alt = item.title; image.width = 900; image.height = 900; image.loading = "lazy"; image.decoding = "async"; media.append(image); card.append(media); } const meta = document.createElement("span"); meta.textContent = messages.savedProduct || ""; const link = document.createElement("a"); link.href = itemPath; link.textContent = item.title || messages.productFallback || ""; const price = document.createElement("strong"); price.textContent = money(item.priceAmount,item.currencyCode); const remove = document.createElement("button"); remove.type = "button"; remove.textContent = messages.remove || ""; remove.addEventListener("click", () => { window.dispatchEvent(new CustomEvent(WISHLIST_UPDATED_EVENT,{ detail:{ items:items.filter((saved) => saved.path !== item.path), origin:"page" } })); }); card.append(meta,link); if (price.textContent) card.append(price); card.append(remove); grid.append(card); }
      content.append(grid);
    };
    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const next = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail?.items;
      if (!Array.isArray(next)) return;
      items = next;
      content.setAttribute("aria-busy", "false");
      render();
    });
    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  })();
</script>
<style is:global lang="scss">@use "./styles/secondary-pages.scss";</style>
