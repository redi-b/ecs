---
import type { LuviaV1Data } from "@ecs/storefront-templates";
import StorefrontLanguageSwitcher from "../../../../components/shell/StorefrontLanguageSwitcher.astro";
import * as m from "../../../../paraglide/messages.js";
import { Icon } from "astro-icon/components";
import type { StoreCategory, StoreCollection } from "../../../../lib/commerce/types";
import { categoryProductsHref, collectionProductsHref, taxonomyHandle } from "../../../../lib/commerce/taxonomy-links";
import Dropdown from "./Dropdown.astro";

interface Props {
  tenantName: string;
  header: LuviaV1Data["header"];
  cartCount?: number;
  deferCartCount?: boolean;
  demoMode?: boolean;
  editorMode?: boolean;
  locale: "am" | "en";
  logoUrl?: string | null;
  emptyLogoUrl?: string | null;
  categories?: StoreCategory[];
  collections?: StoreCollection[];
}

const {
  tenantName,
  header,
  cartCount = 0,
  deferCartCount = false,
  demoMode = false,
  editorMode = false,
  locale,
  logoUrl,
  emptyLogoUrl,
  categories = [],
  collections = [],
} = Astro.props;

const rawPathname = Astro.url.pathname;
const cleanPathname =
  rawPathname
    .replace(/^\/demo\/storefront\/(?:luvia|nexahub|afro)/, "")
    .replace(/^\/(?:luvia|nexahub|afro)/, "") || "/";
const isActiveLink = (href: string) =>
  href === "/" ? cleanPathname === "/" : cleanPathname === href || cleanPathname.startsWith(`${href}/`);

const categoryOptions = [
  { value: "all", label: m.catalog_all_categories({}, { locale }), href: "/products" },
  ...categories.map((cat) => ({
    value: taxonomyHandle(cat) || cat.name || cat.id,
    label: cat.name ?? m.catalog_category_fallback({}, { locale }),
    href: categoryProductsHref(cat),
  })),
];

const collectionOptions = [
  { value: "all", label: m.catalog_all_collections({}, { locale }), href: "/products" },
  ...collections.map((col) => ({
    value: taxonomyHandle(col) || col.title || col.id,
    label: col.title ?? m.catalog_collection_fallback({}, { locale }),
    href: collectionProductsHref(col),
  })),
];
---

<header class="header container">
  <div class="header__start">
    <a
      class="logo"
      href="/"
      aria-label={m.a11y_shop_home({ shop: tenantName }, { locale })}
      data-editor-image-scope
    >
      <img
        src={logoUrl ?? undefined}
        alt={tenantName}
        data-editor-image-path="header.logoAssetId"
        data-editor-empty-src={emptyLogoUrl ?? undefined}
        hidden={!logoUrl}
      />
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="navigation">
      <span class="menu__bar"></span><span class="menu__bar"></span><span class="menu__bar"></span>
      <span class="sr-only">{m.a11y_open_navigation({}, { locale })}</span>
    </button>
    <nav class="nav" id="navigation" aria-label={m.a11y_store_navigation({}, { locale })}>
      <div class="nav__links">
        {
          header.navigation.map((item) => (
            <a
              class:list={[
                "nav__link",
                "type-body-400",
                { "is-active": isActiveLink(item.href), "type-body-500": isActiveLink(item.href) },
              ]}
              href={item.href}
              aria-current={isActiveLink(item.href) ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span class="nav__link-arrow" aria-hidden="true">
                <Icon name="chevron" />
              </span>
            </a>
          ))
        }
        {categories.length > 0 && (
          <Dropdown
            id="nav-categories-dropdown"
            label={m.catalog_category({}, { locale })}
            options={categoryOptions}
            staticLabel={true}
            class="nav__dropdown"
          />
        )}
        {collections.length > 0 && (
          <Dropdown
            id="nav-collections-dropdown"
            label={m.catalog_collection({}, { locale })}
            options={collectionOptions}
            staticLabel={true}
            class="nav__dropdown"
          />
        )}
      </div>
      <div class="nav__customer" role="group" aria-label={m.a11y_customer_links({}, { locale })}>
        <a class="nav__customer-item type-body-s-500" href="/wishlist">
          <span class="nav__customer-icon"><Icon name="wishlist" /></span>
          <span>{m.nav_wishlist({}, { locale })}</span>
        </a>
        <a class="nav__customer-item type-body-s-500" href="/account">
          <span class="nav__customer-icon"><Icon name="user" /></span>
          <span>{m.nav_account({}, { locale })}</span>
        </a>
      </div>
    </nav>
  </div>
  <div class="actions">
    <StorefrontLanguageSwitcher hidden={demoMode || editorMode} />
    <form
      class="search"
      action="/products"
      method="get"
      role="search"
      data-product-search-suggestions
      data-search-suggestions-anchor
      data-search-view-all={m.search_view_all({ query: "{query}" }, { locale })}
      data-search-for={m.search_for({ query: "{query}" }, { locale })}
    >
      <label class="sr-only" for="search-input">{m.search_products_label({}, { locale })}</label>
      <input
        id="search-input"
        class="type-body-400"
        name="q"
        type="search"
        placeholder={m.search_products_placeholder({}, { locale })}
      />
      <button
        type="submit"
        aria-label={m.action_search({}, { locale })}
        aria-controls="search-input"
        aria-expanded="false"
      >
        <Icon name="search" />
      </button>
    </form>
    <div class="actions__group">
      <a
        class="action action--wishlist"
        href="/wishlist"
        aria-label={m.nav_wishlist({}, { locale })}
        data-wishlist-indicator
      >
        <Icon name="wishlist" />
      </a>
      <a
        class="action"
        href="/cart"
        aria-label={m.nav_cart({}, { locale })}
        data-cart-trigger
      >
        <Icon name="cart" />
        <span
          class="count type-body-xs"
          data-cart-count
          aria-live="polite"
          hidden={deferCartCount ? true : cartCount <= 0}
        >
          {deferCartCount ? "" : cartCount}
        </span>
      </a>
      <a
        class="action action--account"
        href="/account"
        aria-label={m.nav_account({}, { locale })}
      >
        <Icon name="user" />
      </a>
    </div>
  </div>
</header>
<button class="header-backdrop" type="button" data-header-backdrop aria-label={m.a11y_close_navigation({}, { locale })} hidden></button>
