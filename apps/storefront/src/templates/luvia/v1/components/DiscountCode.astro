---
import type { StoreCartPromotion } from "../../../../lib/commerce/types";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";

interface Props {
  appliedCodes: StoreCartPromotion[];
  idPrefix: string;
  helper?: string;
  error?: string | null;
}

const { appliedCodes, idPrefix, helper, error } = Astro.props;
const labelId = `${idPrefix}-discount-label`;
const inputId = `${idPrefix}-discount-code`;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<section class="lv-discount-code" aria-labelledby={labelId} data-discount-code>
  <form method="post" action="/actions/cart/promotion" data-cart-promotion-form>
    <label id={labelId} for={inputId} class="type-body-s-500">{m.cart_discount_question({}, { locale })}</label>
    <div class="lv-discount-code__field">
      <input
        id={inputId}
        name="code"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        placeholder={m.cart_discount_placeholder({}, { locale })}
        class="type-body-400"
      />
      <button type="submit" class="type-body-s-500">{m.action_apply({}, { locale })}</button>
    </div>
    {helper && <small class="type-body-xs">{helper}</small>}
  </form>
  <div class="lv-discount-code__applied" data-applied-promotions>
    {appliedCodes.map((promotion) => (
      <form method="post" action="/actions/cart/promotion" data-cart-promotion-form>
        <input type="hidden" name="intent" value="remove" />
        <input type="hidden" name="code" value={promotion.code ?? ""} />
        <span><b class="type-body-s-500">{promotion.code}</b><small class="type-body-xs">{m.cart_discount_applied({}, { locale })}</small></span>
        <button type="submit" class="type-body-xs" aria-label={m.cart_discount_remove({ code: promotion.code ?? "" }, { locale })}>{m.action_remove({}, { locale })}</button>
      </form>
    ))}
  </div>
  <p class:list={["lv-discount-code__status type-body-xs", { "is-error": Boolean(error) }]} data-discount-status aria-live="polite">{error}</p>
</section>
