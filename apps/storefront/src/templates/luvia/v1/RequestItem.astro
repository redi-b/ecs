---
import Icon from "./Icon.astro";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";
interface Props { data: unknown; themeTokens?: unknown; tenantName: string; deferCartCount?: boolean; }
const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseLuviaData(data);
const sent = Astro.url.searchParams.get("sent") === "1";
const submitError = Astro.url.searchParams.get("error");
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const inquiryMessages = {
  sending: m.request_sending({}, { locale }),
  received: m.request_received({}, { locale }),
  failed: m.request_failed({}, { locale }),
};
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title={m.request_title({}, { locale })}>
  <main class="lv-request">
    <section class="lv-request__intro"><p><Icon name="sparkle" />{m.request_title({}, { locale })}</p><h1>{m.request_title({}, { locale })}</h1><span>{m.request_intro({}, { locale })}</span></section>
    <section class="lv-request__panel"><header><span><Icon name="search" /></span><div><h2>{m.request_title({}, { locale })}</h2><p>{m.request_intro({}, { locale })}</p></div></header>
      <form data-inquiry-form action="/actions/inquiries" method="post">
        <input type="hidden" name="type" value="product_request" />
        <label class="lv-inquiry-honeypot" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
        <label><span>{m.request_product_name({}, { locale })}*</span><input name="productName" required /></label>
        <label><span>{m.request_brand_optional({}, { locale })}</span><input name="brand" /></label>
        <label class="is-wide"><span>{m.request_link_optional({}, { locale })}</span><input name="productUrl" type="url" inputmode="url" placeholder="https://" /></label>
        <label><span>{m.request_your_name({}, { locale })}*</span><input name="customerName" required autocomplete="name" /></label>
        <label><span>{m.request_contact({}, { locale })}*</span><input name="contact" required /></label>
        <label class="is-wide"><span>{m.request_details_optional({}, { locale })}</span><textarea name="details" placeholder={m.request_details_placeholder({}, { locale })}></textarea></label>
        <button type="submit">{m.request_send({}, { locale })}</button>
        <p class:list={["lv-inquiry-status", sent && "is-success", submitError && "is-error"]} role="status" aria-live="polite" data-inquiry-status>{sent ? inquiryMessages.received : submitError ? inquiryMessages.failed : ""}</p>
      </form>
    </section>
  </main>
</Layout>
<script is:inline define:vars={{ inquiryMessages }}>
  (() => { const form = document.querySelector("[data-inquiry-form]"); if (!(form instanceof HTMLFormElement)) return; const status = form.querySelector("[data-inquiry-status]"); const button = form.querySelector("button[type=submit]"); form.addEventListener("submit", async (event) => { if (!form.reportValidity()) return; event.preventDefault(); if (button instanceof HTMLButtonElement) { button.disabled = true; button.setAttribute("aria-busy", "true"); } if (status) { status.textContent = inquiryMessages.sending; status.className = "lv-inquiry-status is-pending"; } try { const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } }); if (!response.ok) throw new Error(inquiryMessages.failed); form.reset(); if (status) { status.textContent = inquiryMessages.received; status.className = "lv-inquiry-status is-success"; } } catch { if (status) { status.textContent = inquiryMessages.failed; status.className = "lv-inquiry-status is-error"; } } finally { if (button instanceof HTMLButtonElement) { button.disabled = false; button.removeAttribute("aria-busy"); } } }); })();
</script>
<style is:global lang="scss">@use "./styles/secondary-pages.scss";</style>
