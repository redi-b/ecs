---
import ActionButton from "./ActionButton.astro";
import OfflineStateEnhancer from "../../../components/shell/OfflineStateEnhancer.astro";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount?: number;
  eyebrow: string;
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
  code?: string;
  statusLabel?: string;
  recoveryLabel?: string;
}

const { data, themeTokens, tenantName, cartCount = 0, title, description, actionHref, actionLabel, code } = Astro.props;
const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} seo={{ canonicalUrl: Astro.url.href, description, noindex: true, title: `${title} · ${tenantName}` }}>
  <main class="lv-system" id="main-content" data-storefront-state>
    <div class="lv-system__copy">
      {code ? <p>{code}</p> : null}
      <h1 data-state-copy data-offline-copy={m.status_offline_title({}, { locale })}>{title}</h1>
      <div class="lv-system__description" data-state-copy data-offline-copy={m.status_offline_help({}, { locale })}>{description}</div>
      {actionHref && actionLabel ? <ActionButton href={actionHref} tone="primary">{actionLabel}</ActionButton> : null}
    </div>
  </main>
  <OfflineStateEnhancer />
</Layout>
<style>
  .lv-system{display:grid;min-height:clamp(34rem,72svh,52rem);padding:clamp(5rem,11vw,10rem) clamp(1rem,6vw,6rem);align-content:center;background:var(--lv-bg);color:var(--lv-ink)}
  .lv-system__copy{max-width:52rem}.lv-system__copy>p{margin:0 0 1rem;color:color-mix(in srgb,var(--lv-ink) 58%,transparent);font-size:.875rem;font-weight:600}
  h1{max-width:12ch;margin:0;font-size:clamp(3rem,9vw,7rem);line-height:.95;letter-spacing:-.05em}.lv-system__description{max-width:54ch;margin:1.5rem 0 2rem;line-height:1.7;color:color-mix(in srgb,var(--lv-ink) 68%,transparent)}
</style>
