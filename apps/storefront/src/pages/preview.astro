---
import { loadPageContext } from "../lib/page-context";
import {
  loadStorefrontPreviewPage,
} from "../lib/storefront-preview-pages";
import { parseStorefrontPreviewPageId } from "../lib/storefront-preview-page-contract";
import { getStorefrontEditorManifest } from "@ecs/storefront-templates";

const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const pageId = parseStorefrontPreviewPageId(Astro.url.searchParams.get("page"));
const configuredEditorOrigin = resolveConfiguredEditorOrigin();
const editorOrigins = [Astro.url.origin, configuredEditorOrigin].filter(
  (origin, index, origins): origin is string => Boolean(origin) && origins.indexOf(origin) === index,
);
const ctx = token
  ? await loadPageContext(Astro.request, { previewToken: token, skipCart: true })
  : { ok: false as const, status: 400, message: "Preview token is required." };
const editorManifest = ctx.ok ? getStorefrontEditorManifest(ctx.config.storefront.templateKey) : undefined;
const previewBindings = Object.fromEntries((editorManifest?.sections ?? []).flatMap((section) => section.fields).filter((field) => field.preview).map((field) => [field.path, field.preview]));
const previewPage = ctx.ok && pageId ? await loadStorefrontPreviewPage(ctx, pageId) : null;
const PreviewComponent = previewPage?.component;

Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.headers.set("referrer-policy", "no-referrer");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
Astro.response.headers.set(
  "content-security-policy",
  `frame-ancestors 'self'${configuredEditorOrigin ? ` ${configuredEditorOrigin}` : ""}`,
);
if (!ctx.ok) Astro.response.status = ctx.status;
else if (!pageId) Astro.response.status = 404;
else if (!PreviewComponent) Astro.response.status = 503;

function resolveConfiguredEditorOrigin() {
  const configured = process.env.STOREFRONT_EDITOR_ORIGIN?.trim();
  if (configured && /^https?:\/\/[^/]+$/.test(configured)) return configured;
  return process.env.NODE_ENV === "development" ? "http://dashboard.lvh.me" : null;
}
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Storefront preview</title></head>
  <body>
    {!ctx.ok ? <main><h1>{ctx.message}</h1></main> : !pageId ? <main><h1>This page is not editable.</h1></main> : !PreviewComponent ? <main><h1>Preview is unavailable.</h1></main> : <PreviewComponent {...previewPage?.props} data={ctx.config.storefront.data} tenantName={ctx.config.tenant.name} themeTokens={ctx.config.storefront.themeTokens} platformApiBaseUrl={ctx.platformApiBaseUrl} requestHost={ctx.requestHost} deferCartCount={true} editorMode={true} />}
    {ctx.ok && PreviewComponent ? <script is:inline define:vars={{ editorOrigins, previewBindings }}>
      const allowedParentOrigins = new Set(editorOrigins);
      let activeParentOrigin = null;
      const fieldNodes = () => document.querySelectorAll('[data-editor-path]');
      const postToParent = (message) => {
        if (activeParentOrigin) {
          window.parent.postMessage(message, activeParentOrigin);
          return;
        }
        allowedParentOrigins.forEach((origin) => window.parent.postMessage(message, origin));
      };
      const selectPath = (path) => {
        document.querySelectorAll('[data-editor-selected]').forEach((node) => node.removeAttribute('data-editor-selected'));
        if (!path) return;
        const node = Array.from(document.querySelectorAll('[data-editor-path],[data-editor-section],[data-editor-image-path],[data-editor-background-image-path],[data-editor-links-path],[data-editor-product-path],[data-editor-products-path],[data-editor-collections-path],[data-editor-related-paths]')).find((candidate) =>
          candidate.getAttribute('data-editor-path') === path || candidate.getAttribute('data-editor-section') === path || candidate.getAttribute('data-editor-image-path') === path || candidate.getAttribute('data-editor-background-image-path') === path || candidate.getAttribute('data-editor-links-path') === path || candidate.getAttribute('data-editor-product-path') === path || candidate.getAttribute('data-editor-products-path') === path || candidate.getAttribute('data-editor-collections-path') === path
          || (candidate.getAttribute('data-editor-related-paths') || '').split(/\s+/).includes(path)
        );
        node?.setAttribute('data-editor-selected', 'true');
        if (node instanceof HTMLElement) {
          const viewport = document.scrollingElement;
          const bounds = node.getBoundingClientRect();
          if (viewport && (bounds.top < 24 || bounds.bottom > window.innerHeight - 24)) {
            viewport.scrollTo({
              behavior: 'smooth',
              top: Math.max(0, viewport.scrollTop + bounds.top - (window.innerHeight - bounds.height) / 2),
            });
          }
        }
      };
      const focusTextTarget = (editable, clickedElement) => {
        if (!(editable instanceof HTMLElement)) return;
        const textTarget = editable.matches('[data-editor-text-target]')
          ? editable
          : editable.querySelector('[data-editor-text-target]');
        if (!(textTarget instanceof HTMLElement) || !textTarget.isContentEditable) return;
        if (clickedElement instanceof Node && textTarget.contains(clickedElement)) return;
        textTarget.focus({ preventScroll: true });
        const selection = window.getSelection();
        if (!selection) return;
        const range = document.createRange();
        range.selectNodeContents(textTarget);
        range.collapse(false);
        selection.removeAllRanges();
        selection.addRange(range);
      };
      document.querySelectorAll('a[href]').forEach((link) => {
        link.setAttribute('data-preview-href', link.getAttribute('href') || '');
        link.removeAttribute('href');
      });
      document.querySelectorAll('form[action]').forEach((form) => form.removeAttribute('action'));
      document.querySelectorAll('a,button,input,select,textarea').forEach((control) => control.setAttribute('tabindex', '-1'));
      document.querySelectorAll('[data-editor-image-path]').forEach((node) => {
        if (node instanceof HTMLImageElement) node.dataset.editorOriginalSrc = node.getAttribute('src') || '';
      });
      document.querySelectorAll('[data-editor-background-image-path]').forEach((node) => {
        if (node instanceof HTMLElement) {
          node.dataset.editorOriginalBackgroundImage = node.style.getPropertyValue('--hero-bg');
        }
      });

      const inertControlFor = (element) => {
        const control = element?.closest('a,button,input,select,textarea');
        const editable = element?.closest('[data-editor-path]');
        return control && !editable ? control : null;
      };

      document.addEventListener('pointerdown', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        if (inertControlFor(element)) event.preventDefault();
      }, true);

      document.addEventListener('focusin', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        const control = inertControlFor(element);
        if (control instanceof HTMLElement) control.blur();
      }, true);

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        event.preventDefault();
        if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
        window.getSelection()?.removeAllRanges();
        selectPath('');
        postToParent({ type: 'ecs:preview:select', path: '' });
      }, true);

      document.addEventListener('click', (event) => {
        const element = event.target instanceof Element ? event.target : null;
        const target = element?.closest('[data-editor-path],[data-editor-image-path],[data-editor-background-image-path],[data-editor-links-path],[data-editor-product-path],[data-editor-products-path],[data-editor-collections-path],[data-editor-section]');
        const path = target?.getAttribute('data-editor-path') || target?.getAttribute('data-editor-image-path') || target?.getAttribute('data-editor-background-image-path') || target?.getAttribute('data-editor-links-path') || target?.getAttribute('data-editor-product-path') || target?.getAttribute('data-editor-products-path') || target?.getAttribute('data-editor-collections-path') || target?.getAttribute('data-editor-section');
        if (path) {
          selectPath(path);
          postToParent({ type: 'ecs:preview:select', path });
          if (target?.hasAttribute('data-editor-path')) focusTextTarget(target, element);
        } else {
          selectPath('');
          postToParent({ type: 'ecs:preview:select', path: '' });
        }

        const action = element?.closest('a,button');
        if (action) event.preventDefault();
      }, true);

      document.addEventListener('submit', (event) => event.preventDefault(), true);
      document.addEventListener('input', (event) => {
        const node = event.target instanceof Element ? event.target.closest('[data-editor-path]') : null;
        const path = node?.getAttribute('data-editor-path');
        if (path) postToParent({ type: 'ecs:preview:field-change', path, value: node?.textContent || '' });
      });

      window.addEventListener('message', (event) => {
        if (!allowedParentOrigins.has(event.origin) || event.source !== window.parent) return;
        activeParentOrigin = event.origin;
        if (event.data?.type === 'ecs:editor:connect') {
          postToParent({ type: 'ecs:preview:ready' });
          return;
        }
        if (event.data?.type === 'ecs:editor:ui') {
          document.documentElement.dataset.editorHints = event.data.showEditHints === false ? 'off' : 'on';
          selectPath(typeof event.data.selectedPath === 'string' ? event.data.selectedPath : '');
          return;
        }
        if (event.data?.type !== 'ecs:editor:update') return;
        const fields = event.data.fields || {};
        fieldNodes().forEach((node) => {
          const path = node.getAttribute('data-editor-path');
          const ownsFocus = document.activeElement === node || node.contains(document.activeElement);
          const textTarget = node.querySelector('[data-editor-text-target]') || node;
          if (!ownsFocus && path && typeof fields[path] === 'string' && textTarget.textContent !== fields[path]) textTarget.textContent = fields[path];
        });
        document.querySelectorAll('[data-editor-visible-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-visible-path');
          if (path && typeof fields[path] === 'boolean') node.hidden = !fields[path];
        });
        document.querySelectorAll('[data-editor-image-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-image-path');
          if (!(node instanceof HTMLImageElement) || !path) return;
          const value = typeof fields[path] === 'string' ? fields[path].trim() : '';
          const nextSource = value || node.dataset.editorOriginalSrc || '';
          if (nextSource) node.src = nextSource;
          else node.removeAttribute('src');
        });
        document.querySelectorAll('[data-editor-background-image-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-background-image-path');
          if (!(node instanceof HTMLElement) || !path) return;
          const value = typeof fields[path] === 'string' ? fields[path].trim() : '';
          if (value) node.style.setProperty('--hero-bg', `url(${value})`);
          else {
            const original = node.dataset.editorOriginalBackgroundImage || '';
            if (original) node.style.setProperty('--hero-bg', original);
            else node.style.removeProperty('--hero-bg');
          }
        });
        document.querySelectorAll('[data-editor-links-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-links-path');
          const links = path ? fields[path] : null;
          if (!Array.isArray(links)) return;
          const binding = path ? previewBindings[path] : null;
          // A field-change is echoed back immediately by the editor. Replacing this
          // list while one of its links is being edited would destroy the active
          // contenteditable node (and its caret) after every keystroke.
          const activeElement = document.activeElement;
          if (activeElement instanceof HTMLElement && activeElement.isContentEditable && node.contains(activeElement)) return;
          if (binding?.strategy === 'preserve-structure') {
            links.forEach((item, index) => {
              if (!item || typeof item !== 'object' || typeof item.label !== 'string' || typeof item.href !== 'string') return;
              const target = node.querySelector(`[data-editor-link-target="${index}"]`);
              if (!(target instanceof HTMLElement)) return;
              target.dataset.previewHref = item.href;
              target.setAttribute('aria-label', item.label);
              const label = target.querySelector('[data-editor-link-label]');
              if (label) label.textContent = item.label;
            });
            return;
          }
          const fragment = document.createDocumentFragment();
          links.forEach((item, index) => {
            if (!item || typeof item !== 'object' || typeof item.label !== 'string' || typeof item.href !== 'string') return;
            const link = document.createElement('a');
            link.textContent = item.label;
            link.dataset.previewHref = item.href;
            link.dataset.editorPath = `${path}.${index}.label`;
            link.contentEditable = 'plaintext-only';
            link.setAttribute('tabindex', '-1');
            if (binding?.strategy === 'list-items') {
              link.className = 'type-body-s-400';
              const itemNode = document.createElement('li');
              itemNode.append(link);
              fragment.append(itemNode);
            } else {
              fragment.append(link);
            }
          });
          node.replaceChildren(fragment);
        });
        document.querySelectorAll('[data-editor-product-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-product-path');
          const productId = path && typeof fields[path] === 'string' ? fields[path] : '';
          const option = productId
            ? document.querySelector(`template[data-editor-product-option="${CSS.escape(productId)}"]`)
            : node.hasAttribute('data-editor-preserve-empty') ? null : document.querySelector('template[data-editor-product-option]');
          if (option instanceof HTMLTemplateElement) node.replaceChildren(option.content.cloneNode(true));
          else if (!productId && node.hasAttribute('data-editor-preserve-empty')) node.replaceChildren();
        });
        document.querySelectorAll('[data-editor-products-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-products-path');
          const requestedIds = path && Array.isArray(fields[path]) ? fields[path] : [];
          const ids = requestedIds.length || node.hasAttribute('data-editor-preserve-empty')
            ? requestedIds
            : Array.from(document.querySelectorAll('template[data-editor-product-option]')).slice(0, 3).map((option) => option.getAttribute('data-editor-product-option'));
          const track = node.querySelector('[data-promo-track]');
          const target = track || node;
          const fragment = document.createDocumentFragment();
          ids.slice(0, 6).forEach((id) => {
            if (typeof id !== 'string') return;
            const option = document.querySelector(`template[data-editor-product-option="${CSS.escape(id)}"]`);
            if (option instanceof HTMLTemplateElement) fragment.append(option.content.cloneNode(true));
          });
          target.replaceChildren(fragment);
          node.dispatchEvent(new CustomEvent('ecs:hero-carousel-updated'));
        });
        document.querySelectorAll('[data-editor-collections-path]').forEach((node) => {
          const path = node.getAttribute('data-editor-collections-path');
          const binding = path ? previewBindings[path] : null;
          const variants = binding?.strategy === 'variant-options' && Array.isArray(binding.variants) ? binding.variants : [];
          const requestedIds = path && Array.isArray(fields[path]) ? fields[path] : [];
          const fallbackAttribute = variants.length ? `data-editor-collection-option-${variants[0]}` : 'data-editor-collection-option';
          const ids = requestedIds.length || node.hasAttribute('data-editor-preserve-empty')
            ? requestedIds
            : Array.from(document.querySelectorAll(`template[${fallbackAttribute}]`)).slice(0, 6).map((option) => option.getAttribute(fallbackAttribute));
          const fragment = document.createDocumentFragment();
          ids.slice(0, 6).forEach((id, index) => {
            if (typeof id !== 'string') return;
            const variant = variants[Math.min(index, variants.length - 1)] || '';
            const selector = variant
              ? `template[data-editor-collection-option-${variant}="${CSS.escape(id)}"]`
              : `template[data-editor-collection-option="${CSS.escape(id)}"]`;
            const option = document.querySelector(selector);
            if (!(option instanceof HTMLTemplateElement)) return;
            const content = option.content.cloneNode(true);
            fragment.append(content);
          });
          node.replaceChildren(fragment);
        });
        document.querySelectorAll('[data-editor-theme-vars]').forEach((node) => {
          let mappings = {};
          try { mappings = JSON.parse(node.getAttribute('data-editor-theme-vars') || '{}'); } catch {}
          const theme = event.data.theme || {};
          Object.entries(mappings).forEach(([role, variable]) => {
            if (typeof variable === 'string' && typeof theme[role] === 'string') node.style.setProperty(variable, theme[role]);
          });
        });
      });

      postToParent({ type: 'ecs:preview:ready' });
    </script> : null}
  </body>
</html>
<style>
  html,body{margin:0;overflow-x:hidden}main{padding:20vh 1.5rem;font-family:system-ui;text-align:center}
  :global([data-editor-path]),:global([data-editor-path] *){cursor:text!important}
  :global([data-editor-empty-label]:empty){min-width:7rem;min-height:2rem;display:inline-flex!important;align-items:center;padding:.3rem .55rem;border-radius:.45rem;background:color-mix(in srgb,#1687ff 7%,transparent);color:color-mix(in srgb,#1687ff 78%,#425466);font-size:.75rem;line-height:1.2;cursor:pointer!important}
  :global([data-editor-empty-label]:empty)::before{content:attr(data-editor-empty-label)}
  :global([data-editor-path]),:global([data-editor-section]),:global([data-editor-image-path]),:global([data-editor-background-image-path]),:global([data-editor-links-path]),:global([data-editor-product-path]),:global([data-editor-products-path]),:global([data-editor-collections-path]){outline:1px solid rgb(22 135 255 / 0);outline-offset:2px;box-shadow:0 0 0 3px rgb(22 135 255 / 0);transition:outline-offset .16s ease,box-shadow .16s ease,background-color .16s ease}
  :global([data-editor-path]:focus),:global([data-editor-path]:focus-visible){outline-color:color-mix(in srgb,#1687ff 88%,transparent)!important}
  :global([data-editor-selected="true"] [data-editor-path]:focus),:global([data-editor-selected="true"] [data-editor-path]:focus-visible),:global(.btn [contenteditable]),:global(.btn [contenteditable]:focus),:global(.btn [contenteditable]:focus-visible){outline:0!important;outline-offset:0!important;box-shadow:none!important;border-color:transparent!important}
  :global(html[data-editor-hints="on"] [data-editor-section]){outline:1px dashed color-mix(in srgb,#1687ff 22%,transparent);outline-offset:2px}
  :global(html[data-editor-hints="on"] [data-editor-path]){outline:1px solid color-mix(in srgb,#1687ff 34%,transparent);outline-offset:2px}
  :global(html[data-editor-hints="on"] [data-editor-image-path]),:global(html[data-editor-hints="on"] [data-editor-background-image-path]){outline-color:color-mix(in srgb,#1687ff 34%,transparent)}
  :global(html[data-editor-hints="on"] [data-editor-links-path]),:global(html[data-editor-hints="on"] [data-editor-product-path]),:global(html[data-editor-hints="on"] [data-editor-products-path]),:global(html[data-editor-hints="on"] [data-editor-collections-path]){outline:1px solid color-mix(in srgb,#1687ff 34%,transparent);outline-offset:2px;cursor:pointer}
  :global(html[data-editor-hints="on"] [data-editor-section]:hover){outline-color:color-mix(in srgb,#1687ff 52%,transparent);outline-offset:3px;background-color:color-mix(in srgb,#1687ff 2%,transparent)}
  :global(html[data-editor-hints="on"] [data-editor-path]:hover){outline-color:color-mix(in srgb,#1687ff 78%,transparent);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,#1687ff 7%,transparent)}
  :global(html[data-editor-hints="on"] [data-editor-image-path]:hover),:global(html[data-editor-hints="on"] [data-editor-background-image-path]:hover),:global(html[data-editor-hints="off"] [data-editor-image-path]:hover),:global(html[data-editor-hints="off"] [data-editor-background-image-path]:hover){outline-color:color-mix(in srgb,#1687ff 76%,transparent);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,#1687ff 6%,transparent);cursor:pointer}
  :global(html[data-editor-hints="off"] [data-editor-section]:hover){outline-style:dashed;outline-color:color-mix(in srgb,#1687ff 48%,transparent);outline-offset:3px}
  :global(html[data-editor-hints="off"] [data-editor-path]:hover){outline-color:color-mix(in srgb,#1687ff 76%,transparent);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,#1687ff 6%,transparent)}
  :global(html[data-editor-hints="on"] [data-editor-links-path]:hover),:global(html[data-editor-hints="on"] [data-editor-product-path]:hover),:global(html[data-editor-hints="on"] [data-editor-products-path]:hover),:global(html[data-editor-hints="on"] [data-editor-collections-path]:hover),:global(html[data-editor-hints="off"] [data-editor-links-path]:hover),:global(html[data-editor-hints="off"] [data-editor-product-path]:hover),:global(html[data-editor-hints="off"] [data-editor-products-path]:hover),:global(html[data-editor-hints="off"] [data-editor-collections-path]:hover){outline-color:color-mix(in srgb,#1687ff 76%,transparent);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in srgb,#1687ff 6%,transparent)}
  :global([data-editor-selected="true"]){outline:2px solid color-mix(in srgb,#1687ff 88%,transparent)!important;outline-offset:3px!important;box-shadow:0 0 0 3px color-mix(in srgb,#1687ff 10%,transparent)!important}
  :global(.lv-button[data-editor-path]){border-radius:999px}
  :global([data-preview-href]){cursor:default}
  :global([data-preview-href] [data-editor-path]),:global([data-preview-href] [data-editor-path] *){cursor:text!important}
  @media (prefers-reduced-motion:reduce){:global([data-editor-path]),:global([data-editor-section]),:global([data-editor-selected="true"]){scroll-behavior:auto;transition:none}}
</style>
