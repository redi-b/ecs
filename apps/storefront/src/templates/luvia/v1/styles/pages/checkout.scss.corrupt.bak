@use "../abstracts" as *;
@use "../components/discount-code";

.lv-checkout {
  min-height: 100vh;
  padding: 122px 0 $space-;
  color: var(--clr-ink);
}

.lv-checkout__hero {
  margin-bottom: 76px;
  text-align: center;
}

.lv-checkout__hero h1 {
  margin: 0;
  color: var(--clr-dark);
}

.lv-checkout__hero p {
  margin: $space-350 0 0;
  color: color-mix(in srgb, var(--clr-ink) 48%, var(--clr-bg));
}

.lv-checkout__layout,
.lv-checkout__error,
.lv-checkout__empty {
  margin-right: auto;
  margin-left: auto;
}

.lv-checkout__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 520px;
  gap: $space-;
  align-items: start;
}

.lv-checkout__error {
  margin-bottom: $space-600;
  padding: $space-650 $space-600;
  border-radius: $radius-200;
  background: var(--clr-danger-bg);
  color: var(--clr-danger);
}

.lv-checkout-form-wrap>header {
  padding-bottom: $space-650;
  border-bottom: 1px solid var(--clr-line);
}

.lv-checkout-form-wrap>header h2 {
  margin: 0 0 $space-800;
}

.lv-checkout-form-wrap>header p {
  margin: 0;
  color: color-mix(in srgb, var(--clr-ink) 48%, var(--clr-bg));
}

.lv-checkout-form {
  padding-top: $space-400;
}

.lv-checkout-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: $space-600 $space-250;
}

.lv-checkout-fields>label {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: $space-800;
  color: color-mix(in srgb, var(--clr-ink) 72%, var(--clr-bg));
}

.lv-checkout-fields>label.is-wide {
  grid-column: 1 / -1;
}

.lv-checkout-choice-group {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.lv-checkout-choice-group.is-wide {
  grid-column: 1 / -1;
}

.lv-checkout-choice-group legend,
.lv-checkout-payment legend {
  margin-bottom: $space-750;
  color: color-mix(in srgb, var(--clr-ink) 72%, var(--clr-bg));
}

.lv-checkout-choice-group>div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-700;
}

.lv-checkout-choice-group label,
.lv-checkout-payment label {
  position: relative;
  min-height: 70px;
  padding: $space-650 $space-600;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-700;
  border: 1px solid var(--clr-line);
  border-radius: $radius-100;
  background: var(--clr-surface);
  cursor: pointer;
}

.lv-checkout-choice-group label:hover,
.lv-checkout-payment label:hover {
  border-color: color-mix(in srgb, var(--clr-primary) 48%, var(--clr-line));
}

.lv-checkout-choice-group label:has(input:checked),
.lv-checkout-payment label:has(input:checked) {
  border-color: var(--clr-primary);
  background: color-mix(in srgb, var(--clr-soft) 62%, var(--clr-white));
  box-shadow: 0 0 0 3px alpha(var(--clr-primary), 0.1);
}

.lv-checkout-choice-group input,
.lv-checkout-payment input {
  width: 19px;
  height: 19px;
  flex: 0 0 auto;
  accent-color: var(--clr-primary);
}

.lv-checkout-choice-group label>span,
.lv-checkout-payment label>span {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: $space-950;
}

.lv-checkout-choice-group strong,
.lv-checkout-payment strong {
  color: var(--clr-ink);
}

.lv-checkout-choice-group small,
.lv-checkout-payment small {
  color: color-mix(in srgb, var(--clr-ink) 52%, var(--clr-bg));
}

.lv-checkout-delivery-details {
  grid-column: 1/-1;
  padding: $space-500;
  display: grid;
  gap: $space-600;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: color-mix(in srgb, var(--clr-soft) 48%, var(--clr-white));
}

.lv-checkout-delivery-details>header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: $space-500;
}

.lv-checkout-delivery-details>header div {
  display: grid;
  gap: $space-900;
}

.lv-checkout-delivery-details>header span {
  color: color-mix(in srgb, var(--clr-ink) 55%, var(--clr-bg));
}

.lv-checkout-delivery-details>header a {
  min-height: 36px;
  padding: 0 $space-650;
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--clr-line);
  border-radius: $radius-pill;
  color: var(--clr-ink);
  text-decoration: none;
}

.lv-checkout-address-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: $space-650;
}

.lv-checkout-address-fields label {
  display: grid;
  gap: $space-800;
  color: color-mix(in srgb, var(--clr-ink) 72%, var(--clr-bg));
}

.lv-checkout-address-fields label.is-wide {
  grid-column: 1/-1;
}

.lv-checkout-address-fields input,
.lv-checkout-address-name input {
  width: 100%;
  min-height: 50px;
  padding: 0 $space-650;
  border: 1px solid var(--clr-line);
  border-radius: $radius-pill;
  outline: 0;
  background: var(--clr-surface);
  color: var(--clr-ink);
}

.lv-checkout-address-fields input:focus,
.lv-checkout-address-name input:focus {
  border-color: var(--clr-primary);
  box-shadow: 0 0 0 3px alpha(var(--clr-primary), 0.14);
}

.lv-checkout-saved-addresses {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.lv-checkout-saved-addresses legend {
  margin-bottom: $space-750;
  color: color-mix(in srgb, var(--clr-ink) 72%, var(--clr-bg));
}

.lv-checkout-saved-addresses>div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-700;
}

.lv-checkout-saved-addresses label {
  min-height: 64px;
  padding: $space-700 $space-650;
  display: flex;
  align-items: center;
  gap: $space-700;
  border: 1px solid var(--clr-line);
  border-radius: $radius-100;
  background: var(--clr-surface);
  cursor: pointer;
}

.lv-checkout-saved-addresses label:has(input:checked) {
  border-color: var(--clr-primary);
  background: color-mix(in srgb, var(--clr-soft) 62%, var(--clr-white));
  box-shadow: 0 0 0 3px alpha(var(--clr-primary), 0.1);
}

.lv-checkout-saved-addresses input {
  width: 19px;
  height: 19px;
  flex: 0 0 auto;
  accent-color: var(--clr-primary);
}

.lv-checkout-saved-addresses label span {
  min-width: 0;
  display: grid;
  gap: $space-950;
}

.lv-checkout-saved-addresses label small {
  overflow: hidden;
  color: color-mix(in srgb, var(--clr-ink) 52%, var(--clr-bg));
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lv-checkout-saved-addresses>p {
  margin: $space-750 0 0;
  color: color-mix(in srgb, var(--clr-ink) 52%, var(--clr-bg));
}

.lv-checkout-save-address {
  padding-top: $space-650;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(180px, .55fr);
  gap: $space-700;
  align-items: end;
  border-top: 1px solid var(--clr-line);
}

.lv-checkout-save-address>label:first-child {
  min-height: 50px;
  display: flex;
  align-items: center;
  gap: $space-700;
  cursor: pointer;
}

.lv-checkout-save-address>label:first-child input {
  width: 18px;
  height: 18px;
  accent-color: var(--clr-primary);
}

.lv-checkout-save-address>label:first-child span {
  display: grid;
  gap: $space-950;
}

.lv-checkout-save-address>label:first-child small {
  color: color-mix(in srgb, var(--clr-ink) 52%, var(--clr-bg));
}

.lv-checkout-address-name {
  display: grid;
  gap: $space-800;
}

.lv-checkout-save-address>p {
  grid-column: 1/-1;
  margin: 0;
  padding: $space-700 $space-650;
  border-radius: $radius-150;
  background: color-mix(in srgb, var(--clr-accent) 38%, var(--clr-white));
}

.lv-checkout-fields>label>input,
.lv-checkout-fields>label>select,
.lv-checkout-fields>label>textarea {
  width: 100%;
  min-height: 52px;
  padding: 0 $space-650;
  border: 1px solid var(--clr-line);
  border-radius: $radius-100;
  outline: 0;
  background: var(--clr-surface);
  color: var(--clr-ink);
}

.lv-checkout-fields>label>textarea {
  min-height: 86px;
  padding-top: $space-650;
  resize: vertical;
}

.lv-checkout-fields>label>input:focus,
.lv-checkout-fields>label>select:focus,
.lv-checkout-fields>label>textarea:focus {
  border-color: var(--clr-primary);
  box-shadow: 0 0 0 3px alpha(var(--clr-primary), 0.14);
}

.lv-checkout-fields>label>input::placeholder,
.lv-checkout-fields>label>textarea::placeholder {
  color: color-mix(in srgb, var(--clr-ink) 32%, var(--clr-bg));
}

.lv-checkout-account {
  min-height: 44px;
  margin: $space-650 0;
  display: flex;
  align-items: center;
  gap: $space-700;
  color: color-mix(in srgb, var(--clr-ink) 72%, var(--clr-bg));
}

.lv-checkout-account input {
  width: 19px;
  height: 19px;
  accent-color: var(--clr-primary);
}

.lv-checkout-account:has(input:disabled) {
  color: color-mix(in srgb, var(--clr-ink) 46%, var(--clr-bg));
}

.lv-checkout-account small {
  margin-left: $space-850;
  padding: $space-950 $space-800;
  border-radius: $radius-pill;
  background: var(--clr-soft);
}

.lv-checkout-account a {
  color: var(--clr-ink);
  text-underline-offset: 3px;
}

.lv-checkout-account.is-signed-in {
  padding: $space-700 $space-600;
  align-items: flex-start;
  flex-direction: column;
  gap: $space-950;
  border: 1px solid var(--clr-line);
  border-radius: $radius-50;
  background: color-mix(in srgb, var(--clr-soft) 72%, var(--clr-white));
}

.lv-checkout-account.is-signed-in span {
  color: color-mix(in srgb, var(--clr-ink) 58%, var(--clr-bg));
}

.lv-checkout-payment {
  margin: $space-800 0 $space-600;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-700;
  border: 0;
}

.lv-checkout-payment legend {
  grid-column: 1 / -1;
}

.lv-checkout-payment>p {
  grid-column: 1 / -1;
  margin: 0;
  padding: $space-650;
  border-radius: $radius-100;
  background: var(--clr-soft);
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-checkout-actions {
  display: block;
}

.lv-checkout-actions button {
  min-height: 52px;
  padding: 0 $space-600;
  border: 0;
  border-radius: $radius-pill;
  background: var(--clr-primary);
  color: var(--clr-on-primary);
  cursor: pointer;
  width: 100%;
}

.lv-checkout-actions button:disabled {
  cursor: not-allowed;
  opacity: .5;
}

.lv-checkout-actions button[data-loading] {
  opacity: .72;
}

.lv-checkout-blocker {
  grid-column: 1 / -1;
  margin-bottom: $space-600;
  padding: $space-600;
  border-radius: $radius-100;
  background: var(--clr-warning-bg);
  color: var(--clr-warning);
}

.lv-checkout-blocker p {
  margin: $space-900 0 0;
}

.lv-checkout-summary {
  padding: $space-350;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: var(--clr-surface);
  box-shadow: 1px 7px 34px alpha(var(--clr-soft), 0.18);
}

.lv-checkout-summary header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lv-checkout-summary h2 {
  margin: 0;
}

.lv-checkout-summary header span {
  padding: $space-900 $space-700;
  border-radius: $radius-pill;
  background: var(--clr-soft);
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-checkout-summary ul {
  margin: $space-600 0 $space-500;
  padding: 0;
  list-style: none;
}

.lv-checkout-summary li {
  min-height: 84px;
  padding: $space-700 0;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) auto;
  gap: $space-700;
  align-items: center;
  border-bottom: 1px solid var(--clr-soft);
}

.lv-checkout-summary li>div {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: $radius-250;
  background: color-mix(in srgb, var(--clr-soft) 82%, var(--clr-bg));
}

.lv-checkout-summary li img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lv-checkout-summary li p {
  min-width: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: $space-950;
}

.lv-checkout-summary li strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lv-checkout-summary li span {
  color: color-mix(in srgb, var(--clr-ink) 48%, var(--clr-bg));
}

.lv-checkout-summary li b {
  white-space: nowrap;
}

.lv-checkout-summary .lv-discount-code {
  margin: $space-900 0 $space-500;
}

.lv-checkout-summary dl {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: $space-700;
}

.lv-checkout-summary dl>div {
  display: flex;
  justify-content: space-between;
  color: color-mix(in srgb, var(--clr-ink) 48%, var(--clr-bg));
}

.lv-checkout-summary dd {
  margin: 0;
  text-align: right;
}

.lv-checkout-summary dl>div:last-child {
  margin-top: $space-900;
  padding-top: $space-600;
  border-top: 1px solid var(--clr-line);
  color: var(--clr-ink);
}

.lv-checkout-summary dl>div.is-savings {
  color: color-mix(in srgb, var(--clr-primary) 76%, var(--clr-ink));
}

.lv-checkout-summary>small {
  margin-top: $space-650;
  display: block;
  color: color-mix(in srgb, var(--clr-ink) 48%, var(--clr-bg));
  text-align: center;
}

.lv-checkout__empty {
  padding: $space- $space-350;
  border-radius: $radius-;
  background: var(--clr-soft);
  text-align: center;
}

.lv-checkout__empty h2 {
  margin: 0 0 $space-800;
}

.lv-checkout__empty p {
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-checkout__empty a {
  min-height: 50px;
  padding: 0 $space-400;
  display: inline-flex;
  align-items: center;
  border-radius: $radius-pill;
  background: var(--clr-primary);
  color: var(--clr-on-primary);
  text-decoration: none;
}

@media (max-width: 1120px) {
  .lv-checkout__layout {
    grid-template-columns: minmax(0, 1fr) 410px;
    gap: $space-100;
  }
}

@media (max-width: 820px) {
  .lv-checkout {
    padding: 98px 0 $space-;
  }

  .lv-checkout__hero {
    margin-bottom: 44px;
    padding-inline: $space-700;
  }

  .lv-checkout__hero h1 {
  }

  .lv-checkout__hero p {
    margin-top: $space-600;
  }

  .lv-checkout__layout {
    display: flex;
    flex-direction: column-reverse;
    gap: $space-250;
  }

  .lv-checkout-form-wrap,
  .lv-checkout-summary {
    width: 100%;
  }

  .lv-checkout-summary ul {
    max-height: 260px;
    overflow-y: auto;
  }
}

@media (max-width: 560px) {
  .lv-checkout-fields {
    grid-template-columns: 1fr;
    gap: $space-650;
  }

  .lv-checkout-fields>label.is-wide,
  .lv-checkout-choice-group.is-wide {
    grid-column: auto;
  }

  .lv-checkout-choice-group>div,
  .lv-checkout-payment,
  .lv-checkout-saved-addresses>div {
    grid-template-columns: 1fr;
  }

  .lv-checkout-fields input,
  .lv-checkout-fields select,
  .lv-checkout-fields textarea {
    min-height: 50px;
  }

  .lv-checkout-payment,
  .lv-checkout-actions {
    grid-template-columns: 1fr;
  }

  .lv-checkout-delivery-details {
    padding: $space-600 $space-650;
  }

  .lv-checkout-delivery-details>header {
    align-items: flex-start;
    flex-direction: column;
  }

  .lv-checkout-address-fields,
  .lv-checkout-save-address {
    grid-template-columns: 1fr;
  }

  .lv-checkout-address-fields label.is-wide {
    grid-column: auto;
  }

  .lv-checkout-summary {
    padding: $space-600 $space-650;
  }
}
