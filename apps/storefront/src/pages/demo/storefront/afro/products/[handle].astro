---
import { afroV1Defaults, afroV1ThemeTokens } from "@ecs/storefront-templates";
import { afroDemoProducts, findAfroDemoProduct } from "../../../../../lib/demo/afro-fixture";
import Product from "../../../../../templates/afro/v1/pages/Product.astro";

const handle = Astro.params.handle ?? "suede-zip-jacket";
const product = findAfroDemoProduct(handle) ?? afroDemoProducts[0];
const relatedProducts = afroDemoProducts.filter((p) => p.handle !== product?.handle).slice(0, 4);
---

<Product
  data={afroV1Defaults}
  themeTokens={afroV1ThemeTokens}
  tenantName="AFRO Studio"
  cartCount={2}
  product={product}
  handle={handle}
  relatedProducts={relatedProducts}
  demoMode
/>
