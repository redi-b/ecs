---
import StoreUnavailable from "../../components/shell/StoreUnavailable.astro";
import { listStoreCategories, listStoreCollections } from "../../lib/commerce/catalog";
import { catalogHref, parseCatalogFilters } from "../../lib/commerce/catalog-filters";
import { resolveTaxonomySelection, taxonomyHandle } from "../../lib/commerce/taxonomy-links";
import { listStoreProducts } from "../../lib/commerce/products";
import { isStoreError } from "../../lib/commerce/result";
import type { StoreCategory, StoreCollection, StoreProduct } from "../../lib/commerce/types";
import { applyCatalogCache, CATALOG_CACHE_TTL } from "../../lib/http-cache";
import { loadPageContext } from "../../lib/page-context";
import { buildStorefrontSeo } from "../../lib/seo";
import { getPrimaryColor, themeFromTokens } from "../../lib/theme";
import { resolveRendererSlot } from "../../templates/registry";
import * as m from "../../paraglide/messages.js";

const ctx = await loadPageContext(Astro.request, { skipCart: true });
const locale = ctx.ok ? ctx.locale : "en";
if (!ctx.ok) {
  Astro.response.status = ctx.status;
}

const limit = 24;
const offset = Math.max(0, Number(Astro.url.searchParams.get("offset") ?? "0") || 0);
const filters = parseCatalogFilters(Astro.url.searchParams);
const q = filters.q ?? "";
const collectionValue = filters.collectionId ?? "";
const categoryValue = filters.categoryId ?? "";
const order = filters.order ?? "";

const [collectionsResult, categoriesResult] = ctx.ok
  ? await Promise.all([listStoreCollections({
      platformApiBaseUrl: ctx.platformApiBaseUrl,
      requestHost: ctx.requestHost,
      locale: ctx.commerceLocale,
      limit: 50,
    }), listStoreCategories({
      platformApiBaseUrl: ctx.platformApiBaseUrl,
      requestHost: ctx.requestHost,
      locale: ctx.commerceLocale,
      limit: 100,
    })])
  : [null, null];

const collections: StoreCollection[] =
  collectionsResult && !isStoreError(collectionsResult) ? collectionsResult.collections : [];
const categories: StoreCategory[] =
  categoriesResult && !isStoreError(categoriesResult) ? categoriesResult.categories : [];
const collectionSelection = resolveTaxonomySelection(collections, collectionValue);
const categorySelection = resolveTaxonomySelection(categories, categoryValue);

const legacyCollectionHandle = collectionSelection.item && taxonomyHandle(collectionSelection.item);
const legacyCategoryHandle = categorySelection.item && taxonomyHandle(categorySelection.item);
if (
  ctx.ok &&
  ((collectionSelection.legacyId && legacyCollectionHandle) ||
    (categorySelection.legacyId && legacyCategoryHandle))
) {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (legacyCollectionHandle) params.set("collection", legacyCollectionHandle);
  if (legacyCategoryHandle) params.set("category", legacyCategoryHandle);
  return Astro.redirect(`/products?${params.toString()}`, 308);
}

const invalidTaxonomy = Boolean(
  (collectionValue && (!collectionSelection.item || (collectionSelection.legacyId && !legacyCollectionHandle))) ||
  (categoryValue && (!categorySelection.item || (categorySelection.legacyId && !legacyCategoryHandle))),
);
if (ctx.ok && invalidTaxonomy) Astro.response.status = 404;

const productsResult = ctx.ok && !invalidTaxonomy
  ? await listStoreProducts({
      platformApiBaseUrl: ctx.platformApiBaseUrl,
      requestHost: ctx.requestHost,
      locale: ctx.commerceLocale,
      regionId: ctx.config.commerce.regionId,
      limit,
      offset,
      q: q || null,
      collectionId: collectionSelection.item?.id ?? null,
      categoryId: categorySelection.item?.id ?? null,
      order: order || null,
      optionPairs: filters.optionPairs,
      priceMin: filters.priceMin ?? null,
      priceMax: filters.priceMax ?? null,
    })
  : null;
const products: StoreProduct[] =
  productsResult && !isStoreError(productsResult) ? productsResult.products : [];
const count =
  productsResult && !isStoreError(productsResult) ? (productsResult.count ?? products.length) : 0;
const facets = productsResult && !isStoreError(productsResult) ? productsResult.facets : undefined;
const errorMessage = invalidTaxonomy
  ? m.catalog_taxonomy_not_found({}, { locale })
  : productsResult && isStoreError(productsResult) ? productsResult.message : null;

const hasPrev = offset > 0;
const hasNext = offset + limit < count;

function productsHref(nextOffset: number) {
  return catalogHref(filters, nextOffset);
}

const ProductList = ctx.ok
  ? resolveRendererSlot(ctx.config.storefront.templateKey, "ProductList")
  : null;

if (ctx.ok && ProductList && !errorMessage) {
  applyCatalogCache(Astro.cache, {
    locale,
    path: Astro.url.pathname,
    tenantId: ctx.config.tenant.id,
    publishedRevisionId: ctx.config.storefront.publishedRevisionId,
    templateKey: ctx.config.storefront.templateKey,
    maxAge: CATALOG_CACHE_TTL.productList.maxAge,
    swr: CATALOG_CACHE_TTL.productList.swr,
  });
}
---

{
  !ctx.ok || !ProductList ? (
    <StoreUnavailable message={ctx.ok ? m.status_template_unavailable({}, { locale }) : ctx.message} />
  ) : (
    <ProductList
      data={ctx.config.storefront.data}
      themeTokens={ctx.config.storefront.themeTokens}
      tenantName={ctx.config.tenant.name}
      deferCartCount={true}
      primaryColor={getPrimaryColor(ctx.config.storefront.themeTokens)}
      theme={themeFromTokens(ctx.config.storefront.themeTokens)}
      currentPath="/products"
      products={products}
      errorMessage={errorMessage}
      hasPrev={hasPrev}
      hasNext={hasNext}
      prevHref={hasPrev ? productsHref(Math.max(0, offset - limit)) : undefined}
      nextHref={hasNext ? productsHref(offset + limit) : undefined}
      collections={collections}
      categories={categories}
      facets={facets}
      filters={filters}
      totalCount={count}
      offset={offset}
      limit={limit}
      seo={buildStorefrontSeo({
        noindex: Boolean(
          q || order || offset || invalidTaxonomy || filters.optionPairs.length ||
          filters.priceMin !== undefined || filters.priceMax !== undefined ||
          (collectionValue && categoryValue),
        ),
        path: collectionValue
          ? `/products?collection=${encodeURIComponent(collectionValue)}`
          : categoryValue
            ? `/products?category=${encodeURIComponent(categoryValue)}`
            : "/products",
        publicOrigin: ctx.publicOrigin,
        tenantName: ctx.config.storefront.seo.title ?? ctx.config.tenant.name,
        description: ctx.config.storefront.seo.description,
        imageUrl: ctx.config.storefront.seo.socialImageUrl,
        title: collectionSelection.item?.title ?? categorySelection.item?.name ?? "Products",
      })}
    />
  )
}
