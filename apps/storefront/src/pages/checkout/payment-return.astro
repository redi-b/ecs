---
import StoreShell from "../../components/shell/StoreShell.astro";
import { completeChapaStoreCheckout } from "../../lib/commerce/checkout";
import { isStoreError } from "../../lib/commerce/result";
import { loadPageContext } from "../../lib/page-context";
import { getStorefrontRenderer } from "../../templates/registry";
import * as m from "../../paraglide/messages.js";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import {
  appendSetCookies,
  cartIdClearCookie,
  lastOrderSetCookie,
} from "../../lib/session/cart-cookie";

/**
 * After Chapa redirects back: platform verifies with merchant secret, then completes cart.
 * Does not trust client "success" alone.
 */
const ctx = await loadPageContext(Astro.request);
const locale = ctx.ok
  ? ctx.locale
  : Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am"
    ? "am"
    : "en";
const url = Astro.url;
const txRef =
  url.searchParams.get("trx_ref") ??
  url.searchParams.get("tx_ref") ??
  url.searchParams.get("txRef") ??
  null;

let error: string | null = null;

const friendlyMessages: Record<string, string> = {
  chapa_payment_not_paid: m.payment_chapa_not_paid({}, { locale }),
  chapa_payment_not_found: m.payment_chapa_not_found({}, { locale }),
  chapa_verification_failed: m.payment_chapa_verification_failed({}, { locale }),
  chapa_tx_ref_missing: m.payment_reference_missing({}, { locale }),
  chapa_tx_ref_mismatch: m.payment_reference_mismatch({}, { locale }),
  merchant_chapa_not_configured: m.payment_online_unavailable_shop({}, { locale }),
};

if (!ctx.ok) {
  error = ctx.message;
  Astro.response.status = ctx.status;
} else if (!ctx.cartId) {
  error = m.payment_cart_not_found({}, { locale });
} else {
  const result = await completeChapaStoreCheckout({
    cartId: ctx.cartId,
    platformApiBaseUrl: ctx.platformApiBaseUrl,
    requestHost: ctx.requestHost,
    txRef,
  });

  if (isStoreError(result)) {
    error = friendlyMessages[result.message] ?? m.payment_chapa_verification_failed({}, { locale });
  } else {
    const headers = new Headers({
      Location: `/order/${encodeURIComponent(result.order.id)}`,
    });
    appendSetCookies(headers, [
      cartIdClearCookie(),
      lastOrderSetCookie({
        id: result.order.id,
        total: result.order.total,
        currencyCode: result.order.currencyCode,
      }),
    ]);
    return new Response(null, { status: 303, headers });
  }
}

const storeAvailable = ctx.ok;
const tenantName = ctx.ok ? ctx.config.tenant.name : "Store";
const cartCount = ctx.ok ? ctx.cartCount : 0;
const showError = Boolean(error);
const redirectLabel = m.payment_redirecting({}, { locale });
const PaymentReturn = ctx.ok
  ? getStorefrontRenderer(ctx.config.storefront.templateKey)?.PaymentReturn
  : null;
---

{storeAvailable && PaymentReturn && (
  <PaymentReturn data={ctx.config.storefront.data} themeTokens={ctx.config.storefront.themeTokens} tenantName={tenantName} cartCount={cartCount} error={error} redirectLabel={redirectLabel} />
)}

{storeAvailable && !PaymentReturn && (
  <StoreShell tenantName={tenantName} cartCount={cartCount} title={m.checkout_payment({}, { locale })}>
    <h1 class="sf-title">{m.payment_return_title({}, { locale })}</h1>
    {showError && (
      <div class="sf-notice sf-notice-error" role="alert">
        <p>{error}</p>
        <div class="sf-actions">
          <a class="sf-btn" href="/checkout">{m.payment_back_checkout({}, { locale })}</a>
          <a class="sf-btn sf-btn-secondary" href="/cart">{m.payment_return_cart({}, { locale })}</a>
        </div>
      </div>
    )}
    {!showError && <div class="sf-notice sf-notice-ok">{redirectLabel}</div>}
  </StoreShell>
)}

{!storeAvailable && (
  <html lang={locale}>
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{m.checkout_payment({}, { locale })}</title>
      <link rel="stylesheet" href="/styles/commerce.css" />
    </head>
    <body>
      <main class="sf-main">
        <div class="sf-notice sf-notice-error">
          <p>{error ?? m.status_shop_unavailable_title({}, { locale })}</p>
        </div>
      </main>
    </body>
  </html>
)}
