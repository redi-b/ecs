    <!-- 2. Pain Section -->
    <section class="pain">
      <div class="container pain__wrapper">
        <div class="pain__grid">
          <!-- Left: Problem Headline -->
          <div class="pain__heading-col">
            <h2 class="pain__title type-header-2" data-text-anim="tl:headerAnimation">
              <span class="pain__title-muted">YOUR CUSTOMERS WANT TO BUY. </span><span class="pain__title-dark">DON'T MAKE THEM WAIT.</span>
            </h2>
          </div>

          <!-- Center: Model with floating ChatBubbles & Arched Backdrop -->
          <div class="pain__visual-col" data-fade-in="tl:fade-2">
            <div class="pain__arch-outer" aria-hidden="true"></div>
            <div class="pain__arch-inner" aria-hidden="true"></div>
            
            <!-- Chat Bubbles -->
            <ChatBubble
              question="How much is it?"
              time="10:59 AM"
              class="pain__bubble pain__bubble--1"
            />
            <ChatBubble
              question="Free delivery?"
              time="11:10 AM"
              class="pain__bubble pain__bubble--2"
            />
            
            <div class="img-wrapper pain__subject-img">
              <Image
                src={painSubjectImg}
                alt="Customer using mobile phone"
                width={281}
                height={544}
                class="contain"
              />
            </div>

            <div class="pain__visual-fade" aria-hidden="true"></div>

            <ChatBubble
              question="Do you have this in blue?"
              time="06:32 PM"
              class="pain__bubble pain__bubble--3"
            />
            <ChatBubble
              question="Is this still available?"
              time="09:10 PM"
              class="pain__bubble pain__bubble--4"
            />
          </div>

          <!-- Right: Narrative & Button -->
          <div class="pain__copy-col">
            <p class="pain__copy type-body-400" data-text-anim="tl:bodyAnimation">
              They saw something they like. Now they want the price, the availability, the size, the color, and a simple way to order.
              <br />
              <br />
              When everything happens through social media posts and messages, buying takes more work than it should!
            </p>
            <div class="pain__cta">
              <Button
                text="What ECS Offers"
                variant="neutral"
                size="large"
                icon="link-arrow-icon"
                href="#features"
                data-fade-in="tl:fade-btn"
              />
            </div>
          </div>
        </div>

        <!-- Video Demo Row -->
        <div class="pain__video-row">
          <div class="pain__video-box">
            <DemoVideo class="pain__video" />
            <div class="pain__video-hint">
              <Image src={handDrawnArrow} alt="" width={45} height={45} class="pain__video-arrow" />
              <span class="pain__video-text type-body-500">See it in action!</span>
            </div>
          </div>
        </div>
      </div>
    </section>

