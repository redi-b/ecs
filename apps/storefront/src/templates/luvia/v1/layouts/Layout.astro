---
import "../styles/main.scss";
import "../../../../components/shell/cart-feedback.css";
import "../styles/components/_header.scss";
import "../styles/components/_footer.scss";
import "../styles/components/_cart-drawer.scss";
import "../styles/components/_rail.scss";
import { contrastRatio, deriveTextContrast, type LuviaV1Data } from "@ecs/storefront-templates";
import SeoHead from "../../../../components/shell/SeoHead.astro";
import StorefrontAnalytics from "../../../../components/shell/StorefrontAnalytics.astro";
import StorefrontFonts from "../../../../components/shell/StorefrontFonts.astro";
import StructuredData from "../../../../components/shell/StructuredData.astro";
import { loadNavigationCatalog } from "../../../../lib/navigation-catalog";
import type { StoreCategory } from "../../../../lib/commerce/types";
import type { StorefrontSeo } from "../../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import { resolveTemplateVoiceMessage } from "../../../../lib/template-voice";
import * as m from "../../../../paraglide/messages.js";
import logo from "../assets/luvia-logo.svg";
import { parseLuviaThemeTokens } from "../lib";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";

interface Props {
  tenantName: string;
  header: LuviaV1Data["header"];
  footer: LuviaV1Data["footer"];
  cartCount?: number;
  deferCartCount?: boolean;
  demoMode?: boolean;
  title?: string;
  editorMode?: boolean;
  themeTokens?: unknown;
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
  categories?: StoreCategory[];
}

const {
  tenantName,
  header,
  footer,
  cartCount = 0,
  deferCartCount = false,
  demoMode = false,
  title,
  editorMode = false,
  themeTokens,
  seo,
  structuredData,
  categories: suppliedCategories,
} = Astro.props;

const emptyLogoUrl = header.useShopName ? null : logo.src;
const logoUrl = header.logoAssetId ?? emptyLogoUrl;
const theme = parseLuviaThemeTokens(themeTokens);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const { categories } = await loadNavigationCatalog(Astro.request, {
  categories: suppliedCategories, demoMode, editorMode,
});

const addToCartLabel = resolveTemplateVoiceMessage({
  fallback: m.action_add_to_cart({}, { locale }),
  locale,
  messageId: "action_add_to_cart",
  templateKey: "luvia.v1",
});

const continueShoppingLabel = resolveTemplateVoiceMessage({
  fallback: m.action_continue_shopping({}, { locale }),
  locale,
  messageId: "action_continue_shopping",
  templateKey: "luvia.v1",
});

const clientMessages = {
  addFailed: m.product_add_failed({}, { locale }),
  added: m.product_added({}, { locale }),
  adding: m.product_adding({}, { locale }),
  addToCart: addToCartLabel,
  cartEmpty: m.cart_empty({}, { locale }),
  cartEmptyHelp: m.cart_empty_help({}, { locale }),
  cartLoadFailed: m.cart_load_failed({}, { locale }),
  cartLoading: m.cart_loading({}, { locale }),
  cartItemCount: m.cart_item_count({ count: "__COUNT__" }, { locale }),
  cartUpdateFailed: m.cart_update_failed({}, { locale }),
  cartUpdating: m.cart_updating({}, { locale }),
  cartUpdated: m.cart_updated({}, { locale }),
  continueShopping: continueShoppingLabel,
  decreaseQuantity: m.action_decrease_quantity({}, { locale }),
  increaseQuantity: m.action_increase_quantity({}, { locale }),
  outOfStock: m.catalog_out_of_stock({}, { locale }),
  product: m.cart_item_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
  removingItem: m.cart_item_removing({}, { locale }),
  retry: m.action_retry({}, { locale }),
  showMore: m.product_show_more({}, { locale }),
  showLess: m.action_show_less({}, { locale }),
};

// Brand primary is authored as a fill. Text and button roles are derived so
// they are guaranteed legible: >=4.5:1 for accent text, >=7:1 for links and
// button labels. See deriveTextContrast in @ecs/storefront-templates.
const brandText = deriveTextContrast(theme.colors.primary, theme.colors.background);

const themeStyle = [
  `--clr-bg:${theme.colors.background}`,
  `--clr-ink:${theme.colors.foreground}`,
  `--clr-primary:${theme.colors.primary}`,
  `--clr-soft:${theme.colors.muted}`,
  `--clr-accent:${theme.colors.accent}`,
  // Accent used as copy: >=4.5:1 on --clr-bg.
  `--clr-primary-text:${brandText.text}`,
  // Accent used as a link / interactive label: >=7:1 on --clr-bg.
  `--clr-primary-link:${brandText.link}`,
  // Solid button surface; only shifted when a >=7:1 label needs it.
  `--clr-primary-fill:${brandText.fill}`,
  `--clr-on-primary:${brandText.onPrimary}`,
  `--clr-primary-edge:${
    contrastRatio(theme.colors.primary, theme.colors.background) < 1.3
      ? theme.colors.foreground
      : "transparent"
  }`,
  `--clr-primary-dark:color-mix(in srgb, var(--clr-primary), #000 65%)`,
  `--clr-line:rgb(from var(--clr-ink) r g b / 0.14)`,
].join(";");
---

<!doctype html>
<html lang={locale} class="template-luvia">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={theme.colors.background} />
    {demoMode ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} · ${tenantName}` : tenantName}</title>
    <SeoHead seo={seo} />
    <StorefrontFonts />
    <StructuredData value={structuredData} />
    <link rel="preload" href="/fonts/Right-Grotesk-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GC-Molecule-Demo-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GC-Molecule-Demo-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body
    class="body"
    data-demo-mode={demoMode ? "true" : undefined}
    data-editor-mode={editorMode ? "true" : undefined}
    data-client-messages={JSON.stringify(clientMessages)}
    data-editor-theme-vars={editorMode ? JSON.stringify({
      background: "--clr-bg",
      foreground: "--clr-ink",
      primary: "--clr-primary",
      muted: "--clr-soft",
      accent: "--clr-accent",
      onPrimary: "--clr-on-primary",
      primaryEdge: "--clr-primary-edge",
      primaryFill: "--clr-primary-fill",
      primaryText: "--clr-primary-text",
      primaryLink: "--clr-primary-link",
      primaryDark: "--clr-primary-dark",
    }) : undefined}
    style={themeStyle}
  >
    <a class="skip-link" href="#main-content">{m.a11y_skip_to_content({}, { locale })}</a>
    {demoMode ? (
      <div class="demo-badge type-body-xs" role="status">Preview</div>
    ) : null}

    <Header
      tenantName={tenantName}
      header={header}
      cartCount={cartCount}
      deferCartCount={deferCartCount}
      demoMode={demoMode}
      editorMode={editorMode}
      locale={locale}
      logoUrl={logoUrl}
      emptyLogoUrl={emptyLogoUrl}
    />

    <slot />

    <Footer
      tenantName={tenantName}
      footer={footer}
      editorMode={editorMode}
      locale={locale}
      logoUrl={logoUrl}
      emptyLogoUrl={emptyLogoUrl}
      categories={categories}
    />

    <CartDrawer
      locale={locale}
      continueShoppingLabel={continueShoppingLabel}
    />

    <StorefrontAnalytics disabled={demoMode || editorMode} />

    <script>
      import { initLuviaStorefront } from "../scripts/client";
      initLuviaStorefront();
    </script>
  </body>
</html>
