{
  admin off
  auto_https off
  servers {
    trusted_proxies static private_ranges
    trusted_proxies_strict
  }
}
:8080 {
  # This ingress backend serves storefronts only. Exact host admission remains
  # in Traefik and the Platform API's tenant/domain resolver.
  @private path /platform* /admin* /dashboard* /onboarding* /sign-in* /sign-up* /sign-out* /auth* /ops*
  handle @private {
    respond 404
  }
  handle {
    reverse_proxy ecs-storefront:4321
  }
}
