---
import type { CustomerAccountView } from "../../../../lib/commerce/account";
import { formatStorefrontDate } from "../../../../lib/date";
import { formatMoney } from "../../../../lib/money";
import { formatOrderReference } from "../../../../lib/order-reference";
import { orderStatusLabel } from "../../../../lib/order-status-label";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { parseAfroData } from "../lib";
import "../styles/pages/checkout.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
  account?: CustomerAccountView | null;
  error?: string | null;
  success?: string | null;
  initialMode?: "login" | "register";
}

const {
  data,
  themeTokens,
  tenantName,
  deferCartCount = false,
  account = null,
  error = null,
  success = null,
  initialMode = "login",
} = Astro.props;

const template = parseAfroData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const date = (value: string | null) => {
  if (!value) return m.account_date_unavailable({}, { locale });
  return formatStorefrontDate(value, locale) ?? m.account_date_unavailable({}, { locale });
};
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title={`My Account — ${tenantName}`}>
  <main class="checkout-page" id="main-content">
    <div class="checkout-page__wrapper container" style="max-width: 900px; margin: 0 auto; padding-block: 3rem;">
      {account ? (
        <>
          <header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid #f0e6dd; padding-bottom: 1.5rem;">
            <div>
              <h1 class="type-header-2">Welcome, {account.customer.firstName || "Friend"}</h1>
              <p class="type-body-s-400" style="color: #784b28;">{account.customer.email}</p>
            </div>
            <form action="/actions/account/logout" method="post">
              <button type="submit" style="background: none; border: 1px solid #1c120d; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; font-size: 0.875rem;">
                Sign Out
              </button>
            </form>
          </header>

          {error && <div style="padding: 1rem; margin-bottom: 1.5rem; background: #fff1f0; border: 1px solid #ffa39e; color: #cf1322;">{error}</div>}
          {success && <div style="padding: 1rem; margin-bottom: 1.5rem; background: #f6ffed; border: 1px solid #b7eb8f; color: #389e0d;">{success}</div>}

          <!-- Order History Section -->
          <section style="background: #fff; border: 1px solid #f0e6dd; border-radius: 8px; padding: 2rem; margin-bottom: 2rem;">
            <h2 class="type-header-4" style="margin-bottom: 1.5rem;">Order History ({account.orderCount})</h2>
            {account.orders.length ? (
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                {account.orders.map((order) => (
                  <a
                    href={`/account/orders/${encodeURIComponent(order.id)}`}
                    style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border: 1px solid #f8f2ed; border-radius: 6px; text-decoration: none; color: inherit; transition: background 0.15s;"
                    class="account-order-row"
                  >
                    <div>
                      <strong class="type-body-500" style="display: block;">
                        Order {formatOrderReference(order.id, order.customDisplayId)}
                      </strong>
                      <span class="type-body-xs-500" style="color: #784b28;">{date(order.createdAt)}</span>
                    </div>
                    <div style="text-align: right;">
                      <strong class="type-body-500" style="display: block;">
                        {order.total == null ? "—" : formatMoney(order.total, order.currencyCode, locale)}
                      </strong>
                      <span class="type-body-xs-500" style="text-transform: capitalize; color: #ff720a;">
                        {orderStatusLabel(order.status, locale)}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div style="text-align: center; padding: 2rem 0;">
                <p class="type-body-s-400" style="margin-bottom: 1rem;">You have not placed any orders yet.</p>
                <Button text="Start Shopping" href="/products" variant="primary" size="small" />
              </div>
            )}
          </section>
        </>
      ) : (
        <div style="max-width: 440px; margin: 0 auto; background: #fff; border: 1px solid #f0e6dd; border-radius: 8px; padding: 2.5rem;">
          <h1 class="type-header-3" style="text-align: center; margin-bottom: 0.5rem;">
            {initialMode === "register" ? "Create Account" : "Sign In"}
          </h1>
          <p class="type-body-s-400" style="text-align: center; color: #784b28; margin-bottom: 2rem;">
            {initialMode === "register"
              ? `Join  to track orders and save details.`
              : "Access your saved addresses and order history."}
          </p>

          {error && <div style="padding: 0.75rem 1rem; margin-bottom: 1.5rem; background: #fff1f0; border: 1px solid #ffa39e; color: #cf1322; border-radius: 4px; font-size: 0.875rem;">{error}</div>}

          {initialMode === "login" ? (
            <form action="/actions/account/login" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
              <div>
                <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">Email Address</label>
                <input name="email" type="email" required class="checkout-form__input type-body-s-400" style="width: 100%;" />
              </div>
              <div>
                <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">Password</label>
                <input name="password" type="password" required minlength="8" class="checkout-form__input type-body-s-400" style="width: 100%;" />
              </div>
              <Button text="Sign In" type="submit" variant="primary" size="large" fullWidth={true} />
              <p class="type-body-xs-500" style="text-align: center; margin-top: 1rem;">
                Don't have an account? <a href="/account?mode=register" style="color: #ff720a; text-decoration: underline;">Create one</a>
              </p>
            </form>
          ) : (
            <form action="/actions/account/register" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
              <div style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                  <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">First Name</label>
                  <input name="firstName" required class="checkout-form__input type-body-s-400" style="width: 100%;" />
                </div>
                <div style="flex: 1;">
                  <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">Last Name</label>
                  <input name="lastName" required class="checkout-form__input type-body-s-400" style="width: 100%;" />
                </div>
              </div>
              <div>
                <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">Email Address</label>
                <input name="email" type="email" required class="checkout-form__input type-body-s-400" style="width: 100%;" />
              </div>
              <div>
                <label class="type-body-s-500" style="display: block; margin-bottom: 0.25rem;">Password</label>
                <input name="password" type="password" required minlength="8" class="checkout-form__input type-body-s-400" style="width: 100%;" />
              </div>
              <Button text="Create Account" type="submit" variant="primary" size="large" fullWidth={true} />
              <p class="type-body-xs-500" style="text-align: center; margin-top: 1rem;">
                Already have an account? <a href="/account" style="color: #ff720a; text-decoration: underline;">Sign in</a>
              </p>
            </form>
          )}
        </div>
      )}
    </div>
  </main>
</Layout>
