---
import { formatMoney } from "../../../../lib/money";
import { formatOrderReference } from "../../../../lib/order-reference";
import type { LastOrderCookie } from "../../../../lib/session/cart-cookie";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { parseNexahubData } from "../lib";
import "../styles/pages/commerce.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  orderId: string;
  lastOrder: LastOrderCookie | null;
  hasCustomerSession?: boolean;
  demoMode?: boolean;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  orderId,
  lastOrder,
  hasCustomerSession = false,
  demoMode = false,
} = Astro.props;
const template = parseNexahubData(data);
const verified = Boolean(lastOrder && lastOrder.id === orderId);
const reference = formatOrderReference(orderId);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} demoMode={demoMode}>
  <main class="nexa-commerce nexa-confirm" id="main-content" data-copy-label={m.action_copy_reference({}, { locale })} data-copied-label={m.action_copied({}, { locale })} data-copy-success={m.confirmation_copy_success({}, { locale })} data-copy-fallback={m.confirmation_copy_fallback({ reference: "__REFERENCE__" }, { locale })}>
    <div class="container nexa-commerce__frame">
      <nav class="nexa-breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/">{m.nav_home({}, { locale })}</a><span>/</span><span aria-current="page">{m.order_received({}, { locale })}</span></nav>
      <header class="nexa-commerce__heading"><span class="nexa-kicker">{m.order_confirmed({}, { locale })}</span><div><h1>{m.confirmation_thank_you({}, { locale })}</h1><p>{m.confirmation_intro({}, { locale })}</p></div></header>
      <div class="nexa-receipt">
        <section class="nexa-receipt__main">
          <div class="nexa-receipt__status"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg></span><div><strong>{verified ? m.order_confirmed({}, { locale }) : m.confirmation_order_placed({}, { locale })}</strong><small>{m.confirmation_update_help({}, { locale })}</small></div></div>
          <div class="nexa-receipt__reference"><span>{m.order_reference({}, { locale })}</span><strong>{reference}</strong><button type="button" data-copy-order data-order-id={reference}>{m.action_copy_reference({}, { locale })}</button></div>
          {verified && lastOrder?.total != null && <dl class="nexa-receipt__facts"><div><dt>{m.cart_total({}, { locale })}</dt><dd>{formatMoney(lastOrder.total, lastOrder.currencyCode, locale)}</dd></div><div><dt>{m.confirmation_status({}, { locale })}</dt><dd>{m.confirmation_received({}, { locale })}</dd></div><div><dt>{m.confirmation_shop({}, { locale })}</dt><dd>{tenantName}</dd></div></dl>}
          <p class="nexa-live" data-copy-status aria-live="polite">{m.confirmation_contact_help({}, { locale })} {hasCustomerSession ? m.confirmation_account_help({}, { locale }) : m.confirmation_reference_help({}, { locale })}</p>
          <div class="nexa-receipt__actions"><Button text={m.action_continue_shopping({}, { locale })} href="/products" />{hasCustomerSession && <Button text={m.action_view_order_history({}, { locale })} href="/account" variant="dark" />}<Button text={m.action_return_home({}, { locale })} href="/" variant="neutral" /></div>
        </section>
        <aside class="nexa-receipt__timeline"><header class="nexa-panel-head"><h2>{m.confirmation_next({}, { locale })}</h2><span>{m.confirmation_steps({}, { locale })}</span></header><ol><li><span>01</span><div><strong>{m.confirmation_review({}, { locale })}</strong><small>{m.confirmation_review_help({}, { locale })}</small></div></li><li><span>02</span><div><strong>{m.confirmation_preparation({}, { locale })}</strong><small>{m.confirmation_preparation_help({}, { locale })}</small></div></li><li><span>03</span><div><strong>{m.confirmation_updates({}, { locale })}</strong><small>{m.confirmation_updates_help({}, { locale })}</small></div></li></ol></aside>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  document.querySelector('[data-copy-order]')?.addEventListener('click', async (event) => { const button = event.currentTarget; if (!(button instanceof HTMLButtonElement)) return; const value = button.dataset.orderId || ''; const root = button.closest('[data-copy-label]'); const status = document.querySelector('[data-copy-status]'); const copyLabel = root?.getAttribute('data-copy-label') || ''; try { await navigator.clipboard.writeText(value); button.textContent = root?.getAttribute('data-copied-label') || ''; if (status) status.textContent = root?.getAttribute('data-copy-success') || ''; window.setTimeout(() => button.textContent = copyLabel, 1600); } catch { if (status) status.textContent = (root?.getAttribute('data-copy-fallback') || '').replace('__REFERENCE__', value); } });
</script>

<style>
  .nexa-receipt { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(18rem,.6fr); gap: clamp(1rem,3vw,3rem); align-items: start; }
  .nexa-receipt__main, .nexa-receipt__timeline { overflow:hidden; border: 1px solid rgb(from var(--nexa-ink) r g b / 0.25); border-radius:4px; background:var(--nexa-bg); box-shadow:0 24px 70px rgb(from var(--nexa-ink) r g b / 0.07); }
  .nexa-receipt__main { display: grid; gap: 2rem; padding: clamp(1.5rem,4vw,4rem); }
  .nexa-receipt__status { display: flex; gap: 1rem; align-items: center; }
  .nexa-receipt__status > span { width: 3rem; height: 3rem; display: grid; place-items: center; background: var(--nexa-primary); color: var(--nexa-on-primary); }.nexa-receipt__status svg{width:1.25rem;height:1.25rem;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .nexa-receipt__status div { display: grid; gap: .25rem; } .nexa-receipt__status strong { font: 500 1.4rem/1.1 "Space Grotesk",sans-serif; text-transform: uppercase; } .nexa-receipt__status small { font: 400 .7rem/1.4 "DM Mono",monospace; }
  .nexa-receipt__reference { display: grid; gap: .75rem; border-block: 1px solid rgb(from var(--nexa-ink) r g b / 0.2); padding-block: 1.5rem; }
  .nexa-receipt__reference span, .nexa-receipt__reference button { font: 400 .7rem/1.2 "DM Mono",monospace; text-transform: uppercase; }
  .nexa-receipt__reference strong { overflow-wrap: anywhere; font: 500 clamp(2rem,6vw,5rem)/.95 "Space Grotesk",sans-serif; letter-spacing: -.04em; }
  .nexa-receipt__reference button { justify-self: start; min-height: 44px; border: 1px solid currentColor; background: transparent; padding: 0 1rem; transition:background-color var(--nexa-motion-fast) var(--nexa-ease-out),color var(--nexa-motion-fast) var(--nexa-ease-out),transform var(--nexa-motion-fast) var(--nexa-ease-out); }.nexa-receipt__reference button:hover{background:var(--nexa-ink);color:var(--nexa-bg);transform:translateY(-1px)}
  .nexa-receipt__facts { display: grid; grid-template-columns: repeat(3,1fr); margin: 0; } .nexa-receipt__facts div { display: grid; gap: .5rem; padding: 1rem; border: 1px solid rgb(from var(--nexa-ink) r g b / 0.18); margin-right: -1px; } .nexa-receipt__facts dt,.nexa-receipt__facts dd { margin: 0; font: 400 .7rem/1.3 "DM Mono",monospace; } .nexa-receipt__facts dt { text-transform: uppercase; opacity: .65; }
  .nexa-receipt__actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .nexa-receipt__timeline ol { list-style: none; margin: 0; padding: 0 1rem 1rem; } .nexa-receipt__timeline li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid rgb(from var(--nexa-ink) r g b / 0.15); } .nexa-receipt__timeline li > span,.nexa-receipt__timeline small { font: 400 .68rem/1.4 "DM Mono",monospace; } .nexa-receipt__timeline li div { display: grid; gap: .3rem; } .nexa-receipt__timeline strong { font: 500 .85rem/1.2 "Space Grotesk",sans-serif; text-transform: uppercase; }
  @media(max-width:800px){.nexa-receipt{grid-template-columns:1fr}.nexa-receipt__facts{grid-template-columns:1fr}.nexa-receipt__facts div{margin:0 0 -1px}}
</style>
