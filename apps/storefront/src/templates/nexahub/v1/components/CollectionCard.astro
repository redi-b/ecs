---
import Icon from "./Icon.astro";
import { categoryProductsHref, collectionProductsHref } from "../../../../lib/commerce/taxonomy-links";
import type { StoreCategory, StoreCollection } from "../../../../lib/commerce/types";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Button from "./Button.astro";

interface Props {
  item: StoreCategory | StoreCollection;
  kind: "category" | "collection";
  image: string | null;
  variant: "featured" | "standard";
}

const { item, kind, image, variant } = Astro.props;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const title =
  ("title" in item ? item.title : item.name) ?? m.catalog_collection_fallback({}, { locale });
const href =
  kind === "category"
    ? categoryProductsHref(item as StoreCategory)
    : collectionProductsHref(item as StoreCollection);
---
{variant === "featured" ? (
  <article class="catalogue-section__card catalogue-section__card--featured">
    <div class="catalogue-section__card-bg img-wrapper">
      {image ? <img src={image} alt="" class="cover" loading="lazy" /> : <span class="catalogue-section__image-placeholder" aria-hidden="true"></span>}
    </div>
    <a href={href} class="catalogue-section__corner-btn" aria-label={m.catalog_explore_collection({ collection: title }, { locale })}>
      <span aria-hidden="true"><Icon name="arrow-up-right" /></span>
    </a>
    <div class="catalogue-section__overlay-box">
      <div class="catalogue-section__overlay-info">
        <h3 class="type-heading-4">{title}</h3>
        <p class="type-body-xs-500">{m.catalog_collection_intro({}, { locale })}</p>
      </div>
      <Button text={m.catalog_explore_more({}, { locale })} href={href} variant="secondary" size="small" />
    </div>
  </article>
) : (
  <article class="catalogue-section__card catalogue-section__card--standard">
    <div class="catalogue-section__card-top">
      <h3 class="type-heading-5">{title}</h3>
      <Button text={m.catalog_explore_more({}, { locale })} href={href} variant="neutral" size="small" />
    </div>
    <div class="catalogue-section__card-image img-wrapper">
      {image ? <img src={image} alt="" class="cover" loading="lazy" /> : <span class="catalogue-section__image-placeholder" aria-hidden="true"></span>}
    </div>
  </article>
)}
