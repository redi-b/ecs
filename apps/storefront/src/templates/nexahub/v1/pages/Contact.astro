---
import Button from "../components/Button.astro"; import Layout from "../layouts/Layout.astro"; import { parseNexahubData } from "../lib"; import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale"; import * as m from "../../../../paraglide/messages.js"; import "../styles/pages/secondary.scss";
interface Props { data:unknown; themeTokens?:unknown; tenantName:string; deferCartCount?:boolean; }
const {data,themeTokens,tenantName,deferCartCount=false}=Astro.props; const template=parseNexahubData(data); const {email,phone,address,socialLinks}=template.footer; const sent=Astro.url.searchParams.get("sent")==="1"; const submitError=Astro.url.searchParams.get("error"); const locale=Astro.request.headers.get(STOREFRONT_LOCALE_HEADER)==="am"?"am":"en";
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}>
<main class="nexa-secondary" id="main-content">
<div class="container nexa-secondary__frame">
<header class="nexa-secondary__hero">
<span>01</span>
<div>
<h1>{m.contact_title({}, {locale})}</h1>
<p>{m.contact_intro({}, {locale})}</p>
</div>
</header>
<div class="nexa-secondary__split">
<aside class="nexa-info-panel">
<header class="nexa-panel-head">
<h2>{m.contact_information({}, {locale})}</h2>
<span>{tenantName}</span>
</header>
<ul class="nexa-info-list">{address&&<li>
<small>{m.contact_address({}, {locale})}</small>
<span>{address}</span>
</li>}{email&&<li>
<small>{m.contact_email({}, {locale})}</small>
<a href={`mailto:${email}`}>{email}</a>
</li>}{[phone, ...(template.footer.additionalPhones ?? [])].filter(Boolean).map((number) => <li>
<small>{m.contact_phone({}, {locale})}</small>
<a href={`tel:${number}`}>{number}</a>
</li>)}{socialLinks.map((social)=>
<li>
<small>{m.contact_socials({}, {locale})}</small>
<a href={social.href} rel="noreferrer" target="_blank">{social.label}</a>
</li>)}{!address&&!email&&!phone&&!socialLinks.length&&<li>
<span>{m.contact_empty({}, {locale})}</span>
</li>}</ul>
</aside>
<section class="nexa-form-panel">
<header class="nexa-panel-head">
<h2>{m.contact_send_message({}, {locale})}</h2>
</header>
<form class="nexa-inquiry-form" action="/actions/inquiries" method="post" data-inquiry-form>
<input type="hidden" name="type" value="contact"/>
<label class="nexa-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/>
</label>
<label class="is-wide">{m.contact_full_name({}, {locale})} *<input name="fullName" required autocomplete="name"/>
</label>
<label>{m.contact_email({}, {locale})} *<input name="email" type="email" required autocomplete="email"/>
</label>
<label>{m.contact_whatsapp_optional({}, {locale})}<input name="whatsapp" type="tel" autocomplete="tel" inputmode="tel"/>
</label>
<label class="is-wide">{m.contact_message({}, {locale})} *<textarea name="message" required>
</textarea>
</label>
<Button text={m.contact_send({}, {locale})} type="submit" fullWidth />
<p class:list={["nexa-inquiry-status",sent&&"is-success",submitError&&"is-error"]} role="status" aria-live="polite" data-inquiry-status>{sent?m.contact_received({}, {locale}):submitError?m.contact_failed({}, {locale}):""}</p>
</form>
</section>
</div>
</div>
</main>
</Layout>
