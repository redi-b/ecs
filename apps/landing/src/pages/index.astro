          </div>

          <!-- Right: Dashboard Mockup -->
          <div class="shop-feat__visual" data-fade-in="tl:fade-3">
            <div class="img-wrapper shop-feat__mockup-img">
              <Image
                src={dashboardFeaturesMockup}
