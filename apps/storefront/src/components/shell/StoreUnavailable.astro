---
import { customerFacingStoreError } from "../../lib/commerce/errors";
import StorefrontFailure from "./StorefrontFailure.astro";

interface Props {
  message: string;
  title?: string;
}

const { message, title = "This shop is temporarily unavailable" } = Astro.props;
const friendly = customerFacingStoreError(message);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shop unavailable</title>
  </head>
  <body>
    <StorefrontFailure
      actionHref="/"
      actionLabel="Try again"
      description={friendly}
      eyebrow="Shop paused"
      title={title}
    />
  </body>
</html>
