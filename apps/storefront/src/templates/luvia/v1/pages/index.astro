---
import "../styles/pages/index.scss";
import { Icon } from "astro-icon/components";
import type {
  StoreCollection,
  StorefrontError,
  StoreProduct,
  StoreProductsResponse,
} from "../../../../lib/commerce/types";
import { collectionProductsHref } from "../../../../lib/commerce/taxonomy-links";
import type { StorefrontSeo } from "../../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import ActionButton from "../components/ActionButton.astro";
import categoryImage from "../assets/categories-hero-image.webp";
import ctaImage from "../assets/cta-layer-image.webp";
import heroBg from "../assets/hero-bg-alt-image.webp";
import heroPortrait from "../assets/hero-portrait-image.webp";
import scrollMark from "../assets/scroll-logomark.svg";
import HeroProductSlide from "../components/HeroProductSlide.astro";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData, storefrontAsset } from "../lib";
import ProductCard from "../components/ProductCard.astro";
import TemplateAsset from "../../../../components/media/TemplateAsset.astro";

interface Props {
  data: unknown;
  productsResult: StoreProductsResponse | StorefrontError;
  collectionProducts?: StoreProduct[];
  collections?: StoreCollection[];
  tenantName: string;
  themeTokens: unknown;
  cartCount?: number;
  deferCartCount?: boolean;
  demoMode?: boolean;
  editorMode?: boolean;
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
}
const {
  data,
  productsResult,
  collectionProducts = [],
  collections = [],
  tenantName,
  themeTokens,
  cartCount = 0,
  deferCartCount = false,
  demoMode = false,
  editorMode = false,
  seo,
  structuredData,
} = Astro.props;
const template = parseLuviaData(data);
const locale =
  Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const products = "products" in productsResult ? productsResult.products : [];
const hasError = "message" in productsResult;
const heroBackground = storefrontAsset(
  template.home.hero.imageAssetId,
  heroBg.src,
);
const portrait = storefrontAsset(
  template.home.hero.portraitAssetId,
  heroPortrait.src,
);
const pickProducts = (ids: string[], source: StoreProduct[], limit: number) => {
  if (!ids.length) return source.slice(0, limit);
  const byId = new Map(source.map((product) => [product.id, product]));
  return ids
    .map((id) => byId.get(id))
    .filter((product): product is StoreProduct => Boolean(product))
    .slice(0, limit);
};
const topPicks = pickProducts(
  template.home.featuredProducts.productIds,
  products,
  template.home.featuredProducts.limit,
);
const listingSource = collectionProducts.length ? collectionProducts : products;
const listing = pickProducts(
  template.home.products.productIds,
  listingSource,
  template.home.products.limit,
);
const legacyHeroId = template.home.hero.featuredProductId;
const configuredHeroIds = template.home.hero.featuredProductIds.length
  ? template.home.hero.featuredProductIds
  : legacyHeroId
    ? [legacyHeroId]
    : [];
const heroProducts = pickProducts(configuredHeroIds, products, 6).length
  ? pickProducts(configuredHeroIds, products, 6)
  : products.slice(0, 3);
const collectionById = new Map(
  collections.map((collection) => [collection.id, collection]),
);
const categoryCollections = (
  template.home.categories.collectionIds.length
    ? template.home.categories.collectionIds
        .map((id) => collectionById.get(id))
        .filter((item): item is StoreCollection => Boolean(item))
    : collections
).slice(0, 4);
const collectionHref = collectionProductsHref;
const homeFilterCollections = collections.slice(0, 4);
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  cartCount={cartCount}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  title={m.home_page_title({}, { locale })}
  editorMode={editorMode}
  seo={seo}
  structuredData={structuredData}
>
  <main class="home">
    {
      (editorMode || template.home.hero.enabled) && (
        <section
          class="hero"
          data-editor-section="home.hero"
          data-editor-visible-path="home.hero.enabled"
          data-editor-background-image-path="home.hero.imageAssetId"
          hidden={!template.home.hero.enabled}
        >
          <TemplateAsset
            class="hero__background"
            src={heroBackground}
            fallback={heroBg}
            alt=""
            widths={[480, 768, 1024, 1512, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero__copy container">
            <>
              <h1
                class="type-heading-1"
                data-editor-path="home.hero.title"
                contenteditable={editorMode ? "plaintext-only" : undefined}
              >
                {template.home.hero.title}
              </h1>
              <p
                class="type-body-400"
                data-editor-path="home.hero.subtitle"
                contenteditable={editorMode ? "plaintext-only" : undefined}
              >
                {template.home.hero.subtitle}
              </p>
              <ActionButton
                href={template.home.hero.primaryCtaHref}
                icon="bag"
                editorPath="home.hero.primaryCtaLabel"
                editorRelatedPaths={["home.hero.primaryCtaHref"]}
                editorMode={editorMode}
              >
                {template.home.hero.primaryCtaLabel}
              </ActionButton>
            </>
            {template.home.hero.trustLabels.length > 0 && (
              <ul>
                {template.home.hero.trustLabels.map((label, index) => (
                  <li class="type-body-400">
                    <Icon name="trust-badge" class="trust-badge" />
                    <span
                      data-editor-path={`home.hero.trustLabels.${index}`}
                      contenteditable={
                        editorMode ? "plaintext-only" : undefined
                      }
                    >
                      {label}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="hero__portrait">
            <TemplateAsset
              src={portrait}
              fallback={heroPortrait}
              alt={m.home_luvia_hero_image_alt({}, { locale })}
              widths={[480, 768, 1024]}
              sizes="(max-width: 900px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              data-editor-image-path="home.hero.portraitAssetId"
            />
            {!template.header.useShopName && (
              <img class="hero__scroll" src={scrollMark.src} alt="" />
            )}
            {heroProducts.length > 0 && (
              <article
                class="promo"
                data-promo-carousel
                data-editor-products-path="home.hero.featuredProductIds"
                aria-label={m.home_featured_products({}, { locale })}
              >
                <button
                  type="button"
                  class="promo__nav promo__nav--prev"
                  data-promo-prev
                  aria-label={m.home_previous_products({}, { locale })}
                  hidden={heroProducts.length < 2}
                >
                  <Icon name="chevron" />
                </button>
                <div class="promo__viewport" data-promo-viewport>
                  <div class="promo__track" data-promo-track>
                    {heroProducts.map((product, index) => (
                      <HeroProductSlide
                        product={product}
                        active={index === 0}
                      />
                    ))}
                  </div>
                </div>
                <button
                  type="button"
                  class="promo__nav promo__nav--next"
                  data-promo-next
                  aria-label={m.home_next_products({}, { locale })}
                  hidden={heroProducts.length < 2}
                >
                  <Icon name="chevron" />
                </button>
              </article>
            )}
          </div>
        </section>
      )
    }

    {
      (editorMode || template.home.featuredProducts.enabled) && (
        <section
          class="section top-picks"
          data-editor-section="home.featuredProducts"
          data-editor-visible-path="home.featuredProducts.enabled"
          hidden={!template.home.featuredProducts.enabled}
        >
          <div class="section__wrapper container">
            <header>
              <h2
                class="type-heading-3"
                data-editor-path="home.featuredProducts.title"
                contenteditable={editorMode ? "plaintext-only" : undefined}
              >
                {template.home.featuredProducts.title}
              </h2>
              <div class="rail-controls">
                <button
                  type="button"
                  data-product-rail-prev
                  aria-label={m.home_previous_products({}, { locale })}
                >
                  ←
                </button>
                <button
                  type="button"
                  data-product-rail-next
                  aria-label={m.home_next_products({}, { locale })}
                >
                  →
                </button>
              </div>
            </header>
            {hasError ? (
              <p class="state">{m.catalog_load_error({}, { locale })}</p>
            ) : topPicks.length ? (
              <div
                class="product-rail"
                data-product-rail
                role="region"
                aria-label={m.home_top_picks({}, { locale })}
                tabindex="0"
              >
                {topPicks.map((product, index) => (
                  <ProductCard product={product} eager={index < 4} />
                ))}
              </div>
            ) : (
              <p class="state">{m.home_products_coming({}, { locale })}</p>
            )}
          </div>
        </section>
      )
    }

    {
      (editorMode || template.home.products.enabled) && (
        <section
          class="section products"
          data-editor-section="home.products"
          data-editor-visible-path="home.products.enabled"
          hidden={!template.home.products.enabled}
        >
          <div class="section__wrapper container">
            <header>
              <h2
                class="type-heading-3"
                data-editor-path="home.products.title"
                contenteditable={editorMode ? "plaintext-only" : undefined}
              >
                {template.home.products.title}
              </h2>
              <ActionButton
                href="/products"
                icon="diagonal-arrow"
                iconSize="small"
                tone="secondary"
                size="small"
              >
                {m.home_full_shop({}, { locale })}
              </ActionButton>
            </header>
            <nav
              class="filter"
              aria-label={m.home_product_filters({}, { locale })}
            >
              <a class="is-active type-body-400" href="/products">
                {m.catalog_all_products({}, { locale })}
              </a>
              {homeFilterCollections.map((collection) => (
                <a class="type-body-400" href={collectionHref(collection)}>
                  {collection.title ??
                    m.catalog_collection_fallback({}, { locale })}
                </a>
              ))}
              <span aria-hidden="true" />
              <a class="type-body-400" href="/products?order=created_at">
                {m.catalog_newest({}, { locale })}
              </a>
              <a class="type-body-400" href="/products?order=title">
                {m.home_a_to_z({}, { locale })}
              </a>
            </nav>
            {listing.length ? (
              <div class="product-grid">
                {listing.map((product) => (
                  <ProductCard product={product} />
                ))}
              </div>
            ) : (
              <p class="state">{m.catalog_empty({}, { locale })}</p>
            )}
            {listing.length > 0 && (
              <div
                class:list={[
                  "load-more",
                  { "is-overflowing": listing.length > 8 },
                ]}
              >
                <p class="type-body-400">
                  {m.catalog_result_count(
                    { count: listing.length },
                    { locale },
                  )}
                </p>
                <ActionButton
                  href="/products"
                  icon="diagonal-arrow"
                  iconSize="small"
                  tone="secondary"
                  size="small"
                >
                  {m.home_explore_full_collection({}, { locale })}
                </ActionButton>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      (editorMode || template.home.categories.enabled) && (
        <section
          class="categories"
          data-editor-section="home.categories"
          data-editor-visible-path="home.categories.enabled"
          hidden={!template.home.categories.enabled}
        >
          <>
            <TemplateAsset
              src={storefrontAsset(
                template.home.categories.imageAssetId,
                categoryImage.src,
              )}
              fallback={categoryImage}
              alt={m.home_category_image_alt({}, { locale })}
              widths={[480, 768, 1024]}
              sizes="(max-width: 900px) 100vw, 50vw"
              data-editor-image-path="home.categories.imageAssetId"
            />
            <div>
              <>
                <h2
                  class="type-heading-2"
                  data-editor-path="home.categories.title"
                  contenteditable={editorMode ? "plaintext-only" : undefined}
                >
                  {template.home.categories.title}
                </h2>
                <nav data-editor-collections-path="home.categories.collectionIds">
                  {categoryCollections.length ? (
                    categoryCollections.map((collection, index) => (
                      <a
                        class="type-heading-4"
                        href={collectionHref(collection)}
                      >
                        <span>
                          {index + 1}/{" "}
                          {collection.title ??
                            m.catalog_collection_fallback({}, { locale })}
                        </span>
                        <Icon name="diagonal-arrow" />
                      </a>
                    ))
                  ) : (
                    <a class="type-heading-4" href="/products">
                      <span>{m.catalog_view_all_products({}, { locale })}</span>
                      <Icon name="diagonal-arrow" />
                    </a>
                  )}
                </nav>
              </>
            </div>
          </>
        </section>
      )
    }

    {
      (editorMode || template.home.cta.enabled) && (
        <section
          class="cta"
          data-editor-section="home.cta"
          data-editor-visible-path="home.cta.enabled"
          hidden={!template.home.cta.enabled}
        >
          <>
            <TemplateAsset
              src={storefrontAsset(
                template.home.cta.imageAssetId,
                ctaImage.src,
              )}
              fallback={ctaImage}
              alt="Cosmetics store"
              widths={[480, 768, 1024, 1440, 1920]}
              sizes="(max-width: 900px) calc(100vw - 40px), calc(100vw - 310px)"
              data-editor-image-path="home.cta.imageAssetId"
            />
            <div>
              <>
                <h2
                  class="type-heading-2"
                  data-editor-path="home.cta.title"
                  contenteditable={editorMode ? "plaintext-only" : undefined}
                >
                  {template.home.cta.title}
                </h2>
                <p>
                  {template.home.cta.primary.enabled && (
                    <ActionButton
                      href={template.home.cta.primary.href}
                      icon="bag"
                      size="small"
                      editorPath="home.cta.primary.label"
                      editorRelatedPaths={["home.cta.primary.href"]}
                      editorMode={editorMode}
                    >
                      {template.home.cta.primary.label}
                    </ActionButton>
                  )}
                  {template.home.cta.secondary.enabled && (
                    <ActionButton
                      href={template.home.cta.secondary.href}
                      icon="chat"
                      tone="light"
                      size="small"
                      editorPath="home.cta.secondary.label"
                      editorRelatedPaths={["home.cta.secondary.href"]}
                      editorMode={editorMode}
                    >
                      {template.home.cta.secondary.label}
                    </ActionButton>
                  )}
                </p>
              </>
            </div>
          </>
        </section>
      )
    }

    {
      editorMode &&
        products.map((product) => (
          <template data-editor-product-option={product.id}>
            <HeroProductSlide product={product} active />
          </template>
        ))
    }
    {
      editorMode &&
        collections.map((collection) => (
          <template data-editor-collection-option={collection.id}>
            <a data-preview-href={collectionHref(collection)}>
              <>
                <span>{collection.title ?? "Collection"}</span>
                <Icon name="diagonal-arrow" />
              </>
            </a>
          </template>
        ))
    }
  </main>
</Layout>
<script>
  import { initHeroCarousels } from "../scripts/hero-carousel";
  initHeroCarousels();

  const rail = document.querySelector<HTMLElement>("[data-product-rail]");
  const previous = document.querySelector<HTMLButtonElement>(
    "[data-product-rail-prev]",
  );
  const next = document.querySelector<HTMLButtonElement>(
    "[data-product-rail-next]",
  );
  const updateRailControls = () => {
    if (!rail || !previous || !next) return;
    const max = Math.max(0, rail.scrollWidth - rail.clientWidth);
    previous.disabled = rail.scrollLeft <= 2;
    next.disabled = rail.scrollLeft >= max - 2;
  };
  const moveRail = (direction: -1 | 1) => {
    if (!rail) return;
    const card = rail.querySelector<HTMLElement>(".product-card");
    const distance = Math.max(
      card?.offsetWidth ?? rail.clientWidth * 0.75,
      rail.clientWidth * 0.72,
    );
    rail.scrollBy({ left: distance * direction, behavior: "smooth" });
  };
  previous?.addEventListener("click", () => moveRail(-1));
  next?.addEventListener("click", () => moveRail(1));
  rail?.addEventListener("scroll", updateRailControls, { passive: true });
  rail?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      moveRail(event.key === "ArrowLeft" ? -1 : 1);
    }
  });
  if (rail) new ResizeObserver(updateRailControls).observe(rail);
  updateRailControls();
</script>
