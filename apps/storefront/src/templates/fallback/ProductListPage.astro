---
import ProductCard from "../../components/commerce/ProductCard.astro";
import StoreShell from "../../components/shell/StoreShell.astro";
import type { StoreCategory, StoreCollection, StoreProduct } from "../../lib/commerce/types";
import type { StorefrontSeo } from "../../lib/seo";
import type { ShellTheme } from "../../lib/theme";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import * as m from "../../paraglide/messages.js";

interface Props {
  /** Template-owned storefront data; unused by the fallback shell. */
  data?: unknown;
  tenantName: string;
  cartCount?: number;
  /** Accepted for template contract parity; the fallback shell shows server cart count. */
  deferCartCount?: boolean;
  primaryColor?: string;
  theme?: ShellTheme;
  currentPath?: string;
  products: StoreProduct[];
  errorMessage?: string | null;
  hasPrev: boolean;
  hasNext: boolean;
  prevHref?: string;
  nextHref?: string;
  /** Optional filters (used by full templates; ignored by the fallback shell). */
  collections?: StoreCollection[];
  categories?: StoreCategory[];
  filters?: {
    q?: string;
    collectionId?: string;
    categoryId?: string;
    order?: string;
  };
  totalCount?: number;
  offset?: number;
  limit?: number;
  seo?: StorefrontSeo;
}

const {
  tenantName,
  cartCount = 0,
  primaryColor,
  theme,
  currentPath = "/products",
  products,
  errorMessage,
  hasPrev,
  hasNext,
  prevHref,
  nextHref,
  seo,
} = Astro.props;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<StoreShell
  tenantName={tenantName}
  cartCount={cartCount}
  title={m.catalog_products({}, { locale })}
  primaryColor={primaryColor}
  theme={theme}
  currentPath={currentPath}
  seo={seo}
>
  <p class="sf-eyebrow">{m.catalog_eyebrow({}, { locale })}</p>
  <h1 class="sf-title">{m.catalog_products({}, { locale })}</h1>
  <p class="sf-lede">{m.catalog_intro({}, { locale })}</p>

  {
    errorMessage ? (
      <div class="sf-notice sf-notice-error" role="alert">
        {m.catalog_load_error({}, { locale })}
      </div>
    ) : products.length === 0 ? (
      <div class="sf-notice" role="status">
        <p><strong>{m.catalog_empty_title({}, { locale })}</strong></p>
        <p class="sf-muted">{m.catalog_empty_help({}, { locale })}</p>
      </div>
    ) : (
      <ul class="sf-grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </ul>
    )
  }

  {
    (hasPrev || hasNext) && (
      <div class="sf-actions">
        {hasPrev && prevHref && (
          <a class="sf-btn sf-btn-secondary" href={prevHref}>
            {m.catalog_previous({}, { locale })}
          </a>
        )}
        {hasNext && nextHref && (
          <a class="sf-btn sf-btn-secondary" href={nextHref}>
            {m.catalog_next({}, { locale })}
          </a>
        )}
      </div>
    )
  }
</StoreShell>
