              shopFeatures.map((feat) => (
                <div
                  class:list={["shop-feat__item", feat.active && "shop-feat__item--active"]}
                  data-accordion-item
                  data-id={feat.id}
                  role="button"
                  tabindex="0"
                  aria-expanded={feat.active ? "true" : "false"}
                >
                  <!-- Active State Header (Icon on Left, Minus Toggle on Right) -->
