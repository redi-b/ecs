---
import { afroV1Defaults, afroV1ThemeTokens } from "@ecs/storefront-templates";
import { afroDemoCollections, afroDemoCategories, afroDemoProducts, afroDemoFooterContact } from "../../../lib/demo/afro-fixture";
import Home from "../../../templates/afro/v1/pages/index.astro";

const data = structuredClone(afroV1Defaults);
data.home.categories.categoryIds = afroDemoCategories.map((c) => c.id);
data.home.collections.collectionIds = afroDemoCollections.map((c) => c.id);
data.home.products.productIds = afroDemoProducts.slice(0, 8).map((p) => p.id);
Object.assign(data.footer, afroDemoFooterContact);
---

<Home
  data={data}
  themeTokens={afroV1ThemeTokens}
  tenantName="AFRO Studio"
  productsResult={{ products: afroDemoProducts, count: afroDemoProducts.length, limit: afroDemoProducts.length, offset: 0 }}
  collections={afroDemoCollections}
  categories={afroDemoCategories}
  cartCount={0}
  demoMode
/>
