---
import { Icon } from "astro-icon/components";
import "../styles/components/_button.scss";

interface Props {
  text: string;
  href?: string;
  variant?: "primary" | "dark" | "secondary" | "neutral";
  size?: "large" | "small";
  fullWidth?: boolean;
  class?: string;
  icon?: boolean | string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  editorPath?: string;
  editorRelatedPaths?: string[];
  editorMode?: boolean;
}

const {
  text,
  href,
  variant = "primary",
  size = "large",
  fullWidth = false,
  class: className,
  icon = true,
  type = "submit",
  disabled = false,
  editorPath,
  editorRelatedPaths,
  editorMode = false,
  ...rest
} = Astro.props;

const hasIcon = Boolean(icon);
const iconName = typeof icon === "string" ? icon : "arrow-up-right";
const typeClass = size === "large" ? "type-body-l" : "type-body-s-400";
const iconSize = size === "large" ? 18 : 13;

const classes = [
  "btn",
  `btn--${variant}`,
  `btn--${size}`,
  typeClass,
  hasIcon && "btn--with-icon",
  fullWidth && "btn--full-width",
  className,
].filter(Boolean);

const Element = href ? "a" : "button";
---
<Element
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={classes}
  data-editor-path={editorPath}
  data-editor-related-paths={editorRelatedPaths?.length ? editorRelatedPaths.join(" ") : undefined}
  {...rest}
>
  <span
    class="btn__text"
    data-editor-text-target
    contenteditable={editorMode && editorPath ? "plaintext-only" : undefined}
  >{text}</span>
  {
    hasIcon && (
      <span class="btn__icon" aria-hidden="true">
        <Icon name={iconName} width={iconSize} height={iconSize} />
      </span>
    )
  }
</Element>
