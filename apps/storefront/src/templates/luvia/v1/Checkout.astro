---
import type { StoreCart, StoreDeliveryOptions, StorePaymentOptions, StoreShippingOption } from "../../../lib/commerce/types";
import { formatMoney } from "../../../lib/money";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";

interface Props { data: unknown; tenantName: string; cartCount: number; cart: StoreCart | null; delivery: StoreDeliveryOptions | null; payment: StorePaymentOptions; shippingOptions: StoreShippingOption[]; shippingError?: string | null; error?: string | null; }
const { data, tenantName, cartCount, cart, delivery, payment, shippingOptions, shippingError, error } = Astro.props;
const template = parseLuviaData(data);
const items = cart?.items ?? [];
const deliveryEnabled = delivery?.deliveryEnabled === true;
const pickupEnabled = delivery?.pickupEnabled === true;
const fulfillmentAvailable = deliveryEnabled || pickupEnabled;
const phoneRequired = delivery?.phoneConfirmationRequired !== false;
const defaultChoice = deliveryEnabled ? "delivery" : pickupEnabled ? "pickup" : "delivery";
const paidOptions = shippingOptions.filter((option) => (option.amount == null || option.amount > 0) && !/pickup|collect/i.test(option.name ?? ""));
const pickupOptions = shippingOptions.filter((option) => option.amount === 0 || /pickup|collect/i.test(option.name ?? ""));
const deliveryOptions = paidOptions.length ? paidOptions : shippingOptions;
const pickupOption = pickupOptions[0] ?? deliveryOptions[0] ?? null;
const canSubmit = items.length > 0 && fulfillmentAvailable && (defaultChoice === "pickup" ? Boolean(pickupOption) : deliveryOptions.length > 0);
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} cartCount={cartCount} title="Checkout">
  <main class="lv-checkout">
    <header class="lv-checkout__hero"><h1>CHECKOUT</h1><p>Complete your order — natural beauty, delivered with care.</p></header>
    {error && <p class="lv-checkout__error" role="alert">{error}</p>}
    {shippingError && <p class="lv-checkout__error" role="alert">Delivery options could not be loaded. Please refresh and try again.</p>}
    {!items.length ? <section class="lv-checkout__empty"><h2>Your cart is empty</h2><p>Add products before continuing to checkout.</p><a href="/products">Browse products</a></section> : <div class="lv-checkout__layout">
      <section class="lv-checkout-form-wrap">
        <header><h2>Payment Details</h2><p>By proceeding you agree to our Terms of Service and Privacy Policy.</p></header>
        <form method="post" action="/actions/checkout/cod" class="lv-checkout-form" data-checkout-form>
          {!fulfillmentAvailable && <div class="lv-checkout-blocker" role="status"><strong>Orders are temporarily unavailable.</strong><p>This shop has not enabled delivery or pickup yet.</p></div>}
          <div class="lv-checkout-fields">
            <label><span>First Name*</span><input name="firstName" required autocomplete="given-name" placeholder="Jane" /></label>
            <label><span>Last Name*</span><input name="lastName" required autocomplete="family-name" placeholder="Doe" /></label>
            <label><span>Phone Number{phoneRequired ? "*" : ""}</span><input name="phone" required={phoneRequired} autocomplete="tel" inputmode="tel" placeholder="0912345678" /></label>
            <label><span>Email (optional)</span><input name="email" type="email" autocomplete="email" placeholder="name@example.com" /></label>
            <label><span>Fulfillment*</span><select name="deliveryChoice" data-delivery-choice required disabled={!fulfillmentAvailable}>{deliveryEnabled && <option value="delivery" selected={defaultChoice === "delivery"}>Delivery</option>}{pickupEnabled && <option value="pickup" selected={defaultChoice === "pickup"}>Pickup</option>}</select></label>
            <label data-delivery-field><span>City*</span><input name="city" value="Addis Ababa" required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} autocomplete="address-level2" /></label>
            <label class="is-wide" data-delivery-field><span>Street Address*</span><input name="address1" required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} autocomplete="street-address" placeholder="Bole, Ayat Road" /></label>
            {delivery?.landmarkRequired || delivery?.notesEnabled !== false ? <label class="is-wide" data-delivery-field><span>Landmark{delivery?.landmarkRequired ? "*" : " (optional)"}</span><input name="landmark" required={Boolean(delivery?.landmarkRequired) && defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} data-landmark-required={delivery?.landmarkRequired ? "true" : "false"} placeholder="Nearby landmark" /></label> : null}
            {delivery?.notesEnabled !== false && <label class="is-wide"><span>Order Notes (optional)</span><textarea name="notes" rows="3" placeholder="Helpful delivery details" /></label>}
            <label class="is-wide" data-delivery-option><span>Delivery Option*</span><select name="shippingOptionId" required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"}>{deliveryOptions.map((option) => <option value={option.id}>{option.name?.trim() || "Standard Delivery"}{option.amount != null ? ` · ${formatMoney(option.amount, option.currencyCode ?? cart?.currencyCode)}` : ""}</option>)}</select></label>
            <div data-pickup-option hidden>{pickupOption && <input type="hidden" name="shippingOptionId" value={pickupOption.id} disabled={defaultChoice !== "pickup"} />}</div>
          </div>
          <label class="lv-checkout-account"><input type="checkbox" disabled /><span>Create an account at checkout <small>Coming soon</small></span></label>
          <fieldset class="lv-checkout-payment"><legend>Payment Option*</legend>{payment.cod && <div><strong>Pay on delivery</strong><span>Pay when your order arrives.</span></div>}{payment.chapa && <div><strong>Chapa</strong><span>Pay securely online.</span></div>}{!payment.cod && !payment.chapa && <p>No payment method is available for this order.</p>}</fieldset>
          <div class="lv-checkout-actions">{payment.cod && <button type="submit" disabled={!canSubmit}>Place order · Pay on delivery</button>}{payment.chapa && <button class="is-secondary" type="submit" formaction="/actions/checkout/chapa" disabled={!canSubmit}>Proceed with Chapa</button>}</div>
        </form>
      </section>

      <aside class="lv-checkout-summary" aria-label="Order summary"><header><h2>Order Summary</h2><span>{items.length} item{items.length === 1 ? "" : "s"}</span></header><ul>{items.map((item) => <li><div>{item.thumbnail ? <img src={item.thumbnail} alt="" /> : null}</div><p><strong>{item.title ?? "Product"}</strong><span>{item.variantTitle ?? ""}{item.quantity > 1 ? ` × ${item.quantity}` : ""}</span></p><b>{formatMoney(item.total ?? item.unitPrice, cart?.currencyCode)}</b></li>)}</ul><dl><div><dt>Subtotal</dt><dd>{formatMoney(cart?.itemTotal ?? cart?.total, cart?.currencyCode)}</dd></div><div><dt>Delivery</dt><dd>Confirmed above</dd></div><div><dt>Total</dt><dd>{formatMoney(cart?.total ?? cart?.itemTotal, cart?.currencyCode)}</dd></div></dl><small>Delivery timing is confirmed after your order is placed.</small></aside>
    </div>}
  </main>
</Layout>

<script is:inline>
  (() => {
    const select = document.querySelector("[data-delivery-choice]"); if (!(select instanceof HTMLSelectElement)) return;
    const sync = () => { const delivery = select.value === "delivery"; document.querySelectorAll("[data-delivery-field]").forEach((wrapper) => { wrapper.hidden = !delivery; wrapper.querySelectorAll("input,select,textarea").forEach((field) => { field.disabled = !delivery; if (field.name === "landmark") field.required = delivery && field.dataset.landmarkRequired === "true"; else if (field.name !== "notes") field.required = delivery; }); }); const deliveryOption = document.querySelector("[data-delivery-option]"); const pickupOption = document.querySelector("[data-pickup-option]"); if (deliveryOption) { deliveryOption.hidden = !delivery; deliveryOption.querySelectorAll("select").forEach((field) => { field.disabled = !delivery; field.required = delivery; }); } if (pickupOption) { pickupOption.hidden = delivery; pickupOption.querySelectorAll("input").forEach((field) => field.disabled = delivery); } };
    select.addEventListener("change", sync); sync();
    const form = document.querySelector("[data-checkout-form]"); form?.addEventListener("submit", (event) => { const button = event.submitter; if (button instanceof HTMLButtonElement) { button.disabled = true; button.dataset.loading = "true"; button.textContent = button.formAction.endsWith("/chapa") ? "Opening secure payment…" : "Placing your order…"; } });
  })();
</script>
<style is:global lang="scss">@use "./styles/checkout.scss";</style>
