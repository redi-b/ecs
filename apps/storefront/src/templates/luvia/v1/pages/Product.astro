---
import "../styles/pages/product-detail.scss";
import { Icon } from "astro-icon/components";
import { sanitizeProductDescription } from "@ecs/content";
import ProductMediaPlaceholder from "../../../../components/media/ProductMediaPlaceholder.astro";
import { resolveProductBadge } from "../../../../lib/commerce/merchandising";
import { isColorOptionTitle, resolveColorSwatch } from "../../../../lib/commerce/product-options";
import type {
  StoreProduct,
  StoreProductImage,
  StoreProductOption,
  StoreProductVariant,
} from "../../../../lib/commerce/types";
import { buildProductImageSrcset, resolveProductImage } from "../../../../lib/media-url";
import { formatMoney } from "../../../../lib/money";
import type { StorefrontSeo } from "../../../../lib/seo";
import { serializeJsonForScript } from "../../../../lib/serialize-json";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import ProductCard from "../components/ProductCard.astro";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import { resolveTemplateVoiceMessage } from "../../../../lib/template-voice";
import * as m from "../../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount?: number;
  deferCartCount?: boolean;
  product: StoreProduct | null;
  handle: string;
  notice?: string | null;
  error?: string | null;
  relatedProducts?: StoreProduct[];
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
  demoMode?: boolean;
}

const {
  data,
  themeTokens,
  tenantName,
  cartCount = 0,
  deferCartCount = false,
  product,
  handle,
  notice,
  error,
  relatedProducts = [],
  seo,
  structuredData,
  demoMode = false,
} = Astro.props;

const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";

const addToCartLabel = resolveTemplateVoiceMessage({
  fallback: m.action_add_to_cart({}, { locale }),
  locale,
  messageId: "action_add_to_cart",
  templateKey: "luvia.v1",
});

const defaultVariant: StoreProductVariant | null =
  product?.variants.find((variant) => variant.inStock) ?? product?.variants[0] ?? null;

const descriptionHtml =
  sanitizeProductDescription(product?.description) ??
  `<p>${m.product_description_fallback({}, { locale })}</p>`;

const optionAxes: StoreProductOption[] = product?.options?.length
  ? product.options
  : (() => {
      const axes = new Map<string, Set<string>>();
      for (const variant of product?.variants ?? []) {
        for (const option of variant.optionValues) {
          if (!axes.has(option.optionTitle)) axes.set(option.optionTitle, new Set());
          axes.get(option.optionTitle)?.add(option.value);
        }
      }
      return [...axes.entries()].map(([title, values], index) => ({
        id: `axis-${index}`,
        title,
        values: [...values],
      }));
    })();

const gallery: StoreProductImage[] = product?.gallery?.length
  ? product.gallery
  : product?.thumbnail
    ? [{ url: product.thumbnail, variants: product.thumbnailVariants }]
    : [];

const variantsPayload = (product?.variants ?? []).map((variant) => ({
  id: variant.id,
  inStock: variant.inStock,
  priceAmount: variant.priceAmount,
  originalPriceAmount: variant.originalPriceAmount,
  discountPercentage: variant.discountPercentage,
  currencyCode: variant.currencyCode,
  sku: variant.sku,
  imageUrl: variant.imageUrl ?? null,
  imageVariants: variant.imageVariants ?? null,
  options: Object.fromEntries(
    variant.optionValues.map((option) => [option.optionTitle, option.value]),
  ),
}));

const brand = product?.collectionTitle?.toUpperCase() || tenantName.toUpperCase();
const currentPrice = formatMoney(
  defaultVariant?.priceAmount ?? product?.priceAmount,
  defaultVariant?.currencyCode ?? product?.currencyCode,
  locale,
);
const originalPrice = defaultVariant?.originalPriceAmount ?? product?.originalPriceAmount ?? null;
const badge = product ? resolveProductBadge(product, defaultVariant) : null;

const initialHeroImage = defaultVariant?.imageUrl
  ? (gallery.find((img) => img.url === defaultVariant.imageUrl) ?? {
      url: defaultVariant.imageUrl,
      variants: defaultVariant.imageVariants ?? undefined,
    })
  : (gallery[0] ?? null);

const wishlistItem = product
  ? JSON.stringify({
      path: `/products/${encodeURIComponent(handle)}`,
      title: product.title ?? m.catalog_product_fallback({}, { locale }),
      thumbnail: product.thumbnail ?? gallery[0]?.url ?? null,
      priceAmount: defaultVariant?.priceAmount ?? product.priceAmount,
      currencyCode: defaultVariant?.currencyCode ?? product.currencyCode,
    })
  : "";
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  cartCount={cartCount}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  title={product?.title ?? m.product_not_found({}, { locale })}
  seo={seo}
  structuredData={structuredData}
>
  {
    !product ? (
      <main class="product-missing">
        <h1 class="type-heading-2">{m.product_not_found({}, { locale })}</h1>
        <p class="type-body-400">{m.product_unavailable({}, { locale })}</p>
        <a class="type-body-500" href="/products">
          {m.action_back_to_products({}, { locale })}
        </a>
      </main>
    ) : (
      <main class="product-page" data-product-root data-product-detail>
        <nav
          class="product-breadcrumb container type-body-s-400"
          aria-label={m.breadcrumb_label({}, { locale })}
        >
          <a href="/" class="type-body-s-400">{m.nav_home({}, { locale })}</a>
          <Icon name="chevron" />
          <a href="/products" class="type-body-s-400">{m.nav_shop({}, { locale })}</a>
          <Icon name="chevron" />
          <span class="type-body-s-400">{m.catalog_products({}, { locale })}</span>
        </nav>

        {
          (notice === "added" || error) && (
            <p
              class:list={["product-server-notice container type-body-s-400", { "is-error": error }]}
              role={error ? "alert" : "status"}
            >
              {error ?? m.product_added_to_cart({}, { locale })}
            </p>
          )
        }

        <section class="product-detail container">
          <div class="product-gallery">
            {gallery.length > 1 && (
              <div class="product-gallery__thumbs" aria-label={m.product_images({}, { locale })}>
                {gallery.map((img, index) => {
                  const thumbSrc = resolveProductImage(img.variants, "w200", img.url);
                  const mainSrc = resolveProductImage(
                    img.variants,
                    "w1200",
                    resolveProductImage(img.variants, "w800", img.url),
                  );
                  const mainSrcset = buildProductImageSrcset(img.variants);
                  const isInitialActive = initialHeroImage
                    ? img.url === initialHeroImage.url
                    : index === 0;
                  return (
                    <button
                      type="button"
                      data-gallery-thumb={mainSrc}
                      data-gallery-thumb-srcset={mainSrcset ?? undefined}
                      data-image-url={img.url}
                      aria-current={isInitialActive ? "true" : undefined}
                      aria-label={m.product_view_image({ number: index + 1 }, { locale })}
                    >
                      <img src={thumbSrc} alt="" width="96" height="96" loading="lazy" decoding="async" />
                    </button>
                  );
                })}
              </div>
            )}
            <div class="product-gallery__main" data-gallery-main>
              {initialHeroImage ? (
                <img
                  src={resolveProductImage(
                    initialHeroImage.variants,
                    "w1200",
                    resolveProductImage(initialHeroImage.variants, "w800", initialHeroImage.url),
                  )}
                  srcset={buildProductImageSrcset(initialHeroImage.variants) ?? undefined}
                  alt={product.title ?? m.catalog_product_fallback({}, { locale })}
                  width="1200"
                  height="1200"
                  decoding="async"
                />
              ) : (
                <ProductMediaPlaceholder
                  label={m.product_no_image(
                    { product: product.title ?? m.catalog_product_fallback({}, { locale }) },
                    { locale },
                  )}
                />
              )}
              <span
                class:list={["product-gallery__badge type-body-xs", badge ? `is-${badge.kind}` : null]}
                data-product-badge
                hidden={!badge}
              >
                {badge?.kind === "promotion" && <Icon name="star" data-product-badge-icon />}
                <span>{badge?.label ?? ""}</span>
              </span>
            </div>
          </div>

          <div class="product-buy">
            <div class="product-title">
              <span class="type-body-xs">{brand}</span>
              <h1 class="type-heading-3">{product.title}</h1>
              <p class="product-price type-body-xl">
                <strong data-product-price class="type-body-xl">{currentPrice}</strong>
                <del data-product-original-price class="type-body-s-400" hidden={!originalPrice}>
                  {originalPrice
                    ? formatMoney(originalPrice, defaultVariant?.currencyCode ?? product.currencyCode, locale)
                    : ""}
                </del>
              </p>
              <small
                data-product-stock
                class:list={["type-body-s-400", { "is-out": !defaultVariant?.inStock }]}
              >
                {defaultVariant?.inStock ? m.catalog_in_stock({}, { locale }) : m.catalog_out_of_stock({}, { locale })}
                {defaultVariant?.sku ? ` · SKU ${defaultVariant.sku}` : ""}
              </small>
            </div>

            <form method="post" action="/actions/cart/add" data-add-form>
              <input type="hidden" name="variantId" value={defaultVariant?.id ?? ""} data-variant-id />
              <input type="hidden" name="returnTo" value={`/products/${encodeURIComponent(handle)}`} />
              <input type="hidden" name="quantity" value="1" />
              {optionAxes.map((axis) => {
                const isColorAxis = isColorOptionTitle(axis.title);
                const hasSwatches = Boolean(axis.optionSwatches && Object.keys(axis.optionSwatches).length);
                const showSwatches =
                  axis.displayMode === "swatch" ||
                  (axis.displayMode !== "text" && (isColorAxis || hasSwatches));
                return (
                  <fieldset data-option-axis={axis.title}>
                    <legend class="type-body-s-400">
                      {m.product_select_option({ option: axis.title }, { locale })}
                    </legend>
                    <div>
                      {axis.values.map((value) => {
                        const selected = defaultVariant?.optionValues.some(
                          (option) => option.optionTitle === axis.title && option.value === value,
                        );
                        const richSwatch = showSwatches ? axis.optionSwatches?.[value] : undefined;
                        const colorSwatch =
                          richSwatch?.kind === "color"
                            ? richSwatch.value
                            : showSwatches && isColorAxis
                              ? resolveColorSwatch(value, axis.swatches?.[value])
                              : null;
                        const imageSwatch = richSwatch?.kind === "image" ? richSwatch.url : null;

                        if (imageSwatch) {
                          return (
                            <button
                              class="product-swatch product-swatch--image"
                              type="button"
                              data-option-title={axis.title}
                              data-option-value={value}
                              aria-pressed={selected ? "true" : "false"}
                              aria-label={m.product_select_option({ option: value }, { locale })}
                              title={value}
                            >
                              <img
                                src={imageSwatch}
                                alt=""
                                width="28"
                                height="28"
                                loading="lazy"
                                aria-hidden="true"
                              />
                            </button>
                          );
                        }

                        if (colorSwatch) {
                          return (
                            <button
                              class="product-swatch"
                              type="button"
                              data-option-title={axis.title}
                              data-option-value={value}
                              aria-pressed={selected ? "true" : "false"}
                              aria-label={m.product_select_option({ option: value }, { locale })}
                              title={value}
                            >
                              <span style={`background-color:${colorSwatch}`} aria-hidden="true" />
                            </button>
                          );
                        }

                        return (
                          <button
                            class="type-body-s-500"
                            type="button"
                            data-option-title={axis.title}
                            data-option-value={value}
                            aria-pressed={selected ? "true" : "false"}
                          >
                            {value}
                          </button>
                        );
                      })}
                    </div>
                  </fieldset>
                );
              })}
              <div class="product-cart-row">
                <button
                  class="product-add type-body-l-500"
                  type="submit"
                  data-add-button
                  disabled={!defaultVariant?.inStock}
                >
                  <span data-add-label class="type-body-l-500">
                    {defaultVariant?.inStock ? addToCartLabel : m.catalog_out_of_stock({}, { locale })}
                  </span>
                  <span class="product-spinner" aria-hidden="true" />
                </button>
                <button
                  class="product-wishlist"
                  type="button"
                  data-wishlist-toggle
                  data-wishlist-item={wishlistItem}
                  aria-pressed="false"
                  aria-label={m.action_add_to_wishlist({}, { locale })}
                >
                  <Icon name="wishlist" />
                </button>
              </div>
              <p class="product-feedback type-body-xs" data-add-feedback aria-live="polite" />
            </form>

            <div class="product-accordions">
              <details open>
                <summary class="type-body-l-500">
                  {m.product_description({}, { locale })} <Icon name="chevron" />
                </summary>
                <div class="rich-text type-body-400" set:html={descriptionHtml} />
              </details>
              <details>
                <summary class="type-body-l-500">
                  {m.product_delivery_details({}, { locale })} <Icon name="chevron" />
                </summary>
                <div>
                  <p class="type-body-400">{m.product_delivery_help({}, { locale })}</p>
                </div>
              </details>
            </div>
          </div>
        </section>

        {relatedProducts.length > 0 && (
          <section class="related container" aria-labelledby="related-products-title">
            <header>
              <h2 id="related-products-title" class="type-heading-3">
                {m.product_related({}, { locale })}
              </h2>
              <div class="rail-controls">
                <button type="button" data-related-prev aria-label={m.product_related_previous({}, { locale })}>
                  ←
                </button>
                <button type="button" data-related-next aria-label={m.product_related_next({}, { locale })}>
                  →
                </button>
              </div>
            </header>
            <div class="related__rail" data-related-rail role="region" aria-label={m.product_related({}, { locale })}>
              {relatedProducts.map((item) => (
                <ProductCard product={item} />
              ))}
            </div>
          </section>
        )}

        <div class="sticky-product" data-sticky-product>
          <div>
            <strong class="type-body-s-500">{product.title}</strong>
            <span data-sticky-price class="type-body-500">{currentPrice}</span>
          </div>
          <button type="button" data-sticky-add class="type-body-500" disabled={!defaultVariant?.inStock}>
            <span data-add-label class="type-body-500">
              {defaultVariant?.inStock ? addToCartLabel : m.catalog_out_of_stock({}, { locale })}
            </span>
            <span class="product-spinner" aria-hidden="true" />
          </button>
        </div>

        <script
          is:inline
          type="application/json"
          data-variants-data
          set:html={serializeJsonForScript(variantsPayload)}
        />
      </main>
    )
  }
</Layout>

<script>
  import { initLuviaProductPage } from "../scripts/client";
  initLuviaProductPage();
</script>
