---
import "../styles/pages/order-confirmation.scss";
import Icon from "../components/Icon.astro";
import { formatMoney } from "../../../../lib/money";
import { formatOrderReference } from "../../../../lib/order-reference";
import type { LastOrderCookie } from "../../../../lib/session/cart-cookie";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import ActionButton from "../components/ActionButton.astro";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  orderId: string;
  lastOrder: LastOrderCookie | null;
  hasCustomerSession?: boolean;
  demoMode?: boolean;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  orderId,
  lastOrder,
  hasCustomerSession = false,
  demoMode = false,
} = Astro.props;
const template = parseLuviaData(data);
const verified = Boolean(lastOrder && lastOrder.id === orderId);
const reference = formatOrderReference(orderId);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} demoMode={demoMode} title={m.order_confirmed({}, { locale })}>
  <main class="lv-confirmation container" data-copy-label={m.action_copy({}, { locale })} data-copied-label={m.action_copied({}, { locale })} data-copy-success={m.confirmation_copy_success({}, { locale })} data-copy-fallback={m.confirmation_copy_fallback({ reference: "__REFERENCE__" }, { locale })}>
    <div class="lv-confirmation__glow" aria-hidden="true"></div>
    <section class="lv-confirmation__card" aria-labelledby="confirmation-title">
      <div class="lv-confirmation__mark"><span></span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m14 25 7 7 14-17" /></svg><Icon name="sparkle" /></div>
      <p class="lv-confirmation__eyebrow type-body-xs">{m.order_received({}, { locale })}</p>
      <h1 id="confirmation-title" class="type-heading-1">{m.confirmation_luvia_heading({}, { locale })}</h1>
      <p class="lv-confirmation__intro type-body-400">{m.confirmation_luvia_intro({ shop: tenantName }, { locale })}</p>
      <div class="lv-confirmation__receipt">
        <div><span class="type-body-s-400">{m.order_reference({}, { locale })}</span><strong class="type-body-s-500">{reference}</strong><button class="type-body-xs" type="button" data-copy-order data-order-id={reference}>{m.action_copy({}, { locale })}</button></div>
        {verified && lastOrder?.total != null && <div><span class="type-body-s-400">{m.order_total({}, { locale })}</span><strong class="type-body-s-500">{formatMoney(lastOrder.total, lastOrder.currencyCode, locale)}</strong></div>}
        <div><span class="type-body-s-400">{m.confirmation_status({}, { locale })}</span><strong class="type-body-s-500">{verified ? m.order_confirmed({}, { locale }) : m.confirmation_order_placed({}, { locale })}</strong></div>
      </div>
      <p class="lv-confirmation__notice type-body-xs" data-copy-status aria-live="polite">{m.confirmation_reference_help({}, { locale })} {hasCustomerSession ? m.confirmation_account_help({}, { locale }) : m.confirmation_guest_help({}, { locale })}</p>
      <div class="lv-confirmation__actions"><ActionButton href="/products" icon="bag">{m.action_continue_shopping({}, { locale })}</ActionButton>{hasCustomerSession && <ActionButton href="/account" tone="secondary">{m.action_view_order_history({}, { locale })}</ActionButton>}<ActionButton href="/" tone="secondary">{m.action_return_home({}, { locale })}</ActionButton></div>
    </section>
    <aside class="lv-confirmation__steps" aria-label={m.confirmation_next({}, { locale })}><p class="type-body-xs">{m.confirmation_next({}, { locale })}</p><ol><li><span class="type-body-xs">01</span><div><strong class="type-heading-4">{m.confirmation_review({}, { locale })}</strong><small class="type-body-xs">{m.confirmation_review_help({}, { locale })}</small></div></li><li><span class="type-body-xs">02</span><div><strong class="type-heading-4">{m.confirmation_preparation({}, { locale })}</strong><small class="type-body-xs">{m.confirmation_preparation_help({}, { locale })}</small></div></li><li><span class="type-body-xs">03</span><div><strong class="type-heading-4">{m.confirmation_updates({}, { locale })}</strong><small class="type-body-xs">{m.confirmation_updates_help({}, { locale })}</small></div></li></ol></aside>
  </main>
</Layout>

<script is:inline>
  document.querySelector("[data-copy-order]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget;
    if (!(button instanceof HTMLButtonElement)) return;
    const status = document.querySelector("[data-copy-status]");
    const value = button.dataset.orderId || "";
    let copied = false;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        copied = true;
      }
    } catch {}
    if (!copied) {
      const input = document.createElement("textarea");
      input.value = value;
      input.setAttribute("readonly", "");
      input.style.position = "fixed";
      input.style.opacity = "0";
      document.body.append(input);
      input.select();
      copied = document.execCommand("copy");
      input.remove();
    }
    if (copied) {
      const root = button.closest("[data-copy-label]");
      button.textContent = root?.getAttribute("data-copied-label") || "";
      if (status) status.textContent = root?.getAttribute("data-copy-success") || "";
      setTimeout(() => button.textContent = root?.getAttribute("data-copy-label") || "", 1600);
    } else if (status) {
      const root = button.closest("[data-copy-fallback]");
      status.textContent = (root?.getAttribute("data-copy-fallback") || "").replace("__REFERENCE__", value);
    }
  });
</script>
