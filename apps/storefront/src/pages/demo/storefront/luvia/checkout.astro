---
import { luviaV1Defaults, luviaV1ThemeTokens } from "@ecs/storefront-templates";
import {
  luviaDemoCart,
  luviaDemoDelivery,
  luviaDemoShippingOptions,
} from "../../../../lib/demo/luvia-fixture";
import LuviaV1Checkout from "../../../../templates/luvia/v1/Checkout.astro";
---

<LuviaV1Checkout
  data={luviaV1Defaults}
  themeTokens={luviaV1ThemeTokens}
  tenantName="Luvia Beauty"
  cartCount={2}
  cart={luviaDemoCart}
  delivery={luviaDemoDelivery}
  payment={{ cod: true, chapa: true }}
  shippingOptions={luviaDemoShippingOptions}
  demoMode
/>
