---
import { formatMoney } from "../../lib/money";
import type { StoreProduct } from "../../lib/commerce/types";
import { resolveStorefrontMediaVariantUrl } from "../../lib/media-url";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import * as m from "../../paraglide/messages.js";

interface Props {
  product: StoreProduct;
}

const { product } = Astro.props;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const href = product.handle ? `/products/${encodeURIComponent(product.handle)}` : "#";
const title = product.title ?? m.catalog_product_fallback({}, { locale });
const cardThumbnail = resolveStorefrontMediaVariantUrl(product.thumbnail, 400) ?? product.thumbnail;
---

<li>
  <a class="sf-card" href={href}>
    {
      cardThumbnail ? (
        <img class="sf-card-media" src={cardThumbnail} alt="" width="400" height="400" loading="lazy" decoding="async" />
      ) : (
        <div class="sf-card-media-placeholder" aria-hidden="true" />
      )
    }
    <div class="sf-card-body">
      <h3 class="sf-card-title">{title}</h3>
      <p class="sf-card-price">{formatMoney(product.priceAmount, product.currencyCode, locale)}</p>
    </div>
  </a>
</li>
