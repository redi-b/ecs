---
import type { StorefrontSeo } from "../../lib/seo";
import type { ShellTheme } from "../../lib/theme";
import { shellStyle } from "../../lib/theme";
import SeoHead from "./SeoHead.astro";
import StorefrontAnalytics from "./StorefrontAnalytics.astro";
import StructuredData from "./StructuredData.astro";
import StorefrontLanguageSwitcher from "./StorefrontLanguageSwitcher.astro";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import * as m from "../../paraglide/messages.js";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  tenantName: string;
  cartCount?: number;
  title?: string;
  primaryColor?: string;
  theme?: ShellTheme;
  announcement?: string | null;
  nav?: NavItem[];
  footerPhone?: string | null;
  footerAddress?: string | null;
  footerLinks?: NavItem[];
  logoUrl?: string | null;
  /** Path for aria-current on nav */
  currentPath?: string;
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
}

const {
  tenantName,
  cartCount = 0,
  title,
  primaryColor,
  theme = {},
  announcement,
  nav,
  footerPhone,
  footerAddress,
  footerLinks = [],
  logoUrl,
  currentPath,
  seo,
  structuredData,
} = Astro.props;

const pageTitle = title ? `${title} · ${tenantName}` : tenantName;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const style = shellStyle(theme, primaryColor);
const links: NavItem[] =
  nav && nav.length > 0
    ? nav
    : [
        { label: m.nav_shop({}, { locale }), href: "/products" },
        { label: m.nav_cart({}, { locale }), href: "/cart" },
      ];
// Cart is always visible as a dedicated control; avoid duplicating in nav list.
const mainLinks = links.filter((item) => !item.href.startsWith("/cart"));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={theme.primary ?? primaryColor ?? "#0f4c3a"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <SeoHead seo={seo} />
    <StructuredData value={structuredData} />
    <link rel="stylesheet" href="/styles/commerce.css" />
  </head>
  <body style={style}>
    <div class="sf-shell">
      {
        announcement ? (
          <div class="sf-announcement" role="status">{announcement}</div>
        ) : null
      }
      <div class="sf-header-wrap">
        <header class="sf-header">
          <a class="sf-brand" href="/">
            {logoUrl ? <img class="sf-brand-mark" src={logoUrl} alt="" /> : null}
            <span>{tenantName}</span>
          </a>
          <nav class="sf-nav" aria-label={m.a11y_store_navigation({}, { locale })}>
            {
              mainLinks.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    currentPath &&
                    (currentPath === item.href ||
                      (item.href !== "/" && currentPath.startsWith(item.href)))
                      ? "page"
                      : undefined
                  }
                >
                  {item.label}
                </a>
              ))
            }
            <a class="sf-cart-link" href="/cart">
              {m.nav_cart({}, { locale })}
              {
                cartCount > 0 ? (
                  <span class="sf-badge" aria-live="polite">
                    {cartCount}
                  </span>
                ) : null
              }
            </a>
            <StorefrontLanguageSwitcher />
          </nav>
        </header>
      </div>
      <main class="sf-main">
        <slot />
      </main>
      <footer class="sf-footer">
        <div>
          <strong>{tenantName}</strong>
          {footerAddress ? <p style="margin:0.25rem 0 0">{footerAddress}</p> : null}
          {footerPhone ? <p style="margin:0.25rem 0 0">{footerPhone}</p> : null}
          {
            !footerAddress && !footerPhone ? (
              <p style="margin:0.25rem 0 0">{m.footer_thanks({}, { locale })}</p>
            ) : null
          }
        </div>
        {
          footerLinks.length > 0 ? (
            <nav class="sf-footer-nav" aria-label={m.a11y_footer_navigation({}, { locale })}>
              {footerLinks.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
          ) : (
            <nav class="sf-footer-nav" aria-label={m.a11y_footer_navigation({}, { locale })}>
              <a href="/products">{m.nav_shop({}, { locale })}</a>
              <a href="/cart">{m.nav_cart({}, { locale })}</a>
            </nav>
          )
        }
      </footer>
      <StorefrontAnalytics />
    </div>
  </body>
</html>
