---
import type { StoreCustomerOrderDetail } from "../../../lib/commerce/account";
import { formatStorefrontDate } from "../../../lib/date";
import { formatMoney } from "../../../lib/money";
import { formatOrderReference } from "../../../lib/order-reference";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";
import ActionButton from "./ActionButton.astro";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  order: StoreCustomerOrderDetail;
}

const { data, themeTokens, tenantName, cartCount, order } = Astro.props;
const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const reference = formatOrderReference(order.id, order.customDisplayId);
const placedAt = order.createdAt
  ? formatStorefrontDate(order.createdAt, locale, "long") ?? m.account_date_unavailable({}, { locale })
  : m.account_date_unavailable({}, { locale });
const stateLabel = {
  received: m.order_received({}, { locale }),
  preparing: m.order_preparing({}, { locale }),
  shipped: m.order_shipped({}, { locale }),
  delivered: m.order_delivered({}, { locale }),
  cancelled: m.order_cancelled({}, { locale }),
}[order.fulfillmentState];
const money = (value: number | null) => value == null ? "—" : formatMoney(value, order.currencyCode, locale);
const address = order.shippingAddress;
const isPickup = /pickup|pick up|collect/i.test(order.shippingMethod ?? "");
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} title={m.order_title({ reference }, { locale })}>
  <main class="lv-account-order" data-checking-label={m.order_checking({}, { locale })} data-updated-label={m.order_updated_at({ time: "__TIME__" }, { locale })} data-refresh-failed-label={m.order_refresh_failed({}, { locale })}>
    <a class="lv-account-order__back" href="/account">← {m.order_back_to_account({}, { locale })}</a>
    <header class="lv-account-order__hero">
      <div>
        <p>{m.order_eyebrow({}, { locale })}</p>
        <h1>{m.order_title({ reference }, { locale })}</h1>
        <span>{m.order_placed({ date: placedAt }, { locale })}</span>
      </div>
      <div class="lv-account-order__tracking">
        <div class="lv-account-order__status-row">
          <strong data-order-live-status class:list={["lv-account-order__status", `is-${order.fulfillmentState}`]}>{stateLabel}</strong>
          <button class="lv-account-order__refresh" type="button" data-order-refresh aria-describedby="order-refresh-note" aria-label={m.order_check_status({}, { locale })} title={m.order_check_updates({}, { locale })}>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M21 12a9 9 0 0 1-15.2 6.5L3 16" />
              <path d="M3 21v-5h5" />
              <path d="M3 12a9 9 0 0 1 15.2-6.5L21 8" />
              <path d="M21 3v5h-5" />
            </svg>
          </button>
        </div>
        <small id="order-refresh-note" class="lv-account-order__refresh-note" data-order-refresh-note aria-live="polite">{m.order_checked_on_open({}, { locale })}</small>
      </div>
    </header>

    <div class="lv-account-order__layout">
      <section class="lv-account-order__items" aria-labelledby="order-items-title">
        <header><div><p>{m.order_details({}, { locale })}</p><h2 id="order-items-title">{m.order_what_you_ordered({}, { locale })}</h2></div><span>{order.itemCount === 1 ? m.account_item_count({ count: order.itemCount }, { locale }) : m.account_item_count_plural({ count: order.itemCount }, { locale })}</span></header>
        <ol>
          {order.items.map((item) => (
            <li>
              <span class="lv-account-order__media">{item.thumbnail && <img src={item.thumbnail} alt="" loading="lazy" />}</span>
              <div><strong>{item.title}</strong>{item.variantTitle && <span>{item.variantTitle}</span>}<small>{m.order_quantity({ count: item.quantity }, { locale })}</small></div>
              <b>{money(item.total ?? (item.unitPrice == null ? null : item.unitPrice * item.quantity))}</b>
            </li>
          ))}
        </ol>
      </section>

      <aside class="lv-account-order__side">
        <section aria-labelledby="order-summary-title">
          <p>{m.order_payment_summary({}, { locale })}</p><h2 id="order-summary-title">{m.order_total({}, { locale })}</h2>
          <dl>
            <div><dt>{m.cart_subtotal({}, { locale })}</dt><dd>{money(order.subtotal)}</dd></div>
            {Boolean(order.discountTotal && order.discountTotal > 0) && <div class="is-saving"><dt>{m.cart_discount({}, { locale })}</dt><dd>−{money(order.discountTotal)}</dd></div>}
            <div><dt>{m.cart_delivery({}, { locale })}</dt><dd>{money(order.shippingTotal)}</dd></div>
            {Boolean(order.taxTotal && order.taxTotal > 0) && <div><dt>{m.cart_tax({}, { locale })}</dt><dd>{money(order.taxTotal)}</dd></div>}
            <div class="is-total"><dt>{m.cart_total({}, { locale })}</dt><dd>{money(order.total)}</dd></div>
          </dl>
        </section>

        <section data-order-live-fulfillment aria-labelledby="order-fulfillment-title">
          <p>{m.order_fulfillment({}, { locale })}</p><h2 id="order-fulfillment-title">{stateLabel}</h2>
          <span>{order.shippingMethod ?? m.order_fulfillment_pending({}, { locale })}</span>
          {order.trackingNumber && <small>{m.order_tracking_number({ number: order.trackingNumber }, { locale })}</small>}
          {order.trackingUrl && <a href={order.trackingUrl} rel="noreferrer" target="_blank">{m.order_open_tracking({}, { locale })} ↗</a>}
        </section>

        {address && !isPickup && (
          <section aria-labelledby="order-address-title">
            <p>{m.order_delivery_details({}, { locale })}</p><h2 id="order-address-title">{m.order_shipping_address({}, { locale })}</h2>
            <address>
              <strong>{[address.firstName, address.lastName].filter(Boolean).join(" ")}</strong>
              <span>{address.address1}</span>{address.address2 && <span>{address.address2}</span>}
              <span>{[address.city, address.province, address.postalCode].filter(Boolean).join(", ")}</span>
              {address.phone && <span>{address.phone}</span>}
            </address>
          </section>
        )}
      </aside>
    </div>

    <footer class="lv-account-order__help"><div><p>{m.account_need_help({}, { locale })}</p><h2>{m.order_help_title({}, { locale })}</h2><span>{m.order_help_reference({ reference }, { locale })}</span></div><ActionButton href="/contact" tone="secondary">{m.account_contact_shop({}, { locale })}</ActionButton></footer>
  </main>
</Layout>

<script>
  const refreshButton = document.querySelector<HTMLButtonElement>("[data-order-refresh]");
  const refreshNote = document.querySelector<HTMLElement>("[data-order-refresh-note]");

  refreshButton?.addEventListener("click", async () => {
    if (refreshButton.disabled) return;

    refreshButton.disabled = true;
    refreshButton.dataset.loading = "true";
    const root = refreshButton.closest<HTMLElement>("[data-checking-label]");
    if (refreshNote) refreshNote.textContent = root?.dataset.checkingLabel || "";

    try {
      const response = await fetch(window.location.href, {
        cache: "no-store",
        credentials: "same-origin",
        headers: { Accept: "text/html" },
      });
      if (!response.ok) throw new Error(`Order refresh failed (${response.status})`);

      const nextDocument = new DOMParser().parseFromString(await response.text(), "text/html");
      const replacements = ["[data-order-live-status]", "[data-order-live-fulfillment]"];

      for (const selector of replacements) {
        const current = document.querySelector<HTMLElement>(selector);
        const next = nextDocument.querySelector<HTMLElement>(selector);
        if (!current || !next) throw new Error(`Missing refreshed order fragment: ${selector}`);
        current.replaceWith(next);
      }

      if (refreshNote) {
        const checkedAt = new Intl.DateTimeFormat(document.documentElement.lang === "am" ? "am-ET" : "en-ET", { hour: "numeric", minute: "2-digit" }).format(new Date());
        refreshNote.textContent = (root?.dataset.updatedLabel || "").replace("__TIME__", checkedAt);
      }
    } catch {
      if (refreshNote) refreshNote.textContent = root?.dataset.refreshFailedLabel || "";
    } finally {
      refreshButton.disabled = false;
      delete refreshButton.dataset.loading;
    }
  });
</script>

<style is:global lang="scss">@use "./styles/account-order.scss";</style>
