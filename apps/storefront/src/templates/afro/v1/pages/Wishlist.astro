---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { parseAfroData } from "../lib";
import "../styles/pages/wishlist.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
}

const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseAfroData(data);
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  deferCartCount={deferCartCount}
  title={`Wishlist — ${tenantName}`}
>
  <main class="wishlist-page" id="main-content">
    <div class="container wishlist-page__wrap">
      <nav class="wishlist-page__crumbs type-body-xs-500" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="wishlist-page__sep" aria-hidden="true">/</span>
        <span class="type-body-xs-700">Wishlist</span>
      </nav>

      <header class="wishlist-page__header">
        <h1 class="wishlist-page__title type-header-3">Wishlist</h1>
        <p class="wishlist-page__count type-body-s-400" id="wishlist-count">
          Saved pieces stay on this device.
        </p>
      </header>

      <div class="wishlist-page__empty empty-state" id="wishlist-empty">
        <span class="empty-state__mark" aria-hidden="true">
          <Icon name="heart" width={18} height={18} />
        </span>
        <div class="empty-state__copy">
          <h2 class="empty-state__title type-header-4">Your wishlist is empty</h2>
          <p class="empty-state__text type-body-s-400">
            Save pieces with the heart. They stay on this device until you are ready for them.
          </p>
        </div>
        <Button text="Browse the shop" href="/products" variant="primary" size="small" />
      </div>

      <div class="wishlist-page__grid" id="wishlist-grid"></div>
    </div>
  </main>
</Layout>

<script>
  import { WISHLIST_REQUEST_EVENT, WISHLIST_UPDATED_EVENT, type WishlistEntry } from "../../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../../lib/browser/localized-path";

  (() => {
    const grid = document.getElementById("wishlist-grid");
    const empty = document.getElementById("wishlist-empty");
    const count = document.getElementById("wishlist-count");
    if (!grid) return;

    let items: WishlistEntry[] = [];

    const money = (amount: number | null, currency: string | null) => {
      if (typeof amount !== "number") return "";
      try {
        return new Intl.NumberFormat(document.documentElement.lang === "am" ? "am-ET" : "en-ET", {
          style: "currency",
          currency: (currency || "ETB").toUpperCase(),
        }).format(amount);
      } catch {
        return `Br. ${amount.toFixed(2)}`;
      }
    };

    const render = () => {
      grid.replaceChildren();
      if (empty) empty.hidden = items.length > 0;
      if (count) {
        count.textContent = items.length === 0
          ? "Saved pieces stay on this device."
          : `${items.length} ${items.length === 1 ? "piece" : "pieces"} saved on this device.`;
      }

      items.forEach((item) => {
        const card = document.createElement("article");
        card.className = "product-card";
        const itemPath = localizeBrowserPath(item.path);

        card.innerHTML = `
          <div class="product-card__media">
            <a href="${itemPath}" class="product-card__img-link" tabindex="-1">
              <div class="img-wrapper">
                ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${item.title}" class="cover" width="262" height="262" />` : ''}
              </div>
            </a>
            <button type="button" class="product-card__wishlist-btn product-card__wishlist-btn--active" aria-label="Remove from wishlist">
              <span class="wishlist-heart" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 14.25l-1.15-1.04C2.76 9.45 0 6.94 0 3.82 0 1.25 2.02 0 4.6 0c1.45 0 2.85.67 3.4 1.74C8.55.67 9.95 0 11.4 0 13.98 0 16 1.25 16 3.82c0 3.12-2.76 5.63-6.85 9.39L8 14.25z"/></svg>
              </span>
            </button>
          </div>
          <div class="product-card__content">
            <div class="product-card__info">
              <h3 class="product-card__title type-body-l">
                <a href="${itemPath}" class="product-card__title-link">${item.title}</a>
              </h3>
            </div>
            <div class="product-card__pricing">
              <span class="product-card__price type-body-xl">${money(item.priceAmount, item.currencyCode)}</span>
            </div>
          </div>
        `;

        card.querySelector(".product-card__wishlist-btn")?.addEventListener("click", () => {
          window.dispatchEvent(
            new CustomEvent(WISHLIST_UPDATED_EVENT, {
              detail: { items: items.filter((saved) => saved.path !== item.path), origin: "page" },
            }),
          );
        });

        grid.appendChild(card);
      });
    };

    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const next = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail?.items;
      if (!Array.isArray(next)) return;
      items = next;
      render();
    });

    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  })();
</script>
