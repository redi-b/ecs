---
import Layout from "./Layout.astro";
import ActionButton from "./ActionButton.astro";
import userIcon from "./icons/user-icon.svg";
import { parseLuviaData } from "./lib";
import type { CustomerAccountView } from "../../../lib/commerce/account";
import { formatMoney } from "../../../lib/money";
import { formatOrderReference } from "../../../lib/order-reference";
interface Props { data: unknown; themeTokens?: unknown; tenantName: string; deferCartCount?: boolean; account?: CustomerAccountView | null; error?: string | null; success?: string | null; initialMode?: "login" | "register"; }
const { data, themeTokens, tenantName, deferCartCount = false, account = null, error = null, success = null, initialMode = "login" } = Astro.props;
const template = parseLuviaData(data);
function formatOrderDate(value: string | null) {
  if (!value) return "Date unavailable";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? "Date unavailable" : new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(date);
}
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title="Account">
  <main class:list={["lv-account", { "is-signed-in": account }]}>
    {account ? (
      <>
        <section class="lv-account__hub">
          <div><span class="lv-account__icon"><img src={userIcon.src} alt="" /></span><div><p>CUSTOMER ACCOUNT</p><h1>Welcome back, {account.customer.firstName || "friend"}.</h1></div></div>
          <div class="lv-account__identity">
            <p>{account.customer.email}</p>
            <form action="/actions/account/logout" method="post"><button type="submit">Sign out</button></form>
          </div>
          <nav class="lv-account__section-links" aria-label="Account sections" role="tablist"><a href="#order-history" role="tab" aria-selected="true" data-account-view="orders">Orders <span>{account.orderCount}</span></a><a href="#saved-addresses" role="tab" aria-selected="false" data-account-view="addresses">Addresses <span>{account.addresses.length}</span></a><a href="#profile-details" role="tab" aria-selected="false" data-account-view="profile">Profile</a></nav>
        </section>
        <section class="lv-account__profile" id="profile-details" data-account-panel="profile" hidden>
          <form class="lv-account__profile-form" action="/actions/account/profile" method="post">
            <header><p>YOUR PROFILE</p><h2>Your details</h2><span>Keep your checkout contact information up to date.</span></header>
            {error && <p class="lv-account__error" role="alert">{error}</p>}
            {success && !success.toLowerCase().includes("address") && <p class="lv-account__success" role="status">{success}</p>}
            <div>
              <label>First name<input name="firstName" value={account.customer.firstName} autocomplete="given-name" required /></label>
              <label>Last name<input name="lastName" value={account.customer.lastName} autocomplete="family-name" required /></label>
            </div>
            <label>Email address<input value={account.customer.email} autocomplete="email" readonly aria-describedby="account-email-help" /></label>
            <small id="account-email-help">Email changes require a verified account-recovery flow and are not available yet.</small>
            <label>Phone number <small>(optional)</small><input name="phone" value={account.customer.phone} autocomplete="tel" inputmode="tel" /></label>
            <ActionButton type="submit">Save details</ActionButton>
          </form>
        </section>
        <section class="lv-account__orders" id="order-history" aria-labelledby="order-history-title" data-account-panel="orders">
          <header><div><p>YOUR ORDERS</p><h2 id="order-history-title">Order history</h2></div><span>{account.orderCount}</span></header>
          {account.orders.length ? (
            <><ol>{account.orders.map((order) => <li><a href={`/account/orders/${encodeURIComponent(order.id)}`} aria-label={`View order ${formatOrderReference(order.id, order.customDisplayId)}`}><div><strong>Order {formatOrderReference(order.id, order.customDisplayId)}</strong><span>{formatOrderDate(order.createdAt)}</span></div><div><strong>{order.total == null ? "Total unavailable" : formatMoney(order.total, order.currencyCode)}</strong><span>{order.itemCount} {order.itemCount === 1 ? "item" : "items"} · {order.status.replaceAll("_", " ")}</span></div><span class="lv-account__order-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
            {account.orderCount > account.orderLimit && <nav class="lv-account__order-pages" aria-label="Order history pages">{account.orderOffset > 0 && <a href={`/account?page=${Math.max(1, account.orderOffset / account.orderLimit)}`}>Previous</a>}<span>Page {Math.floor(account.orderOffset / account.orderLimit) + 1} of {Math.ceil(account.orderCount / account.orderLimit)}</span>{account.orderOffset + account.orderLimit < account.orderCount && <a href={`/account?page=${account.orderOffset / account.orderLimit + 2}`}>Next</a>}</nav>}</>
          ) : (
            <div class="lv-account__empty"><strong>Your first order will appear here.</strong><p>Browse the collection and check out whenever you are ready.</p><a href="/products">Explore products</a></div>
          )}
        </section>
        <section class="lv-account__addresses" id="saved-addresses" aria-labelledby="saved-addresses-title" data-account-panel="addresses" hidden>
          <header><div><p>FASTER CHECKOUT</p><h2 id="saved-addresses-title">Saved addresses</h2><span>Keep delivery details ready without changing any past order.</span></div><span>{account.addresses.length}</span></header>
          {success?.toLowerCase().includes("address") && <p class="lv-account__success" role="status">{success}</p>}
          <div class="lv-account__address-grid">
            {account.addresses.map((address) => <article class="lv-account__address-card"><button class="lv-account__address-toggle" type="button" aria-expanded="false" data-address-toggle><span><strong>{address.addressName || `${address.firstName} ${address.lastName}`}</strong><small>{address.address1}, {address.city}</small></span><span class="lv-account__address-actions">{address.isDefaultShipping && <em>Default</em>}<b data-toggle-label>Edit</b></span></button><form action="/actions/account/address" method="post" hidden><input type="hidden" name="addressId" value={address.id} /><div><label>Label<input name="addressName" value={address.addressName} placeholder="Home" /></label><label>Phone<input name="phone" value={address.phone} autocomplete="tel" inputmode="tel" /></label><label>First name<input name="firstName" value={address.firstName} required autocomplete="given-name" /></label><label>Last name<input name="lastName" value={address.lastName} required autocomplete="family-name" /></label><label class="is-wide">Street address<input name="address1" value={address.address1} required autocomplete="street-address" /></label><label>City<input name="city" value={address.city} required autocomplete="address-level2" /></label><label>Area / region <small>(optional)</small><input name="province" value={address.province} autocomplete="address-level1" /></label></div><label class="lv-account__default-address"><input type="checkbox" name="isDefaultShipping" checked={address.isDefaultShipping} /> Use first at checkout</label><footer><button type="submit" name="intent" value="save">Save changes</button><button type="submit" name="intent" value="delete" class="is-secondary">Remove</button></footer></form></article>)}
            <article class="lv-account__address-card is-new"><button class="lv-account__address-toggle" type="button" aria-expanded="false" data-address-toggle><span><strong>{account.addresses.length ? "Add another address" : "Add your first address"}</strong><small>Save delivery details for a faster checkout.</small></span><b data-toggle-label>Add address</b></button><form action="/actions/account/address" method="post" hidden><div><label>Label<input name="addressName" placeholder="Home" /></label><label>Phone<input name="phone" value={account.customer.phone} autocomplete="tel" inputmode="tel" /></label><label>First name<input name="firstName" value={account.customer.firstName} required autocomplete="given-name" /></label><label>Last name<input name="lastName" value={account.customer.lastName} required autocomplete="family-name" /></label><label class="is-wide">Street address<input name="address1" required autocomplete="street-address" placeholder="Bole, Ayat Road" /></label><label>City<input name="city" value="Addis Ababa" required autocomplete="address-level2" /></label><label>Area / region <small>(optional)</small><input name="province" autocomplete="address-level1" /></label></div><label class="lv-account__default-address"><input type="checkbox" name="isDefaultShipping" checked={account.addresses.length === 0} /> Use first at checkout</label><footer><button type="submit" name="intent" value="save">Save address</button></footer></form></article>
          </div>
        </section>
      </>
    ) : (
      <>
        <section class="lv-account__welcome">
          <span class="lv-account__icon"><img src={userIcon.src} alt="" /></span>
          <p>CUSTOMER ACCOUNT</p>
          <h1>Your orders,<br />kept together.</h1>
          <div><p>Sign in to revisit orders from this shop. You can always browse and check out as a guest.</p><nav class="lv-account__guest-actions"><a href="/products">Continue as guest</a><a href="/contact">Get order help</a></nav></div>
        </section>
        <aside class="lv-account__auth">
          <div class="lv-account__auth-heading">
            <p>CUSTOMER ACCESS</p>
            <h2>{initialMode === "register" ? "Create your account" : "Welcome back"}</h2>
            <span>{initialMode === "register" ? "Keep future orders and details in one place." : "Use the email connected to your orders."}</span>
          </div>
          <nav class="lv-account__auth-tabs" aria-label="Customer account access" role="tablist">
            <a id="account-login-tab" href="/account?mode=login" role="tab" aria-selected={initialMode === "login" ? "true" : "false"} aria-controls="account-login" tabindex={initialMode === "login" ? 0 : -1} data-account-mode="login">Sign in</a>
            <a id="account-register-tab" href="/account?mode=register" role="tab" aria-selected={initialMode === "register" ? "true" : "false"} aria-controls="account-register" tabindex={initialMode === "register" ? 0 : -1} data-account-mode="register">Create account</a>
          </nav>
          {error && <p class="lv-account__error" role="alert" data-account-error>{error}</p>}
          <section class="lv-account__auth-panel" id="account-login" role="tabpanel" aria-labelledby="account-login-tab" hidden={initialMode !== "login"} data-account-panel="login">
            <form action="/actions/account/login" method="post">
              <label>Email address<input name="email" type="email" autocomplete="email" inputmode="email" required /></label>
              <label>
                Password
                <span class="lv-account__password-control">
                  <input name="password" type="password" autocomplete="current-password" minlength="8" required />
                  <button type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6-9.6-6Z"/><circle cx="12" cy="12" r="2.6"/><path class="lv-account__password-slash" d="m4 4 16 16"/></svg>
                  </button>
                </span>
              </label>
              <ActionButton type="submit" fullWidth={true}>Sign in</ActionButton>
            </form>
            <p class="lv-account__auth-switch">New here? <a href="/account?mode=register" data-account-mode="register">Create an account</a></p>
          </section>
          <section class="lv-account__auth-panel" id="account-register" role="tabpanel" aria-labelledby="account-register-tab" hidden={initialMode !== "register"} data-account-panel="register">
            <form action="/actions/account/register" method="post">
              <div class="lv-account__name-fields">
                <label>First name<input name="firstName" autocomplete="given-name" required /></label>
                <label>Last name<input name="lastName" autocomplete="family-name" required /></label>
              </div>
              <label>Email address<input name="email" type="email" autocomplete="email" inputmode="email" required /></label>
              <label>
                Password
                <span class="lv-account__password-control">
                  <input name="password" type="password" autocomplete="new-password" minlength="8" required />
                  <button type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 12s3.5-6 9.6-6 9.6 6 9.6 6-3.5 6-9.6 6-9.6-6-9.6-6Z"/><circle cx="12" cy="12" r="2.6"/><path class="lv-account__password-slash" d="m4 4 16 16"/></svg>
                  </button>
                </span>
                <small>Use at least 8 characters.</small>
              </label>
              <ActionButton type="submit" fullWidth={true}>Create account</ActionButton>
            </form>
            <p class="lv-account__auth-switch">Already have an account? <a href="/account?mode=login" data-account-mode="login">Sign in</a></p>
          </section>
        </aside>
      </>
    )}
  </main>
</Layout>
<style is:global lang="scss">@use "./styles/secondary-pages.scss";</style>
<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const formAnimations = new WeakMap<HTMLFormElement, Animation>();
  const setAddressFormOpen = (form: HTMLFormElement, open: boolean) => {
    formAnimations.get(form)?.cancel();
    if (reducedMotion.matches) { form.hidden = !open; return; }
    if (open) form.hidden = false;
    const startHeight = open ? 0 : form.scrollHeight;
    const endHeight = open ? form.scrollHeight : 0;
    form.style.overflow = "hidden";
    const animation = form.animate(
      {
        height: [`${startHeight}px`, `${endHeight}px`],
        opacity: open ? [0, 1] : [1, 0],
        transform: open ? ["translateY(-6px)", "translateY(0)"] : ["translateY(0)", "translateY(-4px)"],
      },
      { duration: 220, easing: "cubic-bezier(.22,1,.36,1)" },
    );
    formAnimations.set(form, animation);
    animation.addEventListener("finish", () => {
      if (!open) form.hidden = true;
      form.style.removeProperty("overflow");
      formAnimations.delete(form);
    }, { once: true });
    animation.addEventListener("cancel", () => {
      form.style.removeProperty("overflow");
      formAnimations.delete(form);
    }, { once: true });
  };
  document.querySelectorAll<HTMLButtonElement>("[data-address-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const form = button.parentElement?.querySelector<HTMLFormElement>("form");
      if (!form) return;
      const expanded = button.getAttribute("aria-expanded") === "true";
      document.querySelectorAll<HTMLButtonElement>("[data-address-toggle]").forEach((other) => {
        if (other === button) return;
        other.setAttribute("aria-expanded", "false");
        const otherLabel = other.querySelector<HTMLElement>("[data-toggle-label]");
        if (otherLabel) otherLabel.textContent = other.closest(".is-new") ? "Add address" : "Edit";
        const otherForm = other.parentElement?.querySelector<HTMLFormElement>("form");
        if (otherForm && !otherForm.hidden) setAddressFormOpen(otherForm, false);
      });
      button.setAttribute("aria-expanded", String(!expanded));
      const toggleLabel = button.querySelector<HTMLElement>("[data-toggle-label]");
      if (toggleLabel) toggleLabel.textContent = expanded ? (button.closest(".is-new") ? "Add address" : "Edit") : "Close";
      setAddressFormOpen(form, !expanded);
      if (!expanded) form.querySelector<HTMLInputElement>("input:not([type='hidden'])")?.focus();
    });
  });

  const accountViews = document.querySelectorAll<HTMLElement>("[data-account-view]");
  const accountPanels = document.querySelectorAll<HTMLElement>("[data-account-panel]");
  const showAccountView = (view: string, updateHash = false) => {
    accountViews.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.accountView === view)));
    accountPanels.forEach((panel) => { panel.hidden = panel.dataset.accountPanel !== view; });
    if (updateHash) history.replaceState(null, "", view === "orders" ? "#order-history" : view === "addresses" ? "#saved-addresses" : "#profile-details");
  };
  accountViews.forEach((tab) => tab.addEventListener("click", (event) => {
    event.preventDefault();
    showAccountView(tab.dataset.accountView || "orders", true);
  }));
  if (location.hash === "#saved-addresses") showAccountView("addresses");
  else if (location.hash === "#profile-details") showAccountView("profile");

  const authRoot = document.querySelector<HTMLElement>(".lv-account__auth");

  if (authRoot) {
    const setMode = (mode: "login" | "register", focus = false) => {
      const activeEmail = authRoot.querySelector<HTMLInputElement>("[data-account-panel]:not([hidden]) input[type='email']")?.value ?? "";
      authRoot.querySelectorAll<HTMLElement>("[data-account-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.accountPanel !== mode;
      });
      authRoot.querySelectorAll<HTMLElement>("[role='tab']").forEach((tab) => {
        const selected = tab.dataset.accountMode === mode;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      const heading = authRoot.querySelector<HTMLElement>(".lv-account__auth-heading h2");
      const description = authRoot.querySelector<HTMLElement>(".lv-account__auth-heading span");
      if (heading) heading.textContent = mode === "register" ? "Create your account" : "Welcome back";
      if (description) description.textContent = mode === "register" ? "Keep future orders and details in one place." : "Use the email connected to your orders.";
      authRoot.querySelector<HTMLElement>("[data-account-error]")?.remove();
      const nextEmail = authRoot.querySelector<HTMLInputElement>(`[data-account-panel='${mode}'] input[type='email']`);
      if (nextEmail && !nextEmail.value && activeEmail) nextEmail.value = activeEmail;
      if (focus) authRoot.querySelector<HTMLInputElement>(`[data-account-panel='${mode}'] input`)?.focus();
      window.history.replaceState({}, "", mode === "register" ? "/account?mode=register" : "/account");
    };

    authRoot.querySelectorAll<HTMLAnchorElement>("[data-account-mode]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        setMode(link.dataset.accountMode === "register" ? "register" : "login", true);
      });
    });

    authRoot.querySelectorAll<HTMLAnchorElement>("[role='tab']").forEach((tab) => {
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const mode = tab.dataset.accountMode === "register" ? "login" : "register";
        setMode(mode);
        authRoot.querySelector<HTMLElement>(`[role='tab'][data-account-mode='${mode}']`)?.focus();
      });
    });

    authRoot.querySelectorAll<HTMLButtonElement>("[data-password-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const input = button.parentElement?.querySelector<HTMLInputElement>("input");
        if (!input) return;
        const visible = input.type === "text";
        input.type = visible ? "password" : "text";
        button.setAttribute("aria-pressed", String(!visible));
        button.setAttribute("aria-label", visible ? "Show password" : "Hide password");
        input.focus({ preventScroll: true });
      });
    });

    authRoot.querySelectorAll<HTMLFormElement>("form").forEach((form) => {
      form.addEventListener("invalid", (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement)) return;
        field.setAttribute("aria-invalid", "true");
        const owner = field.closest("label");
        if (!owner) return;
        let message = owner.querySelector<HTMLElement>("[data-field-error]");
        if (!message) {
          message = document.createElement("small");
          message.dataset.fieldError = "";
          message.className = "lv-account__field-error";
          message.setAttribute("role", "alert");
          owner.append(message);
        }
        message.textContent = field.validationMessage;
      }, true);
      form.querySelectorAll<HTMLInputElement>("input").forEach((field) => {
        field.addEventListener("input", () => {
          field.removeAttribute("aria-invalid");
          field.closest("label")?.querySelector("[data-field-error]")?.remove();
        });
      });
      form.addEventListener("submit", async (event) => {
        if (!form.checkValidity()) return;
        event.preventDefault();
        form.setAttribute("aria-busy", "true");
        const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (!button) return;
        const originalText = form.action.endsWith("/register") ? "Create account" : "Sign in";
        button.disabled = true;
        const text = button.querySelector<HTMLElement>(".lv-button__text");
        if (text) text.textContent = form.action.endsWith("/register") ? "Creating account…" : "Signing in…";
        authRoot.querySelector<HTMLElement>("[data-account-error]")?.remove();
        try {
          const response = await fetch(form.action, {
            body: new FormData(form),
            headers: { accept: "application/json" },
            method: "POST",
          });
          const result = await response.json().catch(() => ({}));
          if (response.ok && typeof result.redirectTo === "string") {
            window.location.assign(result.redirectTo);
            return;
          }
          const message = document.createElement("p");
          message.className = "lv-account__error";
          message.dataset.accountError = "";
          message.setAttribute("role", "alert");
          message.textContent = typeof result.message === "string" ? result.message : "Something went wrong. Please try again.";
          authRoot.querySelector(".lv-account__auth-tabs")?.after(message);
        } catch {
          const message = document.createElement("p");
          message.className = "lv-account__error";
          message.dataset.accountError = "";
          message.setAttribute("role", "alert");
          message.textContent = "We could not reach the shop. Check your connection and try again.";
          authRoot.querySelector(".lv-account__auth-tabs")?.after(message);
        } finally {
          form.removeAttribute("aria-busy");
          button.disabled = false;
          if (text) text.textContent = originalText;
        }
      });
    });
  }
</script>
