---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { getImage } from "astro:assets";

type PictureSource = ImageMetadata | string;
type ImageFormat = "avif" | "png" | "jpg" | "jpeg" | "webp" | "svg";

interface SourceEntry {
  media: string;
  src: PictureSource;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  format?: ImageFormat;
  quality?: number;
}

interface Props {
  sources: SourceEntry[];
  alt: string;
  class?: string;
  pictureClass?: string;
  pictureAttributes?: HTMLAttributes<"picture">;
  format?: ImageFormat;
  quality?: number;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "auto" | "low" | "high";
}

const {
  sources,
  alt,
  class: className,
  pictureClass = "responsive-img",
  pictureAttributes = {},
  format = "webp",
  quality,
  widths,
  sizes,
  loading = "lazy",
  decoding = "async",
  fetchpriority = "auto",
  ...rest
} = Astro.props;

if (sources.length === 0) {
  throw new Error("ResponsivePicture requires at least one source.");
}

const buildSrcset = async (entry: SourceEntry) => {
  const entryWidths = entry.widths ?? widths;
  const isSvg = typeof entry.src !== "string" && entry.src.format === "svg";
  const entryFormat = entry.format ?? (isSvg ? "svg" : format);
  const entryQuality = entry.quality ?? quality;

  if (typeof entry.src === "string") {
    return {
      media: entry.media,
      src: entry.src,
      srcset: entry.src,
      sizes: entry.sizes ?? sizes,
      width: entry.width ?? 1,
      height: entry.height ?? 1,
    };
  }

  if (entryWidths?.length) {
    const variants = await Promise.all(
      entryWidths.map(async (targetWidth) => {
        const image = await getImage({
          src: entry.src,
          format: entryFormat,
          quality: entryQuality,
          width: targetWidth,
        });

        return {
          src: image.src,
          descriptor: `${image.attributes.width}w`,
          width: image.attributes.width,
          height: image.attributes.height,
        };
      })
    );

    const fallbackVariant = variants[variants.length - 1];

    return {
      media: entry.media,
      src: fallbackVariant.src,
      srcset: variants
        .map((variant) => `${variant.src} ${variant.descriptor}`)
        .join(", "),
      sizes: entry.sizes ?? sizes,
      width: fallbackVariant.width,
      height: fallbackVariant.height,
    };
  }

  const image = await getImage({
    src: entry.src,
    format: entryFormat,
    quality: entryQuality,
    width: entry.width,
    height: entry.height,
  });

  return {
    media: entry.media,
    src: image.src,
    srcset: image.src,
    sizes: entry.sizes ?? sizes,
    width: image.attributes.width,
    height: image.attributes.height,
  };
};

const processedSources = await Promise.all(
  sources.map((entry) => buildSrcset(entry))
);

const fallbackSource = processedSources[processedSources.length - 1];
---

<picture class={pictureClass} {...pictureAttributes}>
  {
    processedSources
      .slice(0, -1)
      .map((source) => (
        <source
          media={source.media}
          srcset={source.srcset}
          sizes={source.sizes}
        />
      ))
  }

  <img
    class:list={[className]}
    src={fallbackSource.src}
    srcset={fallbackSource.srcset}
    sizes={fallbackSource.sizes}
    alt={alt}
    width={fallbackSource.width}
    height={fallbackSource.height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    {...rest}
  />
</picture>
