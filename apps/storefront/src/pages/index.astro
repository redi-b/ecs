---
import StorefrontFailure from "../components/shell/StorefrontFailure.astro";
import { loadHomePageModel } from "../lib/home-page";
import { applyCatalogCache, CATALOG_CACHE_TTL } from "../lib/http-cache";
import { loadPageContext } from "../lib/page-context";
import { buildStorefrontSeo } from "../lib/seo";
import { buildStorefrontStructuredData } from "../lib/structured-data";
import { getStorefrontRenderer } from "../templates/registry";

const ctx = await loadPageContext(Astro.request, { skipCart: true });

const homeModel = ctx.ok ? await loadHomePageModel(ctx) : null;

const renderer = ctx.ok ? getStorefrontRenderer(ctx.config.storefront.templateKey) : undefined;
const Home = renderer?.Home as ((props: Record<string, unknown>) => unknown) | undefined;
const seo = ctx.ok
  ? buildStorefrontSeo({
      path: "/",
      publicOrigin: ctx.publicOrigin,
      tenantName: ctx.config.storefront.seo.title ?? ctx.config.tenant.name,
      description: ctx.config.storefront.seo.description,
      imageUrl: ctx.config.storefront.seo.socialImageUrl,
    })
  : null;
const structuredData =
  ctx.ok && seo ? buildStorefrontStructuredData({ seo, tenantName: ctx.config.tenant.name }) : null;

if (!ctx.ok) {
  Astro.response.status = ctx.status;
} else if (!Home) {
  Astro.response.status = 503;
} else {
  // Public catalog HTML — cart badge deferred (Layout deferCartCount).
  applyCatalogCache(Astro.cache, {
    tenantId: ctx.config.tenant.id,
    publishedRevisionId: ctx.config.storefront.publishedRevisionId,
    templateKey: ctx.config.storefront.templateKey,
    maxAge: CATALOG_CACHE_TTL.home.maxAge,
    swr: CATALOG_CACHE_TTL.home.swr,
  });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{ctx.ok ? (ctx.config.storefront.seo.title ?? ctx.config.tenant.name) : "Shop unavailable"}</title>
  </head>
  <body>
    {
      !ctx.ok ? (
        <StorefrontFailure actionHref="/" actionLabel="Try again" description={ctx.message} eyebrow="Shop paused" title="This shop is temporarily unavailable" />
      ) : Home ? (
        <Home
          data={ctx.config.storefront.data}
          productsResult={homeModel?.productsResult ?? { products: [] }}
          collectionProducts={homeModel?.collectionProducts ?? []}
          collections={homeModel?.collections ?? []}
          categories={homeModel?.categories ?? []}
          tenantName={ctx.config.tenant.name}
          themeTokens={ctx.config.storefront.themeTokens}
          platformApiBaseUrl={ctx.platformApiBaseUrl}
          requestHost={ctx.requestHost}
          deferCartCount={true}
          seo={seo}
          structuredData={structuredData}
        />
      ) : (
        <StorefrontFailure actionHref="/" actionLabel="Try again" description="The shop could not finish loading. Please try again shortly." eyebrow="Shop paused" title="This shop is temporarily unavailable" />
      )
    }
  </body>
</html>
