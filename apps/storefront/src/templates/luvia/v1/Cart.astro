---
import { resolveStoreCartSummary } from "../../../lib/commerce/cart-summary";
import type { StoreCart } from "../../../lib/commerce/types";
import { formatMoney } from "../../../lib/money";
import ProductMediaPlaceholder from "../../../components/media/ProductMediaPlaceholder.astro";
import DiscountCode from "./components/DiscountCode.astro";
import cartIcon from "./icons/cart-icon.svg";
import chevronIcon from "./icons/chevron-icon.svg";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import { resolveTemplateVoiceMessage } from "../../../lib/template-voice";
import * as m from "../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  cart: StoreCart | null;
  error?: string | null;
  discountError?: string | null;
  demoMode?: boolean;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  cart,
  error,
  discountError,
  demoMode = false,
} = Astro.props;
const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const continueShoppingLabel = resolveTemplateVoiceMessage({ fallback: m.action_continue_shopping({}, { locale }), locale, messageId: "action_continue_shopping", templateKey: "luvia.v1" });
const items = cart?.items ?? [];
const itemCount = items.reduce((sum, item) => sum + item.quantity, 0);
const summary = resolveStoreCartSummary(cart);
const clientMessages = {
  applied: m.cart_discount_applied({}, { locale }),
  applyingDiscount: m.cart_discount_applying({}, { locale }),
  browseProducts: m.action_browse_products({}, { locale }),
  cartEmpty: m.cart_empty({}, { locale }),
  cartEmptyHelp: m.cart_empty_help({}, { locale }),
  cartUpdated: m.cart_updated({}, { locale }),
  deliveryAtCheckout: m.cart_delivery_at_checkout({}, { locale }),
  discountRemoved: m.cart_discount_removed({}, { locale }),
  discountUpdated: m.cart_discount_updated({}, { locale }),
  itemCount: m.cart_item_count({ count: 999 }, { locale }).replace("999", "__COUNT__"),
  readyCount: m.cart_ready_count({ count: 999 }, { locale }).replace("999", "__COUNT__"),
  remove: m.action_remove({}, { locale }),
  removeDiscount: m.cart_discount_remove({ code: "__CODE__" }, { locale }),
  removingDiscount: m.cart_discount_removing({}, { locale }),
  removingItem: m.cart_item_removing({}, { locale }),
  updateFailed: m.cart_update_failed({}, { locale }),
  updating: m.cart_updating({}, { locale }),
};
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} demoMode={demoMode} title={m.cart_title({}, { locale })}>
  <main class="lv-cart-page" data-cart-page>
    <nav class="lv-cart-page__breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/">{m.nav_home({}, { locale })}</a><img src={chevronIcon.src} alt="" /><a href="/products">{m.nav_shop({}, { locale })}</a><img src={chevronIcon.src} alt="" /><span>{m.nav_cart({}, { locale })}</span></nav>
    <header class="lv-cart-page__heading"><div><span>{m.cart_selection_eyebrow({}, { locale })}</span><h1>{m.cart_title({}, { locale })}</h1><p data-page-item-count>{m.cart_ready_count({ count: itemCount }, { locale })}</p></div></header>
    {error && <p class="lv-cart-page__error" role="alert">{error}</p>}
    <p class="lv-cart-page__live" data-cart-page-status aria-live="polite"></p>

    {items.length === 0 ? <section class="lv-cart-page__empty" data-cart-page-empty><span><img src={cartIcon.src} alt="" /></span><h2>{m.cart_empty({}, { locale })}</h2><p>{m.cart_empty_help({}, { locale })}</p><a href="/products">{m.action_browse_products({}, { locale })}</a></section> : <div class="lv-cart-page__layout" data-cart-page-layout>
      <section class="lv-cart-lines" aria-label={m.cart_items_label({}, { locale })} data-cart-page-lines>
        {items.map((item) => <article class="lv-cart-line" data-cart-line={item.id}>
          <a class="lv-cart-line__media" href={item.productHandle ? `/products/${encodeURIComponent(item.productHandle)}` : "/products"}>{(item.imageUrl || item.thumbnail) ? <img src={item.imageUrl || item.thumbnail} alt="" /> : <ProductMediaPlaceholder label={m.catalog_no_image({}, { locale })} />}</a>
          <div class="lv-cart-line__copy"><a href={item.productHandle ? `/products/${encodeURIComponent(item.productHandle)}` : "/products"}>{item.title ?? m.catalog_product_fallback({}, { locale })}</a>{item.variantTitle && <span>{item.variantTitle}</span>}<small>{formatMoney(item.unitPrice, cart?.currencyCode, locale)} {m.cart_each({}, { locale })}</small></div>
          <div class="lv-cart-line__quantity" aria-label={m.cart_quantity_for({ item: item.title ?? m.cart_item_fallback({}, { locale }) }, { locale })}>
            <form method="post" action="/actions/cart/update" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><input type="hidden" name="quantity" value={Math.max(1, item.quantity - 1)} /><button type="submit" aria-label={m.action_decrease_quantity({}, { locale })} disabled={item.quantity <= 1}>−</button></form>
            <span data-line-quantity>{item.quantity}</span>
            <form method="post" action="/actions/cart/update" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><input type="hidden" name="quantity" value={item.quantity + 1} /><button type="submit" aria-label={m.action_increase_quantity({}, { locale })}>+</button></form>
          </div>
          <strong data-line-total>{formatMoney(item.total ?? item.unitPrice, cart?.currencyCode, locale)}</strong>
          <form method="post" action="/actions/cart/remove" class="lv-cart-line__remove" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><button type="submit">{m.action_remove({}, { locale })}</button></form>
        </article>)}
        <a class="lv-cart-page__continue" href="/products">← {continueShoppingLabel}</a>
      </section>

      <aside class="lv-cart-summary" aria-label={m.cart_order_summary({}, { locale })}>
        <header><h2>{m.cart_order_summary({}, { locale })}</h2><span data-summary-count>{m.cart_item_count({ count: itemCount }, { locale })}</span></header>
        <DiscountCode appliedCodes={summary.appliedCodes} idPrefix="cart" error={discountError} />
        <dl><div><dt>{m.cart_subtotal({}, { locale })}</dt><dd data-summary-subtotal>{formatMoney(summary.subtotal, cart?.currencyCode, locale)}</dd></div><div data-summary-discount hidden={!summary.savingsTotal}><dt>{m.cart_discount({}, { locale })}</dt><dd data-summary-discount-value>−{formatMoney(summary.savingsTotal, cart?.currencyCode, locale)}</dd></div><div><dt>{m.cart_delivery({}, { locale })}</dt><dd data-summary-shipping>{summary.shippingTotal != null && summary.shippingTotal > 0 ? formatMoney(summary.shippingTotal, cart?.currencyCode, locale) : m.cart_delivery_at_checkout({}, { locale })}</dd></div>{summary.taxTotal != null && summary.taxTotal > 0 && <div data-summary-tax><dt>{m.cart_tax({}, { locale })}</dt><dd>{formatMoney(summary.taxTotal, cart?.currencyCode, locale)}</dd></div>}<div><dt>{m.cart_total({}, { locale })}</dt><dd data-summary-total>{formatMoney(summary.total, cart?.currencyCode, locale)}</dd></div></dl>
        <p>{m.cart_delivery_note({}, { locale })}</p>
        <a href="/checkout">{m.action_checkout({}, { locale })}</a><small>{m.cart_saved_note({}, { locale })}</small>
      </aside>
    </div>}
    <script is:inline type="application/json" id="luvia-cart-state" set:html={JSON.stringify(cart)} />
  </main>
</Layout>

<script is:inline define:vars={{ clientMessages, locale }}>
  (() => {
    const root = document.querySelector("[data-cart-page]"); if (!root) return;
    const status = root.querySelector("[data-cart-page-status]");
    const text = (template, values) => Object.entries(values).reduce((result, [key, value]) => result.replaceAll(`__${key}__`, String(value)), template);
    const money = (amount, currency) => { if (amount == null) return "—"; try { return new Intl.NumberFormat(locale === "am" ? "am-ET" : "en-ET", { style: "currency", currency: (currency || "ETB").toUpperCase() }).format(amount); } catch { return String(amount); } };
    const renderPromotions = (cart) => { const target = root.querySelector("[data-applied-promotions]"); if (!target) return; target.replaceChildren(); (cart.promotions || []).filter((promotion) => !promotion.isAutomatic && promotion.code).forEach((promotion) => { const form = document.createElement("form"); form.method = "post"; form.action = "/actions/cart/promotion"; form.dataset.cartPromotionForm = ""; const intent = document.createElement("input"); intent.type = "hidden"; intent.name = "intent"; intent.value = "remove"; const code = document.createElement("input"); code.type = "hidden"; code.name = "code"; code.value = promotion.code; const label = document.createElement("span"); const strong = document.createElement("b"); strong.textContent = promotion.code; const small = document.createElement("small"); small.textContent = clientMessages.applied; label.append(strong, small); const button = document.createElement("button"); button.type = "submit"; button.textContent = clientMessages.remove; button.setAttribute("aria-label", text(clientMessages.removeDiscount, { CODE: promotion.code })); form.append(intent, code, label, button); target.append(form); }); };
    const sync = (result) => {
      const cart = result.cart; const items = Array.isArray(cart.items) ? cart.items : []; const count = items.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
      root.querySelectorAll("[data-cart-line]").forEach((line) => { const item = items.find((candidate) => candidate.id === line.dataset.cartLine); if (!item) { line.remove(); return; } line.removeAttribute("data-updating"); const qty = line.querySelector("[data-line-quantity]"); const total = line.querySelector("[data-line-total]"); if (qty) qty.textContent = String(item.quantity); if (total) total.textContent = money(item.total ?? item.unitPrice, cart.currencyCode); const forms = [...line.querySelectorAll('form[action="/actions/cart/update"]')]; const decrease = forms[0]?.querySelector('input[name="quantity"]'); const increase = forms[1]?.querySelector('input[name="quantity"]'); if (decrease) decrease.value = String(Math.max(1, item.quantity - 1)); if (increase) increase.value = String(item.quantity + 1); const decreaseButton = forms[0]?.querySelector("button"); if (decreaseButton) decreaseButton.disabled = item.quantity <= 1; });
      const countNodes = root.querySelectorAll("[data-page-item-count],[data-summary-count]"); countNodes.forEach((node) => node.textContent = text(node.hasAttribute("data-page-item-count") ? clientMessages.readyCount : clientMessages.itemCount, { COUNT: count }));
      const subtotal = root.querySelector("[data-summary-subtotal]"); const total = root.querySelector("[data-summary-total]"); const shipping = root.querySelector("[data-summary-shipping]"); const discountRow = root.querySelector("[data-summary-discount]"); const discountValue = root.querySelector("[data-summary-discount-value]"); const savings = Math.max(0, cart.discountTotal != null ? Number(cart.discountTotal) : Number(cart.itemDiscountTotal || 0) + Number(cart.shippingDiscountTotal || 0)); if (subtotal) subtotal.textContent = money(cart.subtotal ?? cart.itemSubtotal ?? cart.itemTotal ?? cart.total, cart.currencyCode); if (total) total.textContent = money(cart.total ?? cart.itemTotal, cart.currencyCode); if (shipping) shipping.textContent = cart.shippingTotal > 0 ? money(cart.shippingTotal, cart.currencyCode) : clientMessages.deliveryAtCheckout; if (discountRow) discountRow.hidden = savings <= 0; if (discountValue) discountValue.textContent = `−${money(savings, cart.currencyCode)}`; renderPromotions(cart);
      if (!items.length) { const layout = root.querySelector("[data-cart-page-layout]"); layout?.remove(); const empty = document.createElement("section"); empty.className = "lv-cart-page__empty"; const title = document.createElement("h2"); title.textContent = clientMessages.cartEmpty; const copy = document.createElement("p"); copy.textContent = clientMessages.cartEmptyHelp; const link = document.createElement("a"); link.href = "/products"; link.textContent = clientMessages.browseProducts; empty.append(title, copy, link); root.append(empty); }
      window.dispatchEvent(new CustomEvent("ecs:cart-updated", { detail: { ...result, openDrawer: false } }));
    };
    root.addEventListener("submit", async (event) => {
      const form = event.target; if (!(form instanceof HTMLFormElement) || !form.matches("[data-cart-page-form],[data-cart-promotion-form]")) return; event.preventDefault(); const line = form.closest("[data-cart-line]"); const isPromotion = form.matches("[data-cart-promotion-form]"); const feedback = isPromotion ? form.closest("[data-discount-code]")?.querySelector("[data-discount-status]") : status; line?.setAttribute("data-updating", ""); if (feedback) { feedback.textContent = isPromotion ? (new FormData(form).get("intent") === "remove" ? clientMessages.removingDiscount : clientMessages.applyingDiscount) : form.action.endsWith("/remove") ? clientMessages.removingItem : clientMessages.updating; feedback.classList.remove("is-error"); }
      try { const response = await fetch(form.action, { method: "POST", body: new FormData(form), credentials: "same-origin", headers: { Accept: "application/json" } }); const result = await response.json(); if (!response.ok || !result.ok) throw new Error(clientMessages.updateFailed); sync(result); if (isPromotion && new FormData(form).get("intent") !== "remove") form.reset(); if (feedback) feedback.textContent = isPromotion ? clientMessages.discountUpdated : clientMessages.cartUpdated; setTimeout(() => { if (feedback?.textContent === clientMessages.cartUpdated || feedback?.textContent === clientMessages.discountUpdated) feedback.textContent = ""; }, 1200); }
      catch (cause) { line?.removeAttribute("data-updating"); if (feedback) { feedback.textContent = cause instanceof Error ? cause.message : clientMessages.updateFailed; feedback.classList.add("is-error"); } }
    });
  })();
</script>
<style is:global lang="scss">@use "./styles/cart.scss"; @use "./styles/discount-code.scss";</style>
