---
import "../styles/pages/cart.scss";
import { Icon } from "astro-icon/components";
import { resolveStoreCartSummary } from "../../../../lib/commerce/cart-summary";
import type { StoreCart } from "../../../../lib/commerce/types";
import { formatMoney } from "../../../../lib/money";
import DiscountCode from "../components/DiscountCode.astro";
import CartItem from "../components/CartItem.astro";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import { resolveTemplateVoiceMessage } from "../../../../lib/template-voice";
import * as m from "../../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  cart: StoreCart | null;
  error?: string | null;
  discountError?: string | null;
  demoMode?: boolean;
}

const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  cart,
  error,
  discountError,
  demoMode = false,
} = Astro.props;

const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";

const continueShoppingLabel = resolveTemplateVoiceMessage({
  fallback: m.action_continue_shopping({}, { locale }),
  locale,
  messageId: "action_continue_shopping",
  templateKey: "luvia.v1",
});

const items = cart?.items ?? [];
const itemCount = items.reduce((sum, item) => sum + item.quantity, 0);
const summary = resolveStoreCartSummary(cart);

const clientMessages = {
  applied: m.cart_discount_applied({}, { locale }),
  applyingDiscount: m.cart_discount_applying({}, { locale }),
  browseProducts: m.action_browse_products({}, { locale }),
  cartEmpty: m.cart_empty({}, { locale }),
  cartEmptyHelp: m.cart_empty_help({}, { locale }),
  cartUpdated: m.cart_updated({}, { locale }),
  deliveryAtCheckout: m.cart_delivery_at_checkout({}, { locale }),
  discountRemoved: m.cart_discount_removed({}, { locale }),
  discountUpdated: m.cart_discount_updated({}, { locale }),
  itemCount: m.cart_item_count({ count: 999 }, { locale }).replace("999", "__COUNT__"),
  readyCount: m.cart_ready_count({ count: 999 }, { locale }).replace("999", "__COUNT__"),
  remove: m.action_remove({}, { locale }),
  removeDiscount: m.cart_discount_remove({ code: "__CODE__" }, { locale }),
  removingDiscount: m.cart_discount_removing({}, { locale }),
  removingItem: m.cart_item_removing({}, { locale }),
  updateFailed: m.cart_update_failed({}, { locale }),
  updating: m.cart_updating({}, { locale }),
};
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  cartCount={cartCount}
  demoMode={demoMode}
  title={m.cart_title({}, { locale })}
>
  <main class="cart-page" data-cart-page data-client-messages={JSON.stringify(clientMessages)}>
    <nav
      class="cart-page__breadcrumb container type-body-s-400"
      aria-label={m.breadcrumb_label({}, { locale })}
    >
      <a href="/" class="type-body-s-400">{m.nav_home({}, { locale })}</a>
      <Icon name="chevron" />
      <a href="/products" class="type-body-s-400">{m.nav_shop({}, { locale })}</a>
      <Icon name="chevron" />
      <span class="type-body-s-400">{m.nav_cart({}, { locale })}</span>
    </nav>

    <header class="cart-page__heading container">
      <div>
        <span class="type-body-xs">{m.cart_selection_eyebrow({}, { locale })}</span>
        <h1 class="type-heading-1">{m.cart_title({}, { locale })}</h1>
        <p class="type-body-400" data-page-item-count>
          {m.cart_ready_count({ count: itemCount }, { locale })}
        </p>
      </div>
    </header>

    {
      error && (
        <p class="cart-page__error container type-body-s-500" role="alert">
          {error}
        </p>
      )
    }

    {
      items.length === 0 ? (
        <section class="cart-page__empty empty-state container" data-cart-page-empty>
          <span class="empty-state__mark">
            <Icon name="cart" />
          </span>
          <div class="empty-state__copy">
            <h2 class="empty-state__title type-heading-3">{m.cart_empty({}, { locale })}</h2>
            <p class="empty-state__text type-body-400">{m.cart_empty_help({}, { locale })}</p>
          </div>
          <a class="empty-state__action type-body-500" href="/products">
            {m.action_browse_products({}, { locale })}
          </a>
        </section>
      ) : (
        <div class="cart-page__layout container" data-cart-page-layout>
          <section
            class="cart-lines"
            aria-label={m.cart_items_label({}, { locale })}
            data-cart-page-lines
          >
            {items.map((item) => (
              <CartItem item={item} currencyCode={cart?.currencyCode} locale={locale} />
            ))}
            <a class="cart-page__continue type-body-s-500" href="/products">
              ← {continueShoppingLabel}
            </a>
          </section>

          <aside class="cart-summary" aria-label={m.cart_order_summary({}, { locale })}>
            <header>
              <h2 class="type-heading-3">{m.cart_order_summary({}, { locale })}</h2>
              <span class="type-body-xs" data-summary-count>
                {m.cart_item_count({ count: itemCount }, { locale })}
              </span>
            </header>
            <DiscountCode
              appliedCodes={summary.appliedCodes}
              idPrefix="cart"
              error={discountError}
            />
            <dl>
              <div>
                <dt class="type-body-s-400">{m.cart_delivery({}, { locale })}</dt>
                <dd class="type-body-s-500" data-summary-shipping>
                  {summary.shippingTotal != null && summary.shippingTotal > 0
                    ? formatMoney(summary.shippingTotal, cart?.currencyCode, locale)
                    : m.cart_delivery_at_checkout({}, { locale })}
                </dd>
              </div>
              {summary.taxTotal != null && summary.taxTotal > 0 && (
                <div data-summary-tax>
                  <dt class="type-body-s-400">{m.cart_tax({}, { locale })}</dt>
                  <dd class="type-body-s-500">
                    {formatMoney(summary.taxTotal, cart?.currencyCode, locale)}
                  </dd>
                </div>
              )}
              <div>
                <dt class="type-body-l-500">{m.cart_total({}, { locale })}</dt>
                <dd class="type-body-xl" data-summary-total>
                  {formatMoney(summary.total, cart?.currencyCode, locale)}
                </dd>
              </div>
            </dl>
            <p class="type-body-xs">{m.cart_delivery_note({}, { locale })}</p>
            <a class="type-body-500" href="/checkout">
              {m.action_checkout({}, { locale })}
            </a>
            <small class="type-body-xs">{m.cart_saved_note({}, { locale })}</small>
          </aside>
        </div>
      )
    }

    <script
      is:inline
      type="application/json"
      id="luvia-cart-state"
      set:html={JSON.stringify(cart)}
    />
  </main>
</Layout>

<script>
  import { initLuviaCartPage } from "../scripts/client";
  initLuviaCartPage();
</script>
