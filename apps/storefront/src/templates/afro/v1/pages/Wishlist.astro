---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { Icon } from "astro-icon/components";
import { parseAfroData } from "../lib";
import "../styles/pages/wishlist.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
}

const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseAfroData(data);
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  deferCartCount={deferCartCount}
  title={`Wishlist — ${tenantName}`}
>
  <main class="wishlist-page" id="main-content">
    <div class="container wishlist-page__wrap">
      <nav class="wishlist-page__crumbs type-body-xs-500" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="wishlist-page__sep" aria-hidden="true">/</span>
        <span class="type-body-xs-700">Wishlist</span>
      </nav>

      <header class="wishlist-page__header">
        <h1 class="wishlist-page__title type-header-3">Wishlist</h1>
        <p class="wishlist-page__count type-body-s-400" id="wishlist-count">
          Saved pieces stay on this device.
        </p>
      </header>

      <div class="wishlist-page__empty empty-state" id="wishlist-empty">
        <span class="empty-state__mark" aria-hidden="true">
          <Icon name="heart" width={18} height={18} />
        </span>
        <div class="empty-state__copy">
          <h2 class="empty-state__title type-header-4">Your wishlist is empty</h2>
          <p class="empty-state__text type-body-s-400">
            Save pieces with the heart while shopping to keep them here.
          </p>
        </div>
        <Button text="Browse the shop" href="/products" variant="primary" size="small" />
      </div>

      <div class="wishlist-page__grid" id="wishlist-grid"></div>
    </div>
  </main>
</Layout>

<script>
  import {
    WISHLIST_REQUEST_EVENT,
    WISHLIST_UPDATED_EVENT,
    type WishlistEntry,
  } from "../../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../../lib/browser/localized-path";

  (() => {
    const grid = document.getElementById("wishlist-grid");
    const empty = document.getElementById("wishlist-empty");
    const count = document.getElementById("wishlist-count");
    if (!grid) return;

    let items: WishlistEntry[] = [];

    const locale = document.documentElement.lang === "am" ? "am-ET" : "en-ET";
    const money = (amount: number | null, currency: string | null) => {
      if (typeof amount !== "number") return "";
      try {
        return new Intl.NumberFormat(locale, {
          style: "currency",
          currency: (currency || "ETB").toUpperCase(),
        }).format(amount);
      } catch {
        return `Br. ${amount.toFixed(2)}`;
      }
    };

    const escapeHtml = (str: string) =>
      str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const render = (savedItems: readonly WishlistEntry[]) => {
      grid.replaceChildren();
      const hasItems = savedItems.length > 0;
      if (empty) empty.hidden = hasItems;
      grid.hidden = !hasItems;
      if (count) {
        count.textContent = !hasItems
          ? "Saved pieces stay on this device."
          : `${savedItems.length} ${savedItems.length === 1 ? "piece" : "pieces"} saved.`;
      }

      if (!hasItems) return;

      savedItems.forEach((item) => {
        const card = document.createElement("article");
        card.className = "product-card";
        card.dataset.productId = item.path;
        const itemPath = localizeBrowserPath(item.path);
        const handle = item.path.replace(/^\/products\//, "").replace(/\/$/, "");

        card.innerHTML = `
          <div class="product-card__media">
            <a href="${itemPath}" class="product-card__img-link" tabindex="-1" aria-hidden="true">
              <div class="img-wrapper">
                ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${escapeHtml(item.title)}" class="cover" width="262" height="262" loading="lazy" decoding="async" />` : `<div class="product-media-placeholder">${escapeHtml(item.title)}</div>`}
              </div>
            </a>
            <button
              type="button"
              class="product-card__wishlist-btn product-card__wishlist-btn--active"
              aria-label="Remove ${escapeHtml(item.title)} from wishlist"
              aria-pressed="true"
            >
              <span class="wishlist-heart" aria-hidden="true">
                <svg data-icon="heart" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </span>
            </button>
          </div>
          <div class="product-card__content">
            <div class="product-card__info">
              <h3 class="product-card__title type-body-l">
                <a href="${itemPath}" class="product-card__title-link">${escapeHtml(item.title)}</a>
              </h3>
            </div>
            <div class="product-card__pricing">
              <span class="product-card__price type-body-xl">${money(item.priceAmount, item.currencyCode)}</span>
            </div>
          </div>
          <form action="/actions/cart/add" method="post" data-card-add-form>
            <input type="hidden" name="productHandle" value="${escapeHtml(handle)}" />
            <input type="hidden" name="quantity" value="1" />
            <button
              type="submit"
              class="product-card__quick-add-btn"
              aria-label="Add ${escapeHtml(item.title)} to cart"
              data-action="quick-add"
            >
              <span class="product-card__quick-glyph" aria-hidden="true">
                <svg data-icon="plus" viewBox="0 0 12 12" focusable="false"><path d="M6 1.5v9M1.5 6h9" /></svg>
                <svg data-icon="check" viewBox="0 0 14 14" focusable="false"><path d="m2.5 7 3 3 6-6" /></svg>
              </span>
              <span class="product-card__tip type-body-xs-500" role="tooltip">Add to cart</span>
            </button>
          </form>
        `;

        card.querySelector(".product-card__wishlist-btn")?.addEventListener("click", () => {
          window.dispatchEvent(
            new CustomEvent(WISHLIST_UPDATED_EVENT, {
              detail: {
                items: items.filter((saved) => saved.path !== item.path),
                origin: "page",
              },
            }),
          );
        });

        grid.appendChild(card);
      });
    };

    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const next = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail?.items;
      if (!Array.isArray(next)) return;
      items = next;
      render(items);
    });
    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  })();
</script>
