---
import "../styles/pages/product-list.scss";
import { Icon } from "astro-icon/components";
import type { StoreCategory, StoreCollection, StoreProduct } from "../../../../lib/commerce/types";
import { catalogHref, parseOptionPair, type CatalogFilters } from "../../../../lib/commerce/catalog-filters";
import { taxonomyHandle } from "../../../../lib/commerce/taxonomy-links";
import type { StorefrontSeo } from "../../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import heroBackground from "../assets/products-hero-background-image.webp";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import ProductCard from "../components/ProductCard.astro";
import TemplateAsset from "../../../../components/media/TemplateAsset.astro";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount?: number;
  deferCartCount?: boolean;
  products: StoreProduct[];
  errorMessage?: string | null;
  hasPrev: boolean;
  hasNext: boolean;
  prevHref?: string;
  nextHref?: string;
  collections?: StoreCollection[];
  categories?: StoreCategory[];
  facets?: {
    categories: Record<string, number>;
    collections: Record<string, number>;
    options: Array<{ name: string; values: Array<{ count: number; token: string; value: string }> }>;
    price: { min: number; max: number } | null;
  };
  filters?: CatalogFilters;
  totalCount?: number;
  offset?: number;
  limit?: number;
  seo?: StorefrontSeo;
  demoMode?: boolean;
}

const {
  data,
  themeTokens,
  tenantName,
  cartCount = 0,
  deferCartCount = false,
  products,
  errorMessage,
  hasPrev,
  hasNext,
  prevHref,
  nextHref,
  collections = [],
  categories = [],
  facets,
  filters = { optionPairs: [] },
  totalCount = products.length,
  offset = 0,
  limit = 24,
  seo,
  demoMode = false,
} = Astro.props;

const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const template = parseLuviaData(data);
const activeCollection = collections.find((item) => taxonomyHandle(item) === filters.collectionId);
const activeCategory = categories.find((item) => taxonomyHandle(item) === filters.categoryId);

const totalPages = Math.max(1, Math.ceil(totalCount / limit));
const currentPage = Math.min(totalPages, Math.floor(offset / limit) + 1);
const pageWindow = Array.from({ length: totalPages }, (_, index) => index + 1).filter(
  (page) => page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1,
);

function pageHref(page: number) {
  return `${catalogHref(filters, (page - 1) * limit)}#shop-products`;
}

const title = filters.q
  ? `Search: "${filters.q}"`
  : activeCollection?.title ?? activeCategory?.name ?? m.catalog_listing_title({}, { locale });

const sortOptions = [
  { value: "", label: m.catalog_featured({}, { locale }) },
  { value: "created_at", label: m.catalog_newest({}, { locale }) },
  { value: "price", label: m.catalog_price_low_high({}, { locale }) },
  { value: "-price", label: m.catalog_price_high_low({}, { locale }) },
  { value: "title", label: m.catalog_title_az({}, { locale }) },
  { value: "-title", label: m.catalog_title_za({}, { locale }) },
];

const currentSort = sortOptions.find((opt) => (filters.order ?? "") === opt.value) ?? sortOptions[0];

interface ActiveFilterPill {
  id: string;
  label: string;
  href: string;
}

const activeFilterPills: ActiveFilterPill[] = [];

if (filters.categoryId) {
  const cat = categories.find((c) => taxonomyHandle(c) === filters.categoryId);
  activeFilterPills.push({
    id: `cat-${filters.categoryId}`,
    label: cat?.name ?? filters.categoryId,
    href: `${catalogHref({ ...filters, categoryId: undefined }, 0)}#shop-products`,
  });
}

if (filters.collectionId) {
  const col = collections.find((c) => taxonomyHandle(c) === filters.collectionId);
  activeFilterPills.push({
    id: `col-${filters.collectionId}`,
    label: col?.title ?? filters.collectionId,
    href: `${catalogHref({ ...filters, collectionId: undefined }, 0)}#shop-products`,
  });
}

if (filters.q?.trim()) {
  activeFilterPills.push({
    id: `q-${filters.q}`,
    label: `Search: "${filters.q}"`,
    href: `${catalogHref({ ...filters, q: undefined }, 0)}#shop-products`,
  });
}

if (filters.priceMin !== undefined && filters.priceMin > 0) {
  activeFilterPills.push({
    id: "price-min",
    label: `Min: ETB ${filters.priceMin.toLocaleString()}`,
    href: `${catalogHref({ ...filters, priceMin: undefined }, 0)}#shop-products`,
  });
}

if (filters.priceMax !== undefined && filters.priceMax < 25000) {
  activeFilterPills.push({
    id: "price-max",
    label: `Max: ETB ${filters.priceMax.toLocaleString()}`,
    href: `${catalogHref({ ...filters, priceMax: undefined }, 0)}#shop-products`,
  });
}

if (filters.optionPairs && filters.optionPairs.length > 0) {
  filters.optionPairs.forEach((token, idx) => {
    const pair = parseOptionPair(token);
    if (!pair) return;
    activeFilterPills.push({
      id: `opt-${pair.name}-${pair.value}`,
      label: `${pair.name}: ${pair.value}`,
      href: `${catalogHref({ ...filters, optionPairs: filters.optionPairs?.filter((_, i) => i !== idx) }, 0)}#shop-products`,
    });
  });
}
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  cartCount={cartCount}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  title={m.catalog_listing_title({}, { locale })}
  seo={seo}
>
  <main id="main-content" class="shop-page">
    <!-- Hero Section -->
    <section class="shop-hero">
      <TemplateAsset
        class="shop-hero__media"
        fallback={heroBackground}
        alt=""
        widths={[480, 768, 1024, 1512, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="shop-hero__inner container">
        <div class="shop-hero__content">
          <nav aria-label={m.breadcrumb_label({}, { locale })} class="type-body-s-400">
            <a href="/" class="type-body-s-400">{m.nav_home({}, { locale })}</a>
            <Icon name="chevron" />
            <span class="type-body-s-400">{m.nav_shop({}, { locale })}</span>
          </nav>
          <h1 class="type-heading-1">{title}</h1>
        </div>
      </div>
    </section>

    <!-- Shop Layout: Sidebar + Product Grid -->
    <section class="shop-layout container" id="shop-products">
      <div class="shop-layout__wrapper">
        <!-- Sidebar Filters -->
        <aside class="shop-sidebar" id="shop-sidebar" aria-label={m.catalog_filters({}, { locale })}>
          <div class="shop-sidebar__header">
            <h2 class="shop-sidebar__header-title type-body-s-500">
              <Icon name="filter" width={16} height={16} />
              {m.catalog_filters({}, { locale })}
            </h2>
            <a href="/products#shop-products" class="shop-sidebar__reset-btn type-body-xs-500" id="shop-reset-filters">
              {m.catalog_clear_filters({}, { locale })}
            </a>
            <button
              type="button"
              class="shop-sidebar__close-btn type-body-l"
              id="shop-sidebar-close"
              aria-label={m.catalog_close_filters({}, { locale })}
            >
              &times;
            </button>
          </div>

          <!-- Search in Sidebar -->
          <form
            class="shop-sidebar__search"
            action="/products"
            method="get"
            role="search"
            data-product-search-suggestions
            data-search-suggestions-anchor
            data-search-view-all={m.search_view_all({ query: "{query}" }, { locale })}
            data-search-for={m.search_for({ query: "{query}" }, { locale })}
          >
            {filters.categoryId && <input type="hidden" name="category" value={filters.categoryId} />}
            {filters.collectionId && <input type="hidden" name="collection" value={filters.collectionId} />}
            {filters.priceMin !== undefined && <input type="hidden" name="price_min" value={filters.priceMin} />}
            {filters.priceMax !== undefined && <input type="hidden" name="price_max" value={filters.priceMax} />}
            {filters.order && <input type="hidden" name="order" value={filters.order} />}
            <div class="shop-sidebar__search-input-wrap">
              <input
                type="search"
                name="q"
                value={filters.q ?? ""}
                placeholder={m.search_products_placeholder({}, { locale })}
                class="shop-sidebar__search-input type-body-s-400"
                aria-label={m.search_products_label({}, { locale })}
                autocomplete="off"
              />
              <button type="submit" class="shop-sidebar__search-btn" aria-label={m.action_search({}, { locale })}>
                <Icon name="search" width={16} height={16} />
              </button>
            </div>
          </form>

          <!-- Category Filter Group -->
          {categories.length > 0 && (
            <div class="shop-sidebar__group">
              <h3 class="shop-sidebar__group-title type-body-s-500">
                <button
                  type="button"
                  class="shop-sidebar__group-toggle"
                  aria-expanded="true"
                  aria-controls="shop-filter-categories"
                >
                  <span>{m.catalog_category({}, { locale })}</span>
                  <Icon name="chevron-down" width={10} height={6} />
                </button>
              </h3>
              <div class="shop-sidebar__disclosure" id="shop-filter-categories">
                <div class="shop-sidebar__category-list" role="radiogroup" aria-label={m.catalog_category({}, { locale })}>
                  <label class="shop-sidebar__category-item">
                    <span class="shop-sidebar__category-label type-body-s-400">
                      <input
                        type="radio"
                        name="shop-category"
                        value="all"
                        checked={!filters.categoryId}
                        onchange="window.location.href = '/products#shop-products'"
                      />
                      {m.catalog_all_categories({}, { locale })}
                    </span>
                  </label>
                  {categories.map((cat) => {
                    const handle = taxonomyHandle(cat);
                    const isChecked = filters.categoryId === handle;
                    const nextHref = catalogHref({ ...filters, categoryId: handle ?? undefined }, 0);
                    return (
                      <label class="shop-sidebar__category-item">
                        <span class="shop-sidebar__category-label type-body-s-400">
                          <input
                            type="radio"
                            name="shop-category"
                            value={handle ?? ""}
                            checked={isChecked}
                            onchange={`window.location.href = '${nextHref}#shop-products'`}
                          />
                          {cat.name}
                        </span>
                        {facets?.categories?.[cat.id] !== undefined && (
                          <span class="shop-sidebar__category-count type-body-xs">
                            {facets.categories[cat.id]}
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          <!-- Collection Filter Group -->
          {collections.length > 0 && (
            <div class="shop-sidebar__group">
              <h3 class="shop-sidebar__group-title type-body-s-500">
                <button
                  type="button"
                  class="shop-sidebar__group-toggle"
                  aria-expanded="true"
                  aria-controls="shop-filter-collections"
                >
                  <span>{m.catalog_collection({}, { locale })}</span>
                  <Icon name="chevron-down" width={10} height={6} />
                </button>
              </h3>
              <div class="shop-sidebar__disclosure" id="shop-filter-collections">
                <div class="shop-sidebar__category-list" role="radiogroup" aria-label={m.catalog_collection({}, { locale })}>
                  <label class="shop-sidebar__category-item">
                    <span class="shop-sidebar__category-label type-body-s-400">
                      <input
                        type="radio"
                        name="shop-collection"
                        value="all"
                        checked={!filters.collectionId}
                        onchange="window.location.href = '/products#shop-products'"
                      />
                      {m.catalog_all_collections({}, { locale })}
                    </span>
                  </label>
                  {collections.map((col) => {
                    const handle = taxonomyHandle(col);
                    const isChecked = filters.collectionId === handle;
                    const nextHref = catalogHref({ ...filters, collectionId: handle ?? undefined }, 0);
                    return (
                      <label class="shop-sidebar__category-item">
                        <span class="shop-sidebar__category-label type-body-s-400">
                          <input
                            type="radio"
                            name="shop-collection"
                            value={handle}
                            checked={isChecked}
                            onchange={`window.location.href = '${nextHref}#shop-products'`}
                          />
                          {col.title}
                        </span>
                        {facets?.collections?.[col.id] !== undefined && (
                          <span class="shop-sidebar__category-count type-body-xs">
                            {facets.collections[col.id]}
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          <!-- Price Range Filter Group -->
          <div class="shop-sidebar__group">
            <h3 class="shop-sidebar__group-title type-body-s-500">
              <button
                type="button"
                class="shop-sidebar__group-toggle"
                aria-expanded="true"
                aria-controls="shop-filter-price"
              >
                <span>{m.catalog_price_range({}, { locale })}</span>
                <Icon name="chevron-down" width={10} height={6} />
              </button>
            </h3>
            <div class="shop-sidebar__disclosure" id="shop-filter-price">
              <div class="shop-sidebar__price-range">
                <div class="shop-sidebar__price-inputs">
                  <label class="shop-sidebar__price-box">
                    <span class="type-body-xs">{m.catalog_from({}, { locale })}</span>
                    <input
                      type="number"
                      id="shop-price-min"
                      value={filters.priceMin ?? 0}
                      min="0"
                      max="25000"
                      step="500"
                      class="shop-sidebar__price-field type-body-s-400"
                      aria-label="Minimum price"
                    />
                  </label>
                  <label class="shop-sidebar__price-box">
                    <span class="type-body-xs">{m.catalog_to({}, { locale })}</span>
                    <input
                      type="number"
                      id="shop-price-max"
                      value={filters.priceMax ?? 25000}
                      min="0"
                      max="25000"
                      step="500"
                      class="shop-sidebar__price-field type-body-s-400"
                      aria-label="Maximum price"
                    />
                  </label>
                </div>
                <div class="shop-sidebar__range">
                  <div class="shop-sidebar__range-track" aria-hidden="true">
                    <div
                      class="shop-sidebar__range-fill"
                      id="shop-price-fill"
                      style={`left: ${((filters.priceMin ?? 0) / 25000) * 100}%; right: ${100 - ((filters.priceMax ?? 25000) / 25000) * 100}%`}
                    ></div>
                  </div>
                  <input
                    type="range"
                    id="shop-price-min-slider"
                    min="0"
                    max="25000"
                    step="500"
                    value={filters.priceMin ?? 0}
                    class="shop-sidebar__range-input"
                    aria-label="Minimum price"
                  />
                  <input
                    type="range"
                    id="shop-price-slider"
                    min="0"
                    max="25000"
                    step="500"
                    value={filters.priceMax ?? 25000}
                    class="shop-sidebar__range-input"
                    aria-label="Maximum price"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Option Filters Group (if facets available) -->
          {facets?.options && facets.options.length > 0 && facets.options.map((option) => (
            <div class="shop-sidebar__group">
              <h3 class="shop-sidebar__group-title type-body-s-500">
                <button
                  type="button"
                  class="shop-sidebar__group-toggle"
                  aria-expanded="true"
                  aria-controls={`shop-filter-opt-${option.name}`}
                >
                  <span>{option.name}</span>
                  <Icon name="chevron-down" width={10} height={6} />
                </button>
              </h3>
              <div class="shop-sidebar__disclosure" id={`shop-filter-opt-${option.name}`}>
                <div class="shop-sidebar__category-list" role="group" aria-label={`Filter by ${option.name}`}>
                  {option.values.map((item) => {
                    const isChecked = filters.optionPairs.includes(item.token);
                    const nextPairs = isChecked
                      ? filters.optionPairs.filter((p) => p !== item.token)
                      : [...filters.optionPairs, item.token];
                    const nextHref = catalogHref({ ...filters, optionPairs: nextPairs }, 0);
                    return (
                      <label class="shop-sidebar__category-item">
                        <span class="shop-sidebar__category-label type-body-s-400">
                          <input
                            type="checkbox"
                            value={item.token}
                            checked={isChecked}
                            onchange={`window.location.href = '${nextHref}#shop-products'`}
                          />
                          {item.value}
                        </span>
                        {item.count !== undefined && (
                          <span class="shop-sidebar__category-count type-body-xs">
                            {item.count}
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>
          ))}
        </aside>

        <!-- Main Product Area -->
        <div class="shop-main">
          <!-- Toolbar (Top Bar above products listing) -->
          <div class="shop-main__toolbar">
            <p class="shop-main__count type-body-s-500" id="shop-item-count">
              {products.length > 0
                ? m.catalog_showing({ shown: Math.min(offset + products.length, totalCount), total: totalCount }, { locale })
                : m.catalog_result_count({ count: 0 }, { locale })}
            </p>

            <div class="shop-main__controls">
              <button
                type="button"
                class="shop-main__mobile-filter-btn type-body-s-500"
                id="shop-mobile-filter-toggle"
              >
                <Icon name="filter" width={14} height={14} />
                {m.catalog_filters({}, { locale })}
              </button>

              <div class="shop-main__sort-wrapper">
                <span class="shop-main__sort-label type-body-xs-500">{m.catalog_sort_by({}, { locale })}</span>
                <div class="luvia-dropdown" id="shop-sort" data-dropdown>
                  <button
                    type="button"
                    class="luvia-dropdown__trigger type-body-s-500"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                  >
                    <span data-dropdown-label>{currentSort.label}</span>
                    <span class="luvia-dropdown__chevron" aria-hidden="true">
                      <Icon name="chevron-down" width={10} height={6} />
                    </span>
                  </button>
                  <ul class="luvia-dropdown__menu" role="listbox" hidden>
                    {sortOptions.map((opt) => (
                      <li>
                        <button
                          type="button"
                          class="luvia-dropdown__option type-body-s-400"
                          role="option"
                          data-value={opt.value}
                          aria-selected={String((filters.order ?? "") === opt.value)}
                          onclick={`window.location.href = '${catalogHref({ ...filters, order: opt.value || undefined }, 0)}#shop-products'`}
                        >
                          <span class="luvia-dropdown__option-text">{opt.label}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Active Filter Tags -->
          {activeFilterPills.length > 0 && (
            <div class="shop-main__active-tags" id="shop-active-tags">
              {activeFilterPills.map((pill) => (
                <a
                  href={pill.href}
                  class="shop-main__tag-pill type-body-xs-500"
                  aria-label={`Remove filter: ${pill.label}`}
                >
                  <span class="shop-main__tag-label">{pill.label}</span>
                  <span class="shop-main__tag-remove type-body-xs-700" aria-hidden="true">&times;</span>
                </a>
              ))}
              <a href="/products#shop-products" class="shop-main__clear-all type-body-xs-500">
                {m.catalog_clear_filters({}, { locale })}
              </a>
            </div>
          )}

          <!-- Product Grid -->
          {errorMessage ? (
            <div class="shop-main__empty empty-state is-visible">
              <div class="empty-state__copy">
                <h3 class="empty-state__title type-heading-3">{m.catalog_load_failed({}, { locale })}</h3>
                <p class="empty-state__text type-body-s-400">{errorMessage}</p>
              </div>
              <a class="empty-state__action type-body-500" href="/products#shop-products">
                {m.action_retry({}, { locale })}
              </a>
            </div>
          ) : products.length > 0 ? (
            <div class="shop-main__grid" id="shop-product-grid">
              {products.map((prod, index) => (
                <ProductCard product={prod} eager={index < 4} />
              ))}
            </div>
          ) : (
            <div class="shop-main__empty empty-state is-visible" id="shop-empty-state">
              <span class="empty-state__mark" aria-hidden="true">
                <Icon name="search" width={18} height={18} />
              </span>
              <div class="empty-state__copy">
                <h3 class="empty-state__title type-heading-3">{m.catalog_no_match({}, { locale })}</h3>
                <p class="empty-state__text type-body-s-400">
                  {m.catalog_adjust_filters({}, { locale })}
                </p>
              </div>
              <a class="empty-state__action type-body-500" href="/products#shop-products">
                {m.catalog_clear_filters({}, { locale })}
              </a>
            </div>
          )}

          <!-- Pagination -->
          {totalPages > 1 && (
            <nav class="shop-main__pagination" id="shop-pagination" aria-label={m.catalog_pagination({}, { locale })}>
              {hasPrev && prevHref ? (
                <a href={`${prevHref}#shop-products`} class="shop-main__page-btn shop-main__page-btn--prev" aria-label={m.catalog_previous({}, { locale })}>
                  <Icon name="arrow" width={14} height={10} />
                </a>
              ) : (
                <button type="button" class="shop-main__page-btn shop-main__page-btn--prev" disabled aria-label={m.catalog_previous({}, { locale })}>
                  <Icon name="arrow" width={14} height={10} />
                </button>
              )}

              {pageWindow.map((page) => (
                <a
                  href={pageHref(page)}
                  class:list={[
                    "shop-main__page-btn",
                    page === currentPage ? "type-body-s-500 is-active" : "type-body-s-400",
                  ]}
                  aria-current={page === currentPage ? "page" : undefined}
                >
                  {page}
                </a>
              ))}

              {hasNext && nextHref ? (
                <a href={`${nextHref}#shop-products`} class="shop-main__page-btn shop-main__page-btn--next" aria-label={m.catalog_next({}, { locale })}>
                  <Icon name="arrow" width={14} height={10} />
                </a>
              ) : (
                <button type="button" class="shop-main__page-btn shop-main__page-btn--next" disabled aria-label={m.catalog_next({}, { locale })}>
                  <Icon name="arrow" width={14} height={10} />
                </button>
              )}
            </nav>
          )}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { initProductSearchSuggestions } from "../../../../lib/browser/product-search-suggestions";

  // Search suggestions
  const searchForm = document.querySelector<HTMLFormElement>(".shop-sidebar__search");
  if (searchForm) initProductSearchSuggestions(searchForm);

  // Mobile sidebar drawer toggle
  const sidebar = document.getElementById("shop-sidebar");
  const mobileToggle = document.getElementById("shop-mobile-filter-toggle");
  const closeBtn = document.getElementById("shop-sidebar-close");

  mobileToggle?.addEventListener("click", () => {
    sidebar?.classList.add("is-open");
    document.body.classList.add("no-scroll");
  });

  closeBtn?.addEventListener("click", () => {
    sidebar?.classList.remove("is-open");
    document.body.classList.remove("no-scroll");
  });

  // Collapsible Accordion Groups
  const groupToggles = document.querySelectorAll<HTMLButtonElement>(".shop-sidebar__group-toggle");
  groupToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const group = toggle.closest<HTMLElement>(".shop-sidebar__group");
      if (!group) return;
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isExpanded));
      group.classList.toggle("is-collapsed", isExpanded);
    });
  });

  // Price Slider & Inputs on Shop page
  const minInput = document.getElementById("shop-price-min") as HTMLInputElement | null;
  const maxInput = document.getElementById("shop-price-max") as HTMLInputElement | null;
  const minSlider = document.getElementById("shop-price-min-slider") as HTMLInputElement | null;
  const maxSlider = document.getElementById("shop-price-slider") as HTMLInputElement | null;
  const fill = document.getElementById("shop-price-fill");

  function updateFill() {
    if (!minSlider || !maxSlider || !fill) return;
    const minVal = Number(minSlider.value);
    const maxVal = Number(maxSlider.value);
    const minPercent = (minVal / 25000) * 100;
    const maxPercent = (maxVal / 25000) * 100;
    fill.style.left = `${minPercent}%`;
    fill.style.right = `${100 - maxPercent}%`;
  }

  function commitPriceFilter() {
    const min = minInput ? Number(minInput.value) : 0;
    const max = maxInput ? Number(maxInput.value) : 25000;
    const url = new URL(window.location.href);
    if (min > 0) url.searchParams.set("price_min", String(min));
    else url.searchParams.delete("price_min");
    if (max < 25000) url.searchParams.set("price_max", String(max));
    else url.searchParams.delete("price_max");
    url.searchParams.delete("offset");
    url.hash = "shop-products";
    window.location.href = url.toString();
  }

  minSlider?.addEventListener("input", () => {
    if (!minSlider || !maxSlider || !minInput) return;
    if (Number(minSlider.value) > Number(maxSlider.value)) {
      minSlider.value = maxSlider.value;
    }
    minInput.value = minSlider.value;
    updateFill();
  });

  maxSlider?.addEventListener("input", () => {
    if (!minSlider || !maxSlider || !maxInput) return;
    if (Number(maxSlider.value) < Number(minSlider.value)) {
      maxSlider.value = minSlider.value;
    }
    maxInput.value = maxSlider.value;
    updateFill();
  });

  minSlider?.addEventListener("change", commitPriceFilter);
  maxSlider?.addEventListener("change", commitPriceFilter);

  minInput?.addEventListener("change", () => {
    if (!minSlider || !minInput) return;
    minSlider.value = minInput.value;
    updateFill();
    commitPriceFilter();
  });

  maxInput?.addEventListener("change", () => {
    if (!maxSlider || !maxInput) return;
    maxSlider.value = maxInput.value;
    updateFill();
    commitPriceFilter();
  });

  // Custom Dropdown
  const dropdown = document.querySelector<HTMLElement>("[data-dropdown]");
  if (dropdown) {
    const trigger = dropdown.querySelector<HTMLButtonElement>(".luvia-dropdown__trigger");
    const menu = dropdown.querySelector<HTMLElement>(".luvia-dropdown__menu");
    trigger?.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!open));
      if (menu) menu.hidden = open;
    });
    document.addEventListener("click", (event) => {
      if (!dropdown.contains(event.target as Node)) {
        trigger?.setAttribute("aria-expanded", "false");
        if (menu) menu.hidden = true;
      }
    });
  }
</script>
