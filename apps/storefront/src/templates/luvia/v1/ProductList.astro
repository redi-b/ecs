---
import type { StoreCategory, StoreCollection, StoreProduct } from "../../../lib/commerce/types";
import { catalogHref, parseOptionPair, type CatalogFilters } from "../../../lib/commerce/catalog-filters";
import { taxonomyHandle } from "../../../lib/commerce/taxonomy-links";
import type { StorefrontSeo } from "../../../lib/seo";
import heroBackground from "./assets/products-hero-background-image.webp";
import chevronIcon from "./icons/chevron-icon.svg";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";
import ProductCard from "./ProductCard.astro";
import TemplateImage from "./TemplateImage.astro";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount?: number;
  deferCartCount?: boolean;
  products: StoreProduct[];
  errorMessage?: string | null;
  hasPrev: boolean;
  hasNext: boolean;
  prevHref?: string;
  nextHref?: string;
  collections?: StoreCollection[];
  categories?: StoreCategory[];
  facets?: { categories: Record<string, number>; collections: Record<string, number>; options: Array<{ name: string; values: Array<{ count: number; token: string; value: string }> }>; price: { min: number; max: number } | null };
  filters?: CatalogFilters;
  totalCount?: number;
  offset?: number;
  limit?: number;
  seo?: StorefrontSeo;
  demoMode?: boolean;
}

const {
  data,
  themeTokens,
  tenantName,
  cartCount = 0,
  deferCartCount = false,
  products,
  errorMessage,
  hasPrev,
  hasNext,
  prevHref,
  nextHref,
  collections = [],
  categories = [],
  facets,
  filters = { optionPairs: [] },
  totalCount = products.length,
  offset = 0,
  limit = 24,
  seo,
  demoMode = false,
} = Astro.props;

const template = parseLuviaData(data);
const activeCollection = collections.find((item) => taxonomyHandle(item) === filters.collectionId);
const activeCategory = categories.find((item) => taxonomyHandle(item) === filters.categoryId);
const hasActiveFilters = Boolean(
  filters.q || filters.collectionId || filters.categoryId || filters.optionPairs.length ||
  filters.priceMin !== undefined || filters.priceMax !== undefined || filters.order,
);
const categoryLabel = activeCategory?.name ?? "All categories";
const sortLabel =
  filters.order === "created_at"
    ? "Newest"
    : filters.order === "title"
      ? "Title A–Z"
      : filters.order === "-title"
        ? "Title Z–A"
        : filters.order === "price"
          ? "Price: low to high"
          : filters.order === "-price"
            ? "Price: high to low"
        : "Featured";
const totalPages = Math.max(1, Math.ceil(totalCount / limit));
const currentPage = Math.min(totalPages, Math.floor(offset / limit) + 1);

function productsHref(nextOffset: number, overrides: Partial<CatalogFilters> = {}) {
  return catalogHref({ ...filters, ...overrides }, nextOffset);
}

function clearFilterHref(key: "q" | "collectionId" | "categoryId" | "priceMin" | "priceMax" | "order") {
  return productsHref(0, { [key]: undefined });
}

function clearOptionHref(token: string) {
  return productsHref(0, { optionPairs: filters.optionPairs.filter((item) => item !== token) });
}

const pageWindow = Array.from({ length: totalPages }, (_, index) => index + 1).filter(
  (page) => page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1,
);
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} deferCartCount={deferCartCount} demoMode={demoMode} title="Products Listing" seo={seo}>
  <main class="lv-shop">
    <section class="lv-shop-hero">
      <TemplateImage class="lv-shop-hero__media" fallback={heroBackground} alt="" widths={[480, 768, 1024, 1512, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="lv-shop-hero__content">
        <nav aria-label="Breadcrumb"><a href="/">Home</a><img src={chevronIcon.src} alt="" /><span>Shop</span></nav>
        <h1>Our Products Listing</h1>
      </div>
    </section>

    <section class="lv-shop-products" aria-labelledby="products-listing-title">
      <form class="lv-catalog-filter" method="get" action="/products" data-product-search-suggestions>
        <header><h2 id="products-listing-title">Products Listing</h2><button class="lv-filter-toggle" type="button" aria-expanded="false" aria-controls="catalog-filter-controls"><span>Filters</span><svg class="lv-filter-toggle__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg></button></header>
        <button class="lv-filter-backdrop" type="button" aria-label="Close filters" data-filter-close></button>
        <div class="lv-catalog-filter__body" id="catalog-filter-controls">
          <div class="lv-filter-sheet-head"><strong>Filter products</strong><button type="button" aria-label="Close filters" data-filter-close><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg></button></div>
          <div class="lv-catalog-filter__scroll">
          <div class="lv-catalog-filter__controls">
            {filters.collectionId && <input type="hidden" name="collection" value={filters.collectionId} />}
            <div class="lv-catalog-filter__search" data-search-suggestions-anchor><label class="sr-only" for="lv-catalog-search">Search products</label><input id="lv-catalog-search" name="q" type="search" value={filters.q ?? ""} placeholder="Search products" /></div>
            {collections.length > 0 && <details class="lv-filter-menu" open>
              <summary><span>Collection</span><strong data-filter-value>{activeCollection?.title ?? "All collections"}</strong></summary>
              <div role="radiogroup" aria-label="Product collection">
                <label><input type="radio" name="collection" value="" checked={!filters.collectionId} /><span>All collections</span></label>
                {collections.flatMap((collection) => { const handle = taxonomyHandle(collection); return handle ? [<label><input type="radio" name="collection" value={handle} checked={filters.collectionId === handle} /><span>{collection.title ?? "Collection"}</span>{facets?.collections[collection.id] !== undefined && <small>{facets.collections[collection.id]}</small>}</label>] : []; })}
              </div>
            </details>}
            {categories.length > 0 && <details class="lv-filter-menu">
              <summary><span>Category</span><strong data-filter-value>{categoryLabel}</strong></summary>
              <div role="radiogroup" aria-label="Product category">
                <label><input type="radio" name="category" value="" checked={!filters.categoryId} /><span>All categories</span></label>
                {categories.flatMap((category) => { const handle = taxonomyHandle(category); return handle ? [<label><input type="radio" name="category" value={handle} checked={filters.categoryId === handle} /><span>{category.name ?? "Category"}</span>{facets?.categories[category.id] !== undefined && <small>{facets.categories[category.id]}</small>}</label>] : []; })}
              </div>
            </details>}
            {facets?.options.map((option) => <details class="lv-filter-menu">
              <summary><span>{option.name}</span><strong data-filter-value>{filters.optionPairs.some((token) => parseOptionPair(token)?.name === option.name) ? "Selected" : `All ${option.name.toLowerCase()}`}</strong></summary>
              <div role="group" aria-label={`Filter by ${option.name}`}>
                {option.values.map((item) => <label><input type="checkbox" name="option" value={item.token} checked={filters.optionPairs.includes(item.token)} /><span>{item.value}</span><small>{item.count}</small></label>)}
              </div>
            </details>)}
            {facets?.price && <details class="lv-filter-menu lv-filter-menu--price">
              <summary><span>Price</span><strong data-filter-value>{filters.priceMin !== undefined || filters.priceMax !== undefined ? "Custom" : "Any price"}</strong></summary>
              <div class="lv-price-filter" role="group" aria-label="Price in Ethiopian birr">
                <label><span>From</span><input name="price_min" type="number" min={Math.floor(facets.price.min)} max={Math.ceil(facets.price.max)} step="1" value={filters.priceMin} placeholder={String(Math.floor(facets.price.min))} /></label>
                <label><span>To</span><input name="price_max" type="number" min={Math.floor(facets.price.min)} max={Math.ceil(facets.price.max)} step="1" value={filters.priceMax} placeholder={String(Math.ceil(facets.price.max))} /></label>
              </div>
            </details>}
            <details class="lv-filter-menu lv-filter-menu--sort">
              <summary><span>Sort by</span><strong data-filter-value>{sortLabel}</strong></summary>
              <div role="radiogroup" aria-label="Sort products">
                <label><input type="radio" name="order" value="" checked={!filters.order} /><span>Featured</span></label>
                <label><input type="radio" name="order" value="created_at" checked={filters.order === "created_at"} /><span>Newest</span></label>
                <label><input type="radio" name="order" value="title" checked={filters.order === "title"} /><span>Title A–Z</span></label>
                <label><input type="radio" name="order" value="-title" checked={filters.order === "-title"} /><span>Title Z–A</span></label>
                <label><input type="radio" name="order" value="price" checked={filters.order === "price"} /><span>Price: low to high</span></label>
                <label><input type="radio" name="order" value="-price" checked={filters.order === "-price"} /><span>Price: high to low</span></label>
              </div>
            </details>
          </div>
          <div class="lv-catalog-filter__active">
            <div>
              {filters.q && <a href={clearFilterHref("q")}><strong>Search:</strong> {filters.q}<span aria-hidden="true">×</span></a>}
              {activeCollection && <a href={clearFilterHref("collectionId")}><strong>Collection:</strong> {activeCollection.title}<span aria-hidden="true">×</span></a>}
              {activeCategory && <a href={clearFilterHref("categoryId")}><strong>Category:</strong> {activeCategory.name}<span aria-hidden="true">×</span></a>}
              {filters.optionPairs.map((token) => { const pair = parseOptionPair(token); return pair ? <a href={clearOptionHref(token)}><strong>{pair.name}:</strong> {pair.value}<span aria-hidden="true">×</span></a> : null; })}
              {filters.priceMin !== undefined && <a href={clearFilterHref("priceMin")}><strong>From:</strong> ETB {filters.priceMin.toLocaleString()}<span aria-hidden="true">×</span></a>}
              {filters.priceMax !== undefined && <a href={clearFilterHref("priceMax")}><strong>To:</strong> ETB {filters.priceMax.toLocaleString()}<span aria-hidden="true">×</span></a>}
              {filters.order && <a href={clearFilterHref("order")}><strong>Sort:</strong> {sortLabel}<span aria-hidden="true">×</span></a>}
              {hasActiveFilters && <a class="lv-filter-clear" href="/products">Clear filters</a>}
            </div>
            <span>{totalCount} Results</span>
          </div>
          </div>
          <div class="lv-filter-footer"><button class="lv-filter-apply" type="submit">Apply filters</button></div>
        </div>
      </form>

      <div class="lv-catalog-loading" data-catalog-loading hidden role="status" aria-live="polite">
        <div>{Array.from({ length: 8 }, () => <span></span>)}</div>
        <p>Refreshing the collection…</p>
      </div>

      <div data-catalog-results>
        {errorMessage ? <div class="lv-catalog-state" role="alert"><h2>We couldn’t load the collection.</h2><p>Please refresh the page or try again in a moment.</p></div> : products.length === 0 && hasActiveFilters ? <div class="lv-catalog-state" role="status"><h2>No products match your selection.</h2><p>Try a broader search or remove one of the active filters.</p><a href="/products">Clear all filters</a></div> : products.length === 0 ? <div class="lv-catalog-state" role="status"><h2>The collection is getting ready.</h2><p>There are no products available yet. Please check back soon.</p><a href="/">Return home</a></div> : <div class="lv-catalog-grid">{products.map((product, index) => <ProductCard product={product} eager={index < 4} />)}</div>}

        {!errorMessage && products.length > 0 && <div class="lv-catalog-pagination"><p>Showing {Math.min(offset + products.length, totalCount)} out of <strong>{totalCount}</strong> results</p>{totalPages > 1 && <nav aria-label="Product pages">{hasPrev && prevHref ? <a href={prevHref} rel="prev" aria-label="Previous page">‹</a> : <span aria-disabled="true">‹</span>}{pageWindow.map((page, index) => <>{index > 0 && pageWindow[index - 1] !== page - 1 && <i aria-hidden="true">…</i>}<a class:list={{ "is-current": page === currentPage }} href={productsHref((page - 1) * limit)} aria-current={page === currentPage ? "page" : undefined}>{page}</a></>)}{hasNext && nextHref ? <a href={nextHref} rel="next" aria-label="Next page">›</a> : <span aria-disabled="true">›</span>}</nav>}</div>}
      </div>
    </section>
  </main>
</Layout>

<script>
  import { initProductSearchSuggestions } from "../../../lib/browser/product-search-suggestions";
  import { initAnimatedDetails } from "../../../lib/browser/animate-details";

  const toggle = document.querySelector<HTMLButtonElement>(".lv-filter-toggle");
  const controls = document.querySelector<HTMLElement>("#catalog-filter-controls");
  const filterFocusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
  const setFiltersOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    controls?.toggleAttribute("data-open", open);
    document.documentElement.toggleAttribute("data-lv-filters-open", open);
    if (controls && window.matchMedia("(max-width: 700px)").matches) {
      controls.toggleAttribute("aria-modal", open);
      if (open) { controls.setAttribute("role", "dialog"); controls.querySelector<HTMLElement>("[data-filter-close]")?.focus(); }
      else controls.removeAttribute("role");
    }
  };
  toggle?.addEventListener("click", () => setFiltersOpen(toggle.getAttribute("aria-expanded") !== "true"));
  document.querySelectorAll<HTMLButtonElement>("[data-filter-close]").forEach((button) => button.addEventListener("click", () => { setFiltersOpen(false); toggle?.focus(); }));

  const form = document.querySelector<HTMLFormElement>(".lv-catalog-filter");
  initProductSearchSuggestions(form);
  initAnimatedDetails(document, ".lv-filter-menu", ":scope > div");
  const section = document.querySelector<HTMLElement>(".lv-shop-products");
  const loading = document.querySelector<HTMLElement>("[data-catalog-loading]");
  const results = document.querySelector<HTMLElement>("[data-catalog-results]");
  const apply = form?.querySelector<HTMLButtonElement>(".lv-filter-apply");
  const showLoading = () => {
    if (!loading || !results || !section) return;
    loading.hidden = false;
    results.hidden = true;
    section.setAttribute("aria-busy", "true");
    if (apply) { apply.disabled = true; apply.textContent = "Applying…"; }
  };
  form?.addEventListener("submit", showLoading);
  document.querySelectorAll<HTMLDetailsElement>(".lv-filter-menu").forEach((menu) => {
    menu.addEventListener("change", (event) => {
      const input = event.target instanceof HTMLInputElement ? event.target : null;
      const value = menu.querySelector<HTMLElement>("[data-filter-value]");
      const label = input?.closest("label")?.querySelector("span")?.textContent;
      if (value && label) value.textContent = label;
    });
  });
  document.addEventListener("click", (event) => {
    const anchor = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>(".lv-catalog-filter a, .lv-catalog-pagination a, .lv-catalog-state a")
      : null;
    const mouseEvent = event instanceof MouseEvent ? event : null;
    if (anchor && mouseEvent && !event.defaultPrevented && !mouseEvent.metaKey && !mouseEvent.ctrlKey && !mouseEvent.shiftKey && !mouseEvent.altKey) showLoading();
  });
  document.addEventListener("keydown", (event) => {
    if (controls?.hasAttribute("data-open") && window.matchMedia("(max-width: 700px)").matches) {
      if (event.key === "Escape") { setFiltersOpen(false); toggle?.focus(); return; }
      if (event.key === "Tab") {
        const focusable = [...controls.querySelectorAll<HTMLElement>(filterFocusableSelector)].filter((element) => element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (first && last && event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (first && last && !event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
      return;
    }
  });
  window.addEventListener("pageshow", () => {
    if (loading) loading.hidden = true;
    if (results) results.hidden = false;
    section?.removeAttribute("aria-busy");
    if (apply) { apply.disabled = false; apply.textContent = "Apply filters"; }
  });
</script>

<style is:global lang="scss">@use "./styles/product-list.scss";</style>
