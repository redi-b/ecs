---
import "../styles/pages/contact.scss";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import type { StoreCategory } from "../../../../lib/commerce/types";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
  demoMode?: boolean;
  categories?: StoreCategory[];
}
const { data, themeTokens, tenantName, deferCartCount = false, demoMode = false, categories } = Astro.props;
const template = parseLuviaData(data);
const email = template.footer.email?.trim();
const phone = template.footer.phone?.trim();
const address = template.footer.address?.trim();
const socials = template.footer.socialLinks;
const sent = Astro.url.searchParams.get("sent") === "1";
const submitError = Astro.url.searchParams.get("error");
const locale =
  Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const inquiryMessages = {
  sending: m.contact_sending({}, { locale }),
  received: m.contact_received({}, { locale }),
  failed: m.contact_failed({}, { locale }),
};
const requestMessages = { sending: m.request_sending({}, { locale }), received: m.request_received({}, { locale }), failed: m.request_failed({}, { locale }) };
const initialMode = Astro.url.searchParams.get("mode") === "request" ? "request" : "contact";
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  categories={categories}
  title={m.contact_title({}, { locale })}
>
  <main id="main-content" class="contact">
    <header class="contact__hero">
      <h1 class="type-display">{m.contact_title({}, { locale })}</h1><p
        class="type-body-400"
      >
        {m.contact_intro({}, { locale })}
      </p>
    </header>
    <section class="contact__layout container">
      <div class="contact__aside">
        <article class="contact-info">
          <h2 class="type-heading-4">
            {m.contact_information({}, { locale })}
          </h2><div>
            {
              address && (
                <p>
                  <>
                    <span>
                      <Icon name="location" />
                    </span>
                    <span>
                      <>
                        <small class="type-body-xs">
                          {m.contact_address({}, { locale })}
                        </small>
                        <strong class="type-body-s-500">{address}</strong>
                      </>
                    </span>
                  </>
                </p>
              )
            }
            {
              email && (
                <p>
                  <>
                    <span>
                      <Icon name="mail" />
                    </span>
                    <span>
                      <>
                        <small class="type-body-xs">
                          {m.contact_email({}, { locale })}
                        </small>
                        <a class="type-body-s-500" href={`mailto:${email}`}>
                          {email}
                        </a>
                      </>
                    </span>
                  </>
                </p>
              )
            }
            {
              [phone, ...(template.footer.additionalPhones ?? [])]
                .filter(Boolean)
                .map((number) => (
                  <p>
                    <>
                      <span>
                        <Icon name="phone" />
                      </span>
                      <span>
                        <>
                          <small class="type-body-xs">
                            {m.contact_phone({}, { locale })}
                          </small>
                          <a class="type-body-s-500" href={`tel:${number}`}>
                            {number}
                          </a>
                        </>
                      </span>
                    </>
                  </p>
                ))
            }
            {
              socials.length > 0 && (
                <p>
                  <>
                    <span>
                      <Icon name="socials-web" />
                    </span>
                    <span>
                      <>
                        <small class="type-body-xs">
                          {m.contact_socials({}, { locale })}
                        </small>
                        <span class="contact-socials type-body-s-500">
                          {socials.map((social, index) => (
                            <>
                              <a href={social.href}>{social.label}</a>
                              {index < socials.length - 1 && " · "}
                            </>
                          ))}
                        </span>
                      </>
                    </span>
                  </>
                </p>
              )
            }
            {
              !address && !email && !phone && !socials.length && (
                <p class="contact-info__empty type-body-400">
                  {m.contact_empty({}, { locale })}
                </p>
              )
            }
          </div>
        </article>
      </div>
      <div class="inquiry-panel" data-inquiry-panel data-mode={initialMode}>
      <div class="inquiry-switcher" role="tablist" aria-label={m.contact_title({}, { locale })}>
        <button class="type-body-s-500" type="button" role="tab" aria-selected={initialMode === "contact" ? "true" : "false"} aria-controls="contact-form" data-inquiry-tab="contact">{m.contact_title({}, { locale })}</button>
        <button class="type-body-s-500" type="button" role="tab" aria-selected={initialMode === "request" ? "true" : "false"} aria-controls="request-form" data-inquiry-tab="request">{m.request_title({}, { locale })}</button>
      </div>
      <form
        class="contact-form" id="contact-form" role="tabpanel"
        action="/actions/inquiries"
        method="post"
        data-inquiry-form
        data-inquiry-kind="contact"
        hidden={initialMode !== "contact"}
      >
        <input type="hidden" name="type" value="contact" />
        <label class="inquiry-honeypot"
          ><span>Website</span><input
            name="website"
            tabindex="-1"
            autocomplete="off"
          /></label
        >
        <label class="is-wide type-body-s-400"
          ><span>{m.contact_full_name({}, { locale })}*</span><input
            class="type-body-400"
            name="fullName"
            required
            autocomplete="name"
          /></label
        >
        <label class="type-body-s-400"
          ><span>{m.contact_email({}, { locale })}*</span><input
            class="type-body-400"
            name="email"
            type="email"
            required
            autocomplete="email"
          /></label
        >
        <label class="type-body-s-400"
          ><span>{m.contact_whatsapp_optional({}, { locale })}</span><input
            class="type-body-400"
            name="whatsapp"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
          /></label
        >
        <label class="is-wide type-body-s-400"
          ><span>{m.contact_message({}, { locale })}*</span><textarea
            class="type-body-400"
            name="message"
            required></textarea></label
        >
        <button type="submit" class="type-body-l-500"
          ><span>{m.contact_send({}, { locale })}</span></button
        >
        <p
          class:list={[
            "inquiry-status",
            "type-body-s-400",
            sent && "is-success",
            submitError && "is-error",
          ]}
          role="status"
          aria-live="polite"
          data-inquiry-status
        >
          {
            sent
              ? inquiryMessages.received
              : submitError
                ? inquiryMessages.failed
                : ""
          }
        </p>
      </form>
      <form class="contact-form" id="request-form" role="tabpanel" action="/actions/inquiries" method="post" data-inquiry-form data-inquiry-kind="request" hidden={initialMode !== "request"}>
        <input type="hidden" name="type" value="product_request" />
        <label class="inquiry-honeypot"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
        <label class="type-body-s-400"><span>{m.request_product_name({}, { locale })}*</span><input class="type-body-400" name="productName" required /></label>
        <label class="type-body-s-400"><span>{m.request_brand_optional({}, { locale })}</span><input class="type-body-400" name="brand" /></label>
        <label class="is-wide type-body-s-400"><span>{m.request_link_optional({}, { locale })}</span><input class="type-body-400" name="productUrl" type="url" inputmode="url" placeholder="https://" /></label>
        <label class="type-body-s-400"><span>{m.request_your_name({}, { locale })}*</span><input class="type-body-400" name="customerName" required autocomplete="name" /></label>
        <label class="type-body-s-400"><span>{m.request_contact({}, { locale })}*</span><input class="type-body-400" name="contact" required /></label>
        <label class="is-wide type-body-s-400"><span>{m.request_details_optional({}, { locale })}</span><textarea class="type-body-400" name="details" placeholder={m.request_details_placeholder({}, { locale })}></textarea></label>
        <button type="submit" class="type-body-l-500"><span>{m.request_send({}, { locale })}</span></button>
        <p class:list={["inquiry-status type-body-s-400", sent && initialMode === "request" && "is-success", submitError && initialMode === "request" && "is-error"]} role="status" aria-live="polite" data-inquiry-status>{initialMode === "request" ? sent ? requestMessages.received : submitError ? requestMessages.failed : "" : ""}</p>
      </form>
      </div>
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ inquiryMessages, requestMessages }}>
  (() => {
    const panel = document.querySelector("[data-inquiry-panel]");
    const tabs = [...document.querySelectorAll("[data-inquiry-tab]")];
    const forms = [...document.querySelectorAll("[data-inquiry-form]")];
    const selectMode = (mode) => {
      panel?.setAttribute("data-mode", mode);
      tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.getAttribute("data-inquiry-tab") === mode)));
      forms.forEach((form) => { form.hidden = form.getAttribute("data-inquiry-kind") !== mode; });
    };
    tabs.forEach((tab) => tab.addEventListener("click", () => selectMode(tab.getAttribute("data-inquiry-tab") || "contact")));
    forms.forEach((form) => form.addEventListener("submit", async (event) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.reportValidity()) return;
      event.preventDefault();
      const messages = form.dataset.inquiryKind === "request" ? requestMessages : inquiryMessages;
      const status = form.querySelector("[data-inquiry-status]");
      const button = form.querySelector("button[type=submit]");
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      }
      if (status) {
        status.textContent = messages.sending;
        status.className = "inquiry-status is-pending";
      }
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(messages.failed);
        form.reset();
        if (status) {
          status.textContent = messages.received;
          status.className = "inquiry-status is-success";
        }
      } catch {
        if (status) {
          status.textContent = messages.failed;
          status.className = "inquiry-status is-error";
        }
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      }
    }));
  })();
</script>
