---
import type { StoreCustomerOrderDetail } from "../../../lib/commerce/account";
import { formatMoney } from "../../../lib/money";
import { formatOrderReference } from "../../../lib/order-reference";
import Button from "./Button.astro";
import Layout from "./Layout.astro";
import { parseNexahubData } from "./lib";
import "./styles/pages/commerce.scss";
import "./styles/pages/secondary.scss";
interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  order: StoreCustomerOrderDetail;
}
const { data, themeTokens, tenantName, cartCount, order } = Astro.props;
const template = parseNexahubData(data);
const reference = formatOrderReference(order.id, order.customDisplayId);
const placedAt = order.createdAt
  ? new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(order.createdAt))
  : "Date unavailable";
const stateLabel = {
  received: "Order received",
  preparing: "Being prepared",
  shipped: "Shipped",
  delivered: "Delivered",
  cancelled: "Cancelled",
}[order.fulfillmentState];
const money = (value: number | null) =>
  value == null ? "—" : formatMoney(value, order.currencyCode);
const address = order.shippingAddress;
const isPickup = /pickup|pick up|collect/i.test(order.shippingMethod ?? "");
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount}><main class="nexa-secondary" id="main-content"><div class="container nexa-secondary__frame"><nav class="nexa-breadcrumb" aria-label="Breadcrumb"><a href="/account">Account</a><span>/</span><span aria-current="page">Order {reference}</span></nav><header class="nexa-secondary__hero"><span>Customer order / {stateLabel}</span><div><h1>Order {reference}</h1><p>Placed {placedAt}</p></div></header><div class="nexa-order-status"><strong data-order-live-status>{stateLabel}</strong><button type="button" data-order-refresh aria-describedby="order-refresh-note">Refresh status</button><small id="order-refresh-note" data-order-refresh-note aria-live="polite">Status checked when this page opened</small></div><div class="nexa-secondary__split"><section class="nexa-data-panel"><header class="nexa-panel-head"><h2>Items</h2><span>{order.itemCount} records</span></header><ol class="nexa-order-items">{order.items.map((item,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div class="nexa-order-items__media">{item.thumbnail&&<img src={item.thumbnail} alt="" loading="lazy"/>}</div><div><strong>{item.title}</strong>{item.variantTitle&&<small>{item.variantTitle}</small>}<small>Quantity {item.quantity}</small></div><b>{money(item.total??(item.unitPrice==null?null:item.unitPrice*item.quantity))}</b></li>)}</ol></section><aside class="nexa-order-side"><section><header class="nexa-panel-head"><h2>Payment summary</h2><span>{order.currencyCode}</span></header><dl class="nexa-totals"><div><dt>Subtotal</dt><dd>{money(order.subtotal)}</dd></div>{Boolean(order.discountTotal&&order.discountTotal>0)&&<div><dt>Discount</dt><dd>−{money(order.discountTotal)}</dd></div>}<div><dt>Delivery</dt><dd>{money(order.shippingTotal)}</dd></div>{Boolean(order.taxTotal&&order.taxTotal>0)&&<div><dt>Tax</dt><dd>{money(order.taxTotal)}</dd></div>}<div class="nexa-totals__total"><dt>Total</dt><dd>{money(order.total)}</dd></div></dl></section><section data-order-live-fulfillment><header class="nexa-panel-head"><h2>Fulfillment</h2><span>{stateLabel}</span></header><div class="nexa-order-side__body"><p>{order.shippingMethod??"The shop will confirm the fulfillment method."}</p>{order.trackingNumber&&<p>Tracking number: <strong>{order.trackingNumber}</strong></p>}{order.trackingUrl&&<a href={order.trackingUrl} rel="noreferrer" target="_blank">Open carrier tracking ↗</a>}</div></section>{address&&!isPickup&&<section><header class="nexa-panel-head"><h2>Shipping address</h2><span>Delivery</span></header><address class="nexa-order-side__body"><strong>{[address.firstName,address.lastName].filter(Boolean).join(" ")}</strong><span>{address.address1}</span>{address.address2&&<span>{address.address2}</span>}<span>{[address.city,address.province,address.postalCode].filter(Boolean).join(", ")}</span>{address.phone&&<span>{address.phone}</span>}</address></section>}</aside></div><footer class="nexa-order-help"><div><span class="nexa-kicker">Need help?</span><h2>Question about this order?</h2><p>Keep reference {reference} ready when you contact the shop.</p></div><Button text="Contact the shop" href="/contact" variant="dark"/></footer></div></main></Layout>
<script>const button=document.querySelector<HTMLButtonElement>('[data-order-refresh]');const note=document.querySelector<HTMLElement>('[data-order-refresh-note]');button?.addEventListener('click',async()=>{if(button.disabled)return;button.disabled=true;button.dataset.busy='true';button.setAttribute('aria-busy','true');if(note)note.textContent='Checking for updates…';try{const response=await fetch(location.href,{cache:'no-store',credentials:'same-origin',headers:{Accept:'text/html'}});if(!response.ok)throw new Error();const next=new DOMParser().parseFromString(await response.text(),'text/html');for(const selector of ['[data-order-live-status]','[data-order-live-fulfillment]']){const current=document.querySelector(selector);const replacement=next.querySelector(selector);if(!current||!replacement)throw new Error();current.replaceWith(replacement);}if(note)note.textContent=`Updated at ${new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit'}).format(new Date())}`;}catch{if(note)note.textContent='Could not refresh. Try again.';}finally{button.disabled=false;delete button.dataset.busy;button.removeAttribute('aria-busy');}});</script>
<style>
  .nexa-secondary__hero h1{max-width:18ch;font-size:clamp(2.5rem,5.5vw,5.75rem);overflow-wrap:anywhere}.nexa-order-status{display:grid;grid-template-columns:max-content max-content minmax(0,1fr);gap:.65rem;align-items:center;border:1px solid color-mix(in srgb,var(--nexa-ink) 25%,transparent);border-radius:4px;padding:.75rem}.nexa-order-status strong{min-height:44px;display:inline-flex;align-items:center;background:var(--nexa-primary);color:var(--nexa-on-primary);padding:0 1rem;font:500 .7rem/1.2 "DM Mono",monospace;text-transform:uppercase}.nexa-order-status button{position:relative;min-height:44px;border:1px solid currentColor;background:transparent;padding:0 1rem;font:400 .7rem/1.2 "DM Mono",monospace;text-transform:uppercase;transition:background-color var(--nexa-motion-fast) var(--nexa-ease-out),color var(--nexa-motion-fast) var(--nexa-ease-out),opacity var(--nexa-motion-fast) var(--nexa-ease-out)}.nexa-order-status button:hover:not(:disabled){background:var(--nexa-ink);color:var(--nexa-bg)}.nexa-order-status button:disabled{opacity:.6}.nexa-order-status button[data-busy=true]{padding-right:2.5rem}.nexa-order-status button[data-busy=true]::after{content:"";position:absolute;right:.85rem;top:50%;width:.8rem;height:.8rem;margin-top:-.4rem;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:nexa-order-spin .7s linear infinite}.nexa-order-status small{justify-self:end;font:400 .68rem/1.3 "DM Mono",monospace}
  .nexa-order-items{list-style:none;padding:0;margin:0}.nexa-order-items li{display:grid;grid-template-columns:2rem 5rem 1fr auto;gap:1rem;align-items:center;padding:1rem}.nexa-order-items li+li{border-top:1px solid color-mix(in srgb,var(--nexa-ink) 15%,transparent)}.nexa-order-items__media{aspect-ratio:1;overflow:hidden;background:var(--nexa-muted)}.nexa-order-items img{width:100%;height:100%;object-fit:cover}.nexa-order-items li>span,.nexa-order-items small,.nexa-order-items b{font:400 .68rem/1.3 "DM Mono",monospace}.nexa-order-items li>div:nth-of-type(2){display:grid;gap:.3rem}.nexa-order-items strong{font:500 .9rem/1.2 "Space Grotesk",sans-serif}
  .nexa-order-side{display:grid;gap:1rem}.nexa-order-side>section{overflow:hidden;border:1px solid color-mix(in srgb,var(--nexa-ink) 25%,transparent);border-radius:4px;background:color-mix(in srgb,var(--nexa-bg) 96%,white);box-shadow:0 18px 50px color-mix(in srgb,var(--nexa-ink) 5%,transparent)}.nexa-order-side .nexa-totals{padding:1rem}.nexa-order-side__body{display:grid;gap:.5rem;padding:1rem;font:400 .72rem/1.5 "DM Mono",monospace;font-style:normal}.nexa-order-side__body a{color:var(--nexa-primary);text-decoration:underline;text-underline-offset:4px}.nexa-order-help{display:flex;justify-content:space-between;gap:2rem;align-items:end;border-block:1px solid color-mix(in srgb,var(--nexa-ink) 25%,transparent);padding-block:2rem}.nexa-order-help h2{margin:.5rem 0;font:500 clamp(2rem,4vw,4rem)/.95 "Space Grotesk",sans-serif;text-transform:uppercase}.nexa-order-help p{font:400 .72rem/1.4 "DM Mono",monospace}@keyframes nexa-order-spin{to{transform:rotate(360deg)}}
  @media(max-width:600px){.nexa-order-status{grid-template-columns:1fr}.nexa-order-items li{grid-template-columns:1.5rem 4rem 1fr}.nexa-order-items b{grid-column:3}.nexa-order-help{align-items:start;flex-direction:column}}
</style>
