---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";
import TemplatesSection from "../components/TemplatesSection.astro";
import PricingSection from "../components/PricingSection.astro";
import { getDashboardUrls, getPublicCatalogs } from "../lib/platform";
import { Image } from "astro:assets";

const placeholderPixel =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

// Hero Assets
import heroBannerDesktop from "../assets/hero-banner.webp";
import heroBannerTab from "../assets/hero-banner-tab.webp";
import heroBannerMb from "../assets/hero-banner-mb.webp";
import avatar1Img from "../assets/customer-avatar-1.png";
import avatar2Img from "../assets/customer-avatar-2.png";
import avatar3Img from "../assets/customer-avatar-3.png";
import webTemplate1 from "../assets/web-template-1.png";
import webTemplate2 from "../assets/web-template-2.png";
import webTemplate3 from "../assets/web-template-3.png";
import webTemplate4 from "../assets/web-template-4.png";
import webTemplate5 from "../assets/web-template-5.png";
import webTemplate6 from "../assets/web-template-6.png";
import webTemplate7 from "../assets/web-template-7.png";

// Pain Section Assets & Components
import ChatBubble from "../components/ChatBubble.astro";
import DemoVideo from "../components/DemoVideo.astro";
import painSubjectImg from "../assets/pain-section-subject.png";
import handDrawnArrow from "../assets/hand-drawn-arrow.svg";

// Section 3: Features Split Assets
import storefrontPhoneImg from "../assets/storefront-mockup-phone.png";
import storefrontUserModel from "../assets/storefront-user-model.png";
import dashboardTabletImg from "../assets/dashboard-mockup-tablet.png";
import dashboardUserModel from "../assets/dashboard-user-model.png";
import incomeTrackingArt from "../assets/income-tracking-art.svg";
import inventoryTrackingArt from "../assets/inventory-tracking-art.svg";

// Section 4: Storefront Features Assets
import { Icon } from "astro-icon/components";
import storefrontProductMockup from "../assets/storefront-product-mockup.png";

// Section 5: Shop Features Assets
import dashboardFeaturesMockup from "../assets/dashboard-features-mockup.png";

// Section 7: Ecom Templates Assets
import ecomTemplate1Preview from "../assets/ecom-template-1-preview.png";
import ecomTemplate2Preview from "../assets/ecom-template-2-preview.png";
import ecomTemplate3Preview from "../assets/ecom-template-3-preview.png";
import "swiper/css";

// Sections 9 & 10 Components
import CtaSection from "../components/CtaSection.astro";
import Footer from "../components/Footer.astro";

const storefrontFeatures = [
  {
    num: "/01",
    title: "Full Product Catalog",
    desc: "Customers can see your entire product range in one clean place instead of scrolling through old posts. Everything is organised and easy to explore.",
    icon: "feat-products-icon",
    active: true,
  },
  {
    num: "/02",
    title: "Real Prices & Availability",
    desc: "Display live prices and clear stock status so customers know exactly what is ready to buy without asking in DMs.",
    icon: "feat-prices-icon",
  },
  {
    num: "/03",
    title: "Easy to Find & Choose",
    desc: "Smart search, categories, and filters make finding and selecting the right product fast and effortless for shoppers.",
    icon: "feat-search-icon",
  },
  {
    num: "/04",
    title: "Order Without Messaging",
    desc: "Customers can add items to cart and check out in seconds without waiting for someone to reply to their messages.",
    icon: "feat-order-icon",
  },
  {
    num: "/05",
    title: "Local Payment Methods",
    desc: "Accept trusted local payment options including Telebirr and all local banks and wallets directly during checkout.",
    icon: "feat-payment-icon",
  },
  {
    num: "/06",
    title: "Amharic Language Support",
    desc: "A seamless localized shopping experience in Amharic so your customers can browse and buy in their preferred language.",
    icon: "feat-lang-icon",
  },
  {
    num: "/07",
    title: "Telegram Mini App Support",
    desc: "Launch your storefront inside Telegram so shoppers can browse and complete purchases directly within the Telegram app.",
    icon: "feat-tg-icon",
  },
];

const shopFeatures = [
  {
    id: "product-mgmt",
    title: "Product Management",
    desc: "Add, edit, and organise all your products in one place. Keep everything structured and easy to update as your catalogue grows.",
    icon: "feat-products-icon",
    active: false,
  },
  {
    id: "stock-control",
    title: "Stock & Inventory Control",
    desc: "Track stock levels accurately across your website and physical shop. Avoid overselling and always know what you have available.",
    icon: "shop-feat-stock-icon",
    active: true,
  },
  {
    id: "orders",
    title: "Online + Walk-in Orders",
    desc: "Record sales from your website and from your physical shop in the same system so nothing gets missed or double-counted.",
    icon: "feat-order-icon",
    active: false,
  },
  {
    id: "discounts",
    title: "Discounts & Campaigns",
    desc: "Create promotions and holiday discounts easily. Update prices in one place instead of changing every post manually.",
    icon: "feat-prices-icon",
    active: false,
  },
  {
    id: "payments",
    title: "Payment Tracking",
    desc: "Accept and track payments from Telebirr and all local banks and digital wallets so you always know what has been received.",
    icon: "feat-payment-icon",
    active: false,
  },
  {
    id: "telegram-whatsapp",
    title: "Telegram & WhatsApp Integration",
    desc: "Connect your store to Telegram and WhatsApp so you can receive order notifications instantly and even manage stock or check key updates directly from the chat.",
    icon: "feat-chat-icon",
    active: false,
  },
  {
    id: "sales-insights",
    title: "Sales Insights",
    desc: "Understand what is selling, what is sitting, and how your business is performing without doing the calculations yourself.",
    icon: "feat-insights-icon",
    active: false,
  },
  {
    id: "amharic-dash",
    title: "Amharic Dashboard Support",
    desc: "Use the dashboard in Amharic, making it easier and more comfortable to manage your business in the language you prefer.",
    icon: "feat-lang-icon",
    active: false,
  },
];

const templates = [
  {
    title: "Storefront Template 1",
    desc: "Suitable for all businesses selling cosmetics items or clothes.",
    image: ecomTemplate1Preview,
  },
  {
    title: "Storefront Template 3",
    desc: "Suitable for all businesses selling fashion, bags, or luxury goods.",
    image: ecomTemplate3Preview,
  },
  {
    title: "Storefront Template 2",
    desc: "Ideal for any business that offers technology-related products.",
    image: ecomTemplate2Preview,
  },
  {
    title: "Storefront Template 4",
    desc: "Suitable for all businesses selling cosmetics items or clothes.",
    image: ecomTemplate3Preview,
  },
];

const dashboardUrls = getDashboardUrls();
const publicCatalogs = await getPublicCatalogs();

const templateCards = publicCatalogs.templates.length
  ? publicCatalogs.templates.map((template, index) => ({
      name: template.name,
      description: template.description,
      image: template.version.previewUrl || templates[index % templates.length]?.image || ecomTemplate1Preview,
      imageAlt: template.version.previewAltText || `${template.name} storefront preview`,
      demoUrl: template.version.demoUrl || null,
    }))
  : templates.map((template) => ({
      name: template.title,
      description: template.desc,
      image: template.image,
      imageAlt: `${template.title} storefront preview`,
      demoUrl: null,
    }));

const pricingPlans = publicCatalogs.plans;

Astro.response.headers.set("cache-control", "public, max-age=300, stale-while-revalidate=3600");

import "../styles/pages/index.scss";
---

<Layout
  title="ECS — Make Shopping Easier For Your Buyers"
  description="Set up a branded website in minutes with automated inventory tracking, seamless payment integration and shopping cart."
>
  <Header demoUrl={dashboardUrls.demo} signUpUrl={dashboardUrls.signUp} />

  <main class="home">
    <!-- 1. Hero Section -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true">
        <ResponsivePicture
          sources={[
            { media: "(max-width: 450px)", src: heroBannerMb, width: 450 },
            { media: "(max-width: 833px)", src: heroBannerTab, width: 833 },
            { media: "(min-width: 834px)", src: heroBannerDesktop, width: 1440 },
          ]}
          alt=""
          loading="eager"
          fetchpriority="high"
          class="hero__bg-img"
          pictureClass="hero__bg-picture"
        />
      </div>
      <div class="container hero__wrapper">
        <div class="hero__content">
          <!-- Main Headline -->
          <h1 class="hero__title type-header-1" data-text-anim="tl:headerAnimation">
