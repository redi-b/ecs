---
import Icon from "../components/Icon.astro";
import type { StoreCustomer, StoreCustomerAddress } from "../../../../lib/commerce/account";
import { resolveStoreCartSummary } from "../../../../lib/commerce/cart-summary";
import { resolveStoreFulfillmentOptions } from "../../../../lib/commerce/fulfillment";
import type {
  StoreCart,
  StoreDeliveryOptions,
  StorePaymentOptions,
  StoreShippingOption,
} from "../../../../lib/commerce/types";
import { formatMoney } from "../../../../lib/money";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { parseNexahubData } from "../lib";
import "../styles/pages/commerce.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  cart: StoreCart | null;
  delivery: StoreDeliveryOptions | null;
  payment: StorePaymentOptions;
  shippingOptions: StoreShippingOption[];
  shippingError?: string | null;
  error?: string | null;
  customer?: StoreCustomer | null;
  customerAddresses?: StoreCustomerAddress[];
  demoMode?: boolean;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  cart,
  delivery,
  payment,
  shippingOptions,
  shippingError,
  error,
  customer = null,
  customerAddresses = [],
  demoMode = false,
} = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const items = cart?.items ?? [];
const deliveryEnabled = delivery?.deliveryEnabled === true;
const pickupEnabled = delivery?.pickupEnabled === true;
const fulfillmentAvailable = deliveryEnabled || pickupEnabled;
const phoneRequired = true;
const defaultChoice = deliveryEnabled ? "delivery" : pickupEnabled ? "pickup" : "delivery";
const { deliveryOptions, pickupOption, priceMismatch } = resolveStoreFulfillmentOptions(
  shippingOptions,
  delivery,
);
const canSubmit =
  items.length > 0 &&
  fulfillmentAvailable &&
  !priceMismatch &&
  (defaultChoice === "pickup" ? Boolean(pickupOption) : deliveryOptions.length > 0);
const initialShippingAmount =
  defaultChoice === "pickup" ? (pickupOption?.amount ?? 0) : (deliveryOptions[0]?.amount ?? 0);
const baseTotal = (cart?.total ?? cart?.itemTotal ?? 0) - (cart?.shippingTotal ?? 0);
const summary = resolveStoreCartSummary(cart);
const defaultPayment = payment.cod ? "cod" : payment.chapa ? "chapa" : null;
const defaultAddress =
  customerAddresses.find((address) => address.isDefaultShipping) ?? customerAddresses[0] ?? null;
const clientMessages = {
  applyFailed: m.checkout_code_failed({}, { locale }),
  applied: m.checkout_code_applied({}, { locale }),
  openingPayment: m.checkout_opening_payment({}, { locale }),
  optional: m.checkout_optional({}, { locale }),
  placeOrder: m.checkout_place_order({}, { locale }),
  placingOrder: m.checkout_placing_order({}, { locale }),
  requiredForChapa: m.checkout_email_required_chapa({}, { locale }),
  securePayment: m.checkout_continue_payment({}, { locale }),
};
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} demoMode={demoMode}>
  <main class="nexa-commerce nexa-checkout" id="main-content">
    <div class="container nexa-commerce__frame">
      <nav class="nexa-breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/cart">{m.nav_cart({}, { locale })}</a><span>/</span><span aria-current="page">{m.checkout_title({}, { locale })}</span></nav>
      <header class="nexa-commerce__heading"><span class="nexa-kicker">{m.checkout_title({}, { locale })}</span><div><h1>{m.checkout_title({}, { locale })}</h1><p>{m.checkout_intro({}, { locale })}</p></div></header>
      {error && <div class="nexa-notice nexa-notice--error" role="alert"><strong>{m.checkout_could_not_continue({}, { locale })}</strong><p>{error}</p></div>}
      {shippingError && <div class="nexa-notice nexa-notice--error" role="alert"><strong>{m.checkout_options_unavailable({}, { locale })}</strong><p>{m.checkout_refresh_try_again({}, { locale })}</p></div>}
      {priceMismatch && <div class="nexa-notice nexa-notice--error" role="alert"><strong>{m.checkout_delivery_price_updating({}, { locale })}</strong><p>{m.checkout_refresh_or_contact({}, { locale })}</p></div>}
      {!items.length ? <section class="nexa-empty"><span class="nexa-empty__index">00</span><h2>{m.cart_empty({}, { locale })}</h2><p>{m.checkout_empty_help({}, { locale })}</p><Button text={m.action_browse_products({}, { locale })} href="/products" /></section> : <div class="nexa-commerce__split">
        <section class="nexa-checkout-form-panel">
          <header class="nexa-panel-head"><h2>{m.checkout_customer_fulfillment({}, { locale })}</h2><span>{m.checkout_required_fields({}, { locale })} *</span></header>
          <form class="nexa-checkout-form" method="post" action={defaultPayment === "chapa" ? "/actions/checkout/chapa" : "/actions/checkout/cod"} data-checkout-form>
            {!fulfillmentAvailable && <div class="nexa-notice" role="status"><strong>{m.checkout_orders_unavailable({}, { locale })}</strong><p>{m.checkout_fulfillment_unavailable({}, { locale })}</p></div>}
            <fieldset class="nexa-fieldset"><legend>01 / {m.checkout_contact({}, { locale })}</legend><div class="nexa-field-grid"><label><span>{m.checkout_first_name({}, { locale })} *</span><input name="firstName" value={defaultAddress?.firstName || customer?.firstName} required autocomplete="given-name" /></label><label><span>{m.checkout_last_name({}, { locale })} *</span><input name="lastName" value={defaultAddress?.lastName || customer?.lastName} required autocomplete="family-name" /></label><label><span>{m.checkout_phone({}, { locale })} {phoneRequired ? "*" : ""}</span><input name="phone" value={defaultAddress?.phone || customer?.phone} required={phoneRequired} autocomplete="tel" inputmode="tel" /></label><label><span>{m.checkout_email({}, { locale })} <small data-email-requirement>({defaultPayment === "chapa" ? m.checkout_required({}, { locale }) : m.checkout_optional({}, { locale })})</small></span><input name="email" value={customer?.email} type="email" required={defaultPayment === "chapa"} autocomplete="email" /></label></div>{customer ? <p class="nexa-account-note">{m.checkout_signed_in_as({ email: customer.email }, { locale })}</p> : <p class="nexa-account-note">{m.checkout_account_benefit({}, { locale })} <a href="/account?mode=register">{m.account_create({}, { locale })}</a>.</p>}</fieldset>

            <fieldset class="nexa-fieldset" data-delivery-choice><legend>02 / {m.checkout_fulfillment({}, { locale })}</legend><div class="nexa-choice-grid">{deliveryEnabled && <label class="nexa-choice"><input type="radio" name="deliveryChoice" value="delivery" checked={defaultChoice === "delivery"} /><span><strong>{m.checkout_delivery({}, { locale })}</strong><small>{m.checkout_delivery_help({}, { locale })}</small></span></label>}{pickupEnabled && <label class="nexa-choice"><input type="radio" name="deliveryChoice" value="pickup" checked={defaultChoice === "pickup"} /><span><strong>{m.checkout_pickup({}, { locale })}</strong><small>{m.checkout_pickup_help({}, { locale })}</small></span></label>}</div></fieldset>

            <section class="nexa-fieldset" data-delivery-field><h3>{m.checkout_delivery_address({}, { locale })}</h3>{customerAddresses.length > 0 && <fieldset class="nexa-saved-addresses" data-saved-addresses><legend>{m.checkout_saved_addresses({}, { locale })}</legend><div class="nexa-choice-grid">{customerAddresses.map((address) => <label class="nexa-choice"><input type="radio" name="savedAddressId" value={address.id} checked={address.id === defaultAddress?.id} data-address={JSON.stringify(address)} /><span><strong>{address.addressName || `${address.firstName} ${address.lastName}`}</strong><small>{address.address1}, {address.city}</small></span></label>)}<label class="nexa-choice"><input type="radio" name="savedAddressId" value="" checked={!defaultAddress} /><span><strong>{m.checkout_different_address({}, { locale })}</strong><small>{m.checkout_enter_details({}, { locale })}</small></span></label></div></fieldset>}<div class="nexa-field-grid"><label><span>{m.checkout_city({}, { locale })} *</span><input name="city" value={defaultAddress?.city || "Addis Ababa"} required={defaultChoice === "delivery"} autocomplete="address-level2" /></label><label><span>{m.checkout_street_address({}, { locale })} *</span><input name="address1" value={defaultAddress?.address1} required={defaultChoice === "delivery"} autocomplete="street-address" /></label>{(delivery?.landmarkRequired || delivery?.notesEnabled !== false) && <label class="is-wide"><span>{m.checkout_landmark({}, { locale })} {delivery?.landmarkRequired ? "*" : `(${m.checkout_optional({}, { locale })})`}</span><input name="landmark" required={Boolean(delivery?.landmarkRequired) && defaultChoice === "delivery"} data-landmark-required={delivery?.landmarkRequired ? "true" : "false"} /></label>}</div>{customer && <div class="nexa-save-address" data-save-address hidden={Boolean(defaultAddress)}><label><input type="checkbox" name="saveAddress" value="true" data-save-address-toggle /> {m.checkout_save_address({}, { locale })}</label><label><span>{m.checkout_address_label({}, { locale })}</span><input name="addressName" value={m.account_home({}, { locale })} /></label></div>}</section>

<fieldset class="nexa-fieldset" data-delivery-option><legend>03 / {m.checkout_delivery_option({}, { locale })}</legend><div class="nexa-choice-grid">{deliveryOptions.map((option, index) => <label class="nexa-choice"><input type="radio" name="shippingOptionId" value={option.id} data-amount={option.amount ?? 0} checked={index === 0} required={defaultChoice === "delivery"} /><span><strong>{option.name?.trim() || m.checkout_standard_delivery({}, { locale })}</strong><small>{option.amount === 0 ? m.checkout_free({}, { locale }) : formatMoney(option.amount, option.currencyCode ?? cart?.currencyCode, locale)}</small></span></label>)}</div></fieldset><div data-pickup-option hidden>{template.footer.address && <p>{m.checkout_collect_from({ address: template.footer.address }, { locale })} {template.footer.phone && <a href={`tel:${template.footer.phone}`}>{template.footer.phone}</a>}</p>}{pickupOption && <input type="hidden" name="shippingOptionId" value={pickupOption.id} disabled={defaultChoice !== "pickup"} />}</div>
            {delivery?.notesEnabled !== false && <label class="nexa-textarea"><span>{m.checkout_order_notes({}, { locale })} ({m.checkout_optional({}, { locale })})</span><textarea name="notes" rows="3"></textarea></label>}
            <fieldset class="nexa-fieldset" data-payment-choice><legend>04 / {m.checkout_payment({}, { locale })}</legend><div class="nexa-choice-grid">{payment.cod && <label class="nexa-choice"><input type="radio" name="paymentMethod" value="cod" checked={defaultPayment === "cod"} /><span><strong>{m.checkout_pay_on_delivery({}, { locale })}</strong><small>{m.checkout_pay_on_delivery_help({}, { locale })}</small></span></label>}{payment.chapa && <label class="nexa-choice"><input type="radio" name="paymentMethod" value="chapa" checked={defaultPayment === "chapa"} /><span><strong>Chapa</strong><small>{m.checkout_chapa_short({}, { locale })}</small></span></label>}</div>{!defaultPayment && <p>{m.checkout_no_payment({}, { locale })}</p>}</fieldset>
            <button class="nexa-primary-action" type="submit" data-place-order disabled={!canSubmit || !defaultPayment}><span data-place-order-label>{defaultPayment === "chapa" ? m.checkout_continue_payment({}, { locale }) : m.checkout_place_order({}, { locale })}</span><span class="nexa-primary-action__icon" aria-hidden="true"><Icon name="arrow-up-right" /></span></button>
          </form>
        </section>

        <aside class="nexa-summary nexa-checkout-summary" aria-label={m.cart_order_summary({}, { locale })} data-currency={cart?.currencyCode ?? "ETB"} data-base-total={baseTotal} data-locale={locale === "am" ? "am-ET" : "en-ET"} data-free-label={m.checkout_free({}, { locale })}>
          <header class="nexa-panel-head"><h2>{m.cart_order_summary({}, { locale })}</h2><span>{m.cart_item_count({ count: summary.itemCount }, { locale })}</span></header>
          <ol class="nexa-summary-items">{items.map((item) => <li><div>{item.thumbnail && <img src={item.thumbnail} alt="" />}</div><p><strong>{item.title ?? m.product_fallback_name({}, { locale })}</strong><small>{item.variantTitle}{item.quantity > 1 ? ` × ${item.quantity}` : ""}</small></p><b>{formatMoney(item.total ?? item.unitPrice, cart?.currencyCode, locale)}</b></li>)}</ol>
          <div class="nexa-discount" data-discount-code><label for="nexa-checkout-code">{m.cart_promotion_code({}, { locale })}</label><form method="post" action="/actions/cart/promotion" data-cart-promotion-form><input type="hidden" name="intent" value="apply" /><input id="nexa-checkout-code" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" required /><button type="submit">{m.action_apply({}, { locale })}</button></form><p class="nexa-live" data-discount-status aria-live="polite"></p></div>
          <dl class="nexa-totals"><div><dt>{m.cart_subtotal({}, { locale })}</dt><dd data-summary-subtotal>{formatMoney(summary.subtotal, cart?.currencyCode, locale)}</dd></div><div data-summary-discount hidden={!summary.savingsTotal}><dt>{m.cart_discount({}, { locale })}</dt><dd data-summary-discount-value>−{formatMoney(summary.savingsTotal, cart?.currencyCode, locale)}</dd></div><div><dt>{m.cart_delivery({}, { locale })}</dt><dd data-summary-delivery>{initialShippingAmount === 0 ? m.checkout_free({}, { locale }) : formatMoney(initialShippingAmount, cart?.currencyCode, locale)}</dd></div><div class="nexa-totals__total"><dt>{m.checkout_estimated_total({}, { locale })}</dt><dd data-summary-total>{formatMoney(baseTotal + initialShippingAmount, cart?.currencyCode, locale)}</dd></div></dl>
        </aside>
      </div>}
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ clientMessages }}>
  (() => {
    const form = document.querySelector('[data-checkout-form]'); if (!(form instanceof HTMLFormElement)) return;
    const selected = (name) => form.querySelector(`input[name="${name}"]:checked`)?.value;
    const setValue = (name, value) => { const field = form.elements.namedItem(name); if (field instanceof HTMLInputElement) field.value = String(value || ''); };
    document.querySelector('[data-saved-addresses]')?.addEventListener('change', (event) => { const field = event.target; if (!(field instanceof HTMLInputElement) || field.name !== 'savedAddressId') return; let address = null; try { address = field.dataset.address ? JSON.parse(field.dataset.address) : null; } catch {} if (address) Object.entries({ firstName: address.firstName, lastName: address.lastName, phone: address.phone, address1: address.address1, city: address.city }).forEach(([name, value]) => setValue(name, value)); });
    const summary = document.querySelector('[data-base-total]'); const money = (amount) => new Intl.NumberFormat(summary?.dataset.locale || 'en-ET', { style: 'currency', currency: summary?.dataset.currency || 'ETB' }).format(amount);
    const syncSummary = () => { const shipping = form.querySelector('input[name="shippingOptionId"]:checked'); const amount = selected('deliveryChoice') === 'pickup' ? 0 : Number(shipping?.dataset.amount || 0); const deliveryNode = document.querySelector('[data-summary-delivery]'); const totalNode = document.querySelector('[data-summary-total]'); if (deliveryNode) deliveryNode.textContent = amount ? money(amount) : (summary?.dataset.freeLabel || ''); if (totalNode) totalNode.textContent = money(Number(summary?.dataset.baseTotal || 0) + amount); };
    const syncFulfillment = () => { const delivery = selected('deliveryChoice') === 'delivery'; document.querySelectorAll('[data-delivery-field]').forEach((node) => { node.hidden = !delivery; node.querySelectorAll('input,textarea,select').forEach((field) => field.disabled = !delivery); }); const deliveryOptions = document.querySelector('[data-delivery-option]'); const pickup = document.querySelector('[data-pickup-option]'); if (deliveryOptions) { deliveryOptions.hidden = !delivery; deliveryOptions.querySelectorAll('input').forEach((field) => { field.disabled = !delivery; field.required = delivery; }); } if (pickup) { pickup.hidden = delivery; pickup.querySelectorAll('input').forEach((field) => field.disabled = delivery); } syncSummary(); };
    form.querySelector('[data-delivery-choice]')?.addEventListener('change', syncFulfillment); form.querySelector('[data-delivery-option]')?.addEventListener('change', syncSummary);
    const syncPayment = () => { const chapa = selected('paymentMethod') === 'chapa'; form.action = chapa ? '/actions/checkout/chapa' : '/actions/checkout/cod'; const email = form.elements.namedItem('email'); if (email instanceof HTMLInputElement) email.required = chapa; const note = form.querySelector('[data-email-requirement]'); if (note) note.textContent = `(${chapa ? clientMessages.requiredForChapa : clientMessages.optional})`; const label = form.querySelector('[data-place-order-label]'); if (label) label.textContent = chapa ? clientMessages.securePayment : clientMessages.placeOrder; };
    form.querySelector('[data-payment-choice]')?.addEventListener('change', syncPayment); syncFulfillment(); syncPayment();
    const promotionCode = document.querySelector('#nexa-checkout-code');
    if (promotionCode instanceof HTMLInputElement) promotionCode.addEventListener('input', () => { const start = promotionCode.selectionStart; const end = promotionCode.selectionEnd; promotionCode.value = promotionCode.value.toLocaleUpperCase(); if (start !== null && end !== null) promotionCode.setSelectionRange(start, end); });
    document.querySelector('[data-cart-promotion-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const promotionForm = event.currentTarget; if (!(promotionForm instanceof HTMLFormElement)) return; const status = document.querySelector('[data-discount-status]'); const button = event.submitter; status?.classList.remove('is-error'); if (button instanceof HTMLButtonElement) { button.disabled = true; button.dataset.busy = 'true'; button.setAttribute('aria-busy', 'true'); } promotionForm.setAttribute('aria-busy', 'true'); try { const response = await fetch(promotionForm.action, { method: 'POST', body: new FormData(promotionForm), credentials: 'same-origin', headers: { Accept: 'application/json' } }); const result = await response.json(); if (!response.ok || !result.ok) throw new Error(clientMessages.applyFailed); if (status) status.textContent = clientMessages.applied; window.dispatchEvent(new CustomEvent('ecs:cart-updated', { detail: { ...result, openDrawer: false } })); } catch (cause) { if (status) { status.textContent = cause instanceof Error ? cause.message : clientMessages.applyFailed; status.classList.add('is-error'); } } finally { promotionForm.removeAttribute('aria-busy'); if (button instanceof HTMLButtonElement) { button.disabled = false; delete button.dataset.busy; button.removeAttribute('aria-busy'); } } });
    form.addEventListener('submit', (event) => { const button = event.submitter; if (button instanceof HTMLButtonElement) { button.disabled = true; const label = button.querySelector('[data-place-order-label]'); if (label) label.textContent = selected('paymentMethod') === 'chapa' ? clientMessages.openingPayment : clientMessages.placingOrder; } });
  })();
</script>
