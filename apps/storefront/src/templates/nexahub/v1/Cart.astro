---
import { resolveStoreCartSummary } from "../../../lib/commerce/cart-summary";
import type { StoreCart } from "../../../lib/commerce/types";
import { formatMoney } from "../../../lib/money";
import arrowIcon from "./icons/arrow-up-right.svg?raw";
import arrowRightIcon from "./icons/arrow-right-icon.svg?raw";
import minusIcon from "./icons/minus-icon.svg?raw";
import plusIcon from "./icons/plus-icon.svg?raw";
import Button from "./Button.astro";
import Layout from "./Layout.astro";
import { parseNexahubData } from "./lib";
import "./styles/pages/commerce.scss";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  cart: StoreCart | null;
  error?: string | null;
  discountError?: string | null;
  demoMode?: boolean;
}
const { data, themeTokens, tenantName, cartCount, cart, error, discountError, demoMode = false } = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const items = cart?.items ?? [];
const itemCount = items.reduce((total, item) => total + item.quantity, 0);
const summary = resolveStoreCartSummary(cart);
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} demoMode={demoMode}>
  <main class="nexa-commerce" id="main-content" data-cart-page data-locale={locale === "am" ? "am-ET" : "en-ET"} data-item-count={m.cart_item_count({ count: "__COUNT__" }, { locale })} data-ready-count={m.cart_ready_count({ count: "__COUNT__" }, { locale })} data-updating={m.cart_updating({}, { locale })} data-update-failed={m.cart_update_failed({}, { locale })}>
    <div class="container nexa-commerce__frame">
      <nav class="nexa-breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/">{m.nav_home({}, { locale })}</a><span>/</span><span aria-current="page">{m.nav_cart({}, { locale })}</span></nav>
      <header class="nexa-commerce__heading"><span class="nexa-kicker">{m.cart_selection_eyebrow({}, { locale })}</span><div><h1>{m.cart_title({}, { locale })}</h1><p data-page-item-count>{m.cart_ready_count({ count: itemCount }, { locale })}</p></div></header>
      {error && <div class="nexa-notice nexa-notice--error" role="alert"><strong>{m.cart_unavailable({}, { locale })}</strong><p>{error}</p></div>}
      <p class="nexa-live" data-cart-page-status aria-live="polite"></p>

      {!items.length ? <section class="nexa-empty" data-cart-page-empty><span class="nexa-empty__index">00</span><h2>{m.cart_empty({}, { locale })}</h2><p>{m.cart_empty_help({}, { locale })}</p><Button text={m.action_browse_products({}, { locale })} href="/products" /></section> : <div class="nexa-commerce__split" data-cart-page-layout>
        <section class="nexa-lines" aria-label={m.cart_items_label({}, { locale })} data-cart-page-lines>
          <header class="nexa-panel-head"><span>{m.cart_items_label({}, { locale })}</span><span>{m.cart_total({}, { locale })}</span></header>
          {items.map((item, index) => <article class="nexa-line" data-cart-line={item.id}>
            <span class="nexa-line__index">{String(index + 1).padStart(2, "0")}</span>
            <a class="nexa-line__media" href={item.productHandle ? `/products/${encodeURIComponent(item.productHandle)}` : "/products"}>{(item.imageUrl || item.thumbnail) ? <img src={item.imageUrl || item.thumbnail} alt="" /> : <span>{m.catalog_no_image({}, { locale })}</span>}</a>
            <div class="nexa-line__copy"><a href={item.productHandle ? `/products/${encodeURIComponent(item.productHandle)}` : "/products"}>{item.title ?? m.catalog_product_fallback({}, { locale })}</a>{item.variantTitle && <span>{item.variantTitle}</span>}<small>{formatMoney(item.unitPrice, cart?.currencyCode, locale)} {m.cart_each({}, { locale })}</small></div>
            <div class="nexa-line__controls"><div class="nexa-stepper"><form method="post" action="/actions/cart/update" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><input type="hidden" name="quantity" value={Math.max(1, item.quantity - 1)} /><button type="submit" aria-label={m.action_decrease_quantity({}, { locale })} disabled={item.quantity <= 1}><Fragment set:html={minusIcon} /></button></form><span data-line-quantity>{item.quantity}</span><form method="post" action="/actions/cart/update" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><input type="hidden" name="quantity" value={item.quantity + 1} /><button type="submit" aria-label={m.action_increase_quantity({}, { locale })}><Fragment set:html={plusIcon} /></button></form></div><strong data-line-total>{formatMoney(item.total ?? item.unitPrice, cart?.currencyCode, locale)}</strong><form method="post" action="/actions/cart/remove" data-cart-page-form><input type="hidden" name="lineItemId" value={item.id} /><button class="nexa-text-action" type="submit">{m.action_remove({}, { locale })}</button></form></div>
          </article>)}
          <a class="nexa-back-link" href="/products"><span class="nexa-back-link__icon" aria-hidden="true"><Fragment set:html={arrowRightIcon} /></span>{m.action_continue_shopping({}, { locale })}</a>
        </section>

        <aside class="nexa-summary" aria-label={m.cart_order_summary({}, { locale })}>
          <header class="nexa-panel-head"><h2>{m.cart_order_summary({}, { locale })}</h2><span data-summary-count>{m.cart_item_count({ count: itemCount }, { locale })}</span></header>
          <div class="nexa-discount" data-discount-code><label for="nexa-cart-code">{m.cart_promotion_code({}, { locale })}</label><form method="post" action="/actions/cart/promotion" data-cart-promotion-form><input type="hidden" name="intent" value="apply" /><input id="nexa-cart-code" name="code" autocomplete="off" placeholder={m.cart_code_placeholder({}, { locale })} required /><button type="submit">{m.action_apply({}, { locale })}</button></form><div data-applied-promotions>{summary.appliedCodes.map((promotion) => <form method="post" action="/actions/cart/promotion" data-cart-promotion-form><input type="hidden" name="intent" value="remove" /><input type="hidden" name="code" value={promotion.code ?? ""} /><span>{m.cart_code_applied({ code: promotion.code ?? "" }, { locale })}</span><button type="submit">{m.action_remove({}, { locale })}</button></form>)}</div><p class:list={["nexa-live", { "is-error": discountError }]} data-discount-status aria-live="polite">{discountError}</p></div>
          <dl class="nexa-totals"><div><dt>{m.cart_subtotal({}, { locale })}</dt><dd data-summary-subtotal>{formatMoney(summary.subtotal, cart?.currencyCode, locale)}</dd></div><div data-summary-discount hidden={!summary.savingsTotal}><dt>{m.cart_discount({}, { locale })}</dt><dd data-summary-discount-value>−{formatMoney(summary.savingsTotal, cart?.currencyCode, locale)}</dd></div><div><dt>{m.cart_delivery({}, { locale })}</dt><dd data-summary-shipping>{summary.shippingTotal && summary.shippingTotal > 0 ? formatMoney(summary.shippingTotal, cart?.currencyCode, locale) : m.cart_delivery_at_checkout({}, { locale })}</dd></div>{summary.taxTotal != null && summary.taxTotal > 0 && <div><dt>{m.cart_tax({}, { locale })}</dt><dd>{formatMoney(summary.taxTotal, cart?.currencyCode, locale)}</dd></div>}<div class="nexa-totals__total"><dt>{m.cart_total({}, { locale })}</dt><dd data-summary-total>{formatMoney(summary.total, cart?.currencyCode, locale)}</dd></div></dl>
          <a class="nexa-primary-action" href="/checkout">{m.action_checkout({}, { locale })} <span class="nexa-primary-action__icon" aria-hidden="true"><Fragment set:html={arrowIcon} /></span></a><small>{m.cart_next_step_note({}, { locale })}</small>
        </aside>
      </div>}
    </div>
  </main>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-cart-page]'); if (!root) return;
    const status = root.querySelector('[data-cart-page-status]');
    const money = (amount, currency) => { try { return new Intl.NumberFormat(root.dataset.locale || 'en-ET', { style: 'currency', currency: String(currency || 'ETB').toUpperCase() }).format(Number(amount || 0)); } catch { return String(amount ?? ''); } };
    const sync = (result) => {
      const cart = result.cart; const items = Array.isArray(cart.items) ? cart.items : []; const count = items.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
      root.querySelectorAll('[data-cart-line]').forEach((line) => { const item = items.find((candidate) => candidate.id === line.dataset.cartLine); if (!item) { line.remove(); return; } const quantity = line.querySelector('[data-line-quantity]'); const total = line.querySelector('[data-line-total]'); if (quantity) quantity.textContent = String(item.quantity); if (total) total.textContent = money(item.total ?? item.unitPrice, cart.currencyCode); const forms = [...line.querySelectorAll('form[action="/actions/cart/update"]')]; const down = forms[0]?.querySelector('input[name="quantity"]'); const up = forms[1]?.querySelector('input[name="quantity"]'); if (down) down.value = String(Math.max(1, item.quantity - 1)); if (up) up.value = String(item.quantity + 1); const downButton = forms[0]?.querySelector('button'); if (downButton) downButton.disabled = item.quantity <= 1; });
      root.querySelectorAll('[data-page-item-count],[data-summary-count]').forEach((node) => { const template = node.hasAttribute('data-page-item-count') ? root.dataset.readyCount : root.dataset.itemCount; node.textContent = String(template || '').replace('__COUNT__', String(count)); });
      const savings = Math.max(0, Number(cart.discountTotal ?? 0) || Number(cart.itemDiscountTotal || 0) + Number(cart.shippingDiscountTotal || 0)); const subtotal = root.querySelector('[data-summary-subtotal]'); const total = root.querySelector('[data-summary-total]'); const discount = root.querySelector('[data-summary-discount]'); const discountValue = root.querySelector('[data-summary-discount-value]'); if (subtotal) subtotal.textContent = money(cart.subtotal ?? cart.itemSubtotal ?? cart.itemTotal, cart.currencyCode); if (total) total.textContent = money(cart.total ?? cart.itemTotal, cart.currencyCode); if (discount) discount.hidden = savings <= 0; if (discountValue) discountValue.textContent = `−${money(savings, cart.currencyCode)}`;
      if (!items.length) window.location.reload();
      window.dispatchEvent(new CustomEvent('ecs:cart-updated', { detail: { ...result, openDrawer: false } }));
    };
    root.addEventListener('submit', async (event) => { const form = event.target; if (!(form instanceof HTMLFormElement) || !form.matches('[data-cart-page-form],[data-cart-promotion-form]')) return; event.preventDefault(); const feedback = form.matches('[data-cart-promotion-form]') ? root.querySelector('[data-discount-status]') : status; const button = event.submitter; const wasDisabled = button instanceof HTMLButtonElement ? button.disabled : false; if (button instanceof HTMLButtonElement) { button.disabled = true; button.dataset.busy = 'true'; button.setAttribute('aria-busy', 'true'); } form.setAttribute('aria-busy', 'true'); if (feedback) { feedback.classList.remove('is-error'); feedback.textContent = root.dataset.updating || ''; } try { const response = await fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: { Accept: 'application/json' } }); const result = await response.json(); if (!response.ok || !result.ok) throw new Error(root.dataset.updateFailed || ''); sync(result); if (feedback) feedback.textContent = ''; } catch (cause) { if (feedback) { feedback.textContent = cause instanceof Error ? cause.message : root.dataset.updateFailed || ''; feedback.classList.add('is-error'); } } finally { form.removeAttribute('aria-busy'); if (button instanceof HTMLButtonElement) { button.disabled = wasDisabled; delete button.dataset.busy; button.removeAttribute('aria-busy'); } } });
  })();
</script>
