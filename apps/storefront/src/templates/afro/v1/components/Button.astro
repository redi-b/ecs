---
import Icon from "./Icon.astro";
import "../styles/components/_button.scss";

interface Props {
  text: string;
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "dark";
  size?: "large" | "small";
  fullWidth?: boolean;
  class?: string;
  icon?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  editorPath?: string;
  editorRelatedPaths?: string[];
  editorMode?: boolean;
  [key: string]: any;
}

const {
  text,
  href,
  variant = "primary",
  size = "large",
  fullWidth = false,
  class: className,
  icon,
  type = "button",
  disabled = false,
  editorPath,
  editorRelatedPaths,
  editorMode = false,
  ...rest
} = Astro.props;

const classes = [
  "btn",
  `btn--${variant}`,
  `btn--${size}`,
  icon && "btn--with-icon",
  fullWidth && "btn--full-width",
  className,
].filter(Boolean);

const Element = href ? "a" : "button";
---

<Element
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={classes}
  data-editor-path={editorPath}
  data-editor-related-paths={editorRelatedPaths?.join(",")}
  {...rest}
>
  <span class="btn__text type-body-500" contenteditable={editorMode && editorPath ? "plaintext-only" : undefined}>{text}</span>
  {
    icon && (
      <span class="btn__icon-badge" aria-hidden="true">
        <Icon name={icon} width={14} height={14} />
      </span>
    )
  }
</Element>
