---
import { nexahubV1Defaults, nexahubV1ThemeTokens } from "@ecs/storefront-templates";
import { nexahubDemoFooterContact } from "../../../../lib/demo/nexahub-fixture";
import Contact from "../../../../templates/nexahub/v1/pages/Contact.astro";

const data = structuredClone(nexahubV1Defaults);
Object.assign(data.footer, nexahubDemoFooterContact);
---

<Contact
  data={data}
  themeTokens={nexahubV1ThemeTokens}
  tenantName="NexaHub Technology"
  demoMode
  deferCartCount
/>
