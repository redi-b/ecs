---
import type { StoreCart, StoreDeliveryOptions, StorePaymentOptions, StoreShippingOption } from "../../../lib/commerce/types";
import type { StoreCustomer, StoreCustomerAddress } from "../../../lib/commerce/account";
import { resolveStoreFulfillmentOptions } from "../../../lib/commerce/fulfillment";
import { resolveStoreCartSummary } from "../../../lib/commerce/cart-summary";
import { formatMoney } from "../../../lib/money";
import Layout from "./Layout.astro";
import { parseLuviaData } from "./lib";

interface Props { data: unknown; themeTokens?: unknown; tenantName: string; cartCount: number; cart: StoreCart | null; delivery: StoreDeliveryOptions | null; payment: StorePaymentOptions; shippingOptions: StoreShippingOption[]; shippingError?: string | null; error?: string | null; customer?: StoreCustomer | null; customerAddresses?: StoreCustomerAddress[]; }
const { data, themeTokens, tenantName, cartCount, cart, delivery, payment, shippingOptions, shippingError, error, customer = null, customerAddresses = [] } = Astro.props;
const template = parseLuviaData(data);
const items = cart?.items ?? [];
const deliveryEnabled = delivery?.deliveryEnabled === true;
const pickupEnabled = delivery?.pickupEnabled === true;
const fulfillmentAvailable = deliveryEnabled || pickupEnabled;
const phoneRequired = delivery?.phoneConfirmationRequired !== false;
const defaultChoice = deliveryEnabled ? "delivery" : pickupEnabled ? "pickup" : "delivery";
const { deliveryOptions, pickupOption, priceMismatch } = resolveStoreFulfillmentOptions(shippingOptions, delivery);
const canSubmit = items.length > 0 && fulfillmentAvailable && !priceMismatch && (defaultChoice === "pickup" ? Boolean(pickupOption) : deliveryOptions.length > 0);
const initialShippingAmount = defaultChoice === "pickup" ? (pickupOption?.amount ?? 0) : (deliveryOptions[0]?.amount ?? 0);
const cartShippingAmount = cart?.shippingTotal ?? 0;
const baseTotal = (cart?.total ?? cart?.itemTotal ?? 0) - cartShippingAmount;
const summary = resolveStoreCartSummary(cart);
const defaultPayment = payment.cod ? "cod" : payment.chapa ? "chapa" : null;
const defaultAddress = customerAddresses.find((address) => address.isDefaultShipping) ?? customerAddresses[0] ?? null;
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} title="Checkout">
  <main class="lv-checkout">
    <header class="lv-checkout__hero"><h1>CHECKOUT</h1><p>Complete your order — natural beauty, delivered with care.</p></header>
    {error && <p class="lv-checkout__error" role="alert">{error}</p>}
    {shippingError && <p class="lv-checkout__error" role="alert">Delivery options could not be loaded. Please refresh and try again.</p>}
    {priceMismatch && <p class="lv-checkout__error" role="alert">Delivery pricing is being updated. Please ask the shop to resave its fulfillment settings, then refresh checkout.</p>}
    {!items.length ? <section class="lv-checkout__empty"><h2>Your cart is empty</h2><p>Add products before continuing to checkout.</p><a href="/products">Browse products</a></section> : <div class="lv-checkout__layout">
      <section class="lv-checkout-form-wrap">
        <header><h2>Payment Details</h2><p>By proceeding you agree to our Terms of Service and Privacy Policy.</p></header>
        <form method="post" action={defaultPayment === "chapa" ? "/actions/checkout/chapa" : "/actions/checkout/cod"} class="lv-checkout-form" data-checkout-form>
          {!fulfillmentAvailable && <div class="lv-checkout-blocker" role="status"><strong>Orders are temporarily unavailable.</strong><p>This shop has not enabled delivery or pickup yet.</p></div>}
          <div class="lv-checkout-fields">
            <label><span>First Name*</span><input name="firstName" value={defaultAddress?.firstName || customer?.firstName} required autocomplete="given-name" placeholder="Jane" /></label>
            <label><span>Last Name*</span><input name="lastName" value={defaultAddress?.lastName || customer?.lastName} required autocomplete="family-name" placeholder="Doe" /></label>
            <label><span>Phone Number{phoneRequired ? "*" : ""}</span><input name="phone" value={defaultAddress?.phone || customer?.phone} required={phoneRequired} autocomplete="tel" inputmode="tel" placeholder="0912345678" /></label>
            <label><span>Email <small data-email-requirement>{defaultPayment === "chapa" ? "(required for Chapa)" : "(optional)"}</small></span><input name="email" value={customer?.email} type="email" required={defaultPayment === "chapa"} autocomplete="email" placeholder="name@example.com" /></label>
            <fieldset class="lv-checkout-choice-group is-wide" data-delivery-choice><legend>How would you like to receive it?*</legend><div>{deliveryEnabled && <label><input type="radio" name="deliveryChoice" value="delivery" checked={defaultChoice === "delivery"} disabled={!fulfillmentAvailable} /><span><strong>Delivery</strong><small>Send the order to your address.</small></span></label>}{pickupEnabled && <label><input type="radio" name="deliveryChoice" value="pickup" checked={defaultChoice === "pickup"} disabled={!fulfillmentAvailable} /><span><strong>Pickup</strong><small>Collect it from the shop.</small></span></label>}</div></fieldset>
            <section class="lv-checkout-delivery-details is-wide" data-delivery-field>
              <header><div><strong>Delivery address</strong><span>Choose a saved address or enter one for this order.</span></div>{customer && <a href="/account#saved-addresses">Manage addresses</a>}</header>
              {customerAddresses.length > 0 && <fieldset class="lv-checkout-saved-addresses" data-saved-addresses><legend>Choose an address</legend><div>{customerAddresses.map((address) => <label><input type="radio" name="savedAddressId" value={address.id} checked={address.id === defaultAddress?.id} data-address={JSON.stringify(address)} /><span><strong>{address.addressName || `${address.firstName} ${address.lastName}`}</strong><small>{address.address1}, {address.city}</small></span></label>)}<label><input type="radio" name="savedAddressId" value="" checked={!defaultAddress} /><span><strong>Use a different address</strong><small>Enter delivery details below.</small></span></label></div></fieldset>}
              <div class="lv-checkout-address-fields">
                <label><span>City*</span><input name="city" value={defaultAddress?.city || "Addis Ababa"} required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} autocomplete="address-level2" /></label>
                <label><span>Street Address*</span><input name="address1" value={defaultAddress?.address1} required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} autocomplete="street-address" placeholder="Bole, Ayat Road" /></label>
                {delivery?.landmarkRequired || delivery?.notesEnabled !== false ? <label class="is-wide"><span>Landmark{delivery?.landmarkRequired ? "*" : " (optional)"}</span><input name="landmark" required={Boolean(delivery?.landmarkRequired) && defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} data-landmark-required={delivery?.landmarkRequired ? "true" : "false"} placeholder="Nearby landmark" /></label> : null}
              </div>
              {customer && <div class="lv-checkout-save-address" data-save-address hidden={Boolean(defaultAddress)}><label data-save-address-toggle><input type="checkbox" name="saveAddress" value="true" /><span><strong>Save this address</strong><small>Keep it ready for your next checkout.</small></span></label><label class="lv-checkout-address-name" hidden><span>Address label</span><input name="addressName" value="Home" placeholder="Home or Work" /></label><p data-address-match hidden>This address is already saved to your account.</p></div>}
            </section>
            {delivery?.notesEnabled !== false && <label class="is-wide"><span>Order Notes (optional)</span><textarea name="notes" rows="3" placeholder="Helpful delivery details" /></label>}
            <fieldset class="lv-checkout-choice-group is-wide" data-delivery-option><legend>Delivery option*</legend><div>{deliveryOptions.map((option, index) => <label><input type="radio" name="shippingOptionId" value={option.id} data-amount={option.amount ?? 0} checked={index === 0} required={defaultChoice === "delivery"} disabled={defaultChoice !== "delivery"} /><span><strong>{option.name?.trim() || "Standard delivery"}</strong><small>{option.amount === 0 ? "Free" : formatMoney(option.amount, option.currencyCode ?? cart?.currencyCode)}</small></span></label>)}</div></fieldset>
            <div data-pickup-option hidden>{pickupOption && <input type="hidden" name="shippingOptionId" value={pickupOption.id} disabled={defaultChoice !== "pickup"} />}</div>
          </div>
          {customer ? <p class="lv-checkout-account is-signed-in"><strong>Signed in as {customer.email}</strong><span>Changes here apply only to this order unless you choose to save a new address.</span></p> : <p class="lv-checkout-account"><span>Want faster checkout next time?</span><a href="/account?mode=register">Create an account</a></p>}
          <fieldset class="lv-checkout-payment" data-payment-choice><legend>How would you like to pay?*</legend>{payment.cod && <label><input type="radio" name="paymentMethod" value="cod" checked={defaultPayment === "cod"} /><span><strong>Pay on delivery</strong><small>Pay when your order arrives.</small></span></label>}{payment.chapa && <label><input type="radio" name="paymentMethod" value="chapa" checked={defaultPayment === "chapa"} /><span><strong>Chapa</strong><small>Pay securely online. An email address is required.</small></span></label>}{!payment.cod && !payment.chapa && <p>No payment method is available for this order.</p>}</fieldset>
          <div class="lv-checkout-actions"><button type="submit" data-place-order disabled={!canSubmit || !defaultPayment}>{defaultPayment === "chapa" ? "Continue to secure payment" : "Place order"}</button></div>
        </form>
      </section>

      <aside class="lv-checkout-summary" aria-label="Order summary" data-currency={cart?.currencyCode ?? "ETB"} data-base-total={baseTotal}><header><h2>Order Summary</h2><span>{summary.itemCount} item{summary.itemCount === 1 ? "" : "s"}</span></header><ul>{items.map((item) => <li><div>{item.thumbnail ? <img src={item.thumbnail} alt="" /> : null}</div><p><strong>{item.title ?? "Product"}</strong><span>{item.variantTitle ?? ""}{item.quantity > 1 ? ` × ${item.quantity}` : ""}</span></p><b>{formatMoney(item.total ?? item.unitPrice, cart?.currencyCode)}</b></li>)}</ul><dl><div><dt>Subtotal</dt><dd>{formatMoney(summary.subtotal, cart?.currencyCode)}</dd></div>{summary.savingsTotal != null && summary.savingsTotal > 0 && <div class="is-savings"><dt>Discount</dt><dd>−{formatMoney(summary.savingsTotal, cart?.currencyCode)}</dd></div>}<div><dt>Delivery</dt><dd data-summary-delivery>{initialShippingAmount === 0 ? "Free" : formatMoney(initialShippingAmount, cart?.currencyCode)}</dd></div>{summary.taxTotal != null && summary.taxTotal > 0 && <div><dt>Tax</dt><dd>{formatMoney(summary.taxTotal, cart?.currencyCode)}</dd></div>}<div><dt>Estimated total</dt><dd data-summary-total>{formatMoney(baseTotal + initialShippingAmount, cart?.currencyCode)}</dd></div></dl><small>The final total is confirmed securely when you place the order.</small></aside>
    </div>}
  </main>
</Layout>

<script is:inline>
  (() => {
    const fulfillment = document.querySelector("[data-delivery-choice]"); if (!fulfillment) return;
    const form = document.querySelector("[data-checkout-form]");
    const savedInputs = [...document.querySelectorAll('input[name="savedAddressId"]')];
    const savedAddresses = savedInputs.flatMap((field) => { try { const address = field.dataset.address ? JSON.parse(field.dataset.address) : null; return address ? [{ field, address }] : []; } catch { return []; } });
    const selectedValue = (name) => document.querySelector(`input[name="${name}"]:checked`)?.value;
    const setField = (name, value) => { const input = form?.elements.namedItem(name); if (input instanceof HTMLInputElement) input.value = String(value || ""); };
    const normalized = (value) => String(value || "").trim().toLocaleLowerCase("en").replace(/\s+/g, " ");
    const matchingAddress = () => savedAddresses.find(({ address }) => normalized(address.address1) === normalized(form?.elements.namedItem("address1")?.value) && normalized(address.city) === normalized(form?.elements.namedItem("city")?.value));
    const saveBox = document.querySelector("[data-save-address]");
    const saveChoice = saveBox?.querySelector("[data-save-address-toggle]");
    const saveToggle = saveBox?.querySelector('input[name="saveAddress"]');
    const addressName = saveBox?.querySelector(".lv-checkout-address-name");
    const matchCopy = saveBox?.querySelector("[data-address-match]");
    const syncSaveAddress = () => {
      const delivery = selectedValue("deliveryChoice") === "delivery";
      const selectedSaved = Boolean(selectedValue("savedAddressId"));
      const match = matchingAddress();
      const existing = selectedSaved || Boolean(match);
      if (saveBox) saveBox.hidden = !delivery || selectedSaved;
      if (saveChoice) saveChoice.hidden = Boolean(match);
      if (matchCopy) matchCopy.hidden = !delivery || !match || selectedSaved;
      if (saveToggle instanceof HTMLInputElement) {
        saveToggle.disabled = !delivery || existing;
        if (existing) saveToggle.checked = false;
      }
      if (addressName) addressName.hidden = !(saveToggle instanceof HTMLInputElement && saveToggle.checked && !saveToggle.disabled);
    };
    document.querySelector("[data-saved-addresses]")?.addEventListener("change", (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement) || field.name !== "savedAddressId") return;
      let address = null; try { address = field.dataset.address ? JSON.parse(field.dataset.address) : null; } catch {}
      const values = address ? { firstName: address.firstName, lastName: address.lastName, phone: address.phone, address1: address.address1, city: address.city } : { address1: "", city: "Addis Ababa" };
      Object.entries(values).forEach(([name, value]) => setField(name, value));
      syncSaveAddress();
    });
    saveToggle?.addEventListener("change", syncSaveAddress);
    form?.querySelectorAll('input[name="address1"],input[name="city"]').forEach((field) => field.addEventListener("input", () => {
      const different = savedInputs.find((item) => !item.value); if (different) different.checked = true;
      syncSaveAddress();
    }));
    const sync = () => { const delivery = selectedValue("deliveryChoice") === "delivery"; document.querySelectorAll("[data-delivery-field]").forEach((wrapper) => { wrapper.hidden = !delivery; wrapper.querySelectorAll("input,select,textarea").forEach((field) => { field.disabled = !delivery; }); }); ["address1", "city"].forEach((name) => { const field = form?.elements.namedItem(name); if (field instanceof HTMLInputElement) field.required = delivery; }); const landmark = form?.elements.namedItem("landmark"); if (landmark instanceof HTMLInputElement) landmark.required = delivery && landmark.dataset.landmarkRequired === "true"; const deliveryOption = document.querySelector("[data-delivery-option]"); const pickupOption = document.querySelector("[data-pickup-option]"); if (deliveryOption) { deliveryOption.hidden = !delivery; deliveryOption.querySelectorAll('input[name="shippingOptionId"]').forEach((field) => { field.disabled = !delivery; field.required = delivery; }); } if (pickupOption) { pickupOption.hidden = delivery; pickupOption.querySelectorAll("input").forEach((field) => field.disabled = delivery); } syncSaveAddress(); };
    const summary = document.querySelector("[data-base-total]");
    const money = (amount) => new Intl.NumberFormat("en-ET", { style: "currency", currency: summary?.dataset.currency || "ETB", maximumFractionDigits: 2 }).format(amount);
    const syncSummary = () => { if (!(summary instanceof HTMLElement)) return; const selected = document.querySelector('input[name="shippingOptionId"]:checked'); const amount = selectedValue("deliveryChoice") === "pickup" ? 0 : Number(selected?.dataset.amount || 0); const deliveryNode = document.querySelector("[data-summary-delivery]"); const totalNode = document.querySelector("[data-summary-total]"); if (deliveryNode) deliveryNode.textContent = amount === 0 ? "Free" : money(amount); if (totalNode) totalNode.textContent = money(Number(summary.dataset.baseTotal || 0) + amount); };
    fulfillment.addEventListener("change", () => { sync(); syncSummary(); }); document.querySelector("[data-delivery-option]")?.addEventListener("change", syncSummary); sync(); syncSummary();
    const email = form?.querySelector('input[name="email"]'); const submit = form?.querySelector("[data-place-order]"); const emailRequirement = form?.querySelector("[data-email-requirement]"); const syncPayment = () => { const chapa = selectedValue("paymentMethod") === "chapa"; if (form instanceof HTMLFormElement) form.action = chapa ? "/actions/checkout/chapa" : "/actions/checkout/cod"; if (email instanceof HTMLInputElement) email.required = chapa; if (emailRequirement) emailRequirement.textContent = chapa ? "(required for Chapa)" : "(optional)"; if (submit) submit.textContent = chapa ? "Continue to secure payment" : "Place order"; }; form?.querySelector("[data-payment-choice]")?.addEventListener("change", syncPayment); syncPayment(); form?.addEventListener("submit", (event) => { const button = event.submitter; if (button instanceof HTMLButtonElement) { button.disabled = true; button.dataset.loading = "true"; button.textContent = selectedValue("paymentMethod") === "chapa" ? "Opening secure payment…" : "Placing your order…"; } });
  })();
</script>
<style is:global lang="scss">@use "./styles/checkout.scss";</style>
