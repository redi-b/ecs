---
import type { LuviaV1Data } from "@ecs/storefront-templates";
import * as m from "../../../../paraglide/messages.js";
import { getEcsLandingPageUrl } from "../../../../lib/env";
import ActionButton from "./ActionButton.astro";

interface Props {
  tenantName: string;
  footer: LuviaV1Data["footer"];
  editorMode?: boolean;
  locale: "am" | "en";
  logoUrl?: string | null;
  emptyLogoUrl?: string | null;
}

const ecsLandingPageUrl = getEcsLandingPageUrl();

const {
  tenantName,
  footer,
  editorMode = false,
  locale,
  logoUrl,
  emptyLogoUrl,
} = Astro.props;
---

<footer class="footer" data-editor-section="footer">
  <div class="footer__intro" data-editor-image-scope>
    <div class="footer__brand">
      <img
        src={logoUrl ?? undefined}
        alt={tenantName}
        data-editor-image-path="header.logoAssetId"
        data-editor-empty-src={emptyLogoUrl ?? undefined}
        hidden={!logoUrl}
      />
      <p
        class="type-body-s-400"
      >
        {footer.blurb}
      </p>
    </div>
    <a href={ecsLandingPageUrl} rel="noreferrer" target="_blank" class="type-body-xs">
      {m.footer_design_by_ecs({}, { locale })}
    </a>
  </div>

  <div class="type-body-s-400">
    <strong class="type-body-s-500">{m.footer_quick_links({}, { locale })}</strong>
    <span
      class="footer__links"
    >
      {
        footer.quickLinks.map((item) => (
          <a
            class="type-body-s-400"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </span>
  </div>

  <div class="type-body-s-400">
    <strong class="type-body-s-500">{m.nav_shop({}, { locale })}</strong>
    <span
      class="footer__links"
    >
      {
        footer.shopLinks.map((item) => (
          <a
            class="type-body-s-400"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </span>
  </div>

  {
    (footer.socialLinks.length > 0 || editorMode) && (
      <div class="type-body-s-400">
        <strong class="type-body-s-500">{m.contact_socials({}, { locale })}</strong>
        {editorMode && footer.socialLinks.length === 0 && (
          <p class="footer__contact-missing type-body-xs-500" data-editor-section="footer">
            {m.footer_social_incomplete({}, { locale })}
          </p>
        )}
        <span
          class="footer__links"
        >
          {footer.socialLinks.map((item) => (
            <a
              class="type-body-s-400"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.label}
            </a>
          ))}
        </span>
      </div>
    )
  }

  <div class="type-body-s-400">
    <strong class="type-body-s-500">{m.contact_information({}, { locale })}</strong>
    {editorMode && (!footer.phone || !footer.email) && (
      <p class="footer__contact-missing type-body-xs-500" data-editor-section="footer">
        {m.footer_contact_incomplete({}, { locale })}
      </p>
    )}
    <span class="footer__links">
      {[footer.phone, ...(footer.additionalPhones ?? [])].filter(Boolean).map((phone) => (
        <a
          class="type-body-s-400"
          href={`tel:${phone}`}
        >
          {phone}
        </a>
      ))}
      {(footer.email || (editorMode && !footer.managedContact)) && (
        <a
          class="type-body-s-400"
          href={`mailto:${footer.email ?? ""}`}
        >
          {footer.email}
        </a>
      )}
      {(footer.address || (editorMode && !footer.managedContact)) && (
        <p
          class="type-body-s-400"
        >
          {footer.address}
        </p>
      )}
    </span>
  </div>

  <small class="type-body-s-400">
    © {new Date().getFullYear()} {tenantName}. {m.footer_rights_reserved({}, { locale })}
  </small>
</footer>

<aside class="inquiry" data-editor-section="footer.inquiry">
  <p
    class="type-heading-3"
    data-editor-path="footer.inquiry.title"
    contenteditable={editorMode ? "plaintext-only" : undefined}
  >
    {footer.inquiry.title}
  </p>
  <ActionButton
    href={footer.inquiry.ctaHref}
    icon="chat"
    tone="secondary"
    size="small"
    editorPath="footer.inquiry.ctaLabel"
    editorRelatedPaths={["footer.inquiry.ctaHref"]}
    editorMode={editorMode}
  >
    {footer.inquiry.ctaLabel}
  </ActionButton>
</aside>
