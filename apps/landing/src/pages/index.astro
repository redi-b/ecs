                    <span class="shop-feat__item-icon">
                      <Icon name={feat.icon} />
                    </span>
                    <button type="button" class="shop-feat__toggle-btn" aria-label={`Toggle ${feat.title}`}>
                      <span class="shop-feat__toggle-circle">
                        <span class="shop-feat__toggle-line shop-feat__toggle-line--h"></span>
                        <span class="shop-feat__toggle-line shop-feat__toggle-line--v"></span>
                      </span>
                    </button>
                  </div>

                  <!-- Inactive State Header (Title on Left, Plus Toggle on Right) -->
                  <div class="shop-feat__item-inactive-header">
                    <h3 class="shop-feat__item-title">{feat.title}</h3>
                    <button type="button" class="shop-feat__toggle-btn" aria-label={`Toggle ${feat.title}`}>
                      <span class="shop-feat__toggle-circle">
                        <span class="shop-feat__toggle-line shop-feat__toggle-line--h"></span>
                        <span class="shop-feat__toggle-line shop-feat__toggle-line--v"></span>
                      </span>
                    </button>
                  </div>

                  <!-- Active Content Area -->
                  <div class="shop-feat__item-content">
                    <h3 class="shop-feat__item-title shop-feat__item-title--active">{feat.title}</h3>
                    <p class="shop-feat__item-desc type-body-400">{feat.desc}</p>
