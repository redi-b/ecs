---
import Button from "../components/Button.astro";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Layout from "../layouts/Layout.astro";
import { parseNexahubData } from "../lib";
import "../styles/pages/commerce.scss";
interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  error?: string | null;
  redirectLabel?: string;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  error,
  redirectLabel,
} = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const progressLabel = redirectLabel ?? m.payment_verify_progress({}, { locale });
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount}>
  <main class="nexa-commerce" id="main-content"><div class="container nexa-commerce__frame"><nav class="nexa-breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/checkout">{m.checkout_title({}, { locale })}</a><span>/</span><span aria-current="page">{m.payment_status({}, { locale })}</span></nav><header class="nexa-commerce__heading"><span class="nexa-kicker">{m.payment_secure_checkout({}, { locale })}</span><div><h1>{error ? m.payment_needs_attention({}, { locale }) : m.payment_confirming({}, { locale })}</h1><p>{error ? m.payment_cart_safe({}, { locale }) : progressLabel}</p></div></header>{error ? <section class="nexa-empty" role="alert"><span class="nexa-empty__index">!</span><h2>{m.payment_confirm_failed({}, { locale })}</h2><p>{error}</p><div class="nexa-receipt__actions"><Button text={m.payment_back_checkout({}, { locale })} href="/checkout" /><Button text={m.payment_return_cart({}, { locale })} href="/cart" variant="dark" /></div></section> : <div class="nexa-notice nexa-notice--processing" role="status" aria-live="polite"><span class="nexa-status-spinner" aria-hidden="true"></span><div><strong>{progressLabel}</strong><p>{m.payment_keep_open({}, { locale })}</p></div></div>}</div></main>
</Layout>
