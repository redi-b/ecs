---
import Layout from "./Layout.astro"; import { parseNexahubData } from "./lib"; import "./styles/pages/secondary.scss";
interface Props { data:unknown; themeTokens?:unknown; tenantName:string; deferCartCount?:boolean; }
const {data,themeTokens,tenantName,deferCartCount=false}=Astro.props; const template=parseNexahubData(data); const sent=Astro.url.searchParams.get("sent")==="1"; const submitError=Astro.url.searchParams.get("error");
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}><main class="nexa-secondary" id="main-content"><div class="container nexa-secondary__frame"><header class="nexa-secondary__hero"><span>Sourcing channel / 02</span><div><h1>Request an item</h1><p>Send the product details you have. The shop will review availability and alternatives.</p></div></header><div class="nexa-secondary__split"><aside class="nexa-info-panel"><header class="nexa-panel-head"><h2>Request protocol</h2><span>03 steps</span></header><ul class="nexa-info-list"><li><small>01</small><span>Describe the exact product or category.</span></li><li><small>02</small><span>Add a link, brand, size, or target budget when available.</span></li><li><small>03</small><span>The shop contacts you directly; this is not an order.</span></li></ul></aside><section class="nexa-form-panel"><header class="nexa-panel-head"><h2>Product brief</h2><span>All fields are reviewed</span></header><form class="nexa-inquiry-form" action="/actions/inquiries" method="post" data-inquiry-form><input type="hidden" name="type" value="product_request"/><label class="nexa-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><label>Product name *<input name="productName" required/></label><label>Brand (optional)<input name="brand"/></label><label class="is-wide">Product link (optional)<input name="productUrl" type="url" inputmode="url"/></label><label>Your name *<input name="customerName" required autocomplete="name"/></label><label>Phone or email *<input name="contact" required/></label><label class="is-wide">Details (optional)<textarea name="details"></textarea></label><button type="submit">Send product request ↗</button><p class:list={["nexa-inquiry-status",sent&&"is-success",submitError&&"is-error"]} role="status" aria-live="polite" data-inquiry-status>{sent?"Request received. The shop can now review it.":submitError}</p></form></section></div></div></main></Layout>
