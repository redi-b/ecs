---
import type { StoreCategory, StoreCollection, StoreProduct } from "../../../lib/commerce/types";
import { catalogHref, type CatalogFilters } from "../../../lib/commerce/catalog-filters";
import { taxonomyHandle } from "../../../lib/commerce/taxonomy-links";
import type { StorefrontSeo } from "../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";
import Button from "./Button.astro";
import Layout from "./Layout.astro";
import ProductCard from "./ProductCard.astro";
import ProductFilterBar from "./ProductFilterBar.astro";
import heroTexture from "./assets/product-listing-hero-texture.webp";
import { parseNexahubData } from "./lib";
import "./styles/pages/products.scss";
import "./styles/responsive.scss";

interface Props {
  data: unknown; themeTokens?: unknown; tenantName: string; cartCount?: number; deferCartCount?: boolean;
  products: StoreProduct[]; errorMessage?: string | null; hasPrev: boolean; hasNext: boolean; prevHref?: string; nextHref?: string;
  collections?: StoreCollection[]; categories?: StoreCategory[];
  facets?: { categories: Record<string, number>; collections: Record<string, number>; options: Array<{ name: string; values: Array<{ count: number; token: string; value: string }> }>; price: { min: number; max: number } | null };
  filters?: CatalogFilters;
  totalCount?: number; offset?: number; limit?: number; seo?: StorefrontSeo; demoMode?: boolean; editorMode?: boolean;
}
const { data, themeTokens, tenantName, cartCount = 0, deferCartCount = false, products, errorMessage, hasPrev, hasNext, prevHref, nextHref, collections = [], categories = [], facets, filters = { optionPairs: [] }, totalCount = products.length, offset = 0, limit = 24, seo, demoMode = false, editorMode = false } = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const activeCollection = collections.find((item) => taxonomyHandle(item) === filters.collectionId);
const activeCategory = categories.find((item) => taxonomyHandle(item) === filters.categoryId);
const hasFilters = Boolean(filters.q || filters.collectionId || filters.categoryId || filters.optionPairs.length || filters.priceMin !== undefined || filters.priceMax !== undefined || filters.order);
const totalPages = Math.max(1, Math.ceil(totalCount / limit));
const currentPage = Math.min(totalPages, Math.floor(offset / limit) + 1);
const pageWindow = Array.from({ length: totalPages }, (_, index) => index + 1).filter((page) => page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1);
function pageHref(page: number) { return catalogHref(filters, (page - 1) * limit); }
const title = filters.q ? m.catalog_results_for({ query: filters.q }, { locale }) : activeCollection?.title ?? activeCategory?.name ?? template.listing.title;
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} navigationCollections={collections} themeTokens={themeTokens} cartCount={cartCount} deferCartCount={deferCartCount} demoMode={demoMode} editorMode={editorMode} seo={seo} renderPath={editorMode ? "/products" : undefined}>
  <main id="main-content">
    <section class="products-hero" data-editor-section="listing"><div class="container products-hero__wrapper"><div class="products-hero__card"><div class="products-hero__texture" aria-hidden="true"><img src={heroTexture.src} alt="" class="cover" /></div><div class="products-hero__content"><nav class="products-hero__breadcrumb" aria-label={m.breadcrumb_label({}, { locale })}><a href="/">{m.nav_home({}, { locale })}</a><span class="products-hero__breadcrumb-divider">/</span><span>{m.nav_shop({}, { locale })}</span></nav><div class="products-hero__eyebrow"><span class="products-hero__bar products-hero__bar--sm"></span><span class="products-hero__bar products-hero__bar--md"></span><span class="products-hero__badge" data-editor-path="listing.eyebrow" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.listing.eyebrow}</span></div><h1 class="products-hero__title" data-editor-path={!hasFilters ? "listing.title" : undefined} contenteditable={editorMode && !hasFilters ? "plaintext-only" : undefined}>{title}</h1></div></div></div></section>
    <section class="products-catalog" id="catalog"><div class="container products-catalog__wrapper"><ProductFilterBar collections={collections} categories={categories} facets={facets} values={filters} />
      <div class="products-catalog__results" data-catalog-results><div class="products-catalog__summary"><span>{m.catalog_showing({ shown: products.length, total: totalCount }, { locale })}</span>{hasFilters && <a href="/products">{m.catalog_clear_filters({}, { locale })}</a>}</div>
        {errorMessage ? <div class="nexa-list-state" role="alert"><h2>{m.catalog_load_failed({}, { locale })}</h2><p>{m.status_generic_error({}, { locale })}</p><a href="/products">{m.action_retry({}, { locale })}</a></div> : products.length ? <div class="products-catalog__grid">{products.map((product, index) => <ProductCard product={product} eager={index < 4} />)}</div> : <div class="nexa-list-state"><h2>{filters.q ? m.catalog_no_results({ query: filters.q }, { locale }) : m.catalog_empty({}, { locale })}</h2><p>{hasFilters ? m.catalog_adjust_filters({}, { locale }) : m.catalog_check_back({}, { locale })}</p>{hasFilters ? <Button text={m.catalog_clear_filters({}, { locale })} href="/products" /> : <Button text={m.action_return_home({}, { locale })} href="/" />}</div>}
      </div>
    </div></section>
    {(hasPrev || hasNext) && <nav class="products-pagination" aria-label={m.catalog_pagination({}, { locale })}><div class="container products-pagination__wrapper">{hasPrev ? <a href={prevHref} class="products-pagination__btn" rel="prev">{m.catalog_previous({}, { locale })}</a> : <span class="products-pagination__btn products-pagination__btn--disabled">{m.catalog_previous({}, { locale })}</span>}<div class="products-pagination__numbers">{pageWindow.map((page) => <a href={pageHref(page)} class:list={["products-pagination__num", page === currentPage && "products-pagination__num--active"]} aria-current={page === currentPage ? "page" : undefined}>{page}</a>)}</div>{hasNext ? <a href={nextHref} class="products-pagination__btn" rel="next">{m.catalog_next({}, { locale })}</a> : <span class="products-pagination__btn products-pagination__btn--disabled">{m.catalog_next({}, { locale })}</span>}</div></nav>}
  </main>
</Layout>
