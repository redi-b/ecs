---
import type { StorefrontSeo } from "../../lib/seo";

interface Props {
  seo?: StorefrontSeo;
}

const { seo } = Astro.props;
---

{seo && <link rel="canonical" href={seo.canonicalUrl} />}
{seo && <meta name="description" content={seo.description} />}
{seo?.noindex && <meta name="robots" content="noindex, nofollow" />}
{seo && <meta property="og:type" content="website" />}
{seo && <meta property="og:title" content={seo.title} />}
{seo && <meta property="og:description" content={seo.description} />}
{seo && <meta property="og:url" content={seo.canonicalUrl} />}
{seo?.imageUrl && <meta property="og:image" content={seo.imageUrl} />}
{seo && <meta name="twitter:card" content={seo.imageUrl ? "summary_large_image" : "summary"} />}
{seo && <meta name="twitter:title" content={seo.title} />}
{seo && <meta name="twitter:description" content={seo.description} />}
{seo?.imageUrl && <meta name="twitter:image" content={seo.imageUrl} />}
