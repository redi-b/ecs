---
import { Icon } from "astro-icon/components";
import type {
  StoreProduct,
  StoreProductVariant,
  StoreProductOption,
} from "../../../../lib/commerce/types";
import { resolveProductBadge } from "../../../../lib/commerce/merchandising";
import { isColorOptionTitle, resolveColorSwatch } from "../../../../lib/commerce/product-options";
import { serializeJsonForScript } from "../../../../lib/serialize-json";
import { formatMoney } from "../../../../lib/money";
import type { StorefrontSeo } from "../../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { sanitizeProductDescription } from "@ecs/content";
import { parseAfroData } from "../lib";
import "../styles/pages/product-detail.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount?: number;
  deferCartCount?: boolean;
  product: StoreProduct | null;
  handle: string;
  notice?: string | null;
  error?: string | null;
  relatedProducts?: StoreProduct[];
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
  demoMode?: boolean;
}

const {
  data,
  themeTokens,
  tenantName,
  cartCount = 0,
  deferCartCount = false,
  product,
  relatedProducts = [],
  seo,
  structuredData,
  demoMode = false,
} = Astro.props;

const template = parseAfroData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";

const defaultVariant: StoreProductVariant | null =
  product?.variants.find((variant) => variant.inStock) ?? product?.variants[0] ?? null;

const gallery = product
  ? [...new Set([...(product.images ?? []), ...(product.thumbnail ? [product.thumbnail] : [])])]
  : [];

const badge = product ? resolveProductBadge(product, defaultVariant) : null;
const currentPrice = formatMoney(
  defaultVariant?.priceAmount ?? product?.priceAmount,
  defaultVariant?.currencyCode ?? product?.currencyCode,
  locale,
);
const descriptionHtml = sanitizeProductDescription(product?.description);

// Selectors are derived from the product's real variants. The previous hardcoded
// size/colour lists rendered controls that changed nothing, so the hidden variantId
// stayed pinned to the default variant and shoppers silently bought the wrong size.
const axes: StoreProductOption[] = product?.options?.length
  ? product.options
  : (() => {
      const map = new Map<string, Set<string>>();
      for (const variant of product?.variants ?? [])
        for (const option of variant.optionValues) {
          if (!map.has(option.optionTitle)) map.set(option.optionTitle, new Set());
          map.get(option.optionTitle)?.add(option.value);
        }
      return [...map].map(([title, values], index) => ({
        id: `axis-${index}`,
        title,
        values: [...values],
      }));
    })();

const isSelected = (axisTitle: string, value: string) =>
  defaultVariant?.optionValues.some(
    (option) => option.optionTitle === axisTitle && option.value === value,
  ) ?? false;

// Only the fields the client needs to resolve a selection to a real variant.
const variants = (product?.variants ?? []).map((variant) => ({
  id: variant.id,
  inStock: variant.inStock,
  priceAmount: variant.priceAmount,
  currencyCode: variant.currencyCode,
  optionValues: Object.fromEntries(
    variant.optionValues.map((option) => [option.optionTitle, option.value]),
  ),
}));

const clientMessages = {
  inStock: m.catalog_in_stock({}, { locale }),
  outOfStock: m.catalog_out_of_stock({}, { locale }),
  addToCart: m.action_add_to_cart({}, { locale }),
  selected: m.product_selected({ options: "__OPTIONS__" }, { locale }),
  selectOption: m.product_select_option({ option: "__VALUE__" }, { locale }),
  showMore: m.product_show_more({}, { locale }),
  showLess: m.action_show_less({}, { locale }),
};
const href = product?.handle ? `/products/${encodeURIComponent(product.handle)}` : "/products";
const wishlistItem = product
  ? JSON.stringify({
      path: href,
      title: product.title,
      thumbnail: gallery[0] ?? product.thumbnail ?? null,
      priceAmount: defaultVariant?.priceAmount ?? product.priceAmount ?? null,
      currencyCode: defaultVariant?.currencyCode ?? product.currencyCode ?? "ETB",
    })
  : "";
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  cartCount={cartCount}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  seo={seo}
  structuredData={structuredData}
  title={product ? `${product.title} — ${tenantName}` : `Product — ${tenantName}`}
>
  {!product ? (
    <main id="main-content" class="container" style="min-height: 50vh; padding: 4rem 1rem; text-align: center;">
      <h1 class="type-header-3">{m.product_not_found({}, { locale })}</h1>
      <p class="type-body-s-400">{m.product_unavailable({}, { locale })}</p>
      <div style="margin-top: 2rem;">
        <Button text={m.action_back_to_products({}, { locale })} href="/products" variant="primary" />
      </div>
    </main>
  ) : (
    <main
      class="pdp-page"
      id="main-content"
      data-product-detail
      data-client-messages={JSON.stringify(clientMessages)}
    >
      <section class="product-showcase-section">
        <div class="product-showcase-section__wrapper container">
          <!-- Breadcrumbs -->
          <nav aria-label="Breadcrumb">
            <ol class="breadcrumbs">
              <li class="breadcrumbs__item">
                <a href="/" class="breadcrumbs__link type-body-s-500">Home</a>
                <span class="breadcrumbs__separator type-body-s-400" aria-hidden="true">/</span>
              </li>
              <li class="breadcrumbs__item">
                <a href="/products" class="breadcrumbs__link type-body-s-500">Shop</a>
                <span class="breadcrumbs__separator type-body-s-400" aria-hidden="true">/</span>
              </li>
              {product.collectionTitle && (
                <li class="breadcrumbs__item">
                  <a href={`/products?collection=${encodeURIComponent(product.collectionTitle)}`} class="breadcrumbs__link type-body-s-500">
                    {product.collectionTitle}
                  </a>
                  <span class="breadcrumbs__separator type-body-s-400" aria-hidden="true">/</span>
                </li>
              )}
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__current type-body-s-500" aria-current="page">{product.title}</span>
              </li>
            </ol>
          </nav>

          <!-- Product Main Showcase -->
          <div class="product-layout">
            <!-- Left: Gallery Column -->
            <div class="product-gallery">
              <div class="product-gallery__main">
                <div class="img-wrapper">
                  {gallery[0] ? (
                    <img
                      src={gallery[0]}
                      alt={product.title}
                      class="cover"
                      width="600"
                      height="580"
                    />
                  ) : (
                    <div style="height: 580px; background: #f8f2ed;"></div>
                  )}
                </div>
                {badge && (
                  <span class="product-gallery__badge type-body-s-400">{badge.label}</span>
                )}
              </div>

              {gallery.length > 1 && (
                <div class="product-gallery__thumbnails">
                  {gallery.map((thumb, idx) => (
                    <button
                      type="button"
                      class:list={[
                        "product-gallery__thumb-btn",
                        idx === 0 && "product-gallery__thumb-btn--active",
                      ]}
                      aria-label={`View image ${idx + 1}`}
                      data-gallery-thumb={thumb}
                    >
                      <div class="img-wrapper">
                        <img
                          src={thumb}
                          alt={`${product.title} thumbnail ${idx + 1}`}
                          class="cover"
                          width="141"
                          height="104"
                          loading="lazy"
                        />
                      </div>
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Right: Details Column -->
            <div class="product-details">
              <!-- Badges -->
              <div class="product-details__badges">
                {badge && (
                  <span class="product-details__badge-discount type-body-xs-500">
                    {badge.label}
                  </span>
                )}
                <span
                  class="product-details__badge-stock type-body-xs-500"
                  data-product-stock
                  aria-live="polite"
                >
                  {defaultVariant?.inStock
                    ? m.catalog_in_stock({}, { locale })
                    : m.catalog_out_of_stock({}, { locale })}
                </span>
              </div>

              <!-- Title -->
              <h1 class="product-details__title type-header-3">{product.title}</h1>

              <!-- Pricing -->
              <div class="product-details__pricing">
                <span class="product-details__price type-header-5">{currentPrice}</span>
              </div>

              <!-- Description -->
              {descriptionHtml && (
                <div class="product-details__desc-box" id="afro-product-description">
                  <div
                    class="product-details__description afro-rich-text type-body-s-400"
                    data-product-description
                    set:html={descriptionHtml}
                  />
                  <button
                    class="product-details__desc-toggle type-body-s-500"
                    type="button"
                    data-description-toggle
                    aria-expanded="false"
                    aria-controls="afro-product-description"
                    hidden
                  >
                    {m.product_show_more({}, { locale })}
                  </button>
                </div>
              )}

              <div class="product-details__divider" aria-hidden="true"></div>

              <!-- Variant Selectors: driven by the product's real option axes -->
              {axes.map((axis) => {
                const showSwatches =
                  axis.displayMode === "swatch" || isColorOptionTitle(axis.title);
                return (
                  <fieldset class="product-details__option-group" data-option-axis={axis.title}>
                    <legend class="product-details__option-label type-body-s-500">
                      {axis.title}
                    </legend>
                    <div
                      class:list={[
                        showSwatches ? "product-details__swatches" : "product-details__sizes",
                      ]}
                    >
                      {axis.values.map((value) => {
                        const selected = isSelected(axis.title, value);
                        const swatch = showSwatches ? resolveColorSwatch(value) : null;
                        const label = clientMessages.selectOption.replace("__VALUE__", value);
                        if (showSwatches) {
                          return (
                            <button
                              type="button"
                              class:list={[
                                "product-details__swatch",
                                selected && "product-details__swatch--active",
                              ]}
                              data-option-title={axis.title}
                              data-option-value={value}
                              aria-pressed={selected ? "true" : "false"}
                              aria-label={label}
                              title={value}
                            >
                              <span
                                class="product-details__swatch-chip"
                                style={swatch ? `background-color: ${swatch};` : undefined}
                                aria-hidden="true"
                              />
                            </button>
                          );
                        }
                        return (
                          <button
                            type="button"
                            class:list={[
                              "product-details__size-btn",
                              "type-body-s-500",
                              selected && "product-details__size-btn--active",
                            ]}
                            data-option-title={axis.title}
                            data-option-value={value}
                            aria-pressed={selected ? "true" : "false"}
                          >
                            {value}
                          </button>
                        );
                      })}
                    </div>
                  </fieldset>
                );
              })}

              <!-- Actions Form -->
              <form action="/actions/cart/add" method="post" data-add-form class="product-details__form" data-cart-item={JSON.stringify({ title: product.title, thumbnail: product.thumbnail, productHandle: product.handle, unitPrice: defaultVariant?.priceAmount ?? product.priceAmount })}>
                <input
                  type="hidden"
                  name="variantId"
                  value={defaultVariant?.id ?? ""}
                  data-variant-id
                />
                <input type="hidden" name="quantity" value="1" id="pdp-quantity-input" />

                <p class="product-details__selection type-body-s-400" data-config-summary>
                  {defaultVariant?.optionValues.map((option) => option.value).join(" · ") ||
                    defaultVariant?.title ||
                    ""}
                </p>

                <div class="product-details__actions">
                  <div class="product-details__quantity">
                    <button
                      type="button"
                      class="product-details__qty-btn product-details__qty-btn--minus"
                      aria-label={m.action_decrease_quantity({}, { locale })}
                    >
                      <Icon name="minus" width={12} height={2} />
                    </button>
                    <span class="product-details__qty-value type-body-400" id="pdp-qty-val">1</span>
                    <button
                      type="button"
                      class="product-details__qty-btn product-details__qty-btn--plus"
                      aria-label={m.action_increase_quantity({}, { locale })}
                    >
                      <Icon name="plus" width={12} height={12} />
                    </button>
                  </div>


                  <div class="product-details__cta">
                    <Button
                      text={
                        defaultVariant?.inStock
                          ? m.action_add_to_cart({}, { locale })
                          : m.catalog_out_of_stock({}, { locale })
                      }
                      variant="primary"
                      size="large"
                      fullWidth={true}
                      type="submit"
                      disabled={!defaultVariant?.inStock}
                      data-action="open-cart"
                      data-add-label
                    />
                  </div>

                  <button
                    type="button"
                    class="product-details__wishlist-btn"
                    data-wishlist-id={product.id}
                    data-wishlist-toggle
                    data-wishlist-item={wishlistItem}
                    aria-label={`Add ${product.title} to wishlist`}
                  >
                    <span class="wishlist-heart" aria-hidden="true">
                      <Icon name="heart" width={21} height={20} />
                      <Icon name="heart-filled" width={21} height={20} />
                    </span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>

      <!-- Similar Items Section -->
      {relatedProducts.length > 0 && (
        <section class="similar-items-section">
          <div class="similar-items-section__wrapper container">
            <h2 class="similar-items-section__title type-header-2">
              Similar Items You Might Like
            </h2>

            <div class="similar-items-section__grid">
              {relatedProducts.map((item) => (
                <ProductCard product={item} />
              ))}
            </div>
          </div>
        </section>
      )}
    </main>
  )}

  {product && (
    <script
      is:inline
      type="application/json"
      id="afro-product-variants"
      set:html={serializeJsonForScript(variants)}
    />
  )}
</Layout>

<script>
  // Resolves the selected option values to a real variant and keeps the price,
  // stock label, add-to-cart state and hidden variantId in step with it. The
  // matching rule lives in lib.ts so it is unit tested — see
  // afro-product-variants.test.ts.
  import { resolveAfroVariant } from "../lib";

  const root = document.querySelector("[data-product-detail]");
  // A product with no option axes has nothing to select, and the server already
  // rendered the correct default variant. Leaving this alone also keeps the form
  // usable, since an empty selection resolves to null and would disable submit.
  const axisGroups = root?.querySelectorAll("[data-option-axis]") ?? [];
  if (root && axisGroups.length > 0) {
    let variants: Array<{
      id: string;
      inStock: boolean;
      priceAmount: number | null;
      currencyCode: string | null;
      optionValues: Record<string, string>;
    }> = [];
    let clientMessages: Record<string, string> = {};
    try {
      variants = JSON.parse(
        document.getElementById("afro-product-variants")?.textContent || "[]",
      );
      clientMessages = JSON.parse(root.getAttribute("data-client-messages") || "{}");
    } catch {
      // Unparseable payload: variants stays empty so every selection resolves to
      // null and the submit button is disabled rather than sending a wrong id.
    }
    const selected: Record<string, string | undefined> = {};
    axisGroups.forEach((axis) => {
      const active = axis.querySelector<HTMLElement>('[aria-pressed="true"]');
      if (active) selected[active.dataset.optionTitle || ""] = active.dataset.optionValue;
    });

    const formatPrice = (amount: number, currency: string | null) => {
      try {
        return new Intl.NumberFormat(
          document.documentElement.lang === "am" ? "am-ET" : "en-ET",
          {
            style: "currency",
            currency: (currency || "ETB").toUpperCase(),
            minimumFractionDigits: 0,
            maximumFractionDigits: 2,
          },
        ).format(amount);
      } catch {
        return String(amount);
      }
    };

    const sync = () => {
      const variant = resolveAfroVariant(variants, selected);
      const input = root.querySelector<HTMLInputElement>("[data-variant-id]");
      const submit = root.querySelector<HTMLButtonElement>(
        "[data-add-form] button[type=submit]",
      );
      const price = root.querySelector(".product-details__price");
      const stock = root.querySelector("[data-product-stock]");
      const label = root.querySelector("[data-add-label] .btn__text");
      const summary = root.querySelector("[data-config-summary]");

      if (summary && clientMessages.selected) {
        summary.textContent = clientMessages.selected.replace(
          "__OPTIONS__",
          Object.values(selected).join(" · "),
        );
      }
      if (!variant) {
        // Nothing confirmed, so refuse to submit rather than sell a default variant.
        if (input) input.value = "";
        if (submit) submit.disabled = true;
        return;
      }
      if (input) input.value = variant.id;
      const form = root.querySelector<HTMLFormElement>('[data-add-form]');
      if (form?.dataset.cartItem) form.dataset.cartItem = JSON.stringify({ ...JSON.parse(form.dataset.cartItem), unitPrice: variant.priceAmount, variantTitle: Object.values(selected).join(' · ') });
      if (submit) submit.disabled = !variant.inStock;
      if (label) {
        label.textContent = variant.inStock
          ? clientMessages.addToCart || label.textContent
          : clientMessages.outOfStock || label.textContent;
      }
      if (price && variant.priceAmount != null) {
        price.textContent = formatPrice(variant.priceAmount, variant.currencyCode);
      }
      if (stock) {
        stock.textContent = variant.inStock
          ? clientMessages.inStock || ""
          : clientMessages.outOfStock || "";
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-option-value]").forEach((button) => {
      button.addEventListener("click", () => {
        const title = button.dataset.optionTitle;
        if (!title) return;
        selected[title] = button.dataset.optionValue;
        root
          .querySelectorAll<HTMLElement>(`[data-option-title="${CSS.escape(title)}"]`)
          .forEach((item) => {
            const on = item === button;
            item.setAttribute("aria-pressed", String(on));
            if (item.classList.contains("product-details__swatch")) {
              item.classList.toggle("product-details__swatch--active", on);
            }
            if (item.classList.contains("product-details__size-btn")) {
              item.classList.toggle("product-details__size-btn--active", on);
            }
          });
        sync();
      });
    });
    const description = root.querySelector<HTMLElement>('[data-product-description]');
    const descriptionToggle = root.querySelector<HTMLButtonElement>('[data-description-toggle]');
    if (description && descriptionToggle) {
      const measureDescription = () => {
        const expanded = description.classList.contains('is-expanded');
        description.classList.remove('is-collapsible', 'is-expanded');
        const lineHeight = Number.parseFloat(getComputedStyle(description).lineHeight) || 21;
        const long = description.scrollHeight > lineHeight * 5 + 1;
        description.classList.toggle('is-collapsible', long);
        description.classList.toggle('is-expanded', long && expanded);
        descriptionToggle.hidden = !long;
        descriptionToggle.setAttribute('aria-expanded', String(long && expanded));
        descriptionToggle.textContent = long && expanded
          ? (clientMessages.showLess || "Show less")
          : (clientMessages.showMore || "Show more");
      };
      descriptionToggle.addEventListener('click', () => {
        const expanded = description.classList.toggle('is-expanded');
        descriptionToggle.setAttribute('aria-expanded', String(expanded));
        descriptionToggle.textContent = expanded
          ? (clientMessages.showLess || "Show less")
          : (clientMessages.showMore || "Show more");
      });
      measureDescription();
      if ('ResizeObserver' in window && description.parentElement) {
        let descriptionWidth = description.parentElement.clientWidth;
        new ResizeObserver(([entry]) => {
          const width = Math.round(entry.contentRect.width);
          if (width === descriptionWidth) return;
          descriptionWidth = width;
          measureDescription();
        }).observe(description.parentElement);
      }
    }
  }
</script>
