---
interface Props {
  disabled?: boolean;
}

import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";

const { disabled = false } = Astro.props;
const product = Astro.locals.analyticsProduct;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<span
  data-storefront-analytics={disabled ? "disabled" : "enabled"}
  data-analytics-product={product ? JSON.stringify(product) : undefined}
  data-analytics-locale={locale}
  hidden
></span>

<script>
  import { resolveStorefrontAnalyticsSession } from "../../lib/analytics-session";
  import { cartAnalyticsSubject, type AnalyticsProduct } from "../../lib/analytics-product";

  const analyticsMarker = document.querySelector<HTMLElement>("[data-storefront-analytics]");
  if (analyticsMarker?.dataset.storefrontAnalytics === "enabled") {
    const product: AnalyticsProduct | null = analyticsMarker.dataset.analyticsProduct
      ? JSON.parse(analyticsMarker.dataset.analyticsProduct)
      : null;
    const sessionKey = "ecs:storefront-session";
    let storedSession: string | null = null;
    try {
      storedSession = window.localStorage.getItem(sessionKey);
    } catch {
      // Analytics must never prevent the storefront from working.
    }
    const session = resolveStorefrontAnalyticsSession({
      createId: () => globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`,
      now: Date.now(),
      stored: storedSession,
    });
    const sessionId = session.id;
    try {
      window.localStorage.setItem(sessionKey, JSON.stringify(session));
    } catch {
      // The in-memory session still keeps this page's events correlated.
    }

    const record = (
      eventType: string,
      subjectType?: string,
      subjectId?: string,
      properties: Record<string, unknown> = {},
    ) => {
      const payload = JSON.stringify({
        eventType,
        hostname: location.hostname,
        idempotencyKey: `${sessionId}:${eventType}:${location.pathname}:${Date.now()}`,
        language: analyticsMarker.dataset.analyticsLocale || document.documentElement.lang || "en",
        occurredAt: new Date().toISOString(),
        properties: { path: location.pathname, ...properties },
        referrer: document.referrer,
        screen: `${window.screen.width}x${window.screen.height}`,
        sessionId,
        subjectId: subjectId ?? null,
        subjectType: subjectType ?? null,
        title: document.title,
        url: `${location.pathname}${location.search}`,
      });
      if (
        navigator.sendBeacon?.(
          "/actions/analytics",
          new Blob([payload], { type: "application/json" }),
        )
      ) {
        return;
      }
      void fetch("/actions/analytics", {
        body: payload,
        headers: { "content-type": "application/json" },
        keepalive: true,
        method: "POST",
      });
    };

    record("storefront.page_viewed");
    // Product IDs join to sales; a missing/failed product page is not a product view.
    if (product) record("storefront.product_viewed", "product", product.id, {
      productId: product.id,
      productHandle: product.handle,
      productTitle: product.title,
      identityVersion: 2,
    });
    if (location.pathname === "/checkout") record("storefront.checkout_started");

    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (form instanceof HTMLFormElement && form.matches('[role="search"], [data-product-search-suggestions]')) {
        const query = String(new FormData(form).get("q") ?? "").trim().slice(0, 120);
        if (query.length >= 2) record("storefront.search_submitted", "search", undefined, { query });
      }
      if (form instanceof HTMLFormElement && form.action.includes("/actions/cart/add")) {
        const variantId = String(new FormData(form).get("variantId") ?? "");
        const subject = cartAnalyticsSubject(variantId, product);
        if (subject) record(
          "storefront.add_to_cart_clicked",
          subject.subjectType,
          subject.subjectId,
          subject.properties,
        );
      }
    });
    document.addEventListener("ecs:product-search-suggestion-selected", (event) => {
      const detail = event instanceof CustomEvent && typeof event.detail === "object" && event.detail
        ? event.detail as Record<string, unknown>
        : {};
      record("storefront.search_suggestion_selected", "product", String(detail.handle ?? ""), {
        position: Number(detail.position) || undefined,
        query: String(detail.query ?? "").slice(0, 120),
      });
    });
  }
</script>
