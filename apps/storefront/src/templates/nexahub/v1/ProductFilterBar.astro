---
import type { StoreCategory, StoreCollection } from "../../../lib/commerce/types";
import { taxonomyHandle } from "../../../lib/commerce/taxonomy-links";
import chevronIcon from "./icons/chevron-down-icon.svg?raw";
import "./styles/components/_product-filter-bar.scss";

interface Props {
  collections?: StoreCollection[];
  categories?: StoreCategory[];
  values?: { q?: string; collectionId?: string; categoryId?: string; order?: string };
  action?: string;
}

const { collections = [], categories = [], values = {}, action = "/products" } = Astro.props;
const controls = [
  ...(collections.length ? [{ key: "collection", label: collections.find((item) => taxonomyHandle(item) === values.collectionId)?.title ?? "Collection", options: [{ value: "", label: "All Collections" }, ...collections.flatMap((item) => { const value = taxonomyHandle(item); return value ? [{ value, label: item.title ?? "Collection" }] : []; })] }] : []),
  ...(categories.length ? [{ key: "category", label: categories.find((item) => taxonomyHandle(item) === values.categoryId)?.name ?? "Product Category", options: [{ value: "", label: "All Categories" }, ...categories.flatMap((item) => { const value = taxonomyHandle(item); return value ? [{ value, label: item.name ?? "Category" }] : []; })] }] : []),
];
const sortOptions = [
  { value: "", label: "Featured" },
  { value: "created_at", label: "Newest" },
  { value: "title", label: "Title A–Z" },
  { value: "-title", label: "Title Z–A" },
];
const sortLabel = sortOptions.find((item) => item.value === values.order)?.label ?? "Sort By";
---
<form class="product-filter-bar" action={action} method="get" data-filter-bar>
  {values.q && <input type="hidden" name="q" value={values.q} />}
  <div class="product-filter-bar__filters">
    {controls.map((control, index) => <div class="product-filter-bar__item">
      <input type="hidden" name={control.key} value={control.key === "collection" ? values.collectionId : values.categoryId} data-filter-input />
      <button type="button" class="product-filter-bar__btn type-body-l" aria-expanded="false" aria-controls={`nexa-filter-${index}`} data-filter-toggle={index}><span data-filter-selected>{control.label}</span><Fragment set:html={chevronIcon} /></button>
      <div class="product-filter-bar__dropdown" id={`nexa-filter-${index}`} data-filter-menu={index}>{control.options.map((option) => <button type="button" class="product-filter-bar__dropdown-opt type-body-s-400" data-filter-option={option.value}>{option.label}</button>)}</div>
    </div>)}
  </div>
  <div class="product-filter-bar__item product-filter-bar__item--sort">
    <input type="hidden" name="order" value={values.order} data-filter-input />
    <button type="button" class="product-filter-bar__sort type-body-l" aria-expanded="false" aria-controls="nexa-filter-sort" data-filter-toggle="sort"><span data-filter-selected>{sortLabel}</span><Fragment set:html={chevronIcon} /></button>
    <div class="product-filter-bar__dropdown product-filter-bar__dropdown--right" id="nexa-filter-sort" data-filter-menu="sort">{sortOptions.map((option) => <button type="button" class="product-filter-bar__dropdown-opt type-body-s-400" data-filter-option={option.value}>{option.label}</button>)}</div>
  </div>
</form>
