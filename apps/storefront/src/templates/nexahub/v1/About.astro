---
import Layout from "./Layout.astro";
import { parseNexahubData } from "./lib";
import "./styles/pages/about.scss";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
}

const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}>
  <main class="about-page" id="main-content">
    <section class="about-section container">
      <header class="about-section__hero">
        <p class="about-section__eyebrow">{m.about_eyebrow({}, { locale })}</p>
        <h1 class="about-section__title">{m.about_title({}, { locale })}</h1>
        <p class="about-section__copy">{m.about_intro({ shop: tenantName }, { locale })}</p>
      </header>
      <div class="about-section__principles">
        <article><span>01</span><h2>{m.about_choice_title({}, { locale })}</h2><p>{m.about_choice_copy({}, { locale })}</p></article>
        <article><span>02</span><h2>{m.about_clear_title({}, { locale })}</h2><p>{m.about_clear_copy({}, { locale })}</p></article>
        <article><span>03</span><h2>{m.about_help_title({}, { locale })}</h2><p>{m.about_help_copy({}, { locale })}</p></article>
      </div>
      <aside class="about-section__statement"><span>{m.about_ready({}, { locale })}</span><p>{m.about_statement({}, { locale })}</p><a href="/products">{m.about_find_product({}, { locale })} <b aria-hidden="true">↗</b></a></aside>
    </section>
  </main>
</Layout>
