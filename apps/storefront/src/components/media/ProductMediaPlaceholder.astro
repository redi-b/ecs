---
interface Props { label?: string; class?: string; }
const { label = "No product image available", class: className } = Astro.props;
---
<span class:list={["product-media-placeholder", className]} role="img" aria-label={label}>
  <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="7" y="9" width="34" height="30" rx="2"></rect><circle cx="17" cy="19" r="4"></circle><path d="m10 35 9-9 6 6 5-5 8 8"></path></svg>
</span>
<style>
  .product-media-placeholder { display: grid; width: 100%; height: 100%; min-height: inherit; place-items: center; color: color-mix(in srgb, currentColor 42%, transparent); }
  .product-media-placeholder svg { width: clamp(28px, 18%, 52px); height: auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
</style>
