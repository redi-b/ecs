@use "../abstracts" as *;

.lv-request__intro>p,
.lv-account section>p,
.lv-wishlist header>p {
  display: flex;
  align-items: center;
  gap: $space-800;
  color: color-mix(in srgb, var(--clr-ink) 64%, var(--clr-bg));
}

.lv-request__intro h1,
.lv-account h1,
.lv-wishlist h1 {
  margin: $space-300 0;
}

@media(max-width:900px) {
  .lv-request,  
  .lv-account {  
    gap: $space-200;
  }
}

@media(max-width:760px) {
  .lv-request,  
  .lv-account,  
  .lv-account.is-signed-in {  
    padding: 92px 0 $space-;  
    grid-template-columns: 1fr;
  }

  .lv-wishlist__grid,  
  .lv-account__address-grid {  
    grid-template-columns: 1fr;
  }
}

.lv-wishlist {
  min-height: 75vh;
  padding: 150px 0 $space-;
}

.lv-wishlist>header {
  margin: 0 auto $space-;
  text-align: center;
}

.lv-wishlist>header>span {
  width: 62px;
  height: 62px;
  margin: auto;
  display: grid;
  place-items: center;
  border: 1px solid var(--clr-accent);
  border-radius: 50%;
  background: var(--clr-bg);
}

.lv-wishlist h1 {
  margin: $space-600 0 $space-800;
}

.lv-wishlist header p {
  justify-content: center;
}

.lv-wishlist header small {
  color: color-mix(in srgb, var(--clr-ink) 54%, var(--clr-bg));
}

.lv-wishlist>section {
  margin: auto;
}

.lv-wishlist__loading,
.lv-wishlist__empty {
  padding: $space- $space-350;
  border-radius: $radius-;
  background: var(--clr-soft);
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
  text-align: center;
}

.lv-wishlist__loading {
  min-height: 280px;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: $space-700;
  background: var(--clr-soft);
  overflow: hidden;
}

.lv-wishlist__loading>span {
  position: relative;
  width: 58px;
  height: 58px;
  margin-bottom: $space-700;
  border: 1px solid alpha(var(--clr-primary), 0.28);
  border-radius: 50%;
}

.lv-wishlist__loading>span::before {
  content: "";
  position: absolute;
  inset: 8px;
  border: 1px solid alpha(var(--clr-primary), 0.52);
  border-radius: 50%;
}

.lv-wishlist__loading strong {
  color: var(--clr-ink);
}

.lv-wishlist__empty h2 {
  margin: 0 0 $space-800;
  color: var(--clr-ink);
}

.lv-wishlist__empty p {
  margin: 0 0 $space-400;
}

.lv-wishlist__empty a {
  min-height: 50px;
  padding: 0 $space-400;
  display: inline-flex;
  align-items: center;
  border-radius: $radius-pill;
  background: var(--clr-primary);
  color: var(--clr-on-primary);
  text-decoration: none;
}

.lv-wishlist__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: $space-700;
}

.lv-wishlist__grid article {
  min-height: 320px;
  padding: $space-650;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: linear-gradient(145deg, var(--clr-soft), var(--clr-white));
}

.lv-wishlist__media {
  width: 100%;
  height: 190px;
  margin-bottom: $space-600;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: $radius-200;
  background: var(--clr-bg);
}

.lv-wishlist__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lv-wishlist__grid span {
  color: color-mix(in srgb, var(--clr-ink) 54%, var(--clr-bg));
  text-transform: uppercase;
}

.lv-wishlist__grid a {
  margin: $space-700 0 $space-400;
  color: var(--clr-ink);
  text-transform: capitalize;
  text-decoration: none;
}

.lv-wishlist__grid strong {
  margin-top: -14px;
  margin-bottom: $space-600;
}

.lv-wishlist__grid button {
  min-height: 40px;
  padding: 0 $space-650;
  border: 1px solid var(--clr-line);
  border-radius: $radius-pill;
  background: var(--clr-surface);
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
  cursor: pointer;
}

@media(max-width:900px) {
  .lv-wishlist {  
    padding-inline: $space-500;
  }

  .lv-wishlist__grid {  
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media(max-width:760px) {
  .lv-wishlist {  
    padding: 92px $space-700 $space-;
  }
}
