---
import Layout from "../layouts/Layout.astro"; import { parseNexahubData } from "../lib"; import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale"; import * as m from "../../../../paraglide/messages.js"; import "../styles/pages/secondary.scss";
interface Props { data:unknown; themeTokens?:unknown; tenantName:string; deferCartCount?:boolean; }
const {data,themeTokens,tenantName,deferCartCount=false}=Astro.props; const template=parseNexahubData(data); const sent=Astro.url.searchParams.get("sent")==="1"; const submitError=Astro.url.searchParams.get("error"); const locale=Astro.request.headers.get(STOREFRONT_LOCALE_HEADER)==="am"?"am":"en";
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}><main class="nexa-secondary" id="main-content"><div class="container nexa-secondary__frame"><header class="nexa-secondary__hero"><span>02</span><div><h1>{m.request_title({}, {locale})}</h1><p>{m.request_intro({}, {locale})}</p></div></header><div class="nexa-secondary__split"><aside class="nexa-info-panel"><header class="nexa-panel-head"><h2>{m.request_title({}, {locale})}</h2></header><p>{m.request_intro({}, {locale})}</p></aside><section class="nexa-form-panel"><header class="nexa-panel-head"><h2>{m.request_title({}, {locale})}</h2></header><form class="nexa-inquiry-form" action="/actions/inquiries" method="post" data-inquiry-form><input type="hidden" name="type" value="product_request"/><label class="nexa-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><label>{m.request_product_name({}, {locale})} *<input name="productName" required/></label><label>{m.request_brand_optional({}, {locale})}<input name="brand"/></label><label class="is-wide">{m.request_link_optional({}, {locale})}<input name="productUrl" type="url" inputmode="url"/></label><label>{m.request_your_name({}, {locale})} *<input name="customerName" required autocomplete="name"/></label><label>{m.request_contact({}, {locale})} *<input name="contact" required/></label><label class="is-wide">{m.request_details_optional({}, {locale})}<textarea name="details" placeholder={m.request_details_placeholder({}, {locale})}></textarea></label><button type="submit">{m.request_send({}, {locale})} ↗</button><p class:list={["nexa-inquiry-status",sent&&"is-success",submitError&&"is-error"]} role="status" aria-live="polite" data-inquiry-status>{sent?m.request_received({}, {locale}):submitError?m.request_failed({}, {locale}):""}</p></form></section></div></div></main></Layout>
