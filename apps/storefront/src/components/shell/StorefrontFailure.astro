---
import OfflineStateEnhancer from "./OfflineStateEnhancer.astro";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import * as m from "../../paraglide/messages.js";

interface Props {
  actionHref?: string;
  actionLabel?: string;
  description: string;
  eyebrow: string;
  title: string;
  code?: string;
  recoveryLabel?: string;
  statusLabel?: string;
  offlineTitle?: string;
  offlineDescription?: string;
  offlineActionLabel?: string;
}

const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const { actionHref, actionLabel, description, title, code, offlineTitle = m.status_offline_title({}, { locale }), offlineDescription = m.status_offline_help({}, { locale }), offlineActionLabel = m.action_retry({}, { locale }) } = Astro.props;
---

<main class="failure-stage" data-storefront-state>
  <section class="failure-content">
    {code ? <p class="failure-code">{code}</p> : null}
    <h1 data-state-copy data-offline-copy={offlineTitle}>{title}</h1>
    <p class="failure-description" data-state-copy data-offline-copy={offlineDescription}>{description}</p>
    {actionHref && actionLabel ? <a href={actionHref} data-state-copy data-offline-copy={offlineActionLabel}>{actionLabel}</a> : null}
  </section>
</main>
<OfflineStateEnhancer />

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f6f8; color: #13202c; }
  .failure-stage { display:grid; min-height:100svh; padding:2rem 1.25rem; font-family:Outfit,ui-sans-serif,system-ui,sans-serif }
  .failure-content { align-self:center; width:100%; max-width:34rem; margin:auto }
  .failure-code { margin:0 0 .75rem; color:#637180; font-size:.875rem; font-weight:650 }
  h1 { margin:0; font-size:clamp(2.25rem,7vw,4rem); font-weight:650; letter-spacing:-.045em; line-height:1.05 }
  .failure-description { max-width:32rem; margin:1.25rem 0 0; color:#637180; font-size:1rem; line-height:1.75 }
  a { display:inline-flex; align-items:center; min-height:2.75rem; margin-top:1.75rem; border-radius:999px; background:#0878b8; color:white; padding:.65rem 1.15rem; font-size:.9rem; font-weight:650; text-decoration:none; transition:background 160ms ease,transform 160ms ease }
  a:hover { background:#066698; transform:translateY(-1px) }
  a:focus-visible { outline:3px solid color-mix(in srgb,#0878b8 35%,transparent); outline-offset:3px }
  @media (prefers-color-scheme:dark){ :global(body){background:#09131c;color:#e7edf2}.failure-code,.failure-description{color:#94a4b3} }
</style>
