<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-storefront-state]");
    const update = () => {
      const offline = navigator.onLine === false;
      for (const root of roots) {
        for (const field of root.querySelectorAll("[data-state-copy]")) {
          if (!(field instanceof HTMLElement)) continue;
          field.dataset.onlineCopy ??= field.textContent ?? "";
          const offlineCopy = field.dataset.offlineCopy;
          field.textContent = offline && offlineCopy ? offlineCopy : field.dataset.onlineCopy;
        }
        root.toggleAttribute("data-offline", offline);
      }
    };
    window.addEventListener("online", update);
    window.addEventListener("offline", update);
    update();
  })();
</script>
