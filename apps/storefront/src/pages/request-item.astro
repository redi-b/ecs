---
import StoreUnavailable from "../components/shell/StoreUnavailable.astro";
import { loadPageContext } from "../lib/page-context";
import { getStorefrontRenderer } from "../templates/registry";
import * as m from "../paraglide/messages.js";
const ctx = await loadPageContext(Astro.request, { skipCart: true });
const locale = ctx.ok ? ctx.locale : "en";
if (!ctx.ok) Astro.response.status = ctx.status;
const Page = ctx.ok ? getStorefrontRenderer(ctx.config.storefront.templateKey)?.RequestItem : null;
---
{!ctx.ok || !Page ? <StoreUnavailable message={ctx.ok ? m.status_template_unavailable({}, { locale }) : ctx.message} /> : <Page data={ctx.config.storefront.data} themeTokens={ctx.config.storefront.themeTokens} tenantName={ctx.config.tenant.name} deferCartCount={true} />}
