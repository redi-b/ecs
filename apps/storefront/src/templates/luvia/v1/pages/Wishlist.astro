---
import "../styles/pages/wishlist.scss";
import { Icon } from "astro-icon/components";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import type { StoreCategory, StoreProduct } from "../../../../lib/commerce/types";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
  demoMode?: boolean;
  categories?: StoreCategory[];
  products?: StoreProduct[];
}
const { data, themeTokens, tenantName, deferCartCount = false, demoMode = false, categories, products = [] } = Astro.props;
const template = parseLuviaData(data);
const locale =
  Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const wishlistMessages = {
  emptyTitle: m.wishlist_empty_title({}, { locale }),
  emptyHelp: m.wishlist_empty_help({}, { locale }),
  browse: m.action_browse_products({}, { locale }),
  savedProduct: m.wishlist_saved_product({}, { locale }),
  productFallback: m.catalog_product_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
  view: m.action_view_product({}, { locale }),
  addToCart: m.action_add_to_cart({}, { locale }),
};
const wishlistProducts = products.flatMap((product) => {
  if (!product.handle) return [];
  const variant = product.variants.find((item) => item.inStock) ?? product.variants[0];
  return [{
    path: `/products/${product.handle}`,
    title: product.title ?? m.catalog_product_fallback({}, { locale }),
    thumbnail: product.thumbnail,
    priceAmount: product.priceAmount,
    currencyCode: product.currencyCode,
    variantId: variant?.id ?? null,
    inStock: variant?.inStock === true,
  }];
});
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  deferCartCount={deferCartCount}
  demoMode={demoMode}
  categories={categories}
  title={m.wishlist_title({}, { locale })}
>
  <main id="main-content"
    class="wishlist container"
    data-wishlist-page
    data-wishlist-messages={JSON.stringify(wishlistMessages)}
    data-wishlist-products={JSON.stringify(wishlistProducts)}
  >
    <header>
      <h1 class="type-heading-1">
        {m.wishlist_title({}, { locale })}
      </h1><small class="type-body-400" data-wishlist-account-copy
        >{m.wishlist_intro({}, { locale })}</small>
    </header><section data-wishlist-content aria-live="polite" aria-busy="true">
      <div class="wishlist__loading">
        <span aria-hidden="true"></span><strong class="type-body-l-500"
          >{m.wishlist_loading({}, { locale })}</strong>
      </div>
    </section>
  </main>
  <template data-wishlist-empty-icon><Icon name="wishlist" /></template>
  <template data-wishlist-remove-icon><Icon name="trash" /></template>
  <template data-wishlist-bag-icon><Icon name="bag" /></template>
</Layout>
<script>
  import {
    WISHLIST_REQUEST_EVENT,
    WISHLIST_UPDATED_EVENT,
    type WishlistEntry,
  } from "../../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../../lib/browser/localized-path";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-wishlist-page]");
    const content = root?.querySelector("[data-wishlist-content]");
    if (!content) return;
    const messages = JSON.parse(
      root?.dataset.wishlistMessages || "{}",
    ) as Record<string, string>;
    const catalogByPath = new Map(
      (JSON.parse(root?.dataset.wishlistProducts || "[]") as WishlistEntry[])
        .map((product) => [product.path, product]),
    );
    let items: WishlistEntry[] = [];
    let focusAfterRender: string | null = null;
    const money = (amount: number | null, currency: string | null) => {
      if (typeof amount !== "number") return "";
      try {
        return new Intl.NumberFormat(
          document.documentElement.lang === "am" ? "am-ET" : "en-ET",
          { style: "currency", currency: (currency || "ETB").toUpperCase() },
        ).format(amount);
      } catch {
        return String(amount);
      }
    };
    const render = () => {
      content.replaceChildren();
      if (!items.length) {
        const empty = document.createElement("div");
        empty.className = "wishlist__empty empty-state";
        const mark = document.createElement("span");
        mark.className = "empty-state__mark";
        const icon = document.querySelector<HTMLTemplateElement>("[data-wishlist-empty-icon]");
        if (icon) mark.append(icon.content.cloneNode(true));
        const body = document.createElement("div");
        body.className = "empty-state__copy";
        const title = document.createElement("h2");
        title.className = "empty-state__title type-heading-3";
        title.textContent = messages.emptyTitle || "";
        const copy = document.createElement("p");
        copy.className = "empty-state__text type-body-400";
        copy.textContent = messages.emptyHelp || "";
        body.append(title, copy);
        const link = document.createElement("a");
        link.className = "empty-state__action type-body-500";
        link.href = localizeBrowserPath("/products");
        link.textContent = messages.browse || "";
        empty.append(mark, body, link);
        content.append(empty);
        if (focusAfterRender) {
          focusAfterRender = null;
          link.focus();
        }
        return;
      }
      const grid = document.createElement("div");
      grid.className = "wishlist__grid";
      for (const item of items) {
        const card = document.createElement("article");
        card.className = "product-card";
        card.dataset.wishlistPath = item.path;
        const itemPath = localizeBrowserPath(item.path);
        const mediaWrap = document.createElement("div");
        mediaWrap.className = "product-card__media";
        if (item.thumbnail) {
          const media = document.createElement("a");
          media.className = "product-card__media-link";
          media.href = itemPath;
          const image = document.createElement("img");
          image.src = item.thumbnail;
          image.alt = item.title;
          image.width = 900;
          image.height = 900;
          image.loading = "lazy";
          image.decoding = "async";
          media.append(image);
          mediaWrap.append(media);
        }
        const remove = document.createElement("button");
        remove.className = "wishlist__remove";
        remove.type = "button";
        const removeIcon = document.querySelector<HTMLTemplateElement>("[data-wishlist-remove-icon]");
        if (removeIcon) remove.append(removeIcon.content.cloneNode(true));
        remove.setAttribute("aria-label", `${messages.remove || "Remove"}: ${item.title}`);
        mediaWrap.append(remove);
        const meta = document.createElement("span");
        meta.className = "product-card__brand type-body-s-400";
        meta.textContent = messages.savedProduct || "";
        const link = document.createElement("a");
        link.className = "product-card__title type-body-l-400";
        link.href = itemPath;
        link.textContent = item.title || messages.productFallback || "";
        const price = document.createElement("strong");
        price.className = "product-card__price type-body-xl";
        price.textContent = money(item.priceAmount, item.currencyCode);
        remove.addEventListener("click", () => {
          const index = items.findIndex((saved) => saved.path === item.path);
          focusAfterRender =
            items[index + 1]?.path ?? items[index - 1]?.path ?? "__empty__";
          window.dispatchEvent(
            new CustomEvent(WISHLIST_UPDATED_EVENT, {
              detail: {
                items: items.filter((saved) => saved.path !== item.path),
                origin: "page",
              },
            }),
          );
        });
        card.append(mediaWrap, meta, link);
        if (price.textContent) card.append(price);
        if (item.variantId && item.inStock) {
          const form = document.createElement("form");
          form.className = "wishlist__add";
          form.method = "post";
          form.action = "/actions/cart/add";
          form.dataset.cardAddForm = "";
          const variant = document.createElement("input");
          variant.type = "hidden"; variant.name = "variantId"; variant.value = item.variantId;
          const quantity = document.createElement("input");
          quantity.type = "hidden"; quantity.name = "quantity"; quantity.value = "1";
          const add = document.createElement("button");
          add.type = "submit"; add.className = "type-body-s-500";
          const addIcon = document.querySelector<HTMLTemplateElement>("[data-wishlist-bag-icon]");
          if (addIcon) add.append(addIcon.content.cloneNode(true));
          const addLabel = document.createElement("span");
          addLabel.dataset.cardAddLabel = ""; addLabel.textContent = messages.addToCart || "Add to cart";
          add.append(addLabel); form.append(variant, quantity, add); card.append(form);
        }
        grid.append(card);
      }
      content.append(grid);
      if (focusAfterRender) {
        const target =
          focusAfterRender === "__empty__"
            ? content.querySelector<HTMLElement>(".empty-state__action")
            : content.querySelector<HTMLElement>(
                `[data-wishlist-path="${CSS.escape(focusAfterRender)}"] a`,
              );
        focusAfterRender = null;
        target?.focus();
      }
    };
    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const next = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail
        ?.items;
      if (!Array.isArray(next)) return;
      items = next.map((item) => ({ ...item, ...catalogByPath.get(item.path) }));
      content.setAttribute("aria-busy", "false");
      render();
    });
    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  })();
</script>
