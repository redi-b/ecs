---
import type {
  StoreCollection,
  StorefrontError,
  StoreProduct,
  StoreProductsResponse,
} from "../../../lib/commerce/types";
import type { StorefrontSeo } from "../../../lib/seo";
import ActionButton from "./ActionButton.astro";
import aboutImage from "./assets/about-feature-image.webp";
import brandImage from "./assets/brand-statement-image.webp";
import categoryImage from "./assets/categories-hero-image.webp";
import categoryPreview from "./assets/category-preview-image.webp";
import ctaImage from "./assets/cta-layer-image.webp";
import heroBg from "./assets/hero-bg-alt-image.webp";
import heroPortrait from "./assets/hero-portrait-image.webp";
import scrollMark from "./assets/scroll-logomark.svg";
import HeroProductSlide from "./HeroProductSlide.astro";
import bagIcon from "./icons/bag-icon.svg";
import chatIcon from "./icons/chat-icon.svg";
import diagonalArrow from "./icons/diagonal-arrow-icon.svg";
import sparkleIcon from "./icons/sparkle-icon.svg";
import Layout from "./Layout.astro";
import { parseLuviaData, storefrontAsset } from "./lib";
import ProductCard from "./ProductCard.astro";
import TemplateImage from "./TemplateImage.astro";
import TrustBadge from "./TrustBadge.astro";

interface Props {
  data: unknown;
  productsResult: StoreProductsResponse | StorefrontError;
  collectionProducts?: StoreProduct[];
  collections?: StoreCollection[];
  tenantName: string;
  themeTokens: unknown;
  cartCount?: number;
  deferCartCount?: boolean;
  demoMode?: boolean;
  editorMode?: boolean;
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
}
const {
  data,
  productsResult,
  collectionProducts = [],
  collections = [],
  tenantName,
  themeTokens,
  cartCount = 0,
  deferCartCount = false,
  demoMode = false,
  editorMode = false,
  seo,
  structuredData,
} = Astro.props;
const template = parseLuviaData(data);
const products = "products" in productsResult ? productsResult.products : [];
const hasError = "message" in productsResult;
const heroBackground = storefrontAsset(template.home.hero.imageAssetId, heroBg.src);
const portrait = storefrontAsset(template.home.hero.portraitAssetId, heroPortrait.src);
const pickProducts = (ids: string[], source: StoreProduct[], limit: number) => {
  if (!ids.length) return source.slice(0, limit);
  const byId = new Map(source.map((product) => [product.id, product]));
  return ids
    .map((id) => byId.get(id))
    .filter((product): product is StoreProduct => Boolean(product))
    .slice(0, limit);
};
const topPicks = pickProducts(
  template.home.featuredProducts.productIds,
  products,
  template.home.featuredProducts.limit,
);
const listingSource = collectionProducts.length ? collectionProducts : products;
const listing = pickProducts(
  template.home.products.productIds,
  listingSource,
  template.home.products.limit,
);
const legacyHeroId = template.home.hero.featuredProductId;
const configuredHeroIds = template.home.hero.featuredProductIds.length
  ? template.home.hero.featuredProductIds
  : legacyHeroId
    ? [legacyHeroId]
    : [];
const heroProducts = pickProducts(configuredHeroIds, products, 6).length
  ? pickProducts(configuredHeroIds, products, 6)
  : products.slice(0, 3);
const collectionById = new Map(collections.map((collection) => [collection.id, collection]));
const categoryCollections = (
  template.home.categories.collectionIds.length
    ? template.home.categories.collectionIds
        .map((id) => collectionById.get(id))
        .filter((item): item is StoreCollection => Boolean(item))
    : collections
).slice(0, 4);
const collectionHref = (collection: StoreCollection) =>
  `/products?collection=${encodeURIComponent(collection.id)}`;
const homeFilterCollections = collections.slice(0, 4);
const marquee = ["PURE", "RADIANT", "ORGANIC", "POWERFUL", "LUMINOUS", "COSMETICS"];
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount} deferCartCount={deferCartCount} demoMode={demoMode} title="Complete Cosmetic Essentials" editorMode={editorMode} seo={seo} structuredData={structuredData}>
  <main class="lv-home">
    {(editorMode || template.home.hero.enabled) && <section class="lv-hero" data-editor-section="home.hero" data-editor-visible-path="home.hero.enabled" data-editor-background-image-path="home.hero.imageAssetId" hidden={!template.home.hero.enabled}>
      <TemplateImage class="lv-hero__background" src={heroBackground} fallback={heroBg} alt="" widths={[480, 768, 1024, 1512, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="lv-hero__copy"><h1 data-editor-path="home.hero.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.hero.title}</h1><p data-editor-path="home.hero.subtitle" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.hero.subtitle}</p><ActionButton href={template.home.hero.primaryCtaHref} iconSrc={bagIcon.src} editorPath="home.hero.primaryCtaLabel" editorRelatedPaths={["home.hero.primaryCtaHref"]} editorMode={editorMode}>{template.home.hero.primaryCtaLabel}</ActionButton>
        <ul>{template.home.hero.trustLabels.map((label, index) => <li><TrustBadge /><span data-editor-path={`home.hero.trustLabels.${index}`} contenteditable={editorMode ? "plaintext-only" : undefined}>{label}</span></li>)}</ul>
      </div>
      <div class="lv-hero__portrait">
        <TemplateImage src={portrait} fallback={heroPortrait} alt="Model with radiant skin" widths={[480, 768, 1024]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" fetchpriority="high" data-editor-image-path="home.hero.portraitAssetId" />
        <img class="lv-hero__scroll" src={scrollMark.src} alt="" />
        {heroProducts.length > 0 && <article class="lv-promo" data-promo-carousel data-editor-products-path="home.hero.featuredProductIds" aria-label="Featured products">
          <div class="lv-promo__viewport" data-promo-viewport>
            <div class="lv-promo__track" data-promo-track>
              {heroProducts.map((product, index) => <HeroProductSlide product={product} active={index === 0} />)}
            </div>
          </div>
          <div class="lv-promo__dots" data-promo-dots aria-label="Choose featured product" hidden={heroProducts.length < 2}></div>
        </article>}
      </div>
    </section>}

    {(editorMode || template.home.story.enabled) && <section class="lv-story" data-editor-section="home.story" data-editor-visible-path="home.story.enabled" hidden={!template.home.story.enabled}><div><p data-editor-path="home.story.body" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.story.body}</p><ActionButton href={template.home.story.ctaHref} tone="secondary" size="small" editorPath="home.story.ctaLabel" editorRelatedPaths={["home.story.ctaHref"]} editorMode={editorMode}>{template.home.story.ctaLabel}</ActionButton></div><h2><span data-editor-path="home.story.titleFirstLine" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.story.titleFirstLine}</span><span data-editor-path="home.story.titleSecondLine" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.story.titleSecondLine}</span></h2></section>}

    {(editorMode || template.home.featuredProducts.enabled) && <section class="lv-section lv-top-picks" data-editor-section="home.featuredProducts" data-editor-visible-path="home.featuredProducts.enabled" hidden={!template.home.featuredProducts.enabled}><header><h2 data-editor-path="home.featuredProducts.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.featuredProducts.title}</h2><div class="lv-rail-controls"><button type="button" data-product-rail-prev aria-label="Previous products">←</button><button type="button" data-product-rail-next aria-label="Next products">→</button></div></header>{hasError ? <p class="lv-state">Products could not be loaded. Please try again.</p> : topPicks.length ? <div class="lv-product-rail" data-product-rail role="region" aria-label="Top product picks" tabindex="0">{topPicks.map((product, index) => <ProductCard product={product} eager={index < 4} />)}</div> : <p class="lv-state">Products will appear here when the catalog is ready.</p>}</section>}

    {(editorMode || template.home.products.enabled) && <section class="lv-section lv-products" data-editor-section="home.products" data-editor-visible-path="home.products.enabled" hidden={!template.home.products.enabled}><header><h2 data-editor-path="home.products.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.products.title}</h2><ActionButton href="/products" iconSrc={diagonalArrow.src} iconSize="small" tone="secondary" size="small">Full Shop</ActionButton></header><nav class="lv-filter" aria-label="Browse product listing filters"><a class="is-active" href="/products">All products</a>{homeFilterCollections.map((collection) => <a href={collectionHref(collection)}>{collection.title ?? "Collection"}</a>)}<span aria-hidden="true"></span><a href="/products?order=created_at">Newest</a><a href="/products?order=title">A–Z</a></nav>{listing.length ? <div class="lv-product-grid">{listing.map((product) => <ProductCard product={product} />)}</div> : <p class="lv-state">No products are available yet.</p>}{listing.length > 0 && <div class:list={["lv-load-more", { "is-overflowing": listing.length > 8 }]}><p>Showing {listing.length} results</p><ActionButton href="/products" iconSrc={diagonalArrow.src} iconSize="small" tone="secondary" size="small">Explore the full collection</ActionButton></div>}</section>}

    {(editorMode || template.home.brandStatement.enabled) && <section class="lv-statement" data-editor-section="home.brandStatement" data-editor-visible-path="home.brandStatement.enabled" hidden={!template.home.brandStatement.enabled}><h2 data-editor-path="home.brandStatement.firstLine" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.brandStatement.firstLine}</h2><div><TemplateImage src={storefrontAsset(template.home.brandStatement.imageAssetId, brandImage.src)} fallback={brandImage} alt="Botanical cosmetic products" widths={[128, 256, 384]} sizes="177px" data-editor-image-path="home.brandStatement.imageAssetId" /><span data-editor-path="home.brandStatement.middleLine" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.brandStatement.middleLine}</span></div><h2 data-editor-path="home.brandStatement.lastLine" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.brandStatement.lastLine}</h2></section>}

    {(editorMode || template.home.expertise.enabled) && <section class="lv-about" data-editor-section="home.expertise" data-editor-visible-path="home.expertise.enabled" hidden={!template.home.expertise.enabled}><div class="lv-about__feature"><div><h2 data-editor-path="home.expertise.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.expertise.title}</h2><p data-editor-path="home.expertise.body" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.expertise.body}</p><ActionButton href={template.home.expertise.ctaHref} tone="secondary" size="small" editorPath="home.expertise.ctaLabel" editorRelatedPaths={["home.expertise.ctaHref"]} editorMode={editorMode}>{template.home.expertise.ctaLabel}</ActionButton></div><TemplateImage src={storefrontAsset(template.home.expertise.imageAssetId, aboutImage.src)} fallback={aboutImage} alt="Cosmetic laboratory" widths={[480, 768, 1024]} sizes="(max-width: 900px) calc(100vw - 40px), 62vw" data-editor-image-path="home.expertise.imageAssetId" /></div><div class="lv-marquee">{[...marquee, ...marquee].map((word) => <><span>{word}</span><img src={sparkleIcon.src} alt="" /></>)}</div><blockquote data-editor-path="home.expertise.quote" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.expertise.quote}</blockquote></section>}

    {(editorMode || template.home.categories.enabled) && <section class="lv-categories" data-editor-section="home.categories" data-editor-visible-path="home.categories.enabled" hidden={!template.home.categories.enabled}><TemplateImage src={storefrontAsset(template.home.categories.imageAssetId, categoryImage.src)} fallback={categoryImage} alt="Woman wearing a botanical face mask" widths={[480, 768, 1024]} sizes="(max-width: 900px) 100vw, 50vw" data-editor-image-path="home.categories.imageAssetId" /><div><h2 data-editor-path="home.categories.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.categories.title}</h2><nav data-editor-collections-path="home.categories.collectionIds">{categoryCollections.length ? categoryCollections.map((collection, index) => <a href={collectionHref(collection)}><span>{index + 1}/ {collection.title ?? "Collection"}</span><img src={diagonalArrow.src} alt="" /></a>) : <a href="/products"><span>Explore all products</span><img src={diagonalArrow.src} alt="" /></a>}</nav><TemplateImage src={storefrontAsset(template.home.categories.previewAssetId, categoryPreview.src)} fallback={categoryPreview} alt="Cosmetic cleanser" widths={[128, 256, 384]} sizes="189px" data-editor-image-path="home.categories.previewAssetId" /></div></section>}

    {(editorMode || template.home.cta.enabled) && <section class="lv-cta" data-editor-section="home.cta" data-editor-visible-path="home.cta.enabled" hidden={!template.home.cta.enabled}><TemplateImage src={storefrontAsset(template.home.cta.imageAssetId, ctaImage.src)} fallback={ctaImage} alt="Cosmetics store" widths={[480, 768, 1024, 1440, 1920]} sizes="(max-width: 900px) calc(100vw - 40px), calc(100vw - 310px)" data-editor-image-path="home.cta.imageAssetId" /><div><h2 data-editor-path="home.cta.title" contenteditable={editorMode ? "plaintext-only" : undefined}>{template.home.cta.title}</h2><p>{template.home.cta.primary.enabled && <ActionButton href={template.home.cta.primary.href} iconSrc={bagIcon.src} size="small" editorPath="home.cta.primary.label" editorRelatedPaths={["home.cta.primary.href"]} editorMode={editorMode}>{template.home.cta.primary.label}</ActionButton>}{template.home.cta.secondary.enabled && <ActionButton href={template.home.cta.secondary.href} iconSrc={chatIcon.src} tone="light" size="small" editorPath="home.cta.secondary.label" editorRelatedPaths={["home.cta.secondary.href"]} editorMode={editorMode}>{template.home.cta.secondary.label}</ActionButton>}</p></div></section>}
    {editorMode && products.map((product) => <template data-editor-product-option={product.id}><HeroProductSlide product={product} active /></template>)}
    {editorMode && collections.map((collection) => <template data-editor-collection-option={collection.id}><a data-preview-href={collectionHref(collection)}><span>{collection.title ?? "Collection"}</span><img src={diagonalArrow.src} alt="" /></a></template>)}
  </main>
</Layout>
<script>
  import { initHeroCarousels } from "./scripts/hero-carousel";
  initHeroCarousels();

  const rail = document.querySelector<HTMLElement>("[data-product-rail]");
  const previous = document.querySelector<HTMLButtonElement>("[data-product-rail-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-product-rail-next]");
  const updateRailControls = () => {
    if (!rail || !previous || !next) return;
    const max = Math.max(0, rail.scrollWidth - rail.clientWidth);
    previous.disabled = rail.scrollLeft <= 2;
    next.disabled = rail.scrollLeft >= max - 2;
  };
  const moveRail = (direction: -1 | 1) => {
    if (!rail) return;
    const card = rail.querySelector<HTMLElement>(".lv-product-card");
    const distance = Math.max(card?.offsetWidth ?? rail.clientWidth * .75, rail.clientWidth * .72);
    rail.scrollBy({ left: distance * direction, behavior: "smooth" });
  };
  previous?.addEventListener("click", () => moveRail(-1));
  next?.addEventListener("click", () => moveRail(1));
  rail?.addEventListener("scroll", updateRailControls, { passive: true });
  rail?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      moveRail(event.key === "ArrowLeft" ? -1 : 1);
    }
  });
  if (rail) new ResizeObserver(updateRailControls).observe(rail);
  updateRailControls();
</script>
<style is:global lang="scss">@use "./styles/home.scss";</style>
