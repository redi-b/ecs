---
import Layout from "./Layout.astro";
import searchIcon from "./icons/search-icon.svg";
import sparkleIcon from "./icons/sparkle-icon.svg";
import { parseLuviaData } from "./lib";
interface Props { data: unknown; themeTokens?: unknown; tenantName: string; deferCartCount?: boolean; }
const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseLuviaData(data);
const sent = Astro.url.searchParams.get("sent") === "1";
const submitError = Astro.url.searchParams.get("error");
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title="Request an Item">
  <main class="lv-request">
    <section class="lv-request__intro"><p><img src={sparkleIcon.src} alt="" />PERSONAL SOURCING</p><h1>Can’t find it?<br />Let us look.</h1><span>Tell us what you are searching for. The shop can review your request and contact you about availability, alternatives, and pricing.</span></section>
    <section class="lv-request__panel"><header><span><img src={searchIcon.src} alt="" /></span><div><h2>Request an Item</h2><p>Provide as much detail as you have.</p></div></header>
      <form data-inquiry-form action="/actions/inquiries" method="post">
        <input type="hidden" name="type" value="product_request" />
        <label class="lv-inquiry-honeypot" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
        <label><span>Product Name*</span><input name="productName" required placeholder="Product or item name" /></label>
        <label><span>Brand (optional)</span><input name="brand" placeholder="Brand or maker" /></label>
        <label class="is-wide"><span>Product Link (optional)</span><input name="productUrl" type="url" inputmode="url" placeholder="https://example.com/product" /></label>
        <label><span>Your Name*</span><input name="customerName" required autocomplete="name" placeholder="Jane Doe" /></label>
        <label><span>Phone or Email*</span><input name="contact" required placeholder="How should the shop reach you?" /></label>
        <label class="is-wide"><span>Details (optional)</span><textarea name="details" placeholder="Size, shade, quantity, preferred budget, or anything else that helps"></textarea></label>
        <button type="submit">Send Product Request</button>
        <p class:list={["lv-inquiry-status", sent && "is-success", submitError && "is-error"]} role="status" aria-live="polite" data-inquiry-status>{sent ? "Request received. The shop can now review it and contact you." : submitError}</p>
      </form>
    </section>
  </main>
</Layout>
<script is:inline>
  (() => { const form = document.querySelector("[data-inquiry-form]"); if (!(form instanceof HTMLFormElement)) return; const status = form.querySelector("[data-inquiry-status]"); const button = form.querySelector("button[type=submit]"); form.addEventListener("submit", async (event) => { if (!form.reportValidity()) return; event.preventDefault(); if (button instanceof HTMLButtonElement) { button.disabled = true; button.setAttribute("aria-busy", "true"); } if (status) { status.textContent = "Sending your request…"; status.className = "lv-inquiry-status is-pending"; } try { const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(typeof data.error === "string" ? data.error : "Could not send your request."); form.reset(); if (status) { status.textContent = "Request received. The shop can now review it and contact you."; status.className = "lv-inquiry-status is-success"; } } catch (error) { if (status) { status.textContent = error instanceof Error ? error.message : "Could not send your request."; status.className = "lv-inquiry-status is-error"; } } finally { if (button instanceof HTMLButtonElement) { button.disabled = false; button.removeAttribute("aria-busy"); } } }); })();
</script>
<style is:global lang="scss">@use "./styles/secondary-pages.scss";</style>
