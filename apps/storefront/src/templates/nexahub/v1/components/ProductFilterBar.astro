---
import Icon from "./Icon.astro";
import type { CatalogFilters } from "../../../../lib/commerce/catalog-filters";
import type { StoreCategory, StoreCollection, StoreProductsResponse } from "../../../../lib/commerce/types";
import { taxonomyHandle } from "../../../../lib/commerce/taxonomy-links";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import "../styles/components/_product-filter-bar.scss";

interface Props {
  collections?: StoreCollection[];
  categories?: StoreCategory[];
  facets?: StoreProductsResponse["facets"];
  values?: CatalogFilters;
  action?: string;
}

const { collections = [], categories = [], facets, values = { optionPairs: [] }, action = "/products" } = Astro.props;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const number = new Intl.NumberFormat(locale === "am" ? "am-ET" : "en-ET");
const activeCount = Number(Boolean(values.collectionId)) + Number(Boolean(values.categoryId)) +
  values.optionPairs.length + Number(values.priceMin !== undefined || values.priceMax !== undefined);
const selectedOptionNames = new Set(values.optionPairs.flatMap((token) => {
  try { const pair = JSON.parse(token); return Array.isArray(pair) && typeof pair[0] === "string" ? [pair[0]] : []; }
  catch { return []; }
}));
---
<button class="product-filter-trigger" type="button" aria-expanded="false" aria-controls="product-filter-panel" data-filter-panel-toggle>
  <span>{m.catalog_filters({}, { locale })}{activeCount ? ` (${activeCount})` : ""}</span><Icon name="chevron-down" />
</button>
<button class="product-filter-backdrop" type="button" aria-label={m.catalog_close_filters({}, { locale })} data-filter-panel-close></button>
<form class="product-filter-panel" id="product-filter-panel" action={action} method="get" data-filter-panel>
  {values.q && <input type="hidden" name="q" value={values.q} />}
  <header><h2>{m.catalog_filter_products({}, { locale })}</h2><div>{activeCount > 0 && <a href="/products">{m.catalog_clear_filters({}, { locale })}</a>}<button type="button" aria-label={m.catalog_close_filters({}, { locale })} data-filter-panel-close><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg></button></div></header>
  <div class="product-filter-panel__scroll">
    {collections.length > 0 && <details class="product-filter-group" open>
      <summary><span>{m.catalog_collection({}, { locale })}</span><Icon name="chevron-down" /></summary><fieldset>
        <label><input type="radio" name="collection" value="" checked={!values.collectionId} /><span>{m.catalog_all_collections({}, { locale })}</span></label>
        {collections.flatMap((item) => { const value = taxonomyHandle(item); return value ? [<label><input type="radio" name="collection" value={value} checked={values.collectionId === value} /><span>{item.title ?? m.catalog_collection_fallback({}, { locale })}</span>{facets?.collections[item.id] !== undefined && <small>{facets.collections[item.id]}</small>}</label>] : []; })}
      </fieldset>
    </details>}
    {categories.length > 0 && <details class="product-filter-group" open>
      <summary><span>{m.catalog_category({}, { locale })}</span><Icon name="chevron-down" /></summary><fieldset>
        <label><input type="radio" name="category" value="" checked={!values.categoryId} /><span>{m.catalog_all_categories({}, { locale })}</span></label>
        {categories.flatMap((item) => { const value = taxonomyHandle(item); return value ? [<label><input type="radio" name="category" value={value} checked={values.categoryId === value} /><span>{item.name ?? m.catalog_category_fallback({}, { locale })}</span>{facets?.categories[item.id] !== undefined && <small>{facets.categories[item.id]}</small>}</label>] : []; })}
      </fieldset>
    </details>}
    {facets?.options.map((option) => <details class="product-filter-group" open={selectedOptionNames.has(option.name)}>
      <summary><span>{option.name}</span><Icon name="chevron-down" /></summary><fieldset>
        {option.values.map((item) => <label><input type="checkbox" name="option" value={item.token} checked={values.optionPairs.includes(item.token)} /><span>{item.value}</span><small>{item.count}</small></label>)}
      </fieldset>
    </details>)}
    {facets?.price && <details class="product-filter-group" open={values.priceMin !== undefined || values.priceMax !== undefined}>
      <summary><span>{m.catalog_price_range({}, { locale })}</span><Icon name="chevron-down" /></summary><fieldset class="product-filter-panel__price">
        <p>ETB {number.format(Math.floor(facets.price.min))} {m.catalog_to({}, { locale })} {number.format(Math.ceil(facets.price.max))}</p>
        <div><label><span>{m.catalog_minimum({}, { locale })}</span><input type="number" name="price_min" min={Math.floor(facets.price.min)} max={Math.ceil(facets.price.max)} step="1" value={values.priceMin} placeholder={String(Math.floor(facets.price.min))} /></label><label><span>{m.catalog_maximum({}, { locale })}</span><input type="number" name="price_max" min={Math.floor(facets.price.min)} max={Math.ceil(facets.price.max)} step="1" value={values.priceMax} placeholder={String(Math.ceil(facets.price.max))} /></label></div>
      </fieldset>
    </details>}
    <details class="product-filter-group">
      <summary><span>{m.catalog_sort_by({}, { locale })}</span><Icon name="chevron-down" /></summary><fieldset>
        {[["", values.q ? m.catalog_relevance({}, { locale }) : m.catalog_featured({}, { locale })], ["created_at", m.catalog_newest({}, { locale })], ["price", m.catalog_price_low_high({}, { locale })], ["-price", m.catalog_price_high_low({}, { locale })], ["title", m.catalog_title_az({}, { locale })], ["-title", m.catalog_title_za({}, { locale })]].map(([value, label]) => <label><input type="radio" name="order" value={value} checked={(values.order ?? "") === value} /><span>{label}</span></label>)}
      </fieldset>
    </details>
  </div>
  <div class="product-filter-panel__actions"><button type="submit" data-applying-label={m.catalog_applying_filters({}, { locale })}>{m.catalog_apply_filters({}, { locale })}</button></div>
</form>

<script>
  import { initAnimatedDetails } from "../../../../lib/browser/animate-details";

  const trigger = document.querySelector<HTMLButtonElement>("[data-filter-panel-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-filter-panel]");
  const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
  const setOpen = (open: boolean) => {
    trigger?.setAttribute("aria-expanded", String(open));
    panel?.toggleAttribute("data-open", open);
    document.documentElement.toggleAttribute("data-catalog-filter-open", open);
    const mobile = window.matchMedia("(max-width: 767px)").matches;
    if (panel && mobile) {
      panel.toggleAttribute("aria-modal", open);
      if (open) { panel.setAttribute("role", "dialog"); panel.querySelector<HTMLElement>("[data-filter-panel-close]")?.focus(); }
      else panel.removeAttribute("role");
    }
  };
  trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
  initAnimatedDetails(document, ".product-filter-group", ":scope > fieldset");
  const showCatalogLoading = () => {
    const results = document.querySelector<HTMLElement>("[data-catalog-results]");
    results?.setAttribute("data-loading", "true");
    results?.setAttribute("aria-busy", "true");
  };
  panel?.addEventListener("submit", () => {
    const submit = panel.querySelector<HTMLButtonElement>('button[type="submit"]');
    showCatalogLoading();
    if (submit) { submit.disabled = true; submit.textContent = submit.dataset.applyingLabel || submit.textContent; }
  });
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>(".products-catalog a, .products-pagination a") : null;
    const pointer = event instanceof MouseEvent ? event : null;
    if (link && pointer && !event.defaultPrevented && !pointer.metaKey && !pointer.ctrlKey && !pointer.shiftKey && !pointer.altKey) showCatalogLoading();
  });
  document.querySelectorAll<HTMLButtonElement>("[data-filter-panel-close]").forEach((button) => button.addEventListener("click", () => { setOpen(false); trigger?.focus(); }));
  document.addEventListener("keydown", (event) => {
    if (!panel?.hasAttribute("data-open") || !window.matchMedia("(max-width: 767px)").matches) return;
    if (event.key === "Escape") { setOpen(false); trigger?.focus(); return; }
    if (event.key !== "Tab") return;
    const focusable = [...panel.querySelectorAll<HTMLElement>(focusableSelector)].filter((element) => element.getClientRects().length > 0);
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
</script>
