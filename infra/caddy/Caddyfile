{
	auto_https off
}

# Local dev proxy only. Do NOT long-cache /_next/static here —
# Turbopack/HMR reuses chunk URLs; immutable cache causes stale JS,
# hydration mismatches, and hard-refresh-only updates.
# Production caching lives in infra/dokploy/Caddyfile + dashboard next.config (prod).

http://api.lvh.me {
	reverse_proxy host.docker.internal:3000
}

http://app.lvh.me {
	reverse_proxy host.docker.internal:3001
}

http://dashboard.lvh.me {
	redir http://app.lvh.me{uri} permanent
}

http://ops.lvh.me {
	reverse_proxy host.docker.internal:3002
}

http://*.lvh.me {
	@dashboardAssets path /_next/* /__nextjs* /favicon.ico /favicon.svg /brand/*
	handle @dashboardAssets {
		reverse_proxy host.docker.internal:3001
	}

	@merchantDashboard path /dashboard* /onboarding* /sign-in* /sign-up* /sign-out* /session* /check-email* /verify-email* /forgot-password* /reset-password* /accept-invitation*
	handle @merchantDashboard {
		reverse_proxy host.docker.internal:3001
	}

	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy host.docker.internal:3000
	}

	handle {
		reverse_proxy host.docker.internal:4321
	}
}
