          </div>
        </div>
      </div>
    </section>

    <!-- 6. Steps Section -->
    <section class="steps" id="how-it-works">
      <div class="container steps__wrapper">
        <div class="steps__card" data-fade-in="tl:fade-2">
          <div class="steps__header">
            <h2 class="steps__title type-header-2" data-text-anim="tl:headerAnimation">
              LAUNCHING YOUR NEW STORE IN JUST A FEW CLEAR STEPS
            </h2>
            <div class="steps__header-right">
              <p class="steps__header-desc" data-text-anim="tl:bodyAnimation">
                Getting started is straightforward. Here’s what happens after you decide to move forward.
              </p>
              <Button
                text="Create My Store"
                variant="primary"
                size="large"
                icon="link-arrow-icon"
                href={dashboardUrls.signUp}
                authAware={true}
                authenticatedText="Go to dashboard"
                data-fade-in="tl:fade-btn"
              />
            </div>
          </div>

          <div class="steps__timeline" data-steps-timeline>
            <!-- Timeline center vertical background line -->
            <div class="steps__timeline-line" aria-hidden="true">
              <div class="steps__timeline-progress"></div>
            </div>

            <!-- Step 1 (Active by default) -->
            <div class="steps__item steps__item--1 steps__item--active" data-step="1">
              <div class="steps__item-left">
                <span class="steps__badge">Step 01</span>
                <div class="steps__icon-box">
                  <span class="steps__icon-inner">
                    <Icon name="steps-account-icon" />
                  </span>
                </div>
              </div>
              <div class="steps__dot-wrapper">
                <span class="steps__dot"></span>
              </div>
              <div class="steps__item-right">
                <div class="steps__text-block">
                  <h3 class="steps__item-title">Create Your Account</h3>
                  <p class="steps__item-desc">Sign up and set up your basic business details in a few minutes.</p>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="steps__item steps__item--2" data-step="2">
              <div class="steps__item-left">
                <div class="steps__text-block steps__text-block--right">
                  <h3 class="steps__item-title">Add Your Products</h3>
                  <p class="steps__item-desc">Upload your products, set prices, stock levels, and organise your catalogue.</p>
                </div>
              </div>
              <div class="steps__dot-wrapper">
                <span class="steps__dot"></span>
              </div>
              <div class="steps__item-right">
                <div class="steps__icon-box">
                  <span class="steps__icon-inner">
                    <Icon name="steps-products-icon" />
                  </span>
                </div>
                <span class="steps__badge">Step 02</span>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="steps__item steps__item--3" data-step="3">
              <div class="steps__item-left">
                <span class="steps__badge">Step 03</span>
                <div class="steps__icon-box">
                  <span class="steps__icon-inner">
                    <Icon name="steps-customize-icon" />
                  </span>
                </div>
              </div>
              <div class="steps__dot-wrapper">
                <span class="steps__dot"></span>
              </div>
              <div class="steps__item-right">
                <div class="steps__text-block">
                  <h3 class="steps__item-title">Customize Your Store</h3>
                  <p class="steps__item-desc">Choose a template, add your branding, and adjust the look to match your business.</p>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="steps__item steps__item--4" data-step="4">
              <div class="steps__item-left">
                <div class="steps__text-block steps__text-block--right">
                  <h3 class="steps__item-title">Publish Your Site</h3>
                  <p class="steps__item-desc">Link payment methods, then publish your store and start selling.</p>
                </div>
              </div>
              <div class="steps__dot-wrapper">
                <span class="steps__dot"></span>
              </div>
              <div class="steps__item-right">
                <div class="steps__icon-box">
                  <span class="steps__icon-inner">
                    <Icon name="steps-publish-icon" />
                  </span>
                </div>
                <span class="steps__badge">Step 04</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Live template and plan catalogs are rendered from the ECS Platform API. -->
    <TemplatesSection
      templates={templateCards}
      signUpUrl={dashboardUrls.signUp}
    />

    <PricingSection plans={pricingPlans} signUpUrl={dashboardUrls.signUp} />
    <!-- 9. CTA Section Component -->
    <CtaSection />

    <!-- 10. Footer Component -->
    <Footer />
  </main>
</Layout>
