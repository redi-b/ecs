@use "../abstracts" as *;

.lv-request {
  min-height: 850px;
  margin: auto;
  padding: 150px 0 $space-;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: $space-;
  align-items: center;
}

.lv-request__intro>span {
  max-width: 520px;
  display: block;
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-request__panel {
  padding: $space-250;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: var(--clr-surface);
  box-shadow: 0 30px 80px alpha(var(--clr-ink), 0.1);
}

.lv-request__panel>header {
  margin-bottom: $space-350;
  display: flex;
  gap: $space-650;
  align-items: center;
}

.lv-request__panel>header>span {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--clr-accent);
}

.lv-request__panel h2 {
  margin: 0 0 $space-900;
}

.lv-request__panel header p {
  margin: 0;
  color: color-mix(in srgb, var(--clr-ink) 54%, var(--clr-bg));
}

.lv-request form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: $space-600;
}

.lv-request label {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: $space-800;
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-request label.is-wide,
.lv-request form>button,
.lv-request__unavailable {
  grid-column: 1 / -1;
}

.lv-request input,
.lv-request textarea {
  width: 100%;
  min-height: 52px;
  padding: $space-650;
  border: 1px solid var(--clr-line);
  border-radius: $radius-150;
  outline: 0;
}

.lv-request textarea {
  min-height: 120px;
  resize: vertical;
}

.lv-request input:focus,
.lv-request textarea:focus {
  border-color: var(--clr-primary);
  box-shadow: 0 0 0 3px alpha(var(--clr-primary), 0.14);
}

.lv-request form>button {
  min-height: 54px;
  border: 0;
  border-radius: $radius-pill;
  background: var(--clr-primary);
  color: var(--clr-on-primary);
  cursor: pointer;
}

.lv-request__unavailable {
  padding: $space-650;
  border-radius: $radius-200;
  background: var(--clr-warning-bg);
  color: var(--clr-warning);
}

@media(max-width:760px) {
  .lv-request__panel {  
    padding: $space-400 $space-600;
  }

  .lv-request form {  
    grid-template-columns: 1fr;
  }

  .lv-request label.is-wide,  
  .lv-request form>button,  
  .lv-request__unavailable {  
    grid-column: auto;
  }
}
