{
  "name": "@ecs/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 4321",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "i18n:check": "tsx scripts/i18n-report.ts",
    "i18n:coverage": "tsx scripts/i18n-report.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0 --port 4321"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.0.2",
    "@ecs/content": "workspace:*",
    "@ecs/contracts": "workspace:*",
    "@ecs/storefront-templates": "workspace:*",
    "@inlang/paraglide-js": "^2.25.4",
    "astro": "^7.1.3",
    "embla-carousel": "^8.6.0",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "lenis": "^1.3.26",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "sass-embedded": "^1.102.0"
  }
}
