---
import { sanitizeProductDescription } from "@ecs/content";
import StoreShell from "../../components/shell/StoreShell.astro";
import type { StoreProduct, StoreProductVariant } from "../../lib/commerce/types";
import { buildProductImageSrcset, resolveProductImage } from "../../lib/media-url";
import { formatMoney } from "../../lib/money";
import type { StorefrontSeo } from "../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../lib/storefront-locale";
import type { ShellTheme } from "../../lib/theme";
import * as m from "../../paraglide/messages.js";

interface Props {
  /** Template-owned storefront data; unused by the fallback shell. */
  data?: unknown;
  tenantName: string;
  cartCount?: number;
  deferCartCount?: boolean;
  primaryColor?: string;
  theme?: ShellTheme;
  currentPath?: string;
  product: StoreProduct | null;
  handle: string;
  notice?: string | null;
  error?: string | null;
  relatedProducts?: StoreProduct[];
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
}

const {
  tenantName,
  cartCount = 0,
  primaryColor,
  theme,
  currentPath,
  product,
  handle,
  notice,
  error,
  seo,
  structuredData,
} = Astro.props;

const defaultVariant: StoreProductVariant | null =
  product?.variants.find((variant: StoreProductVariant) => variant.inStock) ??
  product?.variants[0] ??
  null;
const descriptionHtml = sanitizeProductDescription(product?.description);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
---

{
  !product ? (
    <StoreShell
      tenantName={tenantName}
      cartCount={cartCount}
      title={m.product_not_found({}, { locale })}
      primaryColor={primaryColor}
      theme={theme}
      currentPath={currentPath}
      seo={seo}
      structuredData={structuredData}
    >
      <div class="sf-notice" role="status">
        <p class="sf-eyebrow">{m.product_unavailable({}, { locale })}</p>
        <h1 class="sf-title">{m.product_not_found({}, { locale })}</h1>
        <p class="sf-lede">{m.product_unavailable({}, { locale })}</p>
        <a class="sf-btn sf-btn-secondary" href="/products">
          {m.action_back_to_products({}, { locale })}
        </a>
      </div>
    </StoreShell>
  ) : (
    <StoreShell
      tenantName={tenantName}
      cartCount={cartCount}
      title={product.title ?? m.catalog_product_fallback({}, { locale })}
      primaryColor={primaryColor}
      theme={theme}
      currentPath={currentPath}
      seo={seo}
      structuredData={structuredData}
    >
      {notice === "added" && (
        <div class="sf-notice sf-notice-ok" role="status">
          {m.product_added_to_cart({}, { locale })}{" "}
          <a href="/cart">
            <strong>{m.cart_view({}, { locale })}</strong>
          </a>
        </div>
      )}
      {error && (
        <div class="sf-notice sf-notice-error" role="alert">
          {error}
        </div>
      )}

      <div class="sf-pdp">
        <div>
          {product.thumbnail ? (
            <img
              class="sf-pdp-media"
              src={resolveProductImage(product.thumbnailVariants, "w1200", product.thumbnail)}
              srcset={buildProductImageSrcset(product.thumbnailVariants) ?? undefined}
              alt=""
              width="1200"
              height="1200"
              decoding="async"
            />
          ) : (
            <div class="sf-pdp-media" aria-hidden="true" />
          )}
        </div>
        <div class="sf-stack">
          <div>
            <p class="sf-muted">
              <a href="/products">{m.catalog_products({}, { locale })}</a>
            </p>
            <h1 class="sf-title">{product.title ?? m.catalog_product_fallback({}, { locale })}</h1>
            <p class="sf-card-price" style="font-size:1.25rem;margin-top:0.35rem">
              {formatMoney(
                defaultVariant?.priceAmount ?? product.priceAmount,
                defaultVariant?.currencyCode ?? product.currencyCode,
                locale,
              )}
            </p>
          </div>
          {descriptionHtml && <div class="sf-lede sf-rich-text" style="margin-bottom:0" set:html={descriptionHtml} />}

          <form method="post" action="/actions/cart/add" class="sf-stack" style="margin-top:0.5rem">
            {product.variants.length > 1 ? (
              <div class="sf-field">
                <label for="variantId">{m.product_select_option({ option: m.product_option({}, { locale }) }, { locale })}</label>
                <select id="variantId" name="variantId" required>
                  {product.variants.map((variant: StoreProductVariant) => (
                    <option
                      value={variant.id}
                      selected={variant.id === defaultVariant?.id}
                      disabled={!variant.inStock}
                    >
                      {(variant.title ||
                        variant.optionValues.map((v) => v.value).join(" / ") ||
                        m.product_select_option({ option: m.product_option({}, { locale }) }, { locale })) +
                        (variant.inStock ? "" : ` (${m.catalog_out_of_stock({}, { locale })})`) +
                        (variant.priceAmount != null
                          ? ` · ${formatMoney(variant.priceAmount, variant.currencyCode, locale)}`
                          : "")}
                    </option>
                  ))}
                </select>
              </div>
            ) : (
              <input type="hidden" name="variantId" value={defaultVariant?.id ?? ""} />
            )}

            <div class="sf-field">
              <label for="quantity">{m.cart_quantity({}, { locale })}</label>
              <input id="quantity" name="quantity" type="number" min="1" value="1" required />
            </div>

            <input type="hidden" name="returnTo" value={`/products/${encodeURIComponent(handle)}`} />

            <button
              class="sf-btn sf-btn-accent"
              type="submit"
              disabled={
                !defaultVariant ||
                (!defaultVariant.inStock &&
                  product.variants.every((v: StoreProductVariant) => !v.inStock))
              }
            >
              {m.action_add_to_cart({}, { locale })}
            </button>
          </form>
        </div>
      </div>
    </StoreShell>
  )
}
