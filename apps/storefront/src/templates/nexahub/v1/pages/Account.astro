---
import type { CustomerAccountView } from "../../../../lib/commerce/account";
import { formatStorefrontDate } from "../../../../lib/date";
import { formatMoney } from "../../../../lib/money";
import { formatOrderReference } from "../../../../lib/order-reference";
import { orderStatusLabel } from "../../../../lib/order-status-label";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Layout from "../layouts/Layout.astro";
import { parseNexahubData } from "../lib";
import "../styles/pages/secondary.scss";
interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
  account?: CustomerAccountView | null;
  error?: string | null;
  success?: string | null;
  initialMode?: "login" | "register";
}
const {
  data,
  themeTokens,
  tenantName,
  deferCartCount = false,
  account = null,
  error = null,
  success = null,
  initialMode = "login",
} = Astro.props;
const template = parseNexahubData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const date = (value: string | null) => {
  if (!value) return m.account_date_unavailable({}, { locale });
  return formatStorefrontDate(value, locale) ?? m.account_date_unavailable({}, { locale });
};
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}>
<main class="nexa-secondary nexa-account" id="main-content">
<div class="container nexa-secondary__frame">{account?<>
<header class="nexa-secondary__hero">
<span>{m.account_title({}, { locale })}</span>
<div>
<h1>{m.account_welcome({ name: account.customer.firstName || m.account_friend({}, { locale }) }, { locale })}</h1>
<p>{account.customer.email}</p>
</div>
</header>
<div class="nexa-account__toolbar">
<nav aria-label={m.account_title({}, { locale })} role="tablist">
<a href="#order-history" role="tab" aria-selected="true" data-account-view="orders">{m.account_orders({}, { locale })} / {account.orderCount}</a>
<a href="#saved-addresses" role="tab" aria-selected="false" data-account-view="addresses">{m.account_addresses({}, { locale })} / {account.addresses.length}</a>
<a href="#profile-details" role="tab" aria-selected="false" data-account-view="profile">{m.account_profile({}, { locale })}</a>
</nav>
<form action="/actions/account/logout" method="post">
<button type="submit">{m.account_sign_out({}, { locale })}</button>
</form>
</div>{error&&<div class="nexa-notice nexa-notice--error" role="alert">{error}</div>}{success&&<div class="nexa-notice" role="status">{success}</div>}
<section class="nexa-data-panel" id="order-history" data-account-panel="orders">
<header class="nexa-panel-head">
<h2>{m.account_order_history({}, { locale })}</h2>
<span>{account.orderCount===1?m.account_item_count({ count: account.orderCount }, { locale }):m.account_item_count_plural({ count: account.orderCount }, { locale })}</span>
</header>{account.orders.length ? (<>
<ol class="nexa-account__orders">{account.orders.map((order,index)=>
<li>
<a href={`/account/orders/${encodeURIComponent(order.id)}`}>
<span>{String(account.orderOffset+index+1).padStart(2,"0")}</span>
<div>
<strong>{m.account_order_reference({ reference: formatOrderReference(order.id,order.customDisplayId) }, { locale })}</strong>
<small>{date(order.createdAt)}</small>
</div>
<div>
<strong>{order.total==null?m.account_total_unavailable({}, { locale }):formatMoney(order.total,order.currencyCode,locale)}</strong>
<small>{order.itemCount===1?m.account_item_count({ count: order.itemCount }, { locale }):m.account_item_count_plural({ count: order.itemCount }, { locale })} / {orderStatusLabel(order.status, locale)}</small>
</div>
<b aria-hidden="true">↗</b>
</a>
</li>)}</ol>{account.orderCount > account.orderLimit ? <nav class="nexa-pagination" aria-label={m.account_order_pages({}, { locale })}>{account.orderOffset > 0 ? <a href={`/account?page=${Math.max(1,account.orderOffset/account.orderLimit)}`}>{m.account_previous({}, { locale })}</a> : null}<span>{m.account_page_count({ page: Math.floor(account.orderOffset/account.orderLimit)+1, total: Math.ceil(account.orderCount/account.orderLimit) }, { locale })}</span>{account.orderOffset + account.orderLimit < account.orderCount ? <a href={`/account?page=${account.orderOffset/account.orderLimit+2}`}>{m.account_next({}, { locale })}</a> : null}</nav> : null}</>) : <div class="nexa-empty">
<span class="nexa-empty__index">00</span>
<h2>{m.account_no_orders({}, { locale })}</h2>
<p>{m.account_no_orders_help({}, { locale })}</p>
<a class="nexa-primary-action" href="/products">{m.action_browse_products({}, { locale })} <span class="nexa-primary-action__icon" aria-hidden="true">↗</span></a>
</div>}</section>
<section class="nexa-data-panel" id="saved-addresses" data-account-panel="addresses" hidden>
<header class="nexa-panel-head">
<h2>{m.account_saved_addresses({}, { locale })}</h2>
<span>{account.addresses.length===1?m.account_address_count({ count: account.addresses.length }, { locale }):m.account_address_count_plural({ count: account.addresses.length }, { locale })}</span>
</header>
<div class="nexa-account__addresses">{account.addresses.map((address,index)=>
<article>
<button type="button" data-address-toggle aria-expanded="false">
<span>{String(index+1).padStart(2,"0")}</span>
<div>
<strong>{address.addressName||`${address.firstName} ${address.lastName}`}</strong>
<small>{address.address1}, {address.city}</small>
</div>
<b>{address.isDefaultShipping?`${m.account_default({}, { locale })} · ${m.account_edit({}, { locale })}`:m.account_edit({}, { locale })}</b>
</button>
<form class="nexa-account-form" action="/actions/account/address" method="post" hidden>
<input type="hidden" name="addressId" value={address.id}/>
<label>{m.account_label({}, { locale })}<input name="addressName" value={address.addressName}/>
</label>
<label>{m.account_phone({}, { locale })}<input name="phone" value={address.phone}/>
</label>
<label>{m.account_first_name({}, { locale })}<input name="firstName" value={address.firstName} required/>
</label>
<label>{m.account_last_name({}, { locale })}<input name="lastName" value={address.lastName} required/>
</label>
<label class="is-wide">{m.account_street_address({}, { locale })}<input name="address1" value={address.address1} required/>
</label>
<label>{m.account_city({}, { locale })}<input name="city" value={address.city} required/>
</label>
<label>{m.account_region({}, { locale })}<input name="province" value={address.province}/>
</label>
<label class="is-wide">
<span>
<input type="checkbox" name="isDefaultShipping" checked={address.isDefaultShipping}/> {m.account_use_at_checkout({}, { locale })}</span>
</label>
<button type="submit" name="intent" value="save">{m.account_save_changes({}, { locale })}</button>
<button class="is-danger" type="submit" name="intent" value="delete">{m.account_remove_address({}, { locale })}</button>
</form>
</article>)}<article>
<button type="button" data-address-toggle aria-expanded="false">
<span>+</span>
<div>
<strong>{m.account_add_address({}, { locale })}</strong>
<small>{m.account_save_address_help({}, { locale })}</small>
</div>
<b>{m.account_open({}, { locale })}</b>
</button>
<form class="nexa-account-form" action="/actions/account/address" method="post" hidden>
<label>{m.account_label({}, { locale })}<input name="addressName" placeholder={m.account_home({}, { locale })}/>
</label>
<label>{m.account_phone({}, { locale })}<input name="phone" value={account.customer.phone}/>
</label>
<label>{m.account_first_name({}, { locale })}<input name="firstName" value={account.customer.firstName} required/>
</label>
<label>{m.account_last_name({}, { locale })}<input name="lastName" value={account.customer.lastName} required/>
</label>
<label class="is-wide">{m.account_street_address({}, { locale })}<input name="address1" required/>
</label>
<label>{m.account_city({}, { locale })}<input name="city" value="Addis Ababa" required/>
</label>
<label>{m.account_region({}, { locale })}<input name="province"/>
</label>
<label class="is-wide">
<span>
<input type="checkbox" name="isDefaultShipping" checked={account.addresses.length===0}/> {m.account_use_at_checkout({}, { locale })}</span>
</label>
<button type="submit" name="intent" value="save">{m.account_save_address({}, { locale })}</button>
</form>
</article>
</div>
</section>
<section class="nexa-data-panel" id="profile-details" data-account-panel="profile" hidden>
<header class="nexa-panel-head">
<h2>{m.account_profile_details({}, { locale })}</h2>
<span>{m.account_contact_details({}, { locale })}</span>
</header>
<form class="nexa-account-form" action="/actions/account/profile" method="post">
<label>{m.account_first_name({}, { locale })}<input name="firstName" value={account.customer.firstName} required autocomplete="given-name"/>
</label>
<label>{m.account_last_name({}, { locale })}<input name="lastName" value={account.customer.lastName} required autocomplete="family-name"/>
</label>
<label class="is-wide">{m.account_email({}, { locale })}<input value={account.customer.email} readonly autocomplete="email"/>
</label>
<label class="is-wide">{m.account_phone({}, { locale })}<input name="phone" value={account.customer.phone} autocomplete="tel"/>
</label>
<button type="submit">{m.account_save_profile({}, { locale })}</button>
</form>
</section>
</>:<>
<header class="nexa-secondary__hero">
<span>{m.account_title({}, { locale })}</span>
<div>
<h1>{m.account_guest_heading({}, { locale })}</h1>
<p>{m.account_guest_intro({}, { locale })}</p>
</div>
</header>
<div class="nexa-secondary__split">
<aside class="nexa-info-panel">
<header class="nexa-panel-head">
<h2>{m.account_shop_your_way({}, { locale })}</h2>
<span>{m.account_guest_choice({}, { locale })}</span>
</header>
<ul class="nexa-info-list">
<li>
<small>{m.account_browse({}, { locale })}</small>
<a href="/products">{m.action_continue_shopping({}, { locale })} ↗</a>
</li>
<li>
<small>{m.account_need_help({}, { locale })}</small>
<a href="/contact">{m.account_contact_shop({}, { locale })} ↗</a>
</li>
<li>
<small>{m.account_new_here({}, { locale })}</small>
<span>{m.account_benefit({}, { locale })}</span>
</li>
</ul>
</aside>
<section class="nexa-form-panel" data-account-auth>
<header class="nexa-panel-head">
<h2>{initialMode==="register"?m.account_create({}, { locale }):m.action_sign_in({}, { locale })}</h2>
<nav role="tablist">
<a href="/account" role="tab" aria-selected={initialMode==="login"} data-account-mode="login">{m.action_sign_in({}, { locale })}</a> / <a href="/account?mode=register" role="tab" aria-selected={initialMode==="register"} data-account-mode="register">{m.account_register({}, { locale })}</a>
</nav>
</header>{error&&<div class="nexa-notice nexa-notice--error" role="alert">{error}</div>}<section data-auth-panel="login" hidden={initialMode!=="login"}>
<form class="nexa-account-form" action="/actions/account/login" method="post">
<label class="is-wide">{m.account_email({}, { locale })}<input name="email" type="email" required autocomplete="email"/>
</label>
<label class="is-wide">{m.account_password({}, { locale })}<input name="password" type="password" minlength="8" required autocomplete="current-password"/>
</label>
<button type="submit">{m.action_sign_in({}, { locale })}</button>
</form>
</section>
<section data-auth-panel="register" hidden={initialMode!=="register"}>
<form class="nexa-account-form" action="/actions/account/register" method="post">
<label>{m.account_first_name({}, { locale })}<input name="firstName" required autocomplete="given-name"/>
</label>
<label>{m.account_last_name({}, { locale })}<input name="lastName" required autocomplete="family-name"/>
</label>
<label class="is-wide">{m.account_email({}, { locale })}<input name="email" type="email" required autocomplete="email"/>
</label>
<label class="is-wide">{m.account_password({}, { locale })}<input name="password" type="password" minlength="8" required autocomplete="new-password"/>
</label>
<button type="submit">{m.account_create({}, { locale })}</button>
</form>
</section>
</section>
</div>
</>}</div>
</main>
</Layout>
<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  async function swapPanel(current: HTMLElement | null, next: HTMLElement | null) {
    if (!next || current === next) return;
    if (current && !current.hidden && !reducedMotion) {
      await current.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-8px)' }], { duration: 140, easing: 'ease-out' }).finished.catch(() => undefined);
    }
    if (current) current.hidden = true;
    next.hidden = false;
    if (!reducedMotion) next.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 220, easing: 'cubic-bezier(.22,.75,.25,1)' });
  }
  document.querySelectorAll<HTMLElement>('[data-account-view]').forEach(tab=>tab.addEventListener('click',event=>{event.preventDefault();const view=tab.dataset.accountView;const current=document.querySelector<HTMLElement>('[data-account-panel]:not([hidden])');const next=document.querySelector<HTMLElement>(`[data-account-panel="${view}"]`);document.querySelectorAll<HTMLElement>('[data-account-view]').forEach(item=>item.setAttribute('aria-selected',String(item.dataset.accountView===view)));void swapPanel(current,next);history.replaceState(null,'',view==='addresses'?'#saved-addresses':view==='profile'?'#profile-details':'#order-history');}));
  if(location.hash==='#saved-addresses')document.querySelector<HTMLElement>('[data-account-view="addresses"]')?.click();else if(location.hash==='#profile-details')document.querySelector<HTMLElement>('[data-account-view="profile"]')?.click();
  document.querySelectorAll<HTMLButtonElement>('[data-address-toggle]').forEach(button=>button.addEventListener('click',async()=>{const form=button.parentElement?.querySelector<HTMLFormElement>('form');if(!form)return;const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));if(open){if(!reducedMotion)await form.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(-8px)'}],{duration:150,easing:'ease-out'}).finished.catch(()=>undefined);form.hidden=true;}else{form.hidden=false;if(!reducedMotion)form.animate([{opacity:0,transform:'translateY(-8px)'},{opacity:1,transform:'translateY(0)'}],{duration:220,easing:'cubic-bezier(.22,.75,.25,1)'});form.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();}}));
  const auth=document.querySelector<HTMLElement>('[data-account-auth]');auth?.querySelectorAll<HTMLAnchorElement>('[data-account-mode]').forEach(tab=>tab.addEventListener('click',event=>{event.preventDefault();const mode=tab.dataset.accountMode||'login';const current=auth.querySelector<HTMLElement>('[data-auth-panel]:not([hidden])');const next=auth.querySelector<HTMLElement>(`[data-auth-panel="${mode}"]`);auth.querySelectorAll<HTMLElement>('[data-account-mode]').forEach(item=>item.setAttribute('aria-selected',String(item.dataset.accountMode===mode)));void swapPanel(current,next);history.replaceState(null,'',mode==='register'?'/account?mode=register':'/account');}));
</script>
<style>
  .nexa-account .nexa-secondary__hero h1{max-width:12ch;font-size:clamp(3rem,7vw,7rem)}.nexa-account .nexa-secondary__hero p{max-width:42rem}.nexa-account .nexa-secondary__split{align-items:stretch}.nexa-account .nexa-info-panel,.nexa-account .nexa-form-panel,.nexa-account .nexa-data-panel{background:var(--nexa-bg);box-shadow:0 18px 50px rgb(from var(--nexa-ink) r g b / 0.07)}
  .nexa-account__toolbar{display:flex;justify-content:space-between;gap:1rem;border:1px solid rgb(from var(--nexa-ink) r g b / 0.25);border-radius:4px;padding:.65rem}.nexa-account__toolbar nav{display:flex;flex-wrap:wrap;gap:.5rem}.nexa-account__toolbar a,.nexa-account__toolbar button{min-height:44px;display:inline-flex;align-items:center;border:0;background:transparent;padding:0 .75rem;font:400 .7rem/1.2 "DM Mono",monospace;text-transform:uppercase;transition:background-color var(--nexa-motion-fast) var(--nexa-ease-out),color var(--nexa-motion-fast) var(--nexa-ease-out),transform var(--nexa-motion-fast) var(--nexa-ease-out)}.nexa-account__toolbar a:hover,.nexa-account__toolbar button:hover{background:rgb(from var(--nexa-ink) r g b / 0.07)}.nexa-account__toolbar [aria-selected=true]{background:var(--nexa-ink);color:var(--nexa-bg)}
  .nexa-account__orders{list-style:none;padding:0;margin:0}.nexa-account__orders li+li{border-top:1px solid rgb(from var(--nexa-ink) r g b / 0.15)}.nexa-account__orders a{display:grid;grid-template-columns:2rem 1fr 1fr auto;gap:1rem;align-items:center;min-height:88px;padding:1rem;transition:background-color var(--nexa-motion-fast) var(--nexa-ease-out),transform var(--nexa-motion-fast) var(--nexa-ease-out)}.nexa-account__orders a:hover{background:rgb(from var(--nexa-primary) r g b / 0.06);transform:translateX(2px)}.nexa-account__orders div{display:grid;gap:.25rem}.nexa-account__orders strong{font:500 .9rem/1.2 "Space Grotesk",sans-serif}.nexa-account__orders span,.nexa-account__orders small{font:400 .68rem/1.3 "DM Mono",monospace}.nexa-pagination{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border-top:1px solid rgb(from var(--nexa-ink) r g b / 0.15);font:400 .7rem/1.2 "DM Mono",monospace}
  .nexa-account__addresses article+article{border-top:1px solid rgb(from var(--nexa-ink) r g b / 0.15)}.nexa-account__addresses>article>button{width:100%;display:grid;grid-template-columns:2rem 1fr auto;gap:1rem;text-align:left;align-items:center;min-height:80px;border:0;background:transparent;padding:1rem;transition:background-color var(--nexa-motion-fast) var(--nexa-ease-out),color var(--nexa-motion-fast) var(--nexa-ease-out)}.nexa-account__addresses>article>button:hover{background:rgb(from var(--nexa-primary) r g b / 0.06)}.nexa-account__addresses button div{display:grid;gap:.25rem}.nexa-account__addresses button strong{font:500 .9rem/1.2 "Space Grotesk",sans-serif}.nexa-account__addresses button span,.nexa-account__addresses button small,.nexa-account__addresses button b{font:400 .68rem/1.3 "DM Mono",monospace}.nexa-account-form .is-danger{background:#7c1717}
  .nexa-account-form label:has(input[type=checkbox]){grid-column:auto;align-self:center}.nexa-account-form label:has(input[type=checkbox])>span{display:inline-flex;align-items:center;gap:.65rem;width:fit-content;min-height:44px}.nexa-account-form input[type=checkbox]{width:18px;height:18px;min-height:0;margin:0;accent-color:var(--nexa-primary);outline-offset:3px}
  .nexa-form-panel .nexa-panel-head nav{font:400 .68rem/1.2 "DM Mono",monospace}.nexa-form-panel .nexa-panel-head [aria-selected=true]{font-weight:700;text-decoration:underline}
  @media(max-width:650px){.nexa-account__toolbar{align-items:stretch;flex-direction:column}.nexa-account__orders a{grid-template-columns:1.5rem 1fr auto}.nexa-account__orders a>div:nth-of-type(2){grid-column:2/-1}}
</style>
