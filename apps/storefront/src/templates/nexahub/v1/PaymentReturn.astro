---
import Button from "./Button.astro";
import Layout from "./Layout.astro";
import { parseNexahubData } from "./lib";
import "./styles/pages/commerce.scss";
interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  cartCount: number;
  error?: string | null;
  redirectLabel?: string;
}
const {
  data,
  themeTokens,
  tenantName,
  cartCount,
  error,
  redirectLabel = "Verifying payment…",
} = Astro.props;
const template = parseNexahubData(data);
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} cartCount={cartCount}>
  <main class="nexa-commerce" id="main-content"><div class="container nexa-commerce__frame"><nav class="nexa-breadcrumb" aria-label="Breadcrumb"><a href="/checkout">Checkout</a><span>/</span><span aria-current="page">Payment status</span></nav><header class="nexa-commerce__heading"><span class="nexa-kicker">Secure checkout</span><div><h1>{error ? "Payment needs attention" : "Confirming payment"}</h1><p>{error ? "Your cart is safe and ready when you are." : redirectLabel}</p></div></header>{error ? <section class="nexa-empty" role="alert"><span class="nexa-empty__index">!</span><h2>We could not confirm your payment</h2><p>{error}</p><div class="nexa-receipt__actions"><Button text="Back to checkout" href="/checkout" /><Button text="Return to cart" href="/cart" variant="dark" /></div></section> : <div class="nexa-notice nexa-notice--processing" role="status" aria-live="polite"><span class="nexa-status-spinner" aria-hidden="true"></span><div><strong>{redirectLabel}</strong><p>Please keep this page open for a moment.</p></div></div>}</div></main>
</Layout>
