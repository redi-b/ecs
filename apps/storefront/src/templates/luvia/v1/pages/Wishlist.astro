---
import "../styles/pages/wishlist.scss";
import { Icon } from "astro-icon/components";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
}
const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseLuviaData(data);
const locale =
  Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const wishlistMessages = {
  emptyTitle: m.wishlist_empty_title({}, { locale }),
  emptyHelp: m.wishlist_empty_help({}, { locale }),
  browse: m.action_browse_products({}, { locale }),
  savedProduct: m.wishlist_saved_product({}, { locale }),
  productFallback: m.catalog_product_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
  view: m.action_view_product({}, { locale }),
  failure: m.status_generic_error({}, { locale }),
  retry: m.action_retry({}, { locale }),
  singular: m.wishlist_item_singular({}, { locale }),
  plural: m.wishlist_item_plural({}, { locale }),
};
---

<Layout
  tenantName={tenantName}
  header={template.header}
  footer={template.footer}
  themeTokens={themeTokens}
  deferCartCount={deferCartCount}
  title={m.wishlist_title({}, { locale })}
>
  <main
    id="main-content"
    class="wishlist container"
    data-wishlist-page
    data-wishlist-messages={JSON.stringify(wishlistMessages)}
  >
    <header class="wishlist__header" data-wishlist-header>
      <div class="wishlist__meta">
        <span class="wishlist__tag type-body-xs-500">
          <Icon name="wishlist" />
          <span>{m.wishlist_saved_items({}, { locale })}</span>
        </span>
        <span class="wishlist__count-pill type-body-xs-500" data-wishlist-count-badge hidden></span>
      </div>
      <h1 class="wishlist__title type-heading-1">
        {m.wishlist_title({}, { locale })}
      </h1>
    </header>

    <section data-wishlist-content class="wishlist__content" aria-live="polite" aria-busy="true">
      <div class="wishlist__loading">
        <span aria-hidden="true"></span>
        <strong class="type-body-l-500">{m.wishlist_loading({}, { locale })}</strong>
      </div>
    </section>
  </main>
</Layout>


<template data-wishlist-empty-template>
  <div class="wishlist__empty empty-state">
    <span class="empty-state__mark" aria-hidden="true"><Icon name="heart" /></span>
    <div class="empty-state__copy">
      <h2 class="empty-state__title type-heading-3">{m.wishlist_empty_title({}, { locale })}</h2>
      <p class="empty-state__text type-body-400">{m.wishlist_empty_help({}, { locale })}</p>
    </div>
    <a class="empty-state__action type-body-500" href="/products">{m.action_browse_products({}, { locale })}</a>
  </div>
</template>
<script>
  import { WISHLIST_REQUEST_EVENT, WISHLIST_UPDATED_EVENT, type WishlistEntry } from "../../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../../lib/browser/localized-path";
  const root = document.querySelector<HTMLElement>("[data-wishlist-page]");
  const content = root?.querySelector<HTMLElement>("[data-wishlist-content]");
  if (root && content) {
    const messages = JSON.parse(root.dataset.wishlistMessages || "{}") as Record<string, string>;
    const header = root.querySelector<HTMLElement>("[data-wishlist-header]");
    const badge = root.querySelector<HTMLElement>("[data-wishlist-count-badge]");
    let signature: string | null = null;
    let controller: AbortController | undefined;
    let saved: WishlistEntry[] = [];
    let restoreFocus = false;
    root.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-wishlist-toggle]")) restoreFocus = true;
    }, true);
    const render = async (items: WishlistEntry[], force = false) => {
      const paths = items.map((item) => item.path);
      const next = JSON.stringify(paths);
      if (!force && signature === next) return;
      signature = next;
      controller?.abort();
      const current = new AbortController();
      controller = current;
      content.setAttribute("aria-busy", "true");
      if (badge) {
        badge.textContent = `${items.length} ${items.length === 1 ? messages.singular : messages.plural}`;
        badge.hidden = !items.length;
      }
      header?.classList.toggle("is-empty", !items.length);
      try {
        const grid = document.createElement("div");
        grid.className = "wishlist__grid";
        for (let offset = 0; offset < paths.length; offset += 48) {
          const response = await fetch("/actions/wishlist/cards", {
            method: "POST", credentials: "same-origin", signal: current.signal,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ paths: paths.slice(offset, offset + 48) }),
          });
          if (!response.ok) throw new Error("wishlist unavailable");
          const fragment = document.createElement("template");
          fragment.innerHTML = await response.text();
          grid.append(fragment.content);
        }
        if (current.signal.aborted) return;
        const empty = document.querySelector<HTMLTemplateElement>("[data-wishlist-empty-template]");
        content.replaceChildren(...(grid.children.length ? [grid] : empty ? [empty.content.cloneNode(true)] : []));
        content.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((link) => {
          link.href = localizeBrowserPath(link.getAttribute("href") || "/products");
        });
        window.dispatchEvent(new CustomEvent(WISHLIST_UPDATED_EVENT, { detail: { items, origin: "controller" } }));
        if (restoreFocus) {
          restoreFocus = false;
          content.querySelector<HTMLElement>("[data-wishlist-toggle], .empty-state__action")?.focus();
        }
      } catch {
        if (current.signal.aborted) return;
        const error = document.createElement("div");
        error.className = "empty-state";
        error.setAttribute("role", "alert");
        const text = document.createElement("p");
        text.textContent = messages.failure;
        const retry = document.createElement("button");
        retry.type = "button";
        retry.className = "button button--secondary button--small";
        retry.textContent = messages.retry;
        retry.addEventListener("click", () => void render(saved, true));
        error.append(text, retry);
        content.querySelector('[role="alert"]')?.remove();
        if (!content.querySelector(".wishlist__grid")) content.replaceChildren();
        content.append(error);
      } finally {
        if (!current.signal.aborted) content.setAttribute("aria-busy", "false");
      }
    };
    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const items = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail?.items;
      if (!Array.isArray(items)) return;
      saved = items;
      void render(items);
    });
    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  }
</script>
