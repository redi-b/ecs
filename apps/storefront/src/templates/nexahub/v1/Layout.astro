---
import Icon from "./Icon.astro";
import { contrastingInk, type NexahubV1Data } from "@ecs/storefront-templates";
import SeoHead from "../../../components/shell/SeoHead.astro";
import StorefrontAnalytics from "../../../components/shell/StorefrontAnalytics.astro";
import StorefrontFonts from "../../../components/shell/StorefrontFonts.astro";
import StorefrontLanguageSwitcher from "../../../components/shell/StorefrontLanguageSwitcher.astro";
import StructuredData from "../../../components/shell/StructuredData.astro";
import { listStoreCollections } from "../../../lib/commerce/catalog";
import { collectionProductsHref } from "../../../lib/commerce/taxonomy-links";
import type { StoreCollection } from "../../../lib/commerce/types";
import { getPlatformApiBaseUrl, getRequestHost } from "../../../lib/env";
import type { StorefrontSeo } from "../../../lib/seo";
import { STOREFRONT_LOCALE_HEADER } from "../../../lib/storefront-locale";
import * as m from "../../../paraglide/messages.js";
import logo from "./assets/nexahub-logo.svg";
import Button from "./Button.astro";
import { parseNexahubThemeTokens } from "./lib";
import SaveIcon from "./SaveIcon.astro";
import "./styles/main.scss";
import "./styles/components/_header.scss";
import "./styles/components/_footer.scss";
import "./styles/components/_cart-drawer.scss";
import "./styles/responsive.scss";

interface Props {
  tenantName: string;
  header: NexahubV1Data["header"];
  footer: NexahubV1Data["footer"];
  cartCount?: number;
  deferCartCount?: boolean;
  demoMode?: boolean;
  editorMode?: boolean;
  themeTokens?: unknown;
  seo?: StorefrontSeo;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
  navigationCollections?: StoreCollection[];
  renderPath?: string;
}
const {
  tenantName,
  header,
  footer,
  cartCount = 0,
  deferCartCount = false,
  demoMode = false,
  editorMode = false,
  themeTokens,
  seo,
  structuredData,
  navigationCollections: suppliedNavigationCollections,
  renderPath,
} = Astro.props;
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const collectionsResult =
  suppliedNavigationCollections === undefined && !demoMode
    ? await listStoreCollections({
        platformApiBaseUrl: getPlatformApiBaseUrl(),
        requestHost: getRequestHost(Astro.request),
        locale: locale === "am" ? "am-ET" : "en-ET",
        limit: 8,
      })
    : null;
const navigationCollections =
  suppliedNavigationCollections ??
  (collectionsResult && "collections" in collectionsResult ? collectionsResult.collections : []);
const theme = parseNexahubThemeTokens(themeTokens);
const emptyLogoUrl = header.useShopName ? null : logo.src;
const logoUrl = header.logoAssetId ?? emptyLogoUrl;
const themeStyle = [
  `--nexa-bg:${theme.colors.background}`,
  `--nexa-ink:${theme.colors.foreground}`,
  `--nexa-primary:${theme.colors.primary}`,
  `--nexa-muted:${theme.colors.muted}`,
  `--nexa-accent:${theme.colors.accent}`,
  `--nexa-on-primary:${contrastingInk(theme.colors.primary)}`,
].join(";");
// The signed editor is served from `/preview`, but it must retain the visual
// route state of the page it renders. Never let the transport route choose a
// different header treatment or active navigation item.
const pathname = renderPath ?? Astro.url.pathname;
const active = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
const productNav = header.navigation.find((item) => item.href === "/products");
const primaryNav = header.navigation.filter((item) => item.href !== "/products");
const productLinks = [
  { label: m.nav_all_products({}, { locale }), href: "/products" },
  ...navigationCollections
    .filter((item) => item.handle?.trim())
    .slice(0, 8)
    .map((item) => ({
      label: item.title ?? m.catalog_products({}, { locale }),
      href: collectionProductsHref(item),
    })),
];
const socialIconNames = ["facebook", "instagram", "tiktok", "linkedin"] as const;
const nexahubClientMessages = {
  addFailed: m.product_add_failed({}, { locale }),
  added: m.product_added_to_cart({}, { locale }),
  adding: m.product_adding({}, { locale }),
  cartEmpty: m.cart_empty({}, { locale }),
  cartEmptyHelp: m.cart_empty_help({}, { locale }),
  cartLoadFailed: m.cart_load_failed({}, { locale }),
  cartLoading: m.cart_loading({}, { locale }),
  cartUpdated: m.cart_updated({}, { locale }),
  checkoutOpeningPayment: m.checkout_opening_payment({}, { locale }),
  checkoutPlacingOrder: m.checkout_placing_order({}, { locale }),
  closeNavigation: m.a11y_close_navigation({}, { locale }),
  contactFailed: m.contact_failed({}, { locale }),
  contactReceived: m.contact_received({}, { locale }),
  contactSending: m.contact_sending({}, { locale }),
  continueShopping: m.action_continue_shopping({}, { locale }),
  itemCount: m.cart_item_count({ count: "__COUNT__" }, { locale }),
  openNavigation: m.a11y_open_navigation({}, { locale }),
  product: m.catalog_product_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
  requestFailed: m.request_failed({}, { locale }),
  requestReceived: m.request_received({}, { locale }),
  requestSending: m.request_sending({}, { locale }),
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo?.title ?? `${tenantName} | Technology Store`}</title>
    <SeoHead seo={seo} />
    <StorefrontFonts />
    <link rel="preload" href="/fonts/nexahub/Space-Grotesk-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nexahub/DM-Mono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="nexa-body" style={themeStyle} data-editor-mode={editorMode ? "true" : undefined} data-demo-mode={demoMode ? "true" : undefined} data-editor-theme-vars={editorMode ? JSON.stringify({ primary: "--nexa-primary", background: "--nexa-bg", foreground: "--nexa-ink", muted: "--nexa-muted", accent: "--nexa-accent", onPrimary: "--nexa-on-primary" }) : undefined}>
    <StructuredData value={structuredData} />
    <a class="nexa-skip" href="#main-content">{m.a11y_skip_to_content({}, { locale })}</a>
    <div class="nexa-sr-only" role="status" aria-live="polite" aria-atomic="true" data-nexa-live></div>
    <div class="nexa-toast" role="status" aria-live="polite" aria-atomic="true" data-nexa-toast hidden></div>
    <header class:list={["site-header", pathname === "/" ? "site-header--default" : "site-header--light"]}>
      <div class="site-header__inner">
        <div class="site-header__left">
          <a href="/" class="site-header__brand" aria-label={m.a11y_shop_home({ shop: tenantName }, { locale })} data-editor-image-scope><img src={logoUrl ?? undefined} alt={tenantName} data-editor-image-path="header.logoAssetId" data-editor-empty-src={emptyLogoUrl ?? undefined} hidden={!logoUrl} /><span class="nexa-wordmark" data-editor-image-fallback hidden={Boolean(logoUrl)}>{tenantName}</span></a>
          <nav class="site-header__nav" id="nexa-navigation" aria-label={m.a11y_primary_navigation({}, { locale })} data-editor-links-path="header.navigation">
            {primaryNav.slice(0, 1).map((item) => <a class="site-header__link type-body-s-400" href={item.href} aria-current={active(item.href) ? "page" : undefined} data-editor-link-target={header.navigation.indexOf(item)}><span data-editor-link-label>{item.label}</span></a>)}
            {productNav && <div class="site-header__nav-item site-header__nav-item--dropdown"><button type="button" class="site-header__link site-header__link--dropdown type-body-s-400" aria-expanded="false" aria-controls="nexa-products-menu" data-header-dropdown-btn data-editor-link-target={header.navigation.indexOf(productNav)}><span data-editor-link-label>{productNav.label}</span><Icon name="chevron-down" /></button><div class="site-header__dropdown" id="nexa-products-menu" data-header-dropdown-menu>{productLinks.map((item) => <a href={item.href} class="site-header__dropdown-item type-body-s-400">{item.label}</a>)}</div></div>}
            {primaryNav.slice(1).map((item) => <a class="site-header__link type-body-s-400" href={item.href} aria-current={active(item.href) ? "page" : undefined} data-editor-link-target={header.navigation.indexOf(item)}><span data-editor-link-label>{item.label}</span></a>)}
          </nav>
        </div>
        <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="nexa-navigation" aria-label={m.a11y_open_navigation({}, { locale })}><span></span><span></span></button>
        <div class="site-header__right">
          <StorefrontLanguageSwitcher hidden={demoMode || editorMode} />
          <form class="site-header__search" action="/products" method="get" role="search" data-product-search-suggestions data-search-suggestions-anchor data-search-view-all={m.search_view_all({ query: "{query}" }, { locale })} data-search-for={m.search_for({ query: "{query}" }, { locale })}><Icon name="search" /><label class="nexa-sr-only" for="nexa-search">{m.search_products_label({}, { locale })}</label><input id="nexa-search" name="q" type="search" placeholder={m.search_products_placeholder({}, { locale })} class="site-header__search-input type-body-s-400" /></form>
          <a class="site-header__icon" href="/wishlist" aria-label={m.nav_wishlist({}, { locale })} data-wishlist-indicator><SaveIcon /></a>
          <button class="site-header__icon" type="button" aria-label={`${m.nav_cart({}, { locale })}: ${m.cart_item_count({ count: cartCount }, { locale })}`} data-cart-open><Icon name="shopping-cart" /><span data-cart-count aria-live="polite" hidden={deferCartCount || cartCount === 0}>{cartCount}</span></button>
          <a class="site-header__icon" href="/account" aria-label={m.nav_account({}, { locale })}><Icon name="profile" /></a>
          <Button text={m.action_shop_now({}, { locale })} href="/products" size="small" variant="secondary" />
        </div>
      </div>
    </header>
    <button class="site-header__backdrop" type="button" aria-label={m.a11y_close_navigation({}, { locale })} tabindex="-1" data-header-backdrop></button>
    {demoMode && <aside class="nexa-demo" role="status"><strong>Template preview</strong><nav aria-label="Preview pages"><a href="/demo/storefront/nexahub">Home</a><a href="/demo/storefront/nexahub/products">Products</a><a href="/demo/storefront/nexahub/products/portable-workstation">Product</a><a href="/demo/storefront/nexahub/cart">Cart</a><a href="/demo/storefront/nexahub/checkout">Checkout</a><a href="/demo/storefront/nexahub/order-confirmation">Receipt</a></nav><span>Shopping actions are disabled</span></aside>}
    <slot />
    <footer class="site-footer"><div class="site-footer__layers"><div class="site-footer__layer site-footer__layer--1"></div><div class="site-footer__layer site-footer__layer--2"></div></div><div class="site-footer__inner">
<div class="site-footer__col site-footer__col--about"><a href="/" class="site-footer__logo" aria-label={m.a11y_shop_home({ shop: tenantName }, { locale })} data-editor-image-scope><img src={logoUrl ?? undefined} alt={tenantName} data-editor-image-path="header.logoAssetId" data-editor-empty-src={emptyLogoUrl ?? undefined} hidden={!logoUrl} /><span class="nexa-wordmark" data-editor-image-fallback hidden={Boolean(logoUrl)}>{tenantName}</span></a><p class="site-footer__text type-body-s-400" data-editor-path={!footer.managedContact ? "footer.blurb" : undefined} contenteditable={editorMode && !footer.managedContact ? "plaintext-only" : undefined}>{footer.blurb}</p><small class="site-footer__copyright type-body-xs-400">© {new Date().getFullYear()} {tenantName}. {m.footer_rights_reserved({}, { locale })}</small>{(editorMode || footer.credit.enabled) && <small class="nexa-credit" data-editor-section="footer.credit" data-editor-visible-path="footer.credit.enabled" hidden={!footer.credit.enabled}>{m.footer_design_by_ecs({}, { locale })}</small>}</div>
      <div class="site-footer__col site-footer__col--boxed"><h3 class="site-footer__heading type-body-s-500">{m.footer_quick_links({}, { locale })}</h3><ul class="site-footer__nav" data-editor-links-path="footer.quickLinks">{footer.quickLinks.map((item, index) => <li><a href={item.href} class="type-body-s-400" data-editor-path={`footer.quickLinks.${index}.label`} contenteditable={editorMode ? "plaintext-only" : undefined}>{item.label}</a></li>)}</ul></div>
      <div class="site-footer__col site-footer__col--boxed"><h3 class="site-footer__heading type-body-s-500">{m.footer_products({}, { locale })}</h3><ul class="site-footer__nav">{productLinks.map((item) => <li><a href={item.href} class="type-body-s-400">{item.label}</a></li>)}</ul></div>
      <div class="site-footer__col site-footer__col--contact"><h3 class="site-footer__heading type-body-s-500">{m.footer_contacts({}, { locale })}</h3><address class="site-footer__contact-info">
        {footer.address && <p data-editor-path={!footer.managedContact ? "footer.address" : undefined} contenteditable={editorMode && !footer.managedContact ? "plaintext-only" : undefined}>{footer.address}</p>}
        {footer.email && <p><a href={`mailto:${footer.email}`} data-editor-path={!footer.managedContact ? "footer.email" : undefined} contenteditable={editorMode && !footer.managedContact ? "plaintext-only" : undefined}>{footer.email}</a></p>}
        {[footer.phone, ...(footer.additionalPhones ?? [])].filter(Boolean).map((phone) => <p><a href={`tel:${phone}`} data-editor-path={!footer.managedContact ? "footer.phone" : undefined} contenteditable={editorMode && !footer.managedContact ? "plaintext-only" : undefined}>{phone}</a></p>)}
      </address><div class="site-footer__social" data-editor-links-path={!footer.managedContact ? "footer.socialLinks" : undefined}>{footer.socialLinks.map((item, index) => <a href={item.href} aria-label={item.label} target="_blank" rel="noopener noreferrer" data-editor-link-target={!footer.managedContact ? index : undefined}>
        {footer.managedContact ? <span class="type-body-s-400">{item.label}</span> : <Icon name={socialIconNames[index % socialIconNames.length]} />}
        {!footer.managedContact && <span class="nexa-sr-only" data-editor-link-label data-editor-path={`footer.socialLinks.${index}.label`} contenteditable={editorMode ? "plaintext-only" : undefined}>{item.label}</span>}
      </a>)}</div></div>
    </div></footer>
    <div class="cart-drawer-overlay" data-cart-overlay aria-hidden="true"><div class="cart-drawer-container" data-cart-modal role="dialog" aria-modal="true" aria-labelledby="nexa-cart-title"><button class="cart-drawer-close" type="button" aria-label={m.cart_close({}, { locale })} data-cart-close>×</button><aside class="cart-drawer"><div class="cart-drawer__header"><h2 id="nexa-cart-title" class="type-heading-4">{m.cart_title({}, { locale })}</h2><span class="cart-drawer__badge type-body-xs-500" data-cart-drawer-count>{m.cart_item_count({ count: 0 }, { locale })}</span></div><div class="cart-drawer__status" data-cart-status aria-live="polite"></div><div class="cart-drawer__items" data-cart-items></div><div class="cart-drawer__summary" data-cart-footer hidden><div class="cart-drawer__total-row"><span class="type-body-l">{m.cart_total({}, { locale })}</span><strong class="type-heading-6" data-cart-total></strong></div><a class="btn btn--primary btn--large btn--full-width" href="/checkout">{m.action_checkout({}, { locale })}</a><a class="cart-drawer__view" href="/cart">{m.cart_view({}, { locale })}</a></div></aside></div></div>
    <StorefrontAnalytics disabled={demoMode || editorMode} />
    <script is:inline define:vars={{ nexahubClientMessages }}>
      window.__ECS_NEXAHUB_MESSAGES__ = nexahubClientMessages;
    </script>
    <script is:inline>
      if (document.body.dataset.demoMode === 'true') {
        const prefix = '/demo/storefront/nexahub';
        document.addEventListener('submit', (event) => { event.preventDefault(); });
        document.addEventListener('click', (event) => { const link = event.target instanceof Element ? event.target.closest('a[href]') : null; if (!(link instanceof HTMLAnchorElement)) return; const path = link.getAttribute('href') || ''; if (path === '/') link.href = prefix; else if (path === '/products' || path.startsWith('/products/')) link.href = `${prefix}${path}`; else if (['/cart','/checkout'].includes(path)) link.href = `${prefix}${path}`; else if (path.startsWith('/account') || path === '/wishlist' || path === '/contact' || path === '/request-item') event.preventDefault(); });
      }
    </script>
    <script>
      import { gsap } from "gsap";
      import { initProductSearchSuggestions } from "../../../lib/browser/product-search-suggestions";
      import { initNexahubStorefront } from "./client";
      initNexahubStorefront();
      if (document.body.dataset.demoMode !== "true" && document.body.dataset.editorMode !== "true") {
        initProductSearchSuggestions(document.querySelector<HTMLFormElement>(".site-header__search"));
      }
      const body = document.body;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduceMotion && body.dataset.editorMode !== "true" && body.dataset.demoMode !== "true") {
        const targets = Array.from(document.querySelectorAll("main > section, main > .container > *, main.container > *")).slice(0, 18);
        gsap.from(targets, { autoAlpha: 0, y: 18, duration: 0.55, stagger: 0.045, ease: "power2.out", clearProps: "opacity,visibility,transform" });
      }
    </script>
  </body>
</html>
<style>
  .site-header__brand:has(.nexa-wordmark) { width: auto; min-width: 94px; max-width: 220px; }
  .nexa-wordmark { display: block; max-width: 18rem; color: var(--nexa-on-primary); font-family: "Space Grotesk", "Noto Sans Ethiopic", sans-serif; font-size: clamp(.95rem, 1.6vw, 1.25rem); font-weight: 700; line-height: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; letter-spacing: -0.04em; }
  .site-footer__logo .nexa-wordmark { color: inherit; font-size: clamp(1.3rem, 2vw, 2rem); white-space: normal; }
</style>
