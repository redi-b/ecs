---
import "../styles/pages/wishlist.scss";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { parseLuviaData } from "../lib";
import { STOREFRONT_LOCALE_HEADER } from "../../../../lib/storefront-locale";
import * as m from "../../../../paraglide/messages.js";
interface Props { data: unknown; themeTokens?: unknown; tenantName: string; deferCartCount?: boolean; }
const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseLuviaData(data);
const locale = Astro.request.headers.get(STOREFRONT_LOCALE_HEADER) === "am" ? "am" : "en";
const wishlistMessages = {
  emptyTitle: m.wishlist_empty_title({}, { locale }),
  emptyHelp: m.wishlist_empty_help({}, { locale }),
  browse: m.action_browse_products({}, { locale }),
  savedProduct: m.wishlist_saved_product({}, { locale }),
  productFallback: m.catalog_product_fallback({}, { locale }),
  remove: m.action_remove({}, { locale }),
};
---
<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount} title={m.wishlist_title({}, { locale })}>
  <main class="wishlist container" data-wishlist-page data-wishlist-messages={JSON.stringify(wishlistMessages)}><header><span><Icon name="wishlist" /></span><p class="type-body-xs">{m.wishlist_saved_items({}, { locale })}</p><h1 class="type-heading-1">{m.wishlist_title({}, { locale })}</h1><small class="type-body-400" data-wishlist-account-copy>{m.wishlist_intro({}, { locale })}</small></header><section data-wishlist-content aria-live="polite" aria-busy="true"><div class="wishlist__loading"><span aria-hidden="true"></span><strong class="type-body-l-500">{m.wishlist_loading({}, { locale })}</strong></div></section></main>
</Layout>
<script>
  import { WISHLIST_REQUEST_EVENT, WISHLIST_UPDATED_EVENT, type WishlistEntry } from "../../../../lib/browser/wishlist";
  import { localizeBrowserPath } from "../../../../lib/browser/localized-path";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-wishlist-page]"); const content = root?.querySelector("[data-wishlist-content]"); if (!content) return;
    const messages = JSON.parse(root?.dataset.wishlistMessages || "{}") as Record<string, string>;
    let items: WishlistEntry[] = [];
    const money = (amount: number | null, currency: string | null) => { if (typeof amount !== "number") return ""; try { return new Intl.NumberFormat(document.documentElement.lang === "am" ? "am-ET" : "en-ET",{ style:"currency", currency:(currency || "ETB").toUpperCase() }).format(amount); } catch { return String(amount); } };
    const render = () => {
      content.replaceChildren();
      if (!items.length) { const empty = document.createElement("div"); empty.className = "wishlist__empty empty-state"; const mark = document.createElement("span"); mark.className = "empty-state__mark"; mark.innerHTML = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7 3.5C19 15.6 12 20 12 20z"/></svg>'; const body = document.createElement("div"); body.className = "empty-state__copy"; const title = document.createElement("h2"); title.className = "empty-state__title type-heading-3"; title.textContent = messages.emptyTitle || ""; const copy = document.createElement("p"); copy.className = "empty-state__text type-body-400"; copy.textContent = messages.emptyHelp || ""; body.append(title, copy); const link = document.createElement("a"); link.className = "empty-state__action type-body-500"; link.href = localizeBrowserPath("/products"); link.textContent = messages.browse || ""; empty.append(mark, body, link); content.append(empty); return; }
      const grid = document.createElement("div"); grid.className = "wishlist__grid";
      for (const item of items) { const card = document.createElement("article"); const itemPath = localizeBrowserPath(item.path); if (item.thumbnail) { const media = document.createElement("a"); media.className = "wishlist__media"; media.href = itemPath; const image = document.createElement("img"); image.src = item.thumbnail; image.alt = item.title; image.width = 900; image.height = 900; image.loading = "lazy"; image.decoding = "async"; media.append(image); card.append(media); } const meta = document.createElement("span"); meta.className = "type-body-xs"; meta.textContent = messages.savedProduct || ""; const link = document.createElement("a"); link.className = "type-heading-4"; link.href = itemPath; link.textContent = item.title || messages.productFallback || ""; const price = document.createElement("strong"); price.className = "type-body-l-500"; price.textContent = money(item.priceAmount,item.currencyCode); const remove = document.createElement("button"); remove.className = "type-body-xs"; remove.type = "button"; remove.textContent = messages.remove || ""; remove.addEventListener("click", () => { window.dispatchEvent(new CustomEvent(WISHLIST_UPDATED_EVENT,{ detail:{ items:items.filter((saved) => saved.path !== item.path), origin:"page" } })); }); card.append(meta,link); if (price.textContent) card.append(price); card.append(remove); grid.append(card); }
      content.append(grid);
    };
    window.addEventListener(WISHLIST_UPDATED_EVENT, (event) => {
      const next = (event as CustomEvent<{ items?: WishlistEntry[] }>).detail?.items;
      if (!Array.isArray(next)) return;
      items = next;
      content.setAttribute("aria-busy", "false");
      render();
    });
    window.dispatchEvent(new CustomEvent(WISHLIST_REQUEST_EVENT));
  })();
</script>
