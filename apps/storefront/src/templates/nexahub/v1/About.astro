---
import Layout from "./Layout.astro";
import { parseNexahubData } from "./lib";
import "./styles/pages/about.scss";

interface Props {
  data: unknown;
  themeTokens?: unknown;
  tenantName: string;
  deferCartCount?: boolean;
}

const { data, themeTokens, tenantName, deferCartCount = false } = Astro.props;
const template = parseNexahubData(data);
---

<Layout tenantName={tenantName} header={template.header} footer={template.footer} themeTokens={themeTokens} deferCartCount={deferCartCount}>
  <main class="about-page" id="main-content">
    <section class="about-section container">
      <header class="about-section__hero">
        <p class="about-section__eyebrow">Here to make tech simpler</p>
        <h1 class="about-section__title">Find the right technology for your day.</h1>
        <p class="about-section__copy">At {tenantName}, you can compare dependable products without the guesswork—and get friendly help whenever you need it.</p>
      </header>
      <div class="about-section__principles">
        <article><span>01</span><h2>Choices that make sense</h2><p>Explore a focused range of products chosen for work, creativity, entertainment, and everyday life.</p></article>
        <article><span>02</span><h2>No hidden surprises</h2><p>See the details that matter—from availability and pricing to delivery options—before you decide.</p></article>
        <article><span>03</span><h2>Help from real people</h2><p>Need advice before buying or support with an order? Our team is ready to help.</p></article>
      </div>
      <aside class="about-section__statement"><span>Ready when you are</span><p>Better choices, a simpler checkout, and support that stays with you.</p><a href="/products">Find your next product <b aria-hidden="true">↗</b></a></aside>
    </section>
  </main>
</Layout>
