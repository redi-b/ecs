---
import StorefrontFailure from "../components/shell/StorefrontFailure.astro";
import { loadPageContext } from "../lib/page-context";
import { storefrontState } from "../lib/storefront-state";
import { getStorefrontRenderer } from "../templates/registry";

Astro.response.status = 404;
const ctx = await loadPageContext(Astro.request);
const SystemState = ctx.ok ? getStorefrontRenderer(ctx.config.storefront.templateKey)?.SystemState : null;
const state = storefrontState({ status: 404 });
---
{ctx.ok && SystemState ? <SystemState data={ctx.config.storefront.data} themeTokens={ctx.config.storefront.themeTokens} tenantName={ctx.config.tenant.name} cartCount={ctx.cartCount} {...state} /> : <html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Page not found</title></head><body><StorefrontFailure {...state} /></body></html>}
