@use "../abstracts" as *;

.lv-confirmation {
  position: relative;
  min-height: 920px;
  padding: 150px 0 110px;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(330px, .8fr);
  gap: $space-250;
  align-items: start;
  overflow: hidden;
  color: var(--clr-ink);
}

.lv-confirmation__glow {
  position: absolute;
  z-index: 0;
  top: -260px;
  left: 8%;
  width: 760px;
  height: 760px;
  border-radius: 50%;
  background: radial-gradient(circle, alpha(var(--clr-primary), 0.24), alpha(var(--clr-accent), 0.1) 48%, transparent 72%);
  filter: blur(18px);
  pointer-events: none;
}

.lv-confirmation__card,
.lv-confirmation__steps {
  position: relative;
  z-index: 1;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: alpha(var(--clr-bg), 0.84);
  box-shadow: 0 30px 90px alpha(var(--clr-ink), 0.11);
  backdrop-filter: blur(20px);
}

.lv-confirmation__card {
  padding: $space-;
}

.lv-confirmation__mark {
  position: relative;
  width: 82px;
  height: 82px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--clr-primary);
  color: var(--clr-on-primary);
  box-shadow: 0 0 0 10px alpha(var(--clr-primary), 0.12), 0 18px 40px alpha(var(--clr-primary), 0.24);
}

.lv-confirmation__mark span {
  position: absolute;
  inset: 9px;
  border: 1px solid alpha(var(--clr-ink), 0.18);
  border-radius: inherit;
}

.lv-confirmation__mark svg {
  width: 42px;
  height: 42px;
  fill: none;
  stroke: var(--clr-ink);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.lv-confirmation__mark .sf-icon svg {
  position: absolute;
  right: -19px;
  top: -6px;
  width: 18px;
  height: 18px;
}

.lv-confirmation__eyebrow {
  margin: $space- 0 $space-650;
  color: color-mix(in srgb, var(--clr-ink) 64%, var(--clr-bg));
}

.lv-confirmation h1 {
  margin: 0;
  color: var(--clr-dark);
}

.lv-confirmation__intro {
  max-width: 610px;
  margin: $space-250 0 $space-100;
  color: color-mix(in srgb, var(--clr-ink) 62%, var(--clr-bg));
}

.lv-confirmation__receipt {
  padding: $space-900 $space-400;
  border: 1px solid var(--clr-line);
  border-radius: $radius-;
  background: color-mix(in srgb, var(--clr-soft) 48%, var(--clr-bg));
}

.lv-confirmation__receipt>div {
  min-height: 64px;
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr) auto;
  gap: $space-600;
  align-items: center;
  border-bottom: 1px solid var(--clr-line);
}

.lv-confirmation__receipt>div:last-child {
  border-bottom: 0;
}

.lv-confirmation__receipt span {
  color: color-mix(in srgb, var(--clr-ink) 54%, var(--clr-bg));
}

.lv-confirmation__receipt strong {
  overflow-wrap: anywhere;
}

.lv-confirmation__receipt button {
  min-height: 36px;
  padding: 0 $space-650;
  border: 1px solid var(--clr-line);
  border-radius: $radius-pill;
  background: var(--clr-surface);
  color: var(--clr-ink);
  cursor: pointer;
}

.lv-confirmation__notice {
  min-height: 20px;
  margin: $space-600 $space-950 0;
  color: color-mix(in srgb, var(--clr-ink) 54%, var(--clr-bg));
}

.lv-confirmation__actions {
  margin-top: $space-150;
  display: flex;
  flex-wrap: wrap;
  gap: $space-750;
}

.lv-confirmation__steps {
  min-height: 620px;
  padding: $space- $space-100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: var(--clr-dark);
  color: var(--clr-white);
}

.lv-confirmation__steps>p {
  margin: 0 auto auto 0;
  color: color-mix(in srgb, var(--clr-ink) 38%, var(--clr-bg));
}

.lv-confirmation__steps ol {
  margin: $space- 0 0;
  padding: 0;
  list-style: none;
}

.lv-confirmation__steps li {
  position: relative;
  min-height: 120px;
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: $space-600;
}

.lv-confirmation__steps li:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 21px;
  top: 46px;
  bottom: 8px;
  width: 1px;
  background: alpha(var(--clr-primary), 0.23);
}

.lv-confirmation__steps li>span {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid alpha(var(--clr-primary), 0.3);
  border-radius: 50%;
  color: var(--clr-primary);
}

.lv-confirmation__steps li div {
  display: flex;
  flex-direction: column;
  gap: $space-800;
}

.lv-confirmation__steps strong {
}

.lv-confirmation__steps small {
  max-width: 290px;
  color: color-mix(in srgb, var(--clr-on-dark) 68%, var(--clr-dark));
}

@media (max-width: 980px) {
  .lv-confirmation {
    padding-right: $space-500;
    padding-left: $space-500;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr);
  }

  .lv-confirmation__card {
    padding: $space-;
  }
}

@media (max-width: 760px) {
  .lv-confirmation {
    min-height: 0;
    padding: 104px $space-700 66px;
    display: flex;
    flex-direction: column;
  }

  .lv-confirmation__card {
    padding: $space-150 $space-500;
    border-radius: $radius-;
  }

  .lv-confirmation__mark {
    width: 68px;
    height: 68px;
  }

  .lv-confirmation h1 {
  }

  .lv-confirmation__intro {
    margin: $space-400 0 $space-300;
  }

  .lv-confirmation__receipt {
    padding-inline: $space-650;
  }

  .lv-confirmation__receipt>div {
    padding: $space-700 0;
    grid-template-columns: 1fr auto;
    gap: $space-900 $space-700;
  }

  .lv-confirmation__receipt strong {
    grid-column: 1;
    grid-row: 2;
  }

  .lv-confirmation__receipt button {
    grid-column: 2;
    grid-row: 1 / 3;
  }

  .lv-confirmation__actions {
    flex-direction: column;
  }

  .lv-confirmation__actions .lv-button {
    width: 100%;
  }

  .lv-confirmation__actions .lv-button__text {
    flex: 1;
  }

  .lv-confirmation__steps {
    min-height: 510px;
    padding: $space-150 $space-350;
    border-radius: $radius-;
  }

  .lv-confirmation__steps ol {
    margin-top: 56px;
  }
}
