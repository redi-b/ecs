---
import ProductMediaPlaceholder from "../../../../components/media/ProductMediaPlaceholder.astro";
import type { StoreCartItem } from "../../../../lib/commerce/types";
import { cleanVariantTitle } from "../../../../lib/commerce/normalize";
import { formatMoney } from "../../../../lib/money";
import * as m from "../../../../paraglide/messages.js";
import { Icon } from "astro-icon/components";

interface Props {
  item: StoreCartItem;
  currencyCode?: string | null;
  locale: "am" | "en";
}

const { item, currencyCode, locale } = Astro.props;
const productHref = item.productHandle
  ? `/products/${encodeURIComponent(item.productHandle)}`
  : "/products";
const variantLabel = cleanVariantTitle(item.variantTitle, item.title);
---

<article class="cart-line" data-cart-line={item.id}>
  <a class="cart-line__media" href={productHref}>
    {
      item.imageUrl || item.thumbnail ? (
        <img src={item.imageUrl || item.thumbnail} alt={item.title ?? ""} />
      ) : (
        <ProductMediaPlaceholder label={m.catalog_no_image({}, { locale })} />
      )
    }
  </a>
  <div class="cart-line__details">
    <div class="cart-line__header">
      <a class="type-body-l-500 cart-line__title" href={productHref}>
        {item.title ?? m.catalog_product_fallback({}, { locale })}
      </a>
      {variantLabel && <span class="cart-line__variant type-body-xs">{variantLabel}</span>}
    </div>
    <strong data-line-total class="cart-line__price type-body-l-500" aria-live="polite">
      {formatMoney(item.total ?? item.unitPrice, currencyCode, locale)}
    </strong>
  </div>
  <div class="cart-line__actions">
    <div
      class="cart-line__quantity type-body-s-500"
      role="group"
      aria-label={m.cart_quantity_for(
        { item: item.title ?? m.cart_item_fallback({}, { locale }) },
        { locale },
      )}
    >
      <form method="post" action="/actions/cart/update" data-cart-page-form data-qty="dec">
        <input type="hidden" name="lineItemId" value={item.id} />
        <input type="hidden" name="quantity" value={Math.max(1, item.quantity - 1)} />
        <button
          type="submit"
          aria-label={m.action_decrease_quantity({}, { locale })}
          disabled={item.quantity <= 1}
        >
          −
        </button>
      </form>
      <span data-line-quantity class="type-body-s-500" aria-live="polite">{item.quantity}</span>
      <form method="post" action="/actions/cart/update" data-cart-page-form data-qty="inc">
        <input type="hidden" name="lineItemId" value={item.id} />
        <input type="hidden" name="quantity" value={item.quantity + 1} />
        <button type="submit" aria-label={m.action_increase_quantity({}, { locale })}>
          +
        </button>
      </form>
    </div>
    <form method="post" action="/actions/cart/remove" class="cart-line__remove" data-cart-page-form>
      <input type="hidden" name="lineItemId" value={item.id} />
      <button class="cart-line__remove-btn" type="submit" aria-label={m.action_remove({}, { locale })} title={m.action_remove({}, { locale })}>
        <Icon name="trash" />
      </button>
    </form>
  </div>
</article>
