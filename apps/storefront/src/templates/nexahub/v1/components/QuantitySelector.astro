---
import "../styles/components/_quantity-selector.scss";

interface Props {
  value?: number;
  size?: "large" | "small";
  min?: number;
  class?: string;
  decreaseLabel?: string;
  increaseLabel?: string;
}

const {
  value = 1,
  size = "small",
  min = 1,
  class: className,
  decreaseLabel = "Decrease quantity",
  increaseLabel = "Increase quantity",
} = Astro.props;
const typeClass = size === "large" ? "type-body-l" : "type-body";
---

<div class:list={["quantity-selector", `quantity-selector--${size}`, className]} data-min={min}>
  <button
    type="button"
    class="quantity-selector__control"
    data-qty-minus
    data-quantity-decrement
    aria-label={decreaseLabel}
  >
    <svg width={size === "large" ? 14 : 10} height={2} viewBox="0 0 14 2" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M0 1H14" stroke="currentColor" stroke-width="2" />
    </svg>
  </button>
  <output class:list={["quantity-selector__value", typeClass]} data-qty-output aria-live="polite">
    {String(value).padStart(2, "0")}
  </output>
  <button
    type="button"
    class="quantity-selector__control"
    data-qty-plus
    data-quantity-increment
    aria-label={increaseLabel}
  >
    <svg width={size === "large" ? 14 : 10} height={size === "large" ? 14 : 10} viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M7 0V14M0 7H14" stroke="currentColor" stroke-width="2" />
    </svg>
  </button>
</div>
