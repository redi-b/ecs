{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

# Hashed Next.js build assets — safe to cache for a year.
# Do not apply this to dashboard HTML or API routes (cookie-auth; no-store).
(next_static_cache) {
	header Cache-Control "public, max-age=31536000, immutable"
}

:80 {
	encode zstd gzip
	log {
		output stdout
		format console
	}
	log_skip /healthz

	respond /healthz 200

	@platform host api.{$BASE_DOMAIN}
	handle @platform {
		reverse_proxy ecs-platform-api:3000
	}

	@legacy_dashboard host dashboard.{$BASE_DOMAIN}
	redir @legacy_dashboard https://app.{$BASE_DOMAIN}{uri} permanent

	@dashboard host app.{$BASE_DOMAIN}
	handle @dashboard {
		@next_static path /_next/static/*
		handle @next_static {
			import next_static_cache
			reverse_proxy ecs-dashboard:3001
		}

		handle {
			reverse_proxy ecs-dashboard:3001
		}
	}

	@superadmin host ops.{$BASE_DOMAIN}
	handle @superadmin {
		@next_static path /_next/static/*
		handle @next_static {
			import next_static_cache
			reverse_proxy ecs-superadmin:3002
		}

		handle {
			reverse_proxy ecs-superadmin:3002
		}
	}

	# Public S3 API (path-style) + browser presigned PUT/GET → SeaweedFS.
	# Critical: preserve original Host so AWS SigV4 matches the presigned URL.
	@media host media.{$BASE_DOMAIN}
	handle @media {
		@media_get method GET HEAD
		handle @media_get {
			# Long-cache only reads of product/library objects.
			header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
			reverse_proxy ecs-seaweedfs:8333 {
				header_up Host {host}
			}
		}

		# Browser uploads may start on any shop dashboard. Restrict CORS to
		# HTTPS subdomains that this Caddy instance serves.
		@merchant_upload_origin {
			method PUT OPTIONS
			expression `{http.request.header.Origin}.startsWith("https://") && {http.request.header.Origin}.endsWith(".{$BASE_DOMAIN}")`
		}
		handle @merchant_upload_origin {
			header >Access-Control-Allow-Origin {http.request.header.Origin}
			header +Vary Origin
			@upload_preflight method OPTIONS
			handle @upload_preflight {
				header Access-Control-Allow-Methods "PUT, OPTIONS"
				header Access-Control-Allow-Headers "content-type"
				respond 204
			}
			handle {
				reverse_proxy ecs-seaweedfs:8333 {
					header_up Host {host}
					header_up -Origin
					header_down -Access-Control-Allow-Origin
				}
			}
		}

		# PUT/POST/DELETE/OPTIONS (presigned uploads + CORS preflight).
		handle {
			reverse_proxy ecs-seaweedfs:8333 {
				header_up Host {host}
			}
		}
	}

	@storefront host *.{$BASE_DOMAIN}
	handle @storefront {
		@next_static path /_next/static/*
		handle @next_static {
			import next_static_cache
			reverse_proxy ecs-dashboard:3001
		}

		@dashboard_assets path /_next/* /__nextjs* /favicon.ico /favicon.svg /brand/*
		handle @dashboard_assets {
			reverse_proxy ecs-dashboard:3001
		}

		@merchant_dashboard path /dashboard* /onboarding* /sign-in* /sign-up* /sign-out* /session* /check-email* /verify-email* /forgot-password* /reset-password* /accept-invitation*
		handle @merchant_dashboard {
			reverse_proxy ecs-dashboard:3001
		}

		@api path /api/*
		handle @api {
			uri strip_prefix /api
			reverse_proxy ecs-platform-api:3000
		}

		handle {
		reverse_proxy ecs-storefront:4321
		}
	}

	respond 404
}
